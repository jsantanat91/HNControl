<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.OrderDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle orden"
    Background="#E9EEF7">
    <ScrollView>
        <VerticalStackLayout Padding="14,12,14,28" Spacing="10">
            <Border Background="#0E2242" Padding="14" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="TitleLabel" FontAttributes="Bold" FontSize="24" TextColor="White" />
                    <Label x:Name="ClientLabel" FontSize="13" Opacity="0.85" TextColor="#C5D5F0" />
                    <HorizontalStackLayout Spacing="6">
                        <Border x:Name="TypeChip" Background="#D9E8FF" Padding="8,4" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                            <Label x:Name="TypeLabel" FontAttributes="Bold" FontSize="11" />
                        </Border>
                        <Border x:Name="StatusChip" Background="#DDF8E8" Padding="8,4" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                            <Label x:Name="StatusLabel" FontAttributes="Bold" FontSize="11" />
                        </Border>
                        <Border x:Name="AreaChip" Background="#D7F2FF" Padding="8,4" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                            <Label x:Name="AreaLabel" FontAttributes="Bold" FontSize="11" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Background="White" Padding="12" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="ClaimedByLabel" FontSize="13" Opacity="0.8" />
                    <Label x:Name="CreatedLabel" FontSize="13" Opacity="0.75" />
                    <Label x:Name="EstimatedLabel" FontSize="13" Opacity="0.75" />
                </VerticalStackLayout>
            </Border>

            <Border Background="White" Padding="12" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="6">
                    <Label FontAttributes="Bold" Text="Descripción" />
                    <Label x:Name="DescriptionLabel" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="EditorCard" Background="White" Padding="12" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" FontSize="18" Text="Captura técnica" />
                    <Label x:Name="EditHintLabel" FontSize="12" Opacity="0.75" Text="Solo quien tomó la orden puede editar." />

                    <Label FontAttributes="Bold" Text="Levantamiento" />
                    <Editor x:Name="LevantamientoEditor" AutoSize="TextChanges" MinimumHeightRequest="90" Placeholder="Notas de levantamiento técnico..." />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Button x:Name="AttachEvidenceButton"
                                Grid.Column="0"
                                Text="Adjuntar evidencia"
                                CornerRadius="10"
                                Clicked="OnAttachEvidenceClicked" />
                        <Label x:Name="EvidenceHintLabel"
                               Grid.Column="1"
                               FontSize="12"
                               Opacity="0.75"
                               VerticalTextAlignment="Center"
                               Text="Disponible en Levantamiento" />
                    </Grid>
                    <CollectionView x:Name="EvidenceCollection" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Opacity="0.7" Text="Sin evidencias cargadas." />
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <Label FontAttributes="Bold" Text="Materiales" />
                    <Editor x:Name="MaterialesEditor" AutoSize="TextChanges" MinimumHeightRequest="90" Placeholder="Materiales, cantidades y pendientes..." />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="PreviousAreaButton" Grid.Column="0" Text="Área anterior" Clicked="OnPreviousAreaClicked" CornerRadius="10" />
                        <Button x:Name="NextAreaButton" Grid.Column="1" Text="Siguiente área" Clicked="OnNextAreaClicked" CornerRadius="10" BackgroundColor="#2252D5" TextColor="White" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="SaveButton" Grid.Column="0" Text="Guardar" Clicked="OnSaveClicked" CornerRadius="10" BackgroundColor="#0E2242" TextColor="White" />
                        <Button x:Name="SubmitButton" Grid.Column="1" Text="Enviar revisión (final)" Clicked="OnSubmitClicked" CornerRadius="10" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
