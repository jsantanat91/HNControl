<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.OrderDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle orden"
    Background="{StaticResource AppBackgroundBrush}">
    <ScrollView x:Name="RootScroll">
        <VerticalStackLayout Padding="14,12,14,28" Spacing="10">
            <Border Style="{StaticResource HeaderCard}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="TitleLabel" FontAttributes="Bold" FontSize="24" TextColor="White" />
                    <Label x:Name="ClientLabel" FontSize="13" Opacity="0.85" TextColor="#C5D5F0" />
                    <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                        <Border x:Name="TypeChip" Background="#D9E8FF" Padding="8,4" StrokeShape="RoundRectangle 14" Stroke="{StaticResource AppBorder}" Margin="0,0,6,4">
                            <Label x:Name="TypeLabel" FontAttributes="Bold" FontSize="11" />
                        </Border>
                        <Border x:Name="StatusChip" Background="#DDF8E8" Padding="8,4" StrokeShape="RoundRectangle 14" Stroke="{StaticResource AppBorder}" Margin="0,0,6,4">
                            <Label x:Name="StatusLabel" FontAttributes="Bold" FontSize="11" />
                        </Border>
                        <Border x:Name="AreaChip" Background="#D7F2FF" Padding="8,4" StrokeShape="RoundRectangle 14" Stroke="{StaticResource AppBorder}" Margin="0,0,6,4">
                            <Label x:Name="AreaLabel" FontAttributes="Bold" FontSize="11" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="ClaimedByLabel" FontSize="13" Opacity="0.8" />
                    <Label x:Name="CreatedLabel" FontSize="13" Opacity="0.75" />
                    <Label x:Name="EstimatedLabel" FontSize="13" Opacity="0.75" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="6">
                    <Label FontAttributes="Bold" Text="Descripción" />
                    <Label x:Name="DescriptionLabel" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="EditorCard" Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="Captura técnica" />
                    <Label x:Name="EditHintLabel" FontSize="12" Opacity="0.75" Text="Solo quien tomó la orden puede editar." />

                    <VerticalStackLayout x:Name="LevantamientoSection" Spacing="8">
                        <Label FontAttributes="Bold" Text="Levantamiento" />
                        <Editor x:Name="LevantamientoEditor" AutoSize="TextChanges" MinimumHeightRequest="90" Placeholder="Notas de levantamiento técnico..." />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Button x:Name="AttachEvidenceButton"
                                    Grid.Column="0"
                                    Text="Adjuntar evidencia"
                                    CornerRadius="10"
                                    Clicked="OnAttachEvidenceClicked" />
                            <Label x:Name="EvidenceHintLabel"
                                   Grid.Column="1"
                                   FontSize="12"
                                   Opacity="0.75"
                                   VerticalTextAlignment="Center"
                                   Text="Puedes subir foto o PDF" />
                        </Grid>

                        <CollectionView x:Name="EvidenceCollection" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Opacity="0.7" Text="Sin evidencias cargadas." />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="MaterialesSection" Spacing="8" IsVisible="False">
                        <Label FontAttributes="Bold" Text="Materiales" />
                        <Editor x:Name="MaterialesEditor" AutoSize="TextChanges" MinimumHeightRequest="110" Placeholder="Materiales, cantidades y pendientes..." />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ChecklistSection" Spacing="8" IsVisible="False">
                        <Label FontAttributes="Bold" Text="Checklist de ejecución" />
                        <CollectionView x:Name="ChecklistCollection" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFE" Padding="10" Margin="0,4" StrokeShape="RoundRectangle 12" Stroke="{StaticResource AppBorder}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout>
                                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                                    <Label Text="{Binding Category}" FontSize="11" Opacity="0.75" />
                                                </VerticalStackLayout>
                                                <Switch IsToggled="{Binding IsDone}" />
                                            </Grid>
                                            <Editor Text="{Binding Notes}" AutoSize="TextChanges" MinimumHeightRequest="60" Placeholder="Notas" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Opacity="0.7" Text="No hay checklist en esta etapa." />
                            </CollectionView.EmptyView>
                        </CollectionView>
                        <Button x:Name="SaveChecklistButton"
                                Text="Guardar checklist"
                                Clicked="OnSaveChecklistClicked"
                                Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="CloseSection" Spacing="8" IsVisible="False">
                        <Label FontAttributes="Bold" Text="Cierre técnico" />
                        <Label Text="Firma autógrafa del técnico y del cliente." FontSize="12" Opacity="0.75" />
                        <Label x:Name="TechSignatureLabel" FontAttributes="Bold" Text="Técnico: -" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="SignTechButton"
                                    Grid.Column="0"
                                    Text="Firmar técnico"
                                    Clicked="OnSignTechClicked"
                                    CornerRadius="10"
                                    BackgroundColor="#2252D5"
                                    TextColor="White" />
                            <Label x:Name="TechSignStatusLabel"
                                   Grid.Column="1"
                                   VerticalTextAlignment="Center"
                                   FontAttributes="Bold"
                                   Text="Pendiente" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="SignClientButton"
                                    Grid.Column="0"
                                    Text="Firmar cliente"
                                    Clicked="OnSignClientClicked"
                                    CornerRadius="10"
                                    BackgroundColor="#0E2242"
                                    TextColor="White" />
                            <Label x:Name="ClientSignStatusLabel"
                                   Grid.Column="1"
                                   VerticalTextAlignment="Center"
                                   FontAttributes="Bold"
                                   Text="Pendiente" />
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="PreviousAreaButton" Grid.Column="0" Text="Área anterior" Clicked="OnPreviousAreaClicked" Style="{StaticResource GhostButton}" />
                        <Button x:Name="NextAreaButton" Grid.Column="1" Text="Siguiente área" Clicked="OnNextAreaClicked" Style="{StaticResource PrimaryButton}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="SaveButton" Grid.Column="0" Text="Guardar" Clicked="OnSaveClicked" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="SubmitButton" Grid.Column="1" Text="Firmar y enviar" Clicked="OnSubmitClicked" Style="{StaticResource GhostButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
