<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.ModulesHubPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Modulos"
    Background="{StaticResource AppBackgroundBrush}">
    <ScrollView>
        <VerticalStackLayout Padding="14,12,14,26" Spacing="10">
            <Border Style="{StaticResource HeaderCard}">
                <VerticalStackLayout Spacing="4">
                    <Label FontAttributes="Bold" FontSize="23" Text="Modulos operativos" TextColor="White" />
                    <Label FontSize="12" Opacity="0.85" Text="Visibles segun permisos del usuario." TextColor="#C5D5F0" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="ModulesCollection" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource PillBadgeBlue}" VerticalOptions="Start">
                                    <Label Text="{Binding Key}" FontAttributes="Bold" FontSize="10" TextColor="#1D4ED8" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label FontAttributes="Bold" FontSize="18" Text="{Binding Label}" TextColor="#0F172A" />
                                    <Label FontSize="12" Opacity="0.85" Text="{Binding Key}" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Clicked="OnOpenModuleClicked"
                                        CommandParameter="{Binding Key}"
                                        Style="{StaticResource PrimaryButton}"
                                        Text="Abrir"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
