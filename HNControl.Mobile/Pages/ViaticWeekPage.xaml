<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.ViaticWeekPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle de viáticos"
    Background="{StaticResource AppBackgroundBrush}">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,28" Spacing="12">
            <Border Style="{StaticResource HeaderCard}">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="WeekTitleLabel" FontAttributes="Bold" FontSize="22" Text="Semana" TextColor="White" />
                    <Label x:Name="WeekStatusLabel" FontSize="13" Opacity="0.9" TextColor="#C5D5F0" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label FontSize="12" Opacity="0.7" Text="Total semana" />
                        <Label x:Name="TotalLabel" FontAttributes="Bold" FontSize="24" Text="$0.00" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SurfaceCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label FontSize="12" Opacity="0.7" Text="Facturable" />
                        <Label x:Name="BillableLabel" FontAttributes="Bold" FontSize="24" Text="$0.00" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border x:Name="TravelInfoCard" IsVisible="False" Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="4">
                    <Label FontAttributes="Bold" FontSize="17" Text="Solicitud de Gastos" />
                    <Label x:Name="TravelSummaryLabel" FontSize="13" />
                    <Label x:Name="TravelRequestedLabel" FontSize="13" />
                    <Label x:Name="TravelApprovedLabel" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="FormCard" Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="FormTitleLabel" FontAttributes="Bold" FontSize="17" Text="Agregar gasto" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <DatePicker x:Name="DayDatePicker" Grid.Column="0" />
                        <Picker x:Name="CategoryPicker" Grid.Column="1" ItemDisplayBinding="{Binding Label}" Title="Categoria" />
                    </Grid>
                    <Label Text="Concepto del gasto" Style="{StaticResource FieldLabel}" /><Entry x:Name="DescriptionEntry" Placeholder="Descripcion del gasto" />
                    <Label Text="Importe en MXN" Style="{StaticResource FieldLabel}" /><Entry x:Name="AmountEntry" Keyboard="Numeric" Placeholder="Monto (ej. 250.00)" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Switch x:Name="IsBillableSwitch" Grid.Column="0" />
                        <Label Grid.Column="1" VerticalTextAlignment="Center" Text="Facturable (requiere factura adjunta)" />
                        <Button x:Name="AttachButton" Grid.Column="2"
                                Clicked="OnPickAttachmentClicked"
                                CornerRadius="10"
                                MinimumHeightRequest="48"
                                Text="Adjuntar" />
                    </Grid>
                    <Label x:Name="SelectedPdfLabel" FontSize="12" Opacity="0.75" Text="Sin archivo adjunto" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="SaveEntryButton"
                                Grid.Column="0"
                                Clicked="OnSaveEntryClicked"
                                Style="{StaticResource PrimaryButton}"
                                Text="Guardar" />
                        <Button x:Name="CancelEditButton"
                                Grid.Column="1"
                                Clicked="OnCancelEditClicked"
                                CornerRadius="10"
                                MinimumHeightRequest="48"
                                IsVisible="False"
                                Text="Cancelar" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label FontAttributes="Bold" FontSize="18" Text="Gastos" />
                        <Label x:Name="EntriesCountLabel" Grid.Column="1" FontSize="12" Opacity="0.75" />
                    </Grid>
                    <VerticalStackLayout x:Name="EntriesCollection" Spacing="8">
                        <BindableLayout.EmptyView>
                            <Label Opacity="0.7" Text="Aun no agregas gastos en esta semana." />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Background="#F9FBFF" Padding="10" StrokeShape="RoundRectangle 12" Stroke="#E5ECFA">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label FontAttributes="Bold" Text="{Binding Description}" LineBreakMode="WordWrap" />
                                            <Label Grid.Column="1" FontAttributes="Bold" Text="{Binding Amount, StringFormat='${0:N2}'}" />
                                        </Grid>
                                        <Label FontSize="12" Opacity="0.75" Text="{Binding DayDate, StringFormat='{0:yyyy-MM-dd}'}" />
                                        <Label FontSize="12" Opacity="0.75" Text="{Binding CategoryLabel}" />
                                        <Label FontSize="11" Text="{Binding AttachmentLabel}" TextColor="{StaticResource AppMuted}" />
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                                            <Button Clicked="OnEditEntryClicked"
                                                    CommandParameter="{Binding .}"
                                                    CornerRadius="10"
                                                    MinimumHeightRequest="44"
                                                    Text="Editar" />
                                            <Button Grid.Column="1"
                                                    BackgroundColor="#D13A3A"
                                                    Clicked="OnDeleteEntryClicked"
                                                    CommandParameter="{Binding Id}"
                                                    CornerRadius="10"
                                                    MinimumHeightRequest="44"
                                                    Text="Eliminar"
                                                    TextColor="White" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="SubmitButton"
                    Clicked="OnSubmitWeekClicked"
                    Style="{StaticResource PrimaryButton}"
                    Text="Enviar semana al admin" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
