<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.KnowledgeModulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Documentos"
    Background="#E9EEF7">
    <CollectionView x:Name="ItemsCollection" Margin="14,12,14,12" SelectionMode="None">
        <CollectionView.EmptyView>
            <Border Background="White" Padding="16" StrokeShape="RoundRectangle 14">
                <Label HorizontalOptions="Center" Opacity="0.7" Text="No hay documentos publicados." />
            </Border>
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Background="White" Margin="0,0,0,10" Padding="12" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="5">
                        <Label FontAttributes="Bold" FontSize="17" Text="{Binding Title}" />
                        <Label FontSize="12" Opacity="0.75" Text="{Binding Category}" />
                        <Label FontSize="12" Opacity="0.75" Text="{Binding Meta}" />
                        <Button Clicked="OnOpenClicked"
                                CommandParameter="{Binding Url}"
                                CornerRadius="10"
                                HeightRequest="36"
                                IsVisible="{Binding HasUrl}"
                                Text="Abrir enlace" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
