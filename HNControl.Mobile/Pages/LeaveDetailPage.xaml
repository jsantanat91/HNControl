<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.LeaveDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle solicitud"
    Background="#E9EEF7">
    <ScrollView>
        <VerticalStackLayout Padding="14,12,14,24" Spacing="10">
            <Border Background="#0E2242" Padding="14" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="TitleLabel" FontAttributes="Bold" FontSize="22" TextColor="White" />
                    <Label x:Name="StatusLabel" FontSize="13" Opacity="0.85" TextColor="#C5D5F0" />
                </VerticalStackLayout>
            </Border>

            <Border Background="White" Padding="12" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="RangeLabel" />
                    <Label x:Name="MetaLabel" FontSize="12" Opacity="0.75" />
                    <Label x:Name="ReviewedLabel" FontSize="12" Opacity="0.75" />
                </VerticalStackLayout>
            </Border>

            <Border Background="White" Padding="12" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="6">
                    <Label FontAttributes="Bold" Text="Motivo" />
                    <Label x:Name="ReasonLabel" />
                </VerticalStackLayout>
            </Border>

            <Border Background="White" Padding="12" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="6">
                    <Label FontAttributes="Bold" Text="Comentario admin" />
                    <Label x:Name="AdminCommentLabel" />
                </VerticalStackLayout>
            </Border>

            <Border Background="White" Padding="12" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="6">
                    <Label FontAttributes="Bold" Text="Evidencias" />
                    <CollectionView x:Name="EvidenceCollection" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Opacity="0.7" Text="Sin evidencias adjuntas." />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
