<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.ExamTakePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Resolver examen"
    Background="#E9EEF7">
    <Grid RowDefinitions="*,Auto" Padding="14,12,14,14">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="10">
                <Border Background="#0E2242" Padding="14" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="TitleLabel" FontAttributes="Bold" FontSize="22" Text="Examen" TextColor="White" />
                        <Label x:Name="MetaLabel" FontSize="12" Opacity="0.9" TextColor="#C5D5F0" />
                    </VerticalStackLayout>
                </Border>

                <Border Background="White" Padding="12" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="6">
                        <Label FontAttributes="Bold" Text="Descripcion" />
                        <Label x:Name="DescriptionLabel" Opacity="0.85" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="QuestionsStack" Spacing="10" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,10,0,0">
            <Button
                Grid.Column="0"
                BackgroundColor="#2252D5"
                Clicked="OnSaveClicked"
                CornerRadius="12"
                HeightRequest="44"
                Text="Guardar avance"
                TextColor="White" />
            <Button
                Grid.Column="1"
                BackgroundColor="#1D8F58"
                Clicked="OnSubmitClicked"
                CornerRadius="12"
                HeightRequest="44"
                Text="Enviar examen"
                TextColor="White" />
        </Grid>
    </Grid>
</ContentPage>
