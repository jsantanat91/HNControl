<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:HNControl.Mobile.Models" x:Class="HNControl.Mobile.Pages.ServiceInventoryPage" Title="Inventario de Servicios" BackgroundColor="{StaticResource AppBgTop}">
 <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
  <VerticalStackLayout Spacing="4"><Label Text="CONEXIONES Y EQUIPOS" Style="{StaticResource Eyebrow}"/><Label Text="Tus servicios, a la mano." FontSize="24" FontAttributes="Bold"/><Label Text="Consulta por cliente y proveedor." Style="{StaticResource MutedLabel}"/></VerticalStackLayout>
  <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="12"><VerticalStackLayout Spacing="4"><Picker x:Name="ClientPicker" Title="Todos los clientes" SelectedIndexChanged="OnFilterChanged"/><Picker x:Name="CarrierPicker" Title="Todos los proveedores" SelectedIndexChanged="OnFilterChanged"/><Button Text="Actualizar" Clicked="OnRefresh" Style="{StaticResource GhostButton}"/></VerticalStackLayout></Border>
  <VerticalStackLayout Grid.Row="2"><Label x:Name="CountLabel" Style="{StaticResource MutedLabel}"/><Label x:Name="ErrorLabel" TextColor="{StaticResource AppDanger}" IsVisible="False"/><ActivityIndicator x:Name="BusyIndicator" IsVisible="False"/></VerticalStackLayout>
  <CollectionView x:Name="ItemsView" Grid.Row="3" SelectionMode="Single" SelectionChanged="OnSelected">
   <CollectionView.EmptyView><Label Text="No hay servicios para estos filtros." Padding="20" HorizontalTextAlignment="Center" TextColor="{StaticResource AppMuted}"/></CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="models:ServiceInventoryRow"><Border Style="{StaticResource SurfaceCard}" Padding="16" Margin="0,0,0,10"><VerticalStackLayout Spacing="7"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding Carrier}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource AppAccent}"/><Label Grid.Column="1" Text="{Binding Status}" FontSize="11" TextColor="{StaticResource AppMuted}"/></Grid><Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"/><Label Text="{Binding Client}" FontSize="13"/><Label Text="{Binding Summary}" Style="{StaticResource MutedLabel}"/><Label Text="Ver equipo y datos técnicos →" FontSize="12" TextColor="{StaticResource AppAccent}"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
  <Grid Grid.Row="4" ColumnDefinitions="*,Auto,*" ColumnSpacing="12"><Button x:Name="PreviousButton" Text="Anterior" Clicked="OnPrevious" Style="{StaticResource GhostButton}"/><Label x:Name="PageLabel" Grid.Column="1" VerticalOptions="Center"/><Button x:Name="NextButton" Grid.Column="2" Text="Siguiente" Clicked="OnNext" Style="{StaticResource GhostButton}"/></Grid>
 </Grid>
</ContentPage>
