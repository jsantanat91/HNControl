<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.CarrierClientDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Servicios carrier"
    Background="{StaticResource AppBackgroundBrush}">
    <ScrollView>
        <VerticalStackLayout Padding="14,12,14,24" Spacing="10">
            <Border Style="{StaticResource HeaderCard}">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="ClientLabel" FontAttributes="Bold" FontSize="22" TextColor="White" />
                    <Label x:Name="ClientMetaLabel" FontSize="13" Opacity="0.85" TextColor="#C5D5F0" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="ServicesCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource SurfaceCard}" Padding="14">
                        <Label Opacity="0.75" Text="Sin servicios activos." />
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label FontAttributes="Bold" FontSize="17" Text="{Binding ServiceLabel}" LineBreakMode="WordWrap" />
                                    <Border Grid.Column="1" Style="{StaticResource PillBadgeBlue}">
                                        <Label FontSize="12" Text="{Binding Carrier}" TextColor="#1D4ED8" />
                                    </Border>
                                </Grid>
                                <Label FontSize="12" Opacity="0.8" Text="{Binding Plan}" LineBreakMode="WordWrap" />
                                <Label FontSize="12" Opacity="0.75" Text="{Binding Numbers}" LineBreakMode="WordWrap" />
                                <Label FontSize="12" Opacity="0.75" Text="{Binding Address}" LineBreakMode="WordWrap" />
                                <Label FontSize="12" Opacity="0.75" Text="{Binding Support}" LineBreakMode="WordWrap" />
                                <Label FontSize="12" Text="{Binding Notes}" LineBreakMode="WordWrap" />
                                <Label FontSize="11" Opacity="0.7" Text="{Binding LastNotes}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
