<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.MonitoringModulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Monitoreo"
    Background="#E9EEF7">
    <CollectionView x:Name="ItemsCollection" Margin="14,12,14,12" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Background="White" Margin="0,0,0,10" Padding="12" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label FontAttributes="Bold" FontSize="17" Text="{Binding Name}" />
                            <Label Grid.Column="1" Text="{Binding Status}" />
                        </Grid>
                        <Label FontSize="12" Opacity="0.7" Text="{Binding Client}" />
                        <Label FontSize="13" Text="{Binding Address}" />
                        <Label FontSize="12" Opacity="0.75" Text="{Binding Meta}" />
                        <Button Margin="0,6,0,0"
                                HorizontalOptions="Start"
                                Text="Ver detalle"
                                CornerRadius="10"
                                CommandParameter="{Binding Id}"
                                Clicked="OnOpenDetailClicked" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
