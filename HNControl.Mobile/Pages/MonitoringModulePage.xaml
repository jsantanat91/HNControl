<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.MonitoringModulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Monitoreo"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*" Padding="14,12,14,12">
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}">
            <VerticalStackLayout Spacing="2">
                <Label Text="Monitoreo" TextColor="White" FontAttributes="Bold" FontSize="22" />
                <Label Text="Estado en tiempo real de tus targets" TextColor="#C5D5F0" FontSize="12" />
            </VerticalStackLayout>
        </Border>

        <CollectionView x:Name="ItemsCollection" Grid.Row="1" Margin="0,12,0,0" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Label FontAttributes="Bold" FontSize="17" Text="{Binding Name}" LineBreakMode="WordWrap" />
                                <Border Grid.Column="1" BackgroundColor="{Binding StatusBg}" Stroke="{Binding StatusStroke}" StrokeShape="RoundRectangle 999" Padding="10,3">
                                    <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding StatusTextColor}" />
                                </Border>
                            </Grid>
                            <Label FontSize="12" Opacity="0.75" Text="{Binding Client}" LineBreakMode="WordWrap" />
                            <Label FontSize="13" Text="{Binding Address}" LineBreakMode="WordWrap" />
                            <Label FontSize="12" Opacity="0.75" Text="{Binding Meta}" LineBreakMode="WordWrap" />
                            <Button Margin="0,6,0,0"
                                    HorizontalOptions="Start"
                                    Text="Ver detalle"
                                    Style="{StaticResource GhostButton}"
                                    CommandParameter="{Binding Id}"
                                    Clicked="OnOpenDetailClicked" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
