<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.InventoryModulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Inventario"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*" Padding="14,12">
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button
                    Clicked="OnRequestInClicked"
                    Style="{StaticResource PrimaryButton}"
                    Text="+ Entrada" />
                <Button
                    Grid.Column="1"
                    Clicked="OnRequestOutClicked"
                    Style="{StaticResource GhostButton}"
                    Text="- Salida" />
                <Label
                    Grid.Column="2"
                    FontSize="12"
                    HorizontalTextAlignment="End"
                    Opacity="0.85"
                    Text="Solicitudes"
                    TextColor="#C5D5F0"
                    VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <CollectionView x:Name="ItemsCollection" Grid.Row="1" Margin="0,12,0,0" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label FontAttributes="Bold" FontSize="16" Text="{Binding ItemsPreview}" LineBreakMode="WordWrap" />
                                <Border Grid.Column="1" Style="{StaticResource PillBadgeBlue}">
                                    <Label Text="{Binding StatusLabel}" FontSize="12" TextColor="#1D4ED8" />
                                </Border>
                            </Grid>
                            <Label FontSize="12" Opacity="0.75" Text="{Binding Meta}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
