<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.OrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ordenes"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*" Padding="14,12">
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label FontAttributes="Bold" FontSize="24" Text="Ordenes de servicio" TextColor="White" />
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnRefreshClicked"
                        HeightRequest="40"
                        Text="Actualizar"
                        TextColor="White" />
                <Label Grid.Row="1"
                       Grid.ColumnSpan="2"
                       FontSize="12"
                       Opacity="0.85"
                       Text="Visibles para todo el equipo. Solo quien la toma puede editar."
                       TextColor="#C5D5F0" />
            </Grid>
        </Border>

        <RefreshView x:Name="OrdersRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="OrdersCollection" Margin="0,12,0,0" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource SurfaceCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label FontAttributes="Bold" FontSize="19" HorizontalOptions="Center" Text="Sin ordenes" />
                            <Label HorizontalOptions="Center" Opacity="0.7" Text="Desliza hacia abajo para recargar." />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Style="{StaticResource SurfaceCard}">
                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="0">
                                        <Label FontAttributes="Bold" FontSize="19" Text="{Binding Title}" />
                                        <Label FontSize="13" Opacity="0.75" Text="{Binding Client}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           FontSize="12"
                                           Opacity="0.75"
                                           Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd}'}"
                                           VerticalTextAlignment="Start" />
                                </Grid>

                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="{Binding TypeBg}" Padding="8,4" StrokeShape="RoundRectangle 14" Stroke="{StaticResource AppBorder}">
                                        <Label FontAttributes="Bold" FontSize="11" Text="{Binding TypeLabel}" />
                                    </Border>
                                    <Border BackgroundColor="{Binding StatusBg}" Padding="8,4" StrokeShape="RoundRectangle 14" Stroke="{StaticResource AppBorder}">
                                        <Label FontAttributes="Bold" FontSize="11" Text="{Binding StatusLabel}" />
                                    </Border>
                                    <Border BackgroundColor="{Binding AreaBg}" Padding="8,4" StrokeShape="RoundRectangle 14" Stroke="{StaticResource AppBorder}">
                                        <Label FontAttributes="Bold" FontSize="11" Text="{Binding AreaLabel}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Label FontSize="13" Opacity="0.75" Text="{Binding ClaimedBy, StringFormat='Tomada por: {0}'}" />

                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                                    <Button Clicked="OnDetailClicked"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource GhostButton}"
                                            HeightRequest="38"
                                            Text="Detalle" />
                                    <Button Grid.Column="1"
                                            Clicked="OnPdfClicked"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource GhostButton}"
                                            HeightRequest="38"
                                            Text="PDF" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource PrimaryButton}"
                                            Clicked="OnTakeClicked"
                                            CommandParameter="{Binding Id}"
                                            HeightRequest="38"
                                            IsVisible="{Binding CanTake}"
                                            Text="Tomar orden" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
