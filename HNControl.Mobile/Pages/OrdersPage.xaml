<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.OrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ordenes">
    <Grid RowDefinitions="Auto,*" Padding="14">
        <Border Grid.Row="0" Padding="12" StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label FontAttributes="Bold" FontSize="22" Text="Ordenes de servicio" />
                <Button Grid.Column="1" Clicked="OnRefreshClicked" Text="Actualizar" />
                <Label Grid.Row="1" Grid.ColumnSpan="2" Opacity="0.7" Text="Visibles para todo el equipo. Solo quien la toma la edita." />
            </Grid>
        </Border>

        <RefreshView x:Name="OrdersRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="OrdersCollection" Margin="0,12,0,0" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="10" Spacing="8">
                        <Label FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" Text="Sin ordenes" />
                        <Label HorizontalOptions="Center" Opacity="0.7" Text="Intenta recargar." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="12" StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label FontAttributes="Bold" FontSize="18" Text="{Binding Title}" />
                                    <Label Grid.Column="1" Opacity="0.7" Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd}'}" />
                                </Grid>
                                <Label Opacity="0.8" Text="{Binding Client}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label BackgroundColor="#EEF4FF" Padding="8,3" Text="{Binding TypeLabel}" />
                                    <Label BackgroundColor="#F2F4F7" Padding="8,3" Text="{Binding StatusLabel}" />
                                    <Label BackgroundColor="#ECFDF3" Padding="8,3" Text="{Binding AreaLabel}" />
                                </HorizontalStackLayout>
                                <Label Opacity="0.75" Text="{Binding ClaimedBy, StringFormat='Tomada por: {0}'}" />
                                <HorizontalStackLayout Spacing="10">
                                    <Button Clicked="OnDetailClicked" CommandParameter="{Binding Id}" Text="Detalle" />
                                    <Button Clicked="OnTakeClicked" CommandParameter="{Binding Id}" IsVisible="{Binding CanTake}" Text="Tomar orden" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
