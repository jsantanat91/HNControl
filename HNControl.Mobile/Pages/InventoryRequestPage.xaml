<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.InventoryRequestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Solicitar material"
    Background="{StaticResource AppBackgroundBrush}">
    <ScrollView>
        <VerticalStackLayout Margin="14,12,14,24" Spacing="10">
            <Border Style="{StaticResource HeaderCard}">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="HeaderTitleLabel" FontAttributes="Bold" FontSize="22" Text="Solicitud de salida" TextColor="White" />
                    <Label x:Name="HeaderSubLabel" FontSize="12" Opacity="0.85" Text="Captura item y cantidad para solicitar aprobación." TextColor="#C5D5F0" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" Text="Item" />
                    <Picker x:Name="ItemPicker" ItemDisplayBinding="{Binding Display}" Title="Selecciona un item" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="4">
                            <Label FontAttributes="Bold" Text="Cantidad" />
                            <Entry x:Name="QtyEntry" Keyboard="Numeric" Placeholder="1" Text="1" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label FontAttributes="Bold" Text="Proyecto (opcional)" />
                            <Picker x:Name="ProjectPicker" ItemDisplayBinding="{Binding Title}" Title="Sin proyecto" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label FontAttributes="Bold" Text="Notas de la linea (opcional)" />
                    <Entry x:Name="LineNotesEntry" Placeholder="Detalle de esta linea..." />

                    <Button
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnAddLineClicked"
                        HeightRequest="40"
                        Text="Agregar línea" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" Text="Líneas capturadas" />
                    <CollectionView x:Name="LinesCollection" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Opacity="0.65" Text="Aun no agregas lineas." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10" Background="#F8FAFF" StrokeShape="RoundRectangle 12" Stroke="{StaticResource AppBorder}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <Label FontAttributes="Bold" Text="{Binding ItemName}" />
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource GhostButton}"
                                            Clicked="OnRemoveLineClicked"
                                            CommandParameter="{Binding Id}"
                                            FontSize="11"
                                            HeightRequest="30"
                                            Text="Quitar" />
                                        <Label Grid.Row="1" FontSize="12" Opacity="0.75" Text="{Binding Meta}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" Text="Notas globales (opcional)" />
                    <Editor x:Name="GlobalNotesEditor" AutoSize="TextChanges" Placeholder="Contexto general de la solicitud..." />
                </VerticalStackLayout>
            </Border>

            <Button
                BackgroundColor="#1D8F58"
                Clicked="OnSubmitClicked"
                CornerRadius="12"
                HeightRequest="46"
                Text="Enviar solicitud"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
