<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.TicketsModulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Tickets"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*" Padding="14,12,14,14">
        <VerticalStackLayout Spacing="10">
            <Border Style="{StaticResource HeaderCard}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Tickets" TextColor="White" FontAttributes="Bold" FontSize="22" />
                    <Label Text="Flujo operativo ITIL" TextColor="#C5D5F0" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="StatusPicker" Grid.Column="0" Title="Filtro" SelectedIndexChanged="OnFilterChanged">
                    <Picker.Items>
                        <x:String>Abiertos</x:String>
                        <x:String>Mios</x:String>
                        <x:String>Cerrados</x:String>
                    </Picker.Items>
                </Picker>
                <Button Grid.Column="1" Text="Refrescar" Style="{StaticResource PrimaryButton}" Clicked="OnRefreshClicked" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView x:Name="ItemsCollection" Grid.Row="1" Margin="0,12,0,0" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="7">
                            <VerticalStackLayout>
                                <Label Text="{Binding TicketNumber}" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="WordWrap" MaxLines="3" />
                                <Label Text="{Binding Client}" FontSize="13" TextColor="#475569" LineBreakMode="WordWrap" MaxLines="3" />
                            </VerticalStackLayout>

                            <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                                <Border BackgroundColor="{Binding StatusBg}" Stroke="{Binding StatusStroke}" StrokeShape="RoundRectangle 999" Padding="8,3" Margin="0,0,6,0">
                                    <Label Text="{Binding Status}" FontSize="12" TextColor="{Binding StatusColor}" />
                                </Border>
                                <Border BackgroundColor="{Binding PriorityBg}" Stroke="{Binding PriorityStroke}" StrokeShape="RoundRectangle 999" Padding="8,3">
                                    <Label Text="{Binding Priority}" FontSize="12" TextColor="{Binding PriorityColor}" />
                                </Border>
                            </FlexLayout>

                            <Label Text="{Binding Meta}" FontSize="12" TextColor="#64748B" LineBreakMode="WordWrap" />
                            <Label Text="{Binding BreachText}" FontSize="12" TextColor="#DC2626" IsVisible="{Binding IsBreach}" />

                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                                <Button Text="Tomar" Clicked="OnTakeClicked" CommandParameter="{Binding Id}" IsVisible="{Binding CanTake}" Style="{StaticResource GhostButton}" />
                                <Button Grid.Column="1" Text="Abrir" Clicked="OnOpenClicked" CommandParameter="{Binding Id}" Style="{StaticResource PrimaryButton}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
