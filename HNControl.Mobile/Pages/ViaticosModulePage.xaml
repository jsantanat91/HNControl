<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.ViaticosModulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Viáticos"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*" Padding="20,12">
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}">
            <VerticalStackLayout Spacing="14">
                <Label Text="GASTOS Y COMPROBACIONES" TextColor="#BCE7DE" FontSize="10" CharacterSpacing="1.4" FontAttributes="Bold" />
                <Label Text="Mis viáticos" TextColor="White" FontSize="27" FontAttributes="Bold" />
                <Label Text="Registra, comprueba y sigue tus gastos." TextColor="#D5EDE9" FontSize="13" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="+ Semana" Clicked="OnNewWeekClicked" Style="{StaticResource PrimaryButton}" />
                    <Button Grid.Column="1" Text="+ Viaje" Clicked="OnNewTravelClicked" Style="{StaticResource GhostButton}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <RefreshView x:Name="WeeksRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="WeeksCollection" Margin="0,12,0,0" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource SurfaceCard}" Padding="16">
                        <VerticalStackLayout Spacing="6">
                            <Label FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" Text="Tus gastos, en orden" />
                            <Label HorizontalOptions="Center" Opacity="0.7" Text="Crea una semana o solicita un viaje." />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Style="{StaticResource SurfaceCard}">
                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label FontAttributes="Bold"
                                           FontSize="16"
                                           Text="{Binding WeekStartDate, StringFormat='Semana del {0:dd MMM yyyy}'}" />
                                    <Label Grid.Column="1"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Text="{Binding StatusLabel}" />
                                </Grid>
                                <Label FontSize="12" Text="{Binding FlowLabel}" TextColor="{StaticResource AppMuted}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Border Grid.Column="0" BackgroundColor="#EEF3FF" Padding="10,8" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="0">
                                            <Label FontSize="11" Opacity="0.75" Text="Total" />
                                            <Label FontAttributes="Bold" FontSize="16" Text="{Binding TotalAmount, StringFormat='${0:N2}'}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="#F3F7EC" Padding="10,8" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="0">
                                            <Label FontSize="11" Opacity="0.75" Text="Entradas" />
                                            <Label FontAttributes="Bold" FontSize="16" Text="{Binding EntriesCount}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <Button Clicked="OnOpenWeekClicked"
                                        CommandParameter="{Binding Id}"
                                        Style="{StaticResource PrimaryButton}"
                                        Text="Ver gastos  →"
                                        />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
