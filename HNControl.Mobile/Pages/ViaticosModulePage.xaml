<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.ViaticosModulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Viáticos"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Padding="18,14,18,0">
        <Border Style="{StaticResource HeaderCard}">
            <Grid>
                <Image Source="module_signal.png" WidthRequest="112" HeightRequest="82" HorizontalOptions="End" VerticalOptions="Center" Aspect="AspectFit" Opacity="0.5" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" />
                <VerticalStackLayout Spacing="6" Padding="0,8">
                    <Label Text="Mis viáticos" Style="{StaticResource HeroTitle}" />
                    <Label Text="Registra gastos y solicita anticipos." Style="{StaticResource HeroSubtitle}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="+ Semana" Clicked="OnNewWeekClicked" Style="{StaticResource PrimaryButton}" />
            <Button Grid.Column="1" Text="+ Viaje" Clicked="OnNewTravelClicked" Style="{StaticResource GhostButton}" />
        </Grid>

        <RefreshView x:Name="WeeksRefreshView" Grid.Row="2" Refreshing="OnRefreshing">
            <CollectionView x:Name="WeeksCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource SurfaceCard}" Padding="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource SectionTitle}" HorizontalOptions="Center" Text="Sin viáticos registrados" />
                            <Label HorizontalOptions="Center" Opacity="0.7" Text="Crea una semana o solicita un viaje." />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Style="{StaticResource SurfaceCard}">
                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label FontAttributes="Bold"
                                           FontSize="16"
                                           Text="{Binding WeekStartDate, StringFormat='Semana del {0:dd MMM yyyy}'}" />
                                    <Border Grid.Column="1" Style="{StaticResource PillBadgeBlue}" VerticalOptions="Start">
                                        <Label FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource AppAccent}" Text="{Binding StatusLabel}" />
                                    </Border>
                                </Grid>
                                <Label FontSize="12" Text="{Binding FlowLabel}" TextColor="{StaticResource AppMuted}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Border Grid.Column="0" BackgroundColor="{StaticResource AppAccentSoft}" Padding="12,10" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="0">
                                            <Label FontSize="11" Opacity="0.75" Text="Total" />
                                            <Label FontAttributes="Bold" FontSize="16" Text="{Binding TotalAmount, StringFormat='${0:N2}'}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="{StaticResource AppSuccessSoft}" Padding="12,10" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="0">
                                            <Label FontSize="11" Opacity="0.75" Text="Entradas" />
                                            <Label FontAttributes="Bold" FontSize="16" Text="{Binding EntriesCount}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <Button Clicked="OnOpenWeekClicked"
                                        CommandParameter="{Binding Id}"
                                        Style="{StaticResource PrimaryButton}"
                                        Text="Ver gastos  →"
                                        />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
