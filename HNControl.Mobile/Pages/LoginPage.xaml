<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login"
    Background="#E9EEF7">
    <Grid RowDefinitions="Auto,*">
        <Grid Background="#0E2242" HeightRequest="180">
            <VerticalStackLayout Padding="24,56,24,24" Spacing="4">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Border Background="White" Padding="6" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                        <Image HeightRequest="42" Source="hn_logo.png" WidthRequest="42" />
                    </Border>
                    <VerticalStackLayout Spacing="0">
                        <Label FontAttributes="Bold" FontSize="31" Text="HN Control" TextColor="White" />
                        <Label FontSize="14" Opacity="0.9" Text="Operacion movil" TextColor="#BBD0EE" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Margin="18,-42,18,18" Spacing="14">
            <Border Background="White" Padding="18" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="12">
                    <Label FontAttributes="Bold" FontSize="22" Text="Iniciar sesion" />
                    <Label FontSize="13" Opacity="0.7" Text="control.hubnet-solutions.net" />

                    <VerticalStackLayout Spacing="4">
                        <Label FontAttributes="Bold" FontSize="13" Text="Usuario o correo" />
                        <Entry x:Name="EmailEntry" Placeholder="usuario@empresa.com" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label FontAttributes="Bold" FontSize="13" Text="Contrasena" />
                        <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="********" />
                    </VerticalStackLayout>

                    <Button x:Name="LoginButton"
                            BackgroundColor="#2B5FD9"
                            Clicked="OnLoginClicked"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            HeightRequest="52"
                            Text="Entrar"
                            TextColor="White" />

                    <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" />
                    <Label x:Name="ErrorLabel" FontAttributes="Bold" IsVisible="False" TextColor="#B42318" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
