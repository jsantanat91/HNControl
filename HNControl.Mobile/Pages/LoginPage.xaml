<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login"
    BackgroundColor="#05070B">
    <Grid RowDefinitions="Auto,*">
        <Grid Background="#04070D" HeightRequest="320">
            <Image Source="tech_bg.svg" Aspect="AspectFill" Opacity="0.16" />
            <BoxView Color="#0EA5E9" Opacity="0.08" CornerRadius="260" WidthRequest="360" HeightRequest="360" HorizontalOptions="End" VerticalOptions="Start" TranslationX="120" TranslationY="-110" />
            <BoxView Color="#22D3EE" Opacity="0.08" CornerRadius="220" WidthRequest="280" HeightRequest="280" HorizontalOptions="Start" VerticalOptions="End" TranslationX="-100" TranslationY="90" />

            <VerticalStackLayout Padding="24,56,24,24" Spacing="4">
                <HorizontalStackLayout x:Name="HeroLayout" Spacing="12" VerticalOptions="Center" Opacity="0" TranslationY="18">
                    <Border Background="#0E1B33" Padding="0" StrokeShape="RoundRectangle 14" Stroke="#1E335A" StrokeThickness="1">
                        <Grid HeightRequest="54" WidthRequest="54">
                            <Label FontAttributes="Bold"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   Text="HN"
                                   TextColor="#E2E8F0"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Spacing="0">
                        <Label FontAttributes="Bold" FontSize="31" Text="HN Control" TextColor="#F8FAFC" />
                        <Label FontSize="14" Opacity="0.9" Text="Operacion movil" TextColor="#A7B8D4" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Margin="18,-74,18,18" Spacing="14">
            <Border x:Name="LoginCard" Background="#0D1528" Padding="18" StrokeShape="RoundRectangle 24" Stroke="#1C2A45" StrokeThickness="1" Opacity="0" TranslationY="22">
                <VerticalStackLayout Spacing="12">
                    <Label FontAttributes="Bold" FontSize="24" Text="Iniciar sesion" TextColor="#F8FAFC" />
                    <Label FontSize="13" Opacity="0.85" Text="control.hubnet-solutions.net" TextColor="#A7B8D4" />

                    <VerticalStackLayout Spacing="4">
                        <Label FontAttributes="Bold" FontSize="13" Text="Usuario o correo" TextColor="#D7E1F2" />
                        <Entry x:Name="EmailEntry" Placeholder="usuario@empresa.com" TextColor="#F8FAFC" PlaceholderColor="#7A8CA8" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label FontAttributes="Bold" FontSize="13" Text="Contrasena" TextColor="#D7E1F2" />
                        <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="********" TextColor="#F8FAFC" PlaceholderColor="#7A8CA8" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                        <CheckBox x:Name="RememberCheck" Color="#2B5FD9" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center" Text="Recordarme" TextColor="#A7B8D4" />
                    </Grid>

                    <Button x:Name="LoginButton"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnLoginClicked"
                            Text="Entrar"
                            Margin="0,6,0,0" />

                    <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" />
                    <Label x:Name="ErrorLabel" FontAttributes="Bold" IsVisible="False" TextColor="#FCA5A5" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
