<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HNControl.Mobile.Pages.LoginPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 NavigationPage.HasNavigationBar="False" BackgroundColor="{StaticResource AppBgTop}">
 <ScrollView>
  <VerticalStackLayout Padding="22,18,22,22" Spacing="16" MaximumWidthRequest="520" HorizontalOptions="Fill">
   <HorizontalStackLayout Spacing="12">
    <Border BackgroundColor="{StaticResource AppAccent}" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="52" HeightRequest="52">
     <Label Text="HN" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
    </Border>
    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
     <Label Text="HN Control" FontSize="22" FontAttributes="Bold" />
     <Label Text="HUBNET SOLUTIONS" Style="{StaticResource Eyebrow}" />
    </VerticalStackLayout>
   </HorizontalStackLayout>
   <Border StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="22,20" BackgroundColor="#10284A">
    <VerticalStackLayout x:Name="HeroLayout" Spacing="8">
     <Label Text="TU OPERACIÓN, A LA MANO." FontSize="10" CharacterSpacing="1.3" TextColor="#79C9FF" FontAttributes="Bold" />
     <Label Text="Todo conectado.&#10;Todo bajo control." FontSize="26" LineHeight="1.1" FontAttributes="Bold" TextColor="White" />
     <Label Text="Órdenes, servicios y tu equipo. La información que necesitas, donde estés." TextColor="#C7D9EE" FontSize="14" />
    </VerticalStackLayout>
   </Border>
   <Border x:Name="LoginCard" Style="{StaticResource SurfaceCard}" Padding="20">
    <VerticalStackLayout Spacing="10">
     <Label Text="Entra a tu espacio" FontSize="24" FontAttributes="Bold" />
     <Label Text="Usa tu cuenta de HN Control para continuar." Style="{StaticResource MutedLabel}" />
     <VerticalStackLayout Spacing="6">
      <Label Text="Usuario o correo" Style="{StaticResource FieldLabel}" />
      <Border Style="{StaticResource InputCard}"><Entry x:Name="EmailEntry" Placeholder="Tu usuario o correo" ReturnType="Next" IsTextPredictionEnabled="False" /></Border>
     </VerticalStackLayout>
     <VerticalStackLayout Spacing="6">
      <Label Text="Contraseña" Style="{StaticResource FieldLabel}" />
      <Border Style="{StaticResource InputCard}">
       <Grid ColumnDefinitions="*,Auto">
        <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Tu contraseña" ReturnType="Go" Completed="OnLoginClicked" />
        <Button Grid.Column="1" Text="Ver" Clicked="OnTogglePassword" BackgroundColor="Transparent" TextColor="{StaticResource AppAccent}" Padding="10,0" MinimumWidthRequest="48" />
       </Grid>
      </Border>
     </VerticalStackLayout>
     <HorizontalStackLayout Spacing="4"><CheckBox x:Name="RememberCheck" /><Label Text="Recordarme en este dispositivo" FontSize="12" VerticalOptions="Center" /></HorizontalStackLayout>
     <Label x:Name="ErrorLabel" IsVisible="False" TextColor="{StaticResource AppDanger}" FontSize="13" />
     <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Text="Iniciar sesión  →" Clicked="OnLoginClicked" />
     <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" />
    </VerticalStackLayout>
   </Border>
   <Label Text="HN SOLUTIONS · GESTIÓN Y OPERACIÓN" HorizontalTextAlignment="Center" FontSize="10" CharacterSpacing="1" TextColor="{StaticResource AppMuted}" />
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>