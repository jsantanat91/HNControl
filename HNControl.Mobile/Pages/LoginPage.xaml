<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*">
        <Grid Background="{StaticResource HeaderGradientBrush}" HeightRequest="220">
            <BoxView Color="#7CA6FF" Opacity="0.14" CornerRadius="220" WidthRequest="340" HeightRequest="340" HorizontalOptions="End" VerticalOptions="Start" TranslationX="120" TranslationY="-120" />
            <BoxView Color="#2ED3B7" Opacity="0.10" CornerRadius="220" WidthRequest="260" HeightRequest="260" HorizontalOptions="Start" VerticalOptions="End" TranslationX="-90" TranslationY="80" />
            <VerticalStackLayout Padding="24,56,24,24" Spacing="4">
                <HorizontalStackLayout x:Name="HeroLayout" Spacing="12" VerticalOptions="Center" Opacity="0" TranslationY="18">
                    <Border Background="#243A63" Padding="0" StrokeShape="RoundRectangle 14" Stroke="#35507F" StrokeThickness="1">
                        <Grid HeightRequest="54" WidthRequest="54">
                            <Label FontAttributes="Bold"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   Text="HN"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Spacing="0">
                        <Label FontAttributes="Bold" FontSize="31" Text="HN Control" TextColor="White" />
                        <Label FontSize="14" Opacity="0.9" Text="Operación móvil" TextColor="#BBD0EE" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Margin="18,-58,18,18" Spacing="14">
            <Border x:Name="LoginCard" Background="White" Padding="18" StrokeShape="RoundRectangle 24" Stroke="{StaticResource AppBorder}" StrokeThickness="1" Opacity="0" TranslationY="22">
                <VerticalStackLayout Spacing="12">
                    <Label FontAttributes="Bold" FontSize="24" Text="Iniciar sesión" />
                    <Label FontSize="13" Opacity="0.7" Text="control.hubnet-solutions.net" />

                    <VerticalStackLayout Spacing="4">
                        <Label FontAttributes="Bold" FontSize="13" Text="Usuario o correo" />
                        <Entry x:Name="EmailEntry" Placeholder="usuario@empresa.com" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label FontAttributes="Bold" FontSize="13" Text="Contraseña" />
                        <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="********" />
                    </VerticalStackLayout>

                    <Button x:Name="LoginButton"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnLoginClicked"
                            Text="Entrar"
                            Margin="0,6,0,0" />

                    <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" />
                    <Label x:Name="ErrorLabel" FontAttributes="Bold" IsVisible="False" TextColor="#B42318" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
