<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HNControl.Mobile.Pages.CarriersModulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Carriers"
    Background="#E9EEF7">
    <CollectionView x:Name="ItemsCollection" Margin="14,12,14,12" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Background="White" Margin="0,0,0,10" Padding="12" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="4">
                        <Label FontAttributes="Bold" FontSize="17" Text="{Binding Name}" />
                        <Label FontSize="12" Opacity="0.8" Text="{Binding ServicesCount, StringFormat='Servicios activos: {0}'}" />
                        <Label FontSize="12" Opacity="0.75" Text="{Binding CarriersSummary}" />
                        <Button Margin="0,6,0,0"
                                HorizontalOptions="Start"
                                Text="Ver servicios"
                                CornerRadius="10"
                                CommandParameter="{Binding ClientId}"
                                Clicked="OnOpenClientClicked" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
