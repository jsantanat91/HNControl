w14:textId="5A3A569C" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">Este Acuerdo de Confidencialidad (en adelante, el "Acuerdo") se celebra en la fecha de su firma entre </w:t></w:r><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>HUBNET INFRAESTRUCTURE TECHNOLOGY SOLUTIONS</w:t></w:r><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve"> una sociedad legalmente constituida en México, con domicilio en Tecámac, Estado de México en lo sucesivo referida como "LA EMPRESA</w:t></w:r><w:r w:rsidR="00957B04" w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>”; CLIENTE</w:t></w:r><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>con domicilio en</w:t></w:r><w:r w:rsidR="00957B04"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">                                                                                            </w:t></w:r><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>en lo sucesivo referida como "LA CONTRAPARTE".</w:t></w:r></w:p><w:p w14:paraId="23F7DE7B" w14:textId="77777777" w:rsidR="00957B04" w:rsidRDefault="00957B04" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr></w:p><w:p w14:paraId="26070D7F" w14:textId="12F03397" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>Ambas partes en conjunto serán referidas como "LAS PARTES" y acuerdan lo siguiente:</w:t></w:r></w:p><w:p w14:paraId="059B48DB" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr></w:p><w:p w14:paraId="779D97FA" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>1. OBJETO</w:t></w:r></w:p><w:p w14:paraId="73DC3FAA" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>El propósito de este Acuerdo es proteger la información confidencial que pueda ser compartida entre LAS PARTES en el marco de una posible relación comercial, prestación de servicios o cualquier otra colaboración entre ellas.</w:t></w:r></w:p><w:p w14:paraId="7EC80B2E" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr></w:p><w:p w14:paraId="638341AF" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>2. DEFINICIÓN DE INFORMACIÓN CONFIDENCIAL</w:t></w:r></w:p><w:p w14:paraId="3D7BCA30" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>Para efectos de este Acuerdo, se entiende por "Información Confidencial" cualquier dato, documento, especificación técnica, estrategia de negocio, plan financiero, información de clientes, software, códigos fuente, estudios de mercado, y cualquier otro dato que no sea de dominio público y que sea revelado por una de LAS PARTES a la otra en cualquier forma, ya sea oral, escrita, electrónica o de cualquier otra índole.</w:t></w:r></w:p><w:p w14:paraId="5577197F" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr></w:p><w:p w14:paraId="510877B1" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>3. OBLIGACIONES DE LAS PARTES</w:t></w:r></w:p><w:p w14:paraId="4CE49C7D" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>LAS PARTES acuerdan que:</w:t></w:r></w:p><w:p w14:paraId="7954436B" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="14"/></w:numPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>Mantendrán la Información Confidencial en estricta reserva y no la divulgarán a terceros sin el consentimiento previo y por escrito de la otra parte.</w:t></w:r></w:p><w:p w14:paraId="30AB622C" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="14"/></w:numPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>Utilizarán la Información Confidencial únicamente para los fines establecidos en el presente Acuerdo.</w:t></w:r></w:p><w:p w14:paraId="39E20707" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="14"/></w:numPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>Tomarán todas las medidas razonables para proteger la Información Confidencial, de manera similar a la protección que otorgan a su propia información confidencial de similar importancia.</w:t></w:r></w:p><w:p w14:paraId="5FE28977" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2F34779A" w14:textId="5519F540" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>4. EXCEPCIONES</w:t></w:r></w:p><w:p w14:paraId="0ADD238B" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>La obligación de confidencialidad no será aplicable en los siguientes casos:</w:t></w:r></w:p><w:p w14:paraId="60A941BE" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="15"/></w:numPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>Si la Información Confidencial se encuentra en el dominio público sin que ello derive de una violación a este Acuerdo.</w:t></w:r></w:p><w:p w14:paraId="584C0358" w14:textId="77777777" w:rsidR="00202EF8" w:rsidRPr="00202EF8" w:rsidRDefault="00202EF8" w:rsidP="00202EF8"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="15"/></w:numPr><w:spacing w:after="0"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r w:rsidRPr="00202EF8"><w:rPr><w:rFonts w:ascii="Arial Narrow" w:hAnsi="Arial Narrow"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>Si la Información Confidencial ha sido desarrollada de manera independiente por la parte receptora sin haber te