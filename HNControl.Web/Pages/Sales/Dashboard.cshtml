@page
@model HNControl.Web.Pages.Sales.DashboardModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard comercial";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Dashboard comercial</h1>
        <div class="text-muted small">Embudo, tasa de cierre, ticket promedio y comision proyectada.</div>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <label class="visually-hidden" asp-for="Month">Mes</label>
            <input class="form-control form-control-sm" type="month" asp-for="Month" />
            <button class="btn btn-sm btn-outline-primary" type="submit">Aplicar</button>
        </form>
        <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="modal" data-bs-target="#auditModal">Bitacora</button>
        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#sellerDetailModal">Detalle vendedor</button>
        <a class="btn btn-outline-primary" href="/Ventas/Workflow">Workflow</a>
    </div>
</div>
<div class="alert alert-info py-2 mb-3">
    <b>Alcance:</b>
    @(Model.IsOwnScope ? "solo tus oportunidades" : "vista global")
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft h-100 border-0 sales-kpi-card sales-kpi-leads">
            <div class="card-body">
                <div class="text-muted small">Leads abiertos</div>
                <div class="fs-3 fw-bold">@Model.LeadsOpen</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft h-100 border-0 sales-kpi-card sales-kpi-close">
            <div class="card-body">
                <div class="text-muted small">Cierre ganado</div>
                <div class="fs-3 fw-bold">@Model.ClosedWon</div>
                <div class="small text-muted">@Model.CloseRate.ToString("0.##")% tasa de cierre</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft h-100 border-0 sales-kpi-card sales-kpi-ticket">
            <div class="card-body">
                <div class="text-muted small">Ticket promedio</div>
                <div class="fs-3 fw-bold">@Model.AvgTicket.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft h-100 border-0 sales-kpi-card sales-kpi-commission">
            <div class="card-body">
                <div class="text-muted small">Comision proyectada</div>
                <div class="fs-3 fw-bold">@Model.CommissionProjected.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-7">
        <div class="card shadow-soft hn-hover h-100">
            <div class="card-header fw-semibold">Embudo comercial</div>
            <div class="card-body">
                <canvas id="funnelChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="card shadow-soft hn-hover h-100">
            <div class="card-header fw-semibold">Top vendedores (monto)</div>
            <div class="card-body">
                <canvas id="sellerChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card shadow-soft hn-hover h-100">
            <div class="card-header fw-semibold">Ganadas vs Perdidas por vendedor</div>
            <div class="card-body">
                <canvas id="sellerWinLossChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card shadow-soft hn-hover h-100">
            <div class="card-header fw-semibold">Detalle por vendedor</div>
            <div class="card-body">
                <div class="text-muted small">Resumen rapido. Usa "Ver detalle" para abrir el modal completo por vendedor.</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card shadow-soft hn-hover h-100">
            <div class="card-header fw-semibold">Bitacora comercial</div>
            <div class="card-body">
                @if (!Model.RecentAudit.Any())
                {
                    <div class="text-muted small">Sin actividad reciente.</div>
                }
                else
                {
                    <div class="vstack gap-2">
                        @foreach (var a in Model.RecentAudit.Take(5))
                        {
                            <div class="border rounded-3 p-2">
                                <div class="d-flex justify-content-between gap-2">
                                    <span class="fw-semibold">@a.EventType</span>
                                    <span class="small text-muted">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <div class="small">@a.Details</div>
                                <div class="small text-muted">Por: @a.UserName</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="sellerDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle por vendedor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!Model.Sellers.Any())
                {
                    <div class="text-muted small">Sin datos.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Vendedor</th>
                                    <th>Tratos</th>
                                    <th>Monto</th>
                                    <th>Comision</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Sellers)
                                {
                                    <tr>
                                        <td>@s.Seller</td>
                                        <td>@s.Deals</td>
                                        <td>@s.Amount.ToString("C")</td>
                                        <td>@s.Commission.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="auditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bitacora comercial completa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!Model.RecentAudit.Any())
                {
                    <div class="text-muted small">Sin actividad reciente.</div>
                }
                else
                {
                    <div class="vstack gap-2">
                        @foreach (var a in Model.RecentAudit)
                        {
                            <div class="border rounded-3 p-2">
                                <div class="d-flex justify-content-between gap-2">
                                    <span class="fw-semibold">@a.EventType</span>
                                    <span class="small text-muted">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <div class="small">@a.Details</div>
                                <div class="small text-muted">Por: @a.UserName</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .sales-kpi-card { overflow: hidden; }
    .sales-kpi-card .card-body { min-height: 112px; }
    .sales-kpi-leads { background: linear-gradient(135deg,#dbeafe 0%,#eff6ff 100%); border-left: 4px solid #2563eb; }
    .sales-kpi-close { background: linear-gradient(135deg,#d1fae5 0%,#ecfdf5 100%); border-left: 4px solid #16a34a; }
    .sales-kpi-ticket { background: linear-gradient(135deg,#fef3c7 0%,#fffbeb 100%); border-left: 4px solid #d97706; }
    .sales-kpi-commission { background: linear-gradient(135deg,#cffafe 0%,#ecfeff 100%); border-left: 4px solid #0891b2; }
</style>
}

@section Scripts {
<script>
(() => {
    const funnelLabels = @Html.Raw(Model.FunnelLabelsJson);
    const funnelValues = @Html.Raw(Model.FunnelValuesJson);
    const sellerLabels = @Html.Raw(Model.SellerLabelsJson);
    const sellerValues = @Html.Raw(Model.SellerValuesJson);
    const sellerWLLabels = @Html.Raw(Model.SellerWinLossLabelsJson);
    const sellerWonValues = @Html.Raw(Model.SellerWonValuesJson);
    const sellerLostValues = @Html.Raw(Model.SellerLostValuesJson);

    const funnelCtx = document.getElementById('funnelChart');
    if (funnelCtx && funnelLabels.length) {
        new Chart(funnelCtx, {
            type: 'bar',
            data: {
                labels: funnelLabels,
                datasets: [{
                    label: 'Oportunidades',
                    data: funnelValues,
                    borderWidth: 0,
                    borderRadius: 8,
                    backgroundColor: ['#2563eb','#0891b2','#7c3aed','#ea580c','#dc2626','#0d9488','#16a34a','#65a30d','#475569']
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });
    }

    const sellerCtx = document.getElementById('sellerChart');
    if (sellerCtx && sellerLabels.length) {
        new Chart(sellerCtx, {
            type: 'doughnut',
            data: {
                labels: sellerLabels,
                datasets: [{
                    data: sellerValues,
                    borderWidth: 1,
                    backgroundColor: ['#2563eb','#16a34a','#ea580c','#dc2626','#7c3aed','#0284c7','#db2777','#0d9488']
                }]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
        });
    }

    const sellerWLCtx = document.getElementById('sellerWinLossChart');
    if (sellerWLCtx && sellerWLLabels.length) {
        new Chart(sellerWLCtx, {
            type: 'bar',
            data: {
                labels: sellerWLLabels,
                datasets: [
                    { label: 'Ganadas', data: sellerWonValues, backgroundColor: '#16a34a', borderRadius: 6 },
                    { label: 'Perdidas', data: sellerLostValues, backgroundColor: '#dc2626', borderRadius: 6 }
                ]
            },
            options: {
                responsive: true,
                scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    }
})();
</script>
}

