@page
@model HNControl.Web.Pages.Sales.FeasibilityModel
@using HNControl.Web.Models
@using HNControl.Web.Pages.Sales
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ventas · Factibilidades";
    string Link(LevantamientoSurveyStatus? status = null, string? cliente = null, int p = 1, bool keepStatus = true, bool keepClient = true) =>
        "/Ventas/Factibilidad?" + string.Join("&", new[]
        {
            (keepStatus ? status ?? Model.Status : status) is { } s ? "status=" + s : null,
            (keepClient ? cliente ?? Model.Cliente : cliente) is { Length: > 0 } c ? "cliente=" + Uri.EscapeDataString(c) : null,
            string.IsNullOrWhiteSpace(Model.Q) ? null : "q=" + Uri.EscapeDataString(Model.Q),
            p > 1 ? "p=" + p : null
        }.Where(x => x != null));
    var pages = (Model.Total + FeasibilityModel.PageSize - 1) / FeasibilityModel.PageSize;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Factibilidades</h1>
        <div class="text-muted small">Levantamientos técnicos recibidos del formulario web, con su PDF. Liga o crea el cliente y genera la orden de servicio.</div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" href="https://hubnet-solutions.net/levantamiento/" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Abrir formulario</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success py-2">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger py-2">@Model.Error</div> }

<form method="get" class="card shadow-soft border-0 mb-3">
    <div class="card-body pb-0">
        <div class="hn-filter-chips">
            <a class="hn-filter-chip @(Model.Status == null && Model.Cliente != "sin" ? "is-active" : "")" href="@Link(null, null, 1, false, false)">Todas <span>@Model.AllCount</span></a>
            @foreach (var s in Enum.GetValues<LevantamientoSurveyStatus>())
            {
                <a class="hn-filter-chip @(Model.Status == s ? "is-active" : "")" href="@Link(s, null, 1, false)">@FeasibilityModel.StatusLabel(s) <span>@(Model.Counts.GetValueOrDefault(s))</span></a>
            }
            <a class="hn-filter-chip hn-filter-chip-warn @(Model.Cliente == "sin" ? "is-active" : "")" href="@Link(null, "sin", 1, false, false)"><i class="bi bi-person-exclamation"></i> Sin cliente <span>@Model.Unlinked</span></a>
        </div>
    </div>
    <div class="card-body row g-2 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label small mb-1">Buscar</label>
            <input class="form-control" name="q" value="@Model.Q" placeholder="Empresa, RFC, contacto, correo o servicio" />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small mb-1">Cliente</label>
            <select class="form-select" name="cliente">
                <option value="">Todos los clientes</option>
                <option value="sin" selected="@(Model.Cliente == "sin")">Sin cliente en Control</option>
                @foreach (var c in Model.ClientOptions)
                {
                    <option value="@c.Id" selected="@(Model.Cliente == c.Id.ToString())">@c.Label (@c.Count)</option>
                }
            </select>
        </div>
        @if (Model.Status != null) { <input type="hidden" name="status" value="@Model.Status" /> }
        <div class="col-12 col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit"><i class="bi bi-search"></i> Filtrar</button>
            <a class="btn btn-outline-secondary" href="/Ventas/Factibilidad">Limpiar</a>
        </div>
    </div>
</form>

@if (Model.FilteredClientName != null)
{
    <div class="alert alert-info py-2 small">Mostrando las factibilidades de <b>@Model.FilteredClientName</b>.</div>
}

<div class="card shadow-soft border-0">
    <div class="card-header fw-semibold d-flex justify-content-between">
        <span>Levantamientos</span><span class="text-muted small">@Model.Total resultado(s)</span>
    </div>
    @if (!Model.Rows.Any())
    {
        <div class="card-body text-muted">
            @(Model.AllCount == 0
                ? "Aún no llega ningún levantamiento. Cada envío del formulario web aparecerá aquí con su PDF."
                : "Sin resultados con estos filtros.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr><th>Recibido</th><th>Empresa</th><th>Servicios</th><th>Cliente en Control</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var x in Model.Rows)
                {
                    <tr>
                        <td class="small text-nowrap">@x.ReceivedAt.ToLocalTime().ToString("dd/MM/yyyy")<div class="text-muted">@x.ReceivedAt.ToLocalTime().ToString("HH:mm")</div></td>
                        <td>
                            <div class="fw-semibold">@x.Company</div>
                            <div class="small text-muted">@x.ContactName @(string.IsNullOrEmpty(x.Phone) ? "" : "· " + x.Phone)</div>
                            @if (!string.IsNullOrEmpty(x.Rfc)) { <div class="small text-muted">RFC @x.Rfc</div> }
                        </td>
                        <td class="small" style="max-width:280px">
                            @x.Services
                            @if (!string.IsNullOrEmpty(x.Urgency)) { <div class="text-muted">Urgencia: @x.Urgency</div> }
                            @if (x.HasSites) { <span class="badge text-bg-light border"><i class="bi bi-file-earmark-spreadsheet"></i> Varios sitios</span> }
                        </td>
                        <td class="small">
                            @if (x.ClientId != null)
                            {
                                <a href="/Ventas/Factibilidad?cliente=@x.ClientId">@x.ClientName</a>
                                <div class="text-muted">@x.ClientCode</div>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Sin cliente</span>
                            }
                        </td>
                        <td>
                            <span class="badge @FeasibilityModel.StatusBadge(x.Status)">@FeasibilityModel.StatusLabel(x.Status)</span>
                            @if (x.HasOrder) { <div class="small text-success mt-1"><i class="bi bi-clipboard-check"></i> Con orden</div> }
                        </td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Ventas/Factibilidad/@x.Id">Abrir</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (pages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center small">
                <span>Página @Model.PageNumber de @pages</span>
                <div class="btn-group">
                    <a class="btn btn-sm btn-outline-secondary @(Model.PageNumber <= 1 ? "disabled" : "")" href="@Link(p: Model.PageNumber - 1)">Anterior</a>
                    <a class="btn btn-sm btn-outline-secondary @(Model.PageNumber >= pages ? "disabled" : "")" href="@Link(p: Model.PageNumber + 1)">Siguiente</a>
                </div>
            </div>
        }
    }
</div>
