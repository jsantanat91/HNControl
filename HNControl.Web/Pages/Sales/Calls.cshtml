@page
@model HNControl.Web.Pages.Sales.CallsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ventas · Llamadas";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Llamadas comerciales</h1>
        <div class="text-muted small">Se usa el softphone web oficial integrado por WebView.</div>
    </div>
    <span class="badge text-bg-secondary">@(Model.CanViewAll ? "Vista global" : "Solo mis oportunidades")</span>
</div>

@if (Model.OpportunityId.HasValue)
{
    <div class="alert alert-info border mb-3">
        <div class="fw-semibold">Llamada iniciada desde Workflow</div>
        <div class="small">
            <b>Oportunidad:</b> @(Model.OpportunityFolio ?? Model.OpportunityId.Value.ToString())
            @if (!string.IsNullOrWhiteSpace(Model.OpportunityCustomer))
            {
                <span> · <b>Cliente:</b> @Model.OpportunityCustomer</span>
            }
        </div>
    </div>
}

<div class="card shadow-soft border-0 mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div class="small text-muted">
            Si el navegador bloquea el WebView (X-Frame-Options/CSP), usa "Abrir softphone".
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" href="@Model.ExternalSoftphoneUrl" target="_blank" rel="noopener noreferrer">Abrir softphone</a>
            <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('softphoneFrame').contentWindow.location.reload();">Recargar WebView</button>
        </div>
    </div>
</div>

<div class="card shadow-soft border-0 mb-3">
    <div class="card-body">
        <div class="fw-semibold mb-2">Permisos de micrófono</div>
        <div class="small text-muted mb-2">
            Para llamadas, el navegador debe permitir micrófono en HTTPS. Usa "Probar micrófono" para validar permisos antes de marcar.
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button id="btnTestMic" type="button" class="btn btn-sm btn-outline-primary">Probar micrófono</button>
            <span id="micStatus" class="small text-muted">Sin prueba</span>
        </div>
    </div>
</div>

<div class="card shadow-soft border-0">
    <div class="card-body p-0">
        <iframe
            id="softphoneFrame"
            title="Softphone externo"
            src="@Model.ExternalSoftphoneUrl"
            style="width:100%; height:calc(100vh - 380px); min-height:640px; border:0; border-radius:.75rem;"
            allow="microphone; camera; autoplay; clipboard-read; clipboard-write"
            referrerpolicy="no-referrer-when-downgrade">
        </iframe>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const btn = document.getElementById('btnTestMic');
            const status = document.getElementById('micStatus');
            if (!btn || !status) return;

            btn.addEventListener('click', async function () {
                status.textContent = 'Probando...';
                status.className = 'small text-muted';
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                    stream.getTracks().forEach(t => t.stop());
                    status.textContent = 'Micrófono permitido.';
                    status.className = 'small text-success';
                } catch (err) {
                    const msg = (err && err.message) ? err.message : 'Permiso denegado o no disponible.';
                    status.textContent = `Error de micrófono: ${msg}`;
                    status.className = 'small text-danger';
                }
            });
        })();
    </script>
}
