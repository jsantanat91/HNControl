@page
@model HNControl.Web.Pages.Sales.CallsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ventas - Llamadas";
    const string softphoneDownloadUrl = "https://cm.ucc.systems/connect";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Llamadas comerciales</h1>
        <div class="text-muted small">El softphone se abre en una nueva pestana.</div>
    </div>
    <span class="badge text-bg-secondary">@(Model.CanViewAll ? "Vista global" : "Solo mis oportunidades")</span>
</div>

@if (Model.OpportunityId.HasValue)
{
    <div class="alert alert-info border mb-3">
        <div class="fw-semibold">Llamada iniciada desde Workflow</div>
        <div class="small">
            <b>Oportunidad:</b> @(Model.OpportunityFolio ?? Model.OpportunityId.Value.ToString())
            @if (!string.IsNullOrWhiteSpace(Model.OpportunityCustomer))
            {
                <span> · <b>Cliente:</b> @Model.OpportunityCustomer</span>
            }
        </div>
    </div>
}

<div class="card shadow-soft border-0 mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div class="small text-muted">
            Si el navegador bloquea contenido embebido, usa el boton para abrir el webphone directamente.
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" href="@Model.ExternalSoftphoneUrl" target="_blank" rel="noopener noreferrer">Abrir webphone</a>
            <button class="btn btn-outline-secondary" type="button" onclick="window.open('@Model.ExternalSoftphoneUrl','_blank','noopener,noreferrer');">Abrir en ventana nueva</button>
            <a class="btn btn-outline-success" href="@softphoneDownloadUrl" target="_blank" rel="noopener noreferrer">Descargar softphone</a>
        </div>
    </div>
</div>

<div class="card shadow-soft border-0 mb-3">
    <div class="card-body">
        <div class="fw-semibold mb-2">Permisos de microfono</div>
        <div class="small text-muted mb-2">
            Para llamadas, el navegador debe permitir microfono en HTTPS. Usa "Probar microfono" antes de marcar.
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button id="btnTestMic" type="button" class="btn btn-sm btn-outline-primary">Probar microfono</button>
            <span id="micStatus" class="small text-muted">Sin prueba</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const btn = document.getElementById('btnTestMic');
            const status = document.getElementById('micStatus');
            if (!btn || !status) return;

            btn.addEventListener('click', async function () {
                status.textContent = 'Probando...';
                status.className = 'small text-muted';
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                    stream.getTracks().forEach(t => t.stop());
                    status.textContent = 'Microfono permitido.';
                    status.className = 'small text-success';
                } catch (err) {
                    const msg = (err && err.message) ? err.message : 'Permiso denegado o no disponible.';
                    status.textContent = `Error de microfono: ${msg}`;
                    status.className = 'small text-danger';
                }
            });
        })();
    </script>
}
