@page "/Ventas/Factibilidad/{id:guid}"
@model HNControl.Web.Pages.Sales.FeasibilityDetailModel
@using HNControl.Web.Models
@using HNControl.Web.Pages.Sales
@using HNControl.Web.Services
@{
    Layout = "_Layout";
    var s = Model.Survey;
    ViewData["Title"] = "Factibilidad · " + s.Company;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <a class="small text-decoration-none" href="/Ventas/Factibilidad"><i class="bi bi-arrow-left"></i> Factibilidades</a>
        <h1 class="h4 mb-0 mt-1">@s.Company</h1>
        <div class="text-muted small">
            Recibido el @s.ReceivedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @s.Services
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <span class="badge fs-6 @FeasibilityModel.StatusBadge(s.Status)">@FeasibilityModel.StatusLabel(s.Status)</span>
        @if (s.PdfBytes != null)
        {
            <a class="btn btn-outline-dark btn-sm" asp-page-handler="Pdf" asp-route-id="@s.Id" target="_blank"><i class="bi bi-file-earmark-pdf"></i> Ver PDF</a>
        }
        @if (s.SitesBytes != null)
        {
            <a class="btn btn-outline-success btn-sm" asp-page-handler="Sites" asp-route-id="@s.Id"><i class="bi bi-file-earmark-spreadsheet"></i> Excel de sitios</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success py-2">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger py-2">@Model.Error</div> }

<div class="row g-3">
    <div class="col-12 col-xl-4 order-xl-2">

        @* ---------- Paso 1: cliente ---------- *@
        <div class="card shadow-soft border-0 mb-3">
            <div class="card-header fw-semibold"><span class="badge text-bg-dark me-1">1</span> Cliente en Control</div>
            <div class="card-body">
                @if (Model.LinkedClient != null)
                {
                    <div class="fw-semibold">@Model.LinkedClient.Name</div>
                    <div class="small text-muted mb-2">@Model.LinkedClient.ClientCode @(string.IsNullOrEmpty(Model.LinkedClient.Rfc) ? "" : "· RFC " + Model.LinkedClient.Rfc)</div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-sm btn-outline-primary" href="/Clients/Details/@Model.LinkedClient.Id">Ficha del cliente</a>
                        @if (Model.OtherSurveysOfClient > 0)
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="/Ventas/Factibilidad?cliente=@Model.LinkedClient.Id">+@Model.OtherSurveysOfClient factibilidad(es) más</a>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning small py-2">Este levantamiento no está ligado a un cliente. Puedes crearlo o ligarlo aunque el proyecto no sea viable; la orden de servicio lo necesita.</div>
                    @if (Model.CanCreateClient)
                    {
                        <form method="post" asp-page-handler="CreateClient" asp-route-id="@s.Id" class="mb-3"
                              onsubmit="return confirm('¿Crear el cliente @s.Company.Replace("'", "") con los datos del levantamiento?');">
                            <button class="btn btn-primary w-100" type="submit"><i class="bi bi-person-plus"></i> Crear cliente con estos datos</button>
                            <div class="form-text">Se crea con razón social, RFC, correo, teléfono, dirección y contacto principal. Los datos fiscales se completan después en la ficha.</div>
                        </form>
                    }
                    else
                    {
                        <div class="small text-muted mb-3">Tu perfil no tiene permiso para crear clientes; pide a un administrador que lo cree.</div>
                    }
                    <form method="post" asp-page-handler="Link" asp-route-id="@s.Id">
                        <label class="form-label small mb-1">…o ligar a un cliente existente</label>
                        <div class="input-group input-group-sm">
                            <select class="form-select" name="LinkClientId" required>
                                <option value="">Seleccione…</option>
                                @foreach (var c in Model.ClientChoices) { <option value="@c.Id">@c.Label</option> }
                            </select>
                            <button class="btn btn-outline-primary" type="submit">Ligar</button>
                        </div>
                    </form>
                }
            </div>
        </div>

        @* ---------- Paso 2: dictamen de viabilidad ---------- *@
        @{
            var viableNow = LevantamientoSurveyService.IsViable(s.Status) && Model.IsDecided;
            var notViable = s.Status == LevantamientoSurveyStatus.NotFeasible;
            var showForm = !Model.IsDecided || Model.DecisionError != null;
            var decision = Model.Decision ?? (Model.IsDecided ? (notViable ? "no_viable" : "viable") : null);
        }
        <div class="card shadow-soft border-0 mb-3" id="dictamen">
            <div class="card-header fw-semibold"><span class="badge text-bg-dark me-1">2</span> Dictamen de viabilidad</div>
            <div class="card-body">
                @if (Model.IsDecided)
                {
                    <div class="hn-verdict @(notViable ? "is-no" : "is-yes") mb-3">
                        <i class="bi @(notViable ? "bi-x-octagon" : "bi-check2-circle")"></i>
                        <div>
                            <div class="fw-semibold">@(notViable ? "No viable · el flujo se detiene" : "Viable")</div>
                            <div class="small">Dictaminado el @s.DecidedAt!.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(s.DecisionComments))
                    {
                        <div class="small text-muted mb-1">Comentarios enviados al cliente</div>
                        <div class="small mb-3" style="white-space:pre-line">@s.DecisionComments</div>
                    }
                    @if (Model.ReviewResults.Any())
                    {
                        <ul class="list-unstyled small mb-3">
                            @foreach (var c in LevantamientoReview.Checks)
                            {
                                var r = LevantamientoReview.ResultOf(Model.ReviewResults, c.Key);
                                <li class="d-flex justify-content-between border-bottom py-1">
                                    <span>@c.Label</span>
                                    <span class="fw-semibold @(r == LevantamientoReview.Yes ? "text-success" : r == LevantamientoReview.No ? "text-danger" : "text-muted")">@LevantamientoReview.ResultLabel(r)</span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="small mb-2">
                        @if (s.DecisionEmailSentAt != null)
                        {
                            <span><i class="bi bi-envelope-check text-success"></i> Enviado a @s.DecisionEmailTo el @s.DecisionEmailSentAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-warning-emphasis"><i class="bi bi-envelope-exclamation"></i> Aún no se envía el correo al cliente.</span>
                        }
                    </div>
                    <form method="post" asp-page-handler="SendDecision" asp-route-id="@s.Id" class="mb-2">
                        <div class="input-group input-group-sm">
                            <input class="form-control" type="email" name="EmailTo" value="@Model.EmailTo" required />
                            <button class="btn btn-outline-primary" type="submit"><i class="bi bi-send"></i> @(s.DecisionEmailSentAt != null ? "Reenviar" : "Enviar")</button>
                        </div>
                    </form>
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-page-handler="DecisionPreview" asp-route-id="@s.Id" target="_blank"><i class="bi bi-eye"></i> Ver correo</a>
                        @if (Model.Order == null && !showForm)
                        {
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#dictamen-form"><i class="bi bi-pencil"></i> Cambiar dictamen</button>
                        }
                    </div>
                }
                @if (Model.Order == null)
                {
                    <form method="post" asp-page-handler="Decision" asp-route-id="@s.Id" id="dictamen-form" class="collapse @(showForm ? "show" : "") @(Model.IsDecided ? "mt-3 pt-3 border-top" : "")"
                          onsubmit="var v=this.querySelector('[name=Decision]:checked');return !!v && confirm(v.value==='viable' ? '¿Dictaminar el proyecto como VIABLE?' : '¿Dictaminar el proyecto como NO VIABLE? El flujo se detiene y no se podrá crear la orden.');">
                        @if (Model.DecisionError != null) { <div class="alert alert-danger small py-2">@Model.DecisionError</div> }
                        <div class="small text-muted mb-2">Revisa cada punto antes de comprometer el proyecto.</div>
                        @foreach (var c in LevantamientoReview.Checks)
                        {
                            var r = LevantamientoReview.ResultOf(Model.ReviewResults, c.Key);
                            <div class="hn-check-row">
                                <div>
                                    <div class="small fw-semibold">@c.Label</div>
                                    <div class="text-muted" style="font-size:11px">@c.Hint</div>
                                </div>
                                <div class="btn-group btn-group-sm" role="group">
                                    @foreach (var (val, txt, cls) in new[] { (LevantamientoReview.Yes, "Sí", "success"), (LevantamientoReview.No, "No", "danger"), (LevantamientoReview.NotApplicable, "N/A", "secondary") })
                                    {
                                        var rid = $"chk-{c.Key}-{val}";
                                        <input type="radio" class="btn-check" name="Checks[@c.Key]" id="@rid" value="@val" checked="@(r == val)" autocomplete="off" />
                                        <label class="btn btn-outline-@cls" for="@rid">@txt</label>
                                    }
                                </div>
                            </div>
                        }
                        <label class="form-label small mt-3 mb-1">Comentarios para el cliente</label>
                        <textarea class="form-control form-control-sm mb-1" name="ClientComments" rows="4" maxlength="4000"
                                  placeholder="Viable: condiciones, alcance o tiempos. No viable: la causa (sin cobertura, sin capacidad…).">@Model.ClientComments</textarea>
                        <div class="form-text mb-3">Se incluyen en el correo al cliente. Las notas internas de Seguimiento no se envían.</div>
                        <div class="d-flex gap-2 mb-3">
                            <input type="radio" class="btn-check" name="Decision" id="dec-yes" value="viable" checked="@(decision == "viable")" required />
                            <label class="btn btn-outline-success flex-fill" for="dec-yes"><i class="bi bi-check2-circle"></i> Viable</label>
                            <input type="radio" class="btn-check" name="Decision" id="dec-no" value="no_viable" checked="@(decision == "no_viable")" />
                            <label class="btn btn-outline-danger flex-fill" for="dec-no"><i class="bi bi-x-octagon"></i> No viable</label>
                        </div>
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" name="SendEmail" value="true" id="send-email" checked="@(Model.DecisionError == null || Model.SendEmail)" />
                            <label class="form-check-label small" for="send-email">Enviar el dictamen al cliente por correo</label>
                        </div>
                        <input class="form-control form-control-sm mb-3" type="email" name="EmailTo" value="@Model.EmailTo" placeholder="correo@cliente.com" />
                        <button class="btn btn-primary w-100" type="submit"><i class="bi bi-clipboard2-check"></i> Emitir dictamen</button>
                    </form>
                }
            </div>
        </div>

        @* ---------- Paso 3: orden ---------- *@
        <div class="card shadow-soft border-0 mb-3">
            <div class="card-header fw-semibold"><span class="badge text-bg-dark me-1">3</span> Orden de servicio</div>
            <div class="card-body">
                @if (Model.Order != null)
                {
                    <div class="small mb-2"><i class="bi bi-clipboard-check text-success"></i> @Model.Order.Title</div>
                    <a class="btn btn-sm btn-outline-success" href="/Admin/ServiceOrders/Details/@Model.Order.Id">Abrir orden</a>
                }
                else if (notViable)
                {
                    <button class="btn btn-secondary w-100" type="button" disabled><i class="bi bi-slash-circle"></i> Proyecto no viable</button>
                    <div class="form-text">El flujo se detiene. Si cambian las condiciones, cambia el dictamen a viable.</div>
                }
                else if (!viableNow)
                {
                    <button class="btn btn-secondary w-100" type="button" disabled><i class="bi bi-lock"></i> Crear orden de levantamiento</button>
                    <div class="form-text">Disponible cuando el dictamen sea viable@(Model.LinkedClient == null ? " y el levantamiento tenga cliente" : "").</div>
                }
                else if (Model.LinkedClient == null)
                {
                    <button class="btn btn-secondary w-100" type="button" disabled><i class="bi bi-lock"></i> Crear orden de levantamiento</button>
                    <div class="form-text">Disponible cuando el levantamiento tenga cliente.</div>
                }
                else
                {
                    <form method="post" asp-page-handler="CreateOrder" asp-route-id="@s.Id" onsubmit="return confirm('¿Crear la orden de levantamiento técnico para @Model.LinkedClient.Name.Replace("'", "")?');">
                        <button class="btn btn-success w-100" type="submit"><i class="bi bi-clipboard-plus"></i> Crear orden de levantamiento</button>
                        <div class="form-text">Orden tipo Levantamiento técnico con el resumen y la liga a esta factibilidad. Se notifica como cualquier orden nueva.</div>
                    </form>
                }
            </div>
        </div>

        @* ---------- Seguimiento ---------- *@
        <div class="card shadow-soft border-0">
            <div class="card-header fw-semibold">Seguimiento</div>
            <div class="card-body">
                <form method="post" asp-page-handler="Status" asp-route-id="@s.Id">
                    <label class="form-label small mb-1">Estado</label>
                    <select class="form-select form-select-sm mb-2" name="NewStatus">
                        @foreach (var st in FeasibilityDetailModel.AllowedStatuses(s.Status))
                        {
                            <option value="@st" selected="@(st == s.Status)">@FeasibilityModel.StatusLabel(st)</option>
                        }
                    </select>
                    <label class="form-label small mb-1">Notas internas</label>
                    <textarea class="form-control form-control-sm mb-2" name="Notes" rows="4" maxlength="4000" placeholder="Cobertura, proveedor, costo estimado, siguiente paso…">@s.InternalNotes</textarea>
                    <button class="btn btn-sm btn-primary" type="submit">Guardar</button>
                    @if (s.UpdatedByUserId != null) { <span class="small text-muted ms-2">Actualizado @s.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span> }
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8 order-xl-1">
        <div class="card shadow-soft border-0 mb-3">
            <div class="card-header fw-semibold">Contacto</div>
            <div class="card-body row g-2 small">
                <div class="col-md-6"><span class="text-muted">Contacto:</span> @s.ContactName @(string.IsNullOrEmpty(s.ContactRole) ? "" : "(" + s.ContactRole + ")")</div>
                <div class="col-md-6"><span class="text-muted">Correo:</span> <a href="mailto:@s.Email">@s.Email</a></div>
                <div class="col-md-6"><span class="text-muted">Teléfono:</span> <a href="tel:@s.Phone">@s.Phone</a></div>
                <div class="col-md-6"><span class="text-muted">RFC:</span> @(string.IsNullOrEmpty(s.Rfc) ? "—" : s.Rfc)</div>
                <div class="col-md-6"><span class="text-muted">Ciudad:</span> @s.City</div>
                <div class="col-md-6"><span class="text-muted">Dirección:</span> @s.Address</div>
                <div class="col-md-6"><span class="text-muted">Urgencia:</span> @s.Urgency</div>
                <div class="col-md-6"><span class="text-muted">Presupuesto:</span> @s.Budget</div>
                @if (!string.IsNullOrEmpty(s.Executive)) { <div class="col-md-6"><span class="text-muted">Ejecutivo:</span> @s.Executive</div> }
                @if (!string.IsNullOrEmpty(s.Visit)) { <div class="col-md-6"><span class="text-muted">Visita técnica:</span> @s.Visit</div> }
            </div>
        </div>

        @if (Model.Sites.Any())
        {
            <div class="card shadow-soft border-0 mb-3">
                <div class="card-header fw-semibold d-flex justify-content-between">
                    <span><i class="bi bi-geo-alt"></i> Sitios (@Model.Sites.Count)</span>
                    <span class="small text-muted">@s.SitesFileName</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small">
                        <thead class="table-light"><tr><th>#</th><th>Dirección</th><th class="text-end">MB</th><th>Notas</th></tr></thead>
                        <tbody>
                        @for (var i = 0; i < Model.Sites.Count; i++)
                        {
                            var site = Model.Sites[i];
                            <tr><td>@(i + 1)</td><td>@site.Address</td><td class="text-end">@site.Capacity</td><td class="text-muted">@site.Notes</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (s.SitesBytes != null)
        {
            <div class="alert alert-secondary small">El archivo de sitios no se pudo leer aquí; descárgalo con el botón “Excel de sitios”.</div>
        }

        @foreach (var sec in Model.Sections.Where(x => x.Title != "Datos de la empresa"))
        {
            <div class="card shadow-soft border-0 mb-3">
                <div class="card-header fw-semibold">@sec.Title</div>
                <div class="card-body py-2">
                    <dl class="row mb-0 small">
                    @foreach (var it in sec.Items)
                    {
                        if (it.Heading != null)
                        {
                            <dt class="col-12 text-uppercase text-primary mt-2" style="font-size:.72rem;letter-spacing:.05em">@it.Heading</dt>
                        }
                        else
                        {
                            <dt class="col-sm-5 fw-normal text-muted">@it.Key</dt>
                            <dd class="col-sm-7 mb-1" style="white-space:pre-line">
                                @if (it.IsLink) { <a href="@it.Value" target="_blank" rel="noopener">Abrir en Google Maps</a> } else { @it.Value }
                            </dd>
                        }
                    }
                    </dl>
                </div>
            </div>
        }
    </div>
</div>
