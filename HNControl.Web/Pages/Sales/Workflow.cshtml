@page
@using HNControl.Web.Models
@model HNControl.Web.Pages.Sales.WorkflowModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Workflow comercial";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Workflow comercial</h1>
        <div class="text-muted small">Lead > Cotizacion > Cierre > Ganado > Perdido</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="/Ventas">Dashboard</a>
        <a class="btn btn-outline-secondary" href="/Ventas/Gestion">Gestion</a>
        <a class="btn btn-success" href="/Ventas/Gestion">Nuevo trato</a>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Flash))
{
    <div class="alert alert-@(Model.FlashType ?? "info")">@Model.Flash</div>
}

<div class="alert alert-light border mb-3">
    <b>Alcance:</b> @(Model.CanViewAll ? "Global" : "Solo tus tratos")
    <span class="ms-2 small text-muted">Arrastra cada oportunidad entre columnas para mover etapa.</span>
    <span class="ms-2 badge text-bg-success">Hoy</span>
    <span class="ms-1 badge text-bg-warning">Proximo</span>
    <span class="ms-1 badge text-bg-danger">Atrasado</span>
</div>

<form method="get" class="card shadow-soft border-0 mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label mb-1">Filtrar etapa</label>
            <select class="form-select" asp-for="StageFilter" asp-items="Model.StageFilterItems"></select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label mb-1">Filtrar owner</label>
            <select class="form-select" asp-for="OwnerFilterUserId" asp-items="Model.OwnerFilterItems"></select>
        </div>
        <div class="col-12 col-md-4 d-grid d-md-flex justify-content-md-end gap-2">
            <button class="btn btn-primary" type="submit">Aplicar</button>
            <a class="btn btn-outline-secondary" href="/Ventas/Workflow">Limpiar</a>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft border-0 bg-primary-subtle h-100">
            <div class="card-body">
                <div class="text-muted small">Tratos visibles</div>
                <div class="fs-3 fw-bold">@Model.TotalDeals</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft border-0 bg-danger-subtle h-100">
            <div class="card-body">
                <div class="text-muted small">SLA atrasados</div>
                <div class="fs-3 fw-bold">@Model.OverdueDeals</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft border-0 bg-warning-subtle h-100">
            <div class="card-body">
                <div class="text-muted small">SLA hoy/proximo</div>
                <div class="fs-3 fw-bold">@Model.DueSoonDeals</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft border-0 bg-success-subtle h-100">
            <div class="card-body">
                <div class="text-muted small">Ganados</div>
                <div class="fs-3 fw-bold">@Model.WonDeals</div>
            </div>
        </div>
    </div>
</div>

<div class="workflow-board pb-2">
    @foreach (var stage in new[] { SalesWorkflowStage.Lead, SalesWorkflowStage.Quotation, SalesWorkflowStage.Closing, SalesWorkflowStage.ClosedWon, SalesWorkflowStage.ClosedLost })
    {
        var items = Model.Board.ContainsKey(stage) ? Model.Board[stage] : new List<HNControl.Web.Pages.Sales.WorkflowModel.DealVm>();
        <section class="wf-col card shadow-soft border-0" data-stage-col="@stage">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>@HNControl.Web.Pages.Sales.WorkflowModel.StageLabel(stage)</span>
                <span class="badge text-bg-primary">@items.Count</span>
            </div>
            <div class="card-body wf-col-body" data-stage-drop="@stage">
                @if (!items.Any())
                {
                    <div class="text-muted small">Sin tratos</div>
                }
                else
                {
                    foreach (var d in items)
                    {
                        var slaClass = d.IsOverdue ? "text-bg-danger" : d.IsToday ? "text-bg-success" : d.IsSoon ? "text-bg-warning" : "text-bg-secondary";
                        <article class="border rounded-3 p-2 mb-2 wf-card"
                                 draggable="@(Model.CanMove ? "true" : "false")"
                                 data-opportunity-id="@d.Id"
                                 data-current-stage="@d.Stage">
                            <div class="fw-semibold">@d.Folio</div>
                            <div class="small">@d.Customer</div>
                            <div class="small text-muted">Vendedor: @d.Seller</div>
                            <div class="small text-muted">Owner: @d.Owner</div>
                            <div class="small">Monto: <b>@d.Total.ToString("C")</b></div>

                            <div class="d-flex flex-wrap align-items-center gap-1 mt-1">
                                @if (d.StageDueAt.HasValue)
                                {
                                    <span class="badge @slaClass">SLA @d.StageDueAt.Value.ToString("yyyy-MM-dd")</span>
                                }
                                <span class="badge text-bg-light">@d.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                            </div>

                            @if ((User.IsInRole(HNControl.Web.Models.AppRoles.Admin) || User.IsInRole(HNControl.Web.Models.AppRoles.SuperAdmin)) && d.ClientId.HasValue)
                            {
                                <div class="mt-2">
                                    <a class="btn btn-sm btn-outline-success" asp-page="/Projects/Create" asp-route-clientId="@d.ClientId">Nuevo proyecto</a>
                                </div>
                            }
                        </article>
                    }
                }
            </div>
        </section>
    }
</div>

@if (Model.CanMove)
{
    <form method="post" asp-page-handler="MoveStage" id="dragMoveForm" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OpportunityId" id="dragMoveOpportunityId" />
        <input type="hidden" name="NewStage" id="dragMoveNewStage" />
    </form>
}

<style>
    .workflow-board {
        display: grid;
        grid-template-columns: repeat(9, minmax(260px, 1fr));
        gap: .75rem;
        overflow-x: auto;
    }

    .wf-col {
        min-height: 380px;
    }

    .wf-col-body {
        max-height: 72vh;
        overflow-y: auto;
    }

    .wf-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        cursor: grab;
    }
    .wf-card:active {
        cursor: grabbing;
    }
    .wf-col-body.drag-over {
        outline: 2px dashed #2563eb;
        outline-offset: -4px;
        background: #eff6ff;
    }
</style>

@if (Model.CanMove)
{
    <script>
        (() => {
            const moveForm = document.getElementById('dragMoveForm');
            const idInput = document.getElementById('dragMoveOpportunityId');
            const stageInput = document.getElementById('dragMoveNewStage');
            let draggedId = null;
            let draggedStage = null;

            document.querySelectorAll('.wf-card[draggable="true"]').forEach(card => {
                card.addEventListener('dragstart', () => {
                    draggedId = card.getAttribute('data-opportunity-id');
                    draggedStage = card.getAttribute('data-current-stage');
                    card.classList.add('opacity-50');
                });
                card.addEventListener('dragend', () => {
                    card.classList.remove('opacity-50');
                    draggedId = null;
                    draggedStage = null;
                    document.querySelectorAll('.wf-col-body.drag-over').forEach(x => x.classList.remove('drag-over'));
                });
            });

            document.querySelectorAll('[data-stage-drop]').forEach(zone => {
                zone.addEventListener('dragover', e => {
                    e.preventDefault();
                    zone.classList.add('drag-over');
                });
                zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
                zone.addEventListener('drop', e => {
                    e.preventDefault();
                    zone.classList.remove('drag-over');
                    const newStage = zone.getAttribute('data-stage-drop');
                    if (!draggedId || !newStage || !moveForm) return;
                    if (draggedStage === newStage) return;
                    idInput.value = draggedId;
                    stageInput.value = newStage;
                    moveForm.submit();
                });
            });
        })();
    </script>
}

