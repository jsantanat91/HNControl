@page
@using HNControl.Web.Models
@model HNControl.Web.Pages.Sales.WorkflowModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Workflow comercial";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Workflow comercial</h1>
        <div class="text-muted small">Oportunidad > Cotización > Cierre</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="/Ventas">Dashboard</a>
        <button class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#newDealModal">Nuevo trato</button>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Flash))
{
    <div class="alert alert-@(Model.FlashType ?? "info")">@Model.Flash</div>
}

<div class="alert alert-light border mb-3">
    <b>Alcance:</b> @(Model.CanViewAll ? "Global" : "Solo tus tratos")
    <span class="ms-2 small text-muted">Arrastra cada oportunidad entre columnas para mover etapa.</span>
    <span class="ms-2 badge text-bg-success">Hoy</span>
    <span class="ms-1 badge text-bg-warning">Proximo</span>
    <span class="ms-1 badge text-bg-danger">Atrasado</span>
</div>

<form method="get" class="card shadow-soft border-0 mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-12 col-md-3">
            <label class="form-label mb-1">Filtrar etapa</label>
            <select class="form-select" asp-for="StageFilter" asp-items="Model.StageFilterItems"></select>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label mb-1">Filtrar owner</label>
            <select class="form-select" asp-for="OwnerFilterUserId" asp-items="Model.OwnerFilterItems"></select>
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label mb-1">Mes</label>
            <input class="form-control" type="month" asp-for="Month" />
        </div>
        <div class="col-12 col-md-4 d-grid d-md-flex justify-content-md-end gap-2">
            <button class="btn btn-primary" type="submit">Aplicar</button>
            <a class="btn btn-outline-secondary" href="/Ventas/Workflow">Limpiar</a>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft border-0 bg-primary-subtle h-100">
            <div class="card-body">
                <div class="text-muted small">Tratos visibles</div>
                <div class="fs-3 fw-bold">@Model.TotalDeals</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft border-0 bg-danger-subtle h-100">
            <div class="card-body">
                <div class="text-muted small">SLA atrasados</div>
                <div class="fs-3 fw-bold">@Model.OverdueDeals</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft border-0 bg-warning-subtle h-100">
            <div class="card-body">
                <div class="text-muted small">SLA hoy/proximo</div>
                <div class="fs-3 fw-bold">@Model.DueSoonDeals</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-soft border-0 bg-success-subtle h-100">
            <div class="card-body">
                <div class="text-muted small">Ganados</div>
                <div class="fs-3 fw-bold">@Model.WonDeals</div>
            </div>
        </div>
    </div>
</div>

<div class="workflow-board pb-2">
    @foreach (var stage in new[] { SalesWorkflowStage.Lead, SalesWorkflowStage.Quotation, SalesWorkflowStage.Closing })
    {
        var items = Model.Board.ContainsKey(stage) ? Model.Board[stage] : new List<HNControl.Web.Pages.Sales.WorkflowModel.DealVm>();
        <section class="wf-col card shadow-soft border-0" data-stage-col="@stage">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>@HNControl.Web.Pages.Sales.WorkflowModel.StageLabel(stage)</span>
                <span class="badge text-bg-primary">@items.Count</span>
            </div>
            <div class="card-body wf-col-body" data-stage-drop="@stage">
                @if (!items.Any())
                {
                    <div class="text-muted small">Sin tratos</div>
                }
                else
                {
                    foreach (var d in items)
                    {
                        <article class="border rounded-3 p-2 mb-2 wf-card"
                                 draggable="@(Model.CanMove ? "true" : "false")"
                                 data-opportunity-id="@d.Id"
                                 data-current-stage="@d.Stage">
                            <div class="fw-semibold">@d.Folio</div>
                            <div class="small">Monto: <b>@d.Total.ToString("C")</b></div>
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#wfDetail-@d.Id">Detalle</button>
                                @if (Model.CanCall)
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="/Ventas/Llamadas?OpportunityId=@d.Id">Llamar</a>
                                }
                                @if ((User.IsInRole(HNControl.Web.Models.AppRoles.Admin) || User.IsInRole(HNControl.Web.Models.AppRoles.SuperAdmin)) && d.ClientId.HasValue)
                                {
                                    <a class="btn btn-sm btn-outline-success" asp-page="/Projects/Create" asp-route-clientId="@d.ClientId">Nuevo proyecto</a>
                                }
                            </div>

                            @if (stage == SalesWorkflowStage.Closing)
                            {
                                <div class="border-top mt-2 pt-2 d-flex gap-2">
                                    <form method="post" asp-page-handler="MoveStage">
                                        <input type="hidden" name="OpportunityId" value="@d.Id" />
                                        <input type="hidden" name="NewStage" value="@SalesWorkflowStage.ClosedWon" />
                                        <input type="hidden" asp-for="StageFilter" />
                                        <input type="hidden" asp-for="OwnerFilterUserId" />
                                        <input type="hidden" asp-for="Month" />
                                        <button class="btn btn-sm btn-success" type="submit">Ganado</button>
                                    </form>
                                    <form method="post" asp-page-handler="MoveStage">
                                        <input type="hidden" name="OpportunityId" value="@d.Id" />
                                        <input type="hidden" name="NewStage" value="@SalesWorkflowStage.ClosedLost" />
                                        <input type="hidden" asp-for="StageFilter" />
                                        <input type="hidden" asp-for="OwnerFilterUserId" />
                                        <input type="hidden" asp-for="Month" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Perdido</button>
                                    </form>
                                </div>
                            }
                        </article>
                    }
                }
            </div>
        </section>
    }
</div>

<div class="row g-3 mt-1">
    <div class="col-12 col-xl-6">
        <div class="card shadow-soft border-0">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Ganados</span>
                <span class="badge text-bg-success">@((Model.Board.ContainsKey(SalesWorkflowStage.ClosedWon) ? Model.Board[SalesWorkflowStage.ClosedWon].Count : 0))</span>
            </div>
            <div class="card-body">
                @{
                    var wonItems = Model.Board.ContainsKey(SalesWorkflowStage.ClosedWon) ? Model.Board[SalesWorkflowStage.ClosedWon] : new List<HNControl.Web.Pages.Sales.WorkflowModel.DealVm>();
                }
                @if (!wonItems.Any())
                {
                    <div class="text-muted small">Sin tratos ganados.</div>
                }
                else
                {
                    <div class="vstack gap-2">
                        @foreach (var d in wonItems)
                        {
                            <div class="border rounded-3 p-2 d-flex justify-content-between align-items-center">
                                <div><span class="fw-semibold">@d.Folio</span> · <span>@d.Total.ToString("C")</span></div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-success" disabled>Ganado</button>
                                    <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#wfDetail-@d.Id">Detalle</button>
                                    @if (Model.CanCall)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="/Ventas/Llamadas?OpportunityId=@d.Id">Llamar</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card shadow-soft border-0">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Perdidos</span>
                <span class="badge text-bg-danger">@((Model.Board.ContainsKey(SalesWorkflowStage.ClosedLost) ? Model.Board[SalesWorkflowStage.ClosedLost].Count : 0))</span>
            </div>
            <div class="card-body">
                @{
                    var lostItems = Model.Board.ContainsKey(SalesWorkflowStage.ClosedLost) ? Model.Board[SalesWorkflowStage.ClosedLost] : new List<HNControl.Web.Pages.Sales.WorkflowModel.DealVm>();
                }
                @if (!lostItems.Any())
                {
                    <div class="text-muted small">Sin tratos perdidos.</div>
                }
                else
                {
                    <div class="vstack gap-2">
                        @foreach (var d in lostItems)
                        {
                            <div class="border rounded-3 p-2 d-flex justify-content-between align-items-center">
                                <div><span class="fw-semibold">@d.Folio</span> · <span>@d.Total.ToString("C")</span></div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-danger" disabled>Perdido</button>
                                    <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#wfDetail-@d.Id">Detalle</button>
                                    @if (Model.CanCall)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="/Ventas/Llamadas?OpportunityId=@d.Id">Llamar</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@foreach (var kv in Model.DetailsByOpportunityId)
{
    var det = kv.Value;
    <div class="modal fade" id="wfDetail-@det.OpportunityId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@det.Folio · @det.Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-lg-6">
                            <div class="border rounded-3 p-2 h-100">
                                <div class="fw-semibold mb-1">Cliente / Prospecto</div>
                                <div class="small"><span class="hn-badge hn-badge-blue">@det.CustomerType</span></div>
                                <div class="small mt-1"><b>Nombre:</b> @det.Customer</div>
                                <div class="small"><b>Empresa:</b> @det.CompanyName</div>
                                <div class="small"><b>Correo:</b> @det.CustomerEmail</div>
                                <div class="small"><b>Teléfono:</b> @det.CustomerPhone</div>
                                <div class="small"><b>Ubicación:</b> @det.CustomerLocation</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="border rounded-3 p-2 h-100">
                                <div class="fw-semibold mb-1">Venta</div>
                                <div class="small"><b>Vendedor:</b> @det.Seller</div>
                                <div class="small"><b>Correo vendedor:</b> @det.SellerEmail</div>
                                <div class="small"><b>Owner:</b> @det.Owner</div>
                                <div class="small"><b>Estado:</b> @det.Status</div>
                                <div class="small mt-1"><b>Monto:</b> @det.Total.ToString("C")</div>
                            </div>
                        </div>
                    </div>

                    <div class="fw-semibold mb-2">Bitácora de seguimiento</div>
                    <form method="post" asp-page-handler="AddNote" class="mb-3">
                        <input type="hidden" asp-for="OpportunityId" value="@det.OpportunityId" />
                        <input type="hidden" asp-for="StageFilter" />
                        <input type="hidden" asp-for="OwnerFilterUserId" />
                        <input type="hidden" asp-for="Month" />
                        <textarea class="form-control mb-2" asp-for="NoteText" maxlength="2000" rows="3" placeholder="Escribe seguimiento (max 2000 caracteres)"></textarea>
                        <button class="btn btn-sm btn-primary" type="submit">Guardar nota</button>
                    </form>

                    @if (!det.Notes.Any())
                    {
                        <div class="text-muted small">Sin notas todavía.</div>
                    }
                    else
                    {
                        <div class="vstack gap-2">
                            @foreach (var n in det.Notes)
                            {
                                <div class="border rounded-3 p-2">
                                    <div class="small text-muted">@n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @n.UserName</div>
                                    <div class="small">@n.Text</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (Model.CanMove)
{
    <form method="post" asp-page-handler="MoveStage" id="dragMoveForm" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OpportunityId" id="dragMoveOpportunityId" />
        <input type="hidden" name="NewStage" id="dragMoveNewStage" />
    </form>
}

<div class="modal fade" id="newDealModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo trato</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="height:82vh;">
                <iframe id="newDealFrame" src="/Ventas/Gestion?openCreateOpportunity=1" style="width:100%;height:100%;border:0;"></iframe>
            </div>
        </div>
    </div>
</div>

<style>
    .workflow-board {
        display: grid;
        grid-template-columns: repeat(3, minmax(260px, 1fr));
        gap: .75rem;
        overflow-x: auto;
    }

    .wf-col {
        min-height: 380px;
    }

    .wf-col-body {
        max-height: 72vh;
        overflow-y: auto;
    }

    .wf-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        cursor: grab;
    }
    .wf-card:active {
        cursor: grabbing;
    }
    .wf-col-body.drag-over {
        outline: 2px dashed #2563eb;
        outline-offset: -4px;
        background: #eff6ff;
    }
</style>

@if (Model.CanMove)
{
    <script>
        (() => {
            const moveForm = document.getElementById('dragMoveForm');
            const idInput = document.getElementById('dragMoveOpportunityId');
            const stageInput = document.getElementById('dragMoveNewStage');
            let draggedId = null;
            let draggedStage = null;

            document.querySelectorAll('.wf-card[draggable="true"]').forEach(card => {
                card.addEventListener('dragstart', () => {
                    draggedId = card.getAttribute('data-opportunity-id');
                    draggedStage = card.getAttribute('data-current-stage');
                    card.classList.add('opacity-50');
                });
                card.addEventListener('dragend', () => {
                    card.classList.remove('opacity-50');
                    draggedId = null;
                    draggedStage = null;
                    document.querySelectorAll('.wf-col-body.drag-over').forEach(x => x.classList.remove('drag-over'));
                });
            });

            document.querySelectorAll('[data-stage-drop]').forEach(zone => {
                zone.addEventListener('dragover', e => {
                    e.preventDefault();
                    zone.classList.add('drag-over');
                });
                zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
                zone.addEventListener('drop', e => {
                    e.preventDefault();
                    zone.classList.remove('drag-over');
                    const newStage = zone.getAttribute('data-stage-drop');
                    if (!draggedId || !newStage || !moveForm) return;
                    if (draggedStage === newStage) return;
                    idInput.value = draggedId;
                    stageInput.value = newStage;
                    moveForm.submit();
                });
            });
        })();
    </script>
}


