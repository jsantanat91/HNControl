@inject HNControl.Web.Services.IActionAccessService ActionAccess
@{
    var path = (Context?.Request?.Path.Value ?? "").ToLowerInvariant();
    var isQuotesActive = path.StartsWith("/admin/quotes/requests") || path.StartsWith("/ventas/cotizaciones");
    var isCatalogActive = path.StartsWith("/admin/quotes/catalog");
    var canDashboard = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesViewOwn) || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesViewAll);
    var canWorkflow = canDashboard;
    var canGestion = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesManage);
    var canCalls = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesCallsView);
    var canProspects = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesProspectsView);
    var canQuotes = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesQuotesView) || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesQuotesManage);
    var canTemplates = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.TemplatesManage);
    var canCatalog = User.IsInRole(HNControl.Web.Models.AppRoles.SuperAdmin)
        || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesCatalogView)
        || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesCatalogManage);

    string Btn(string href, string text, string cls)
    {
        var active = path.StartsWith(href.ToLowerInvariant()) ? "text-white" : "";
        var outline = path.StartsWith(href.ToLowerInvariant()) ? "" : "btn-outline-" + cls;
        return $"btn btn-sm px-3 py-2 fw-semibold {(string.IsNullOrWhiteSpace(outline) ? "btn-" + cls : outline)} {active}";
    }
}

<div class="card border-0 shadow-soft mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted small me-2">Comercial:</span>
        @if (canDashboard)
        {
            <a href="/Ventas" class="@Btn("/ventas","Dashboard","primary")">Dashboard</a>
        }
        @if (canProspects)
        {
            <a href="/Ventas/Prospectos" class="@Btn("/ventas/prospectos","Prospecto","warning")">Prospecto</a>
        }
        @if (canQuotes)
        {
            <a href="/Ventas/Cotizaciones" class="btn btn-sm px-3 py-2 fw-semibold @(isQuotesActive ? "btn-info text-white" : "btn-outline-info")">Cotización</a>
        }
        @if (canWorkflow)
        {
            <a href="/Ventas/Workflow" class="@Btn("/ventas/workflow","Workflow","success")">Workflow</a>
        }
        @if (canGestion)
        {
            <a href="/Ventas/Gestion" class="@Btn("/ventas/gestion","Gestion","secondary")">Gestion</a>
        }
        @if (canCalls)
        {
            <a href="/Ventas/Llamadas" class="@Btn("/ventas/llamadas","Llamadas","danger")">Llamadas</a>
        }
        @if (canTemplates)
        {
            <a href="/Ventas/Plantillas" class="@Btn("/ventas/plantillas","Plantillas","dark")">Plantillas</a>
        }
        @if (canCatalog)
        {
            <a href="/Admin/Quotes/Catalog" class="btn btn-sm px-3 py-2 fw-semibold @(isCatalogActive ? "btn-dark text-white" : "btn-outline-dark")">Catálogo</a>
        }
    </div>
</div>
