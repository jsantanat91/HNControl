@inject HNControl.Web.Services.IActionAccessService ActionAccess
@{
    var path = (Context?.Request?.Path.Value ?? "").ToLowerInvariant();
    var isQuotesActive = path.StartsWith("/admin/quotes/requests") || path.StartsWith("/ventas/cotizaciones");
    var isCatalogActive = path.StartsWith("/admin/quotes/catalog");
    var canDashboard = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesDashboardView);
    var canWorkflow = canDashboard;
    var canGestion = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesManage);
    var canCalls = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesCallsView);
    var canProspects = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesProspectsView);
    var canQuotes = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesQuotesView) || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesQuotesManage);
    var canMyQuotes = User.IsInRole(HNControl.Web.Models.AppRoles.Seller) && canDashboard;
    var canTemplates = await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.TemplatesManage);
    var canCatalog = HNControl.Web.Models.AppRoles.IsGlobalAdmin(User)
        || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesCatalogView)
        || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.SalesCatalogManage);

    string Tab(string href)
    {
        var active = path.StartsWith(href.ToLowerInvariant()) ? "active" : "";
        return $"hn-tab-link {active}";
    }
}

<nav class="hn-context-tabs" aria-label="Subm&oacute;dulos de ventas">
        @if (canDashboard)
        {
            <a href="/Ventas" class="@Tab("/ventas")"><i class="bi bi-speedometer2 hn-tab-icon"></i> Dashboard</a>
        }
        @if (canProspects)
        {
            <a href="/Ventas/Prospectos" class="@Tab("/ventas/prospectos")"><i class="bi bi-person-plus hn-tab-icon"></i> Prospecto</a>
        }
        @if (HNControl.Web.Models.AppRoles.IsGlobalAdmin(User) && canQuotes)
        {
            <a href="/Ventas/Cotizaciones" class="hn-tab-link @(isQuotesActive ? "active" : "")"><i class="bi bi-file-earmark-text hn-tab-icon"></i> Cotizaci&oacute;n</a>
        }
        @if (canMyQuotes)
        {
            <a href="/Ventas/MisCotizaciones" class="@Tab("/ventas/miscotizaciones")"><i class="bi bi-journal-check hn-tab-icon"></i> Mis cotizaciones</a>
        }
        @if (canWorkflow)
        {
            <a href="/Ventas/Workflow" class="@Tab("/ventas/workflow")"><i class="bi bi-kanban hn-tab-icon"></i> Workflow</a>
        }
        @if (canGestion)
        {
            <a href="/Ventas/Gestion" class="@Tab("/ventas/gestion")"><i class="bi bi-briefcase hn-tab-icon"></i> Gesti&oacute;n</a>
        }
        @if (canCalls)
        {
            <a href="/Ventas/Llamadas" class="@Tab("/ventas/llamadas")"><i class="bi bi-telephone hn-tab-icon"></i> Llamadas</a>
        }
        @if (canTemplates)
        {
            <a href="/Ventas/Plantillas" class="@Tab("/ventas/plantillas")"><i class="bi bi-collection hn-tab-icon"></i> Plantillas</a>
        }
        @if (canCatalog)
        {
            <a href="/Admin/Quotes/Catalog" class="hn-tab-link @(isCatalogActive ? "active" : "")"><i class="bi bi-grid hn-tab-icon"></i> Cat&aacute;logo</a>
        }
</nav>
