@page
@model HNControl.Web.Pages.Leaves.RequestVacationModel
@{
    ViewData["Title"] = "Solicitar solicitud";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Solicitar vacaciones o incidencia</h1>
        <div class="text-muted small">Ambas siguen el mismo flujo de aprobacion del admin.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Leaves/Index">Volver</a>
</div>

<form method="post" enctype="multipart/form-data" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tipo de solicitud</label>
                <select class="form-select" asp-for="Input.RequestKind">
                    <option value="Vacation">Vacaciones</option>
                    <option value="Incidence">Incidencia</option>
                </select>
                <div class="form-text">Incidencia no consume saldo vacacional.</div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Inicio</label>
                <input class="form-control" asp-for="Input.StartDate" type="date" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fin</label>
                <input class="form-control" asp-for="Input.EndDate" type="date" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Evidencias (opcional)</label>
                <input class="form-control" asp-for="Input.EvidenceFiles" type="file" multiple />
                <div class="form-text">PDF/PNG/JPG/WEBP/HEIC - max 15MB c/u</div>
            </div>

            <div class="col-12">
                <label class="form-label">Motivo / Comentario</label>
                <textarea class="form-control" asp-for="Input.Reason" rows="3" placeholder="Ej: evento familiar, viaje, etc."></textarea>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-send me-1"></i> Enviar solicitud</button>
        <a class="btn btn-outline-secondary" asp-page="/Leaves/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
