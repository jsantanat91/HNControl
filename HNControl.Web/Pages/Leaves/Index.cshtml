@page
@using HNControl.Web.Models
@model HNControl.Web.Pages.Leaves.IndexModel
@{
    ViewData["Title"] = "Vacaciones";

    string TypeText(LeaveRequestType t) => t switch
    {
        LeaveRequestType.Vacation => "Vacaciones",
        LeaveRequestType.Medical => "Médica",
        LeaveRequestType.Personal => "Personal",
        _ => t.ToString()
    };

    string TypeBadge(LeaveRequestType t) => t switch
    {
        LeaveRequestType.Vacation => "bg-primary text-white",
        LeaveRequestType.Medical => "bg-danger text-white",
        LeaveRequestType.Personal => "bg-dark text-white",
        _ => "bg-secondary text-white"
    };

    string StatusText(LeaveRequestStatus s) => s switch
    {
        LeaveRequestStatus.Pending => "Pendiente",
        LeaveRequestStatus.Approved => "Aprobado",
        LeaveRequestStatus.Rejected => "Rechazado",
        LeaveRequestStatus.Cancelled => "Cancelado",
        _ => s.ToString()
    };

    string StatusBadge(LeaveRequestStatus s) => s switch
    {
        LeaveRequestStatus.Approved => "bg-success text-white",
        LeaveRequestStatus.Rejected => "bg-danger text-white",
        LeaveRequestStatus.Cancelled => "bg-secondary text-white",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Vacaciones e incidencias</h1>
        <div class="text-muted small">Solicitudes, aprobaciones y evidencias</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-page="/Leaves/RequestVacation"><i class="bi bi-plus-lg me-1"></i> Solicitar vacaciones</a>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (Model.Profile == null)
{
    <div class="alert alert-warning">No tienes perfil cargado. Pídele al admin que te cree bien 😄</div>
}
else
{
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-soft hn-hover">
                <div class="card-body">
                    <div class="text-muted small">Vacaciones (@Model.Year)</div>
                    <div class="fs-4 fw-semibold">@Model.AllowanceDays <span class="fs-6 text-muted">días</span></div>
                    <div class="text-muted small">Asignadas por RH</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-soft hn-hover">
                <div class="card-body">
                    <div class="text-muted small">Usadas (@Model.Year)</div>
                    <div class="fs-4 fw-semibold">@Model.UsedDays <span class="fs-6 text-muted">días</span></div>
                    <div class="text-muted small">Aprobadas</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-soft hn-hover">
                <div class="card-body">
                    <div class="text-muted small">Disponibles (@Model.Year)</div>
                    <div class="fs-4 fw-semibold">@Model.RemainingDays <span class="fs-6 text-muted">días</span></div>
                    <div class="text-muted small">Si te los gastas todos… no hay patch 😅</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-soft hn-hover mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="fw-semibold">Historial</div>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Leaves/Index" asp-route-year="@(DateTime.Now.Year)">Año actual</a>
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Leaves/Index" asp-route-year="@(DateTime.Now.Year - 1)">Año anterior</a>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Items.Any())
            {
                <div class="text-muted">Sin solicitudes aún.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Fechas</th>
                            <th class="text-end">Días</th>
                            <th>Estatus</th>
                            <th>Evidencias</th>
                            <th class="text-end"></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var r in Model.Items)
                        {
                            var typeText = TypeText(r.Type);
                            var typeCss = TypeBadge(r.Type);

                            var stText = StatusText(r.Status);
                            var stCss = StatusBadge(r.Status);

                            <tr>
                                <td>
                                    <span class="badge rounded-pill @typeCss">@typeText</span>
                                    @if (!string.IsNullOrWhiteSpace(r.Reason))
                                    {
                                        <div class="text-muted small mt-1">@r.Reason</div>
                                    }
                                </td>
                                <td>
                                    <div class="small">@r.StartDate.ToString("yyyy-MM-dd") → @r.EndDate.ToString("yyyy-MM-dd")</div>
                                    <div class="text-muted small">Solicitado: @r.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                </td>
                                <td class="text-end fw-semibold">@r.TotalDays</td>
                                <td><span class="badge rounded-pill @stCss">@stText</span></td>
                                <td>
                                    @if (r.Evidences?.Count > 0)
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var ev in r.Evidences.OrderByDescending(x => x.UploadedAt).Take(3))
                                            {
                                                <a class="small" asp-page="/Leaves/DownloadEvidence" asp-route-id="@ev.Id">
                                                    <i class="bi bi-paperclip"></i> @ev.OriginalFileName
                                                </a>
                                            }
                                            @if (r.Evidences.Count > 3)
                                            {
                                                <span class="text-muted small">+@(r.Evidences.Count - 3) más</span>
                                            }
                                        </div>
                                    }
                                    else { <span class="text-muted small">—</span> }
                                </td>
                                <td class="text-end">
                                    @if (r.Status == LeaveRequestStatus.Pending)
                                    {
                                        <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id" class="d-inline">
                                            <button class="btn btn-sm btn-outline-danger" type="submit"
                                                    onclick="return confirm('¿Cancelar solicitud?');">
                                                Cancelar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}