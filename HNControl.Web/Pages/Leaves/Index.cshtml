@page
@using HNControl.Web.Helpers
@using HNControl.Web.Models
@model HNControl.Web.Pages.Leaves.IndexModel
@{
    ViewData["Title"] = "Vacaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Vacaciones e incidencias</h1>
        <div class="text-muted small">Solicitudes, aprobaciones y evidencias.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-page="/Leaves/RequestVacation"><i class="bi bi-plus-lg me-1"></i> Solicitar vacaciones</a>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (Model.Profile == null)
{
    <div class="alert alert-warning">No tienes perfil cargado. Pidele al admin que te cree bien.</div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Vacaciones (@Model.Year)</div><div class="fs-4 fw-bold">@Model.AllowanceDays <span class="fs-6 text-muted">dias</span></div><div class="text-muted small">Asignadas por RH</div></div></div></div>
        <div class="col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Usadas (@Model.Year)</div><div class="fs-4 fw-bold">@Model.UsedDays <span class="fs-6 text-muted">dias</span></div><div class="text-muted small">Aprobadas</div></div></div></div>
        <div class="col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Disponibles (@Model.Year)</div><div class="fs-4 fw-bold">@Model.RemainingDays <span class="fs-6 text-muted">dias</span></div><div class="text-muted small">Saldo actual</div></div></div></div>
    </div>

    <div class="card shadow-soft hn-hover">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="fw-semibold">Historial</div>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Leaves/Index" asp-route-year="@(DateTime.Now.Year)">A&ntilde;o actual</a>
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Leaves/Index" asp-route-year="@(DateTime.Now.Year - 1)">A&ntilde;o anterior</a>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Items.Any())
            {
                <div class="text-muted">Sin solicitudes aun.</div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-xl-2 g-3">
                    @foreach (var r in Model.Items)
                    {
                        var type = UiBadges.LeaveType(r.Type);
                        var status = UiBadges.LeaveStatus(r.Status);
                        <div class="col d-flex">
                            <div class="card shadow-sm hn-hover w-100 hn-leave-card">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <span class="badge rounded-pill @type.css">@type.text</span>
                                            <span class="badge rounded-pill @status.css ms-1">@status.text</span>
                                            <div class="text-muted small mt-2">
                                                @r.StartDate.ToString("yyyy-MM-dd") &rarr; @r.EndDate.ToString("yyyy-MM-dd")
                                            </div>
                                            <div class="text-muted small">Solicitado: @r.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="text-muted small">Dias</div>
                                            <div class="fs-5 fw-bold">@r.TotalDays</div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(r.Reason))
                                    {
                                        <div class="small mt-2 p-2 rounded-3 border bg-light-subtle">@r.Reason</div>
                                    }

                                    <div class="mt-2 small">
                                        @if (r.Evidences?.Count > 0)
                                        {
                                            <div class="text-muted mb-1">Evidencias:</div>
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var ev in r.Evidences.OrderByDescending(x => x.UploadedAt).Take(3))
                                                {
                                                    <a class="badge rounded-pill bg-light text-dark border" asp-page="/Leaves/DownloadEvidence" asp-route-id="@ev.Id">@ev.OriginalFileName</a>
                                                }
                                                @if (r.Evidences.Count > 3)
                                                {
                                                    <span class="text-muted">+@(r.Evidences.Count - 3) mas</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin evidencias.</span>
                                        }
                                    </div>

                                    <div class="mt-auto pt-3">
                                        @if (r.Status == LeaveRequestStatus.Pending)
                                        {
                                            <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id" class="d-inline">
                                                <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Cancelar solicitud?');">Cancelar</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@section Styles {
    <style>
        .hn-leave-card { border-radius: 16px !important; }
    </style>
}
