@page
@model HNControl.Web.Pages.Viaticos.WeekModel
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis viáticos";

    var week = Model.Week;
    var isTravel = week?.FlowType == ViaticFlowType.TravelAdvance;
    var canEdit = week != null && (isTravel
        ? week.Status is ViaticWeekStatus.Draft or ViaticWeekStatus.Rejected or ViaticWeekStatus.Approved
        : week.Status is ViaticWeekStatus.Draft or ViaticWeekStatus.Rejected);

    var nonBillable = week == null ? 0m : Math.Max(0m, week.TotalAmount - week.BillableAmount);
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-success">@Model.Info</div>
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h4 m-0">Mis viáticos</h1>
        <div class="text-muted small">
            Semana: <strong>@Model.WeekStart.ToString("yyyy-MM-dd")</strong>
            @if (week != null)
            {
                var wkKey = week.Status.GetDisplayName().ToLowerInvariant();
                var wkChip = wkKey.Contains("aprob")
                    ? "hn-chip-status-up"
                    : wkKey.Contains("rechaz")
                        ? "hn-chip-status-down"
                        : wkKey.Contains("envi")
                            ? "hn-chip-status-progress"
                            : "hn-chip-neutral";
                var flowChip = isTravel ? "hn-chip-status-progress" : "hn-chip-neutral";

                <span> · Flujo: <span class="hn-chip @flowChip">@week.FlowType.GetDisplayName()</span></span>
                <span> · Estado: <span class="hn-chip @wkChip">@week.Status.GetDisplayName()</span></span>
            }
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Viaticos/Index">Volver</a>

        @if (week != null && canEdit)
        {
            <a class="btn btn-outline-primary" asp-page="/Viaticos/AddEntry" asp-route-weekId="@week.Id">+ Agregar gasto</a>

            @if (week.Entries.Any())
            {
                <form method="post" asp-page-handler="ClearWeek" class="d-inline" onsubmit="return confirm('¿Limpiar todos los gastos de esta semana?');">
                    <input type="hidden" name="weekId" value="@week.Id" />
                    <button class="btn btn-outline-danger" type="submit">Limpiar semana</button>
                </form>
            }

            @if (week.Status is ViaticWeekStatus.Draft or ViaticWeekStatus.Rejected)
            {
                <form method="post" asp-page-handler="DeleteWeek" class="d-inline" onsubmit="return confirm('¿Eliminar esta semana completa?');">
                    <input type="hidden" name="weekId" value="@week.Id" />
                    <button class="btn btn-outline-danger" type="submit">Eliminar semana</button>
                </form>
            }

            <form method="post" asp-page-handler="SubmitWeek" class="d-inline">
                <input type="hidden" name="weekId" value="@week.Id" />
                @if (isTravel && week.Status == ViaticWeekStatus.Approved)
                {
                    <button class="btn btn-success" type="submit">Enviar comprobación</button>
                }
                else if (isTravel)
                {
                    <button class="btn btn-primary" type="submit">Enviar solicitud</button>
                }
                else
                {
                    <button class="btn btn-primary" type="submit">Enviar semana</button>
                }
            </form>
        }
    </div>
</div>

@if (week == null)
{
    <div class="alert alert-info">Cargando semana...</div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xl-3"><div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Total cargado</div><div class="h3 mb-0">@week.TotalAmount.ToString("0.00")</div></div></div></div>
        <div class="col-12 col-md-6 col-xl-3"><div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Facturable</div><div class="h3 mb-0">@week.BillableAmount.ToString("0.00")</div><div class="small text-muted">Reembolso esperado</div></div></div></div>
        <div class="col-12 col-md-6 col-xl-3"><div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">No facturable</div><div class="h3 mb-0">@nonBillable.ToString("0.00")</div><div class="small text-muted">Gasto absorbido</div></div></div></div>
        <div class="col-12 col-md-6 col-xl-3"><div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Flujo</div><div class="small">Solicitud: <b>@(week.SubmittedAt.HasValue ? week.SubmittedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-")</b></div><div class="small">Aprobación admin: <b>@(week.ApprovedAt.HasValue ? week.ApprovedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-")</b></div></div></div></div>
    </div>

    @if (isTravel)
    {
        <div class="card shadow-soft hn-hover mb-3">
            <div class="card-body">
                <div class="fw-semibold mb-2">Datos de viaje anticipado</div>
                <div class="row g-2 small">
                    <div class="col-md-4">Orden: <b>@(week.RelatedServiceOrder?.Title ?? "Sin orden")</b></div>
                    <div class="col-md-4">Destino: <b>@(string.IsNullOrWhiteSpace(week.TripDestination) ? "-" : week.TripDestination)</b></div>
                    <div class="col-md-4">Monto solicitado: <b>@week.RequestedAdvanceAmount.ToString("C")</b></div>
                    <div class="col-md-4">Monto aprobado: <b>@week.ApprovedAdvanceAmount.ToString("C")</b></div>
                    <div class="col-md-4">Depósito: <b>@(week.DepositedAt.HasValue ? week.DepositedAt.Value.ToString("yyyy-MM-dd HH:mm") : "Pendiente")</b></div>
                    <div class="col-md-12">Motivo: <b>@(string.IsNullOrWhiteSpace(week.TripPurpose) ? "-" : week.TripPurpose)</b></div>
                </div>
                @if (week.Status == ViaticWeekStatus.Approved)
                {
                    <div class="alert alert-info mt-3 mb-0">Ya fue autorizado y depositado. Ahora carga comprobantes (si aplica) y usa <b>Enviar comprobación</b>.</div>
                }
                @if (week.Status == ViaticWeekStatus.SettlementSubmitted)
                {
                    <div class="alert alert-warning mt-3 mb-0">Comprobación enviada, en revisión final de administración.</div>
                }
                @if (week.Status == ViaticWeekStatus.SettlementApproved)
                {
                    <div class="alert alert-success mt-3 mb-0">Comprobación final aprobada.</div>
                }
            </div>
        </div>
    }

    @if (week.Status == ViaticWeekStatus.Rejected && !string.IsNullOrWhiteSpace(week.AdminNotes))
    {
        <div class="alert alert-warning"><strong>Rechazado:</strong> @week.AdminNotes</div>
    }

    @if (!week.Entries.Any())
    {
        <div class="alert alert-light border">No hay gastos cargados en esta semana.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
            @foreach (var e in week.Entries.OrderBy(x => x.DayDate).ThenBy(x => x.Category))
            {
                <div class="col d-flex">
                    <div class="card shadow-soft hn-hover w-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-semibold fs-5">@e.Description</div>
                                    <div class="small text-muted">@e.DayDate.ToString("yyyy-MM-dd")</div>
                                </div>
                                <span class="hn-chip @(e.IsBillable ? "hn-chip-status-up" : "hn-chip-neutral")">@(e.IsBillable ? "Facturable" : "No facturable")</span>
                            </div>

                            <div class="small mt-2">Categoría: <b>@e.Category</b></div>
                            <div class="small">Monto: <b>@e.Amount.ToString("0.00")</b></div>

                            <div class="small mt-2">
                                Comprobante:
                                @if (e.Attachment != null)
                                {
                                    <a asp-page="/Viaticos/Download" asp-route-attachmentId="@e.Attachment.Id">@e.Attachment.OriginalFileName</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>

                            @if (canEdit)
                            {
                                <div class="mt-auto pt-3 d-flex gap-2 flex-wrap">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Viaticos/EditEntry" asp-route-entryId="@e.Id">Editar</a>

                                    <form method="post" asp-page-handler="ToggleBillable" class="d-inline">
                                        <input type="hidden" name="entryId" value="@e.Id" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">@(e.IsBillable ? "No facturable" : "Facturable")</button>
                                    </form>

                                    <form method="post" asp-page-handler="DeleteEntry" class="d-inline" onsubmit="return confirm('¿Eliminar gasto?');">
                                        <input type="hidden" name="entryId" value="@e.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
