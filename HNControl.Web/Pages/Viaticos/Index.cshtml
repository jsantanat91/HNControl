@page
@model HNControl.Web.Pages.Viaticos.IndexModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Mis vi&aacute;ticos</h1>
        <div class="text-muted small">Semanal (lunes a domingo) con desglose por d&iacute;a</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card shadow-sm hn-hover mb-3">
    <div class="card-body">
        <form method="post">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Fecha de la semana (elige cualquier d&iacute;a)</label>
                    <input class="form-control" asp-for="AnyDayInWeek" type="date" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary" type="submit">Crear / Abrir semana</button>
                </div>
            </div>
            <div class="text-muted small mt-2">Tip: guardamos la semana por el <b>lunes</b>. Si pones jueves, se corrige solo.</div>
        </form>
    </div>
</div>

<form method="get" class="card shadow-soft hn-hover mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">Desde</label><input class="form-control" type="date" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-3"><label class="form-label">Hasta</label><input class="form-control" type="date" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-2"><label class="form-label">Por p&aacute;gina</label><select class="form-select" name="PageSize">@foreach (var s in new[] { 10,20,50,100 }) {<option value="@s" selected="@(Model.PageSize==s)">@s</option>}</select></div>
        <div class="col-md-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Filtrar</button><a class="btn btn-outline-secondary" asp-page="/Viaticos/Index">Limpiar</a></div>
    </div>
</form>

@if (!Model.Weeks.Any())
{
    <div class="alert alert-light border">No hay semanas para los filtros seleccionados.</div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
        @foreach (var w in Model.Weeks)
        {
            var wkKey = w.Status.GetDisplayName().ToLowerInvariant();
            var wkChip = wkKey.Contains("aprob")
                ? "hn-chip-status-up"
                : wkKey.Contains("rechaz")
                    ? "hn-chip-status-down"
                    : wkKey.Contains("envi")
                        ? "hn-chip-status-progress"
                        : "hn-chip-neutral";
            <div class="col d-flex">
                <div class="card shadow-soft hn-hover w-100">
                    <div class="card-body d-flex flex-column">
                        <div class="fw-bold fs-5">Semana @w.WeekStartDate.ToString("yyyy-MM-dd")</div>
                        <div class="small mt-2">Estado: <span class="hn-chip @wkChip">@w.Status.GetDisplayName()</span></div>
                        <div class="small">Total: <b>@w.Total.ToString("C")</b></div>
                        <div class="mt-auto pt-3">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Viaticos/Week" asp-route-id="@w.Id">Abrir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Total: @Model.TotalCount · P&aacute;gina @Model.Page de @Model.TotalPages</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-page="/Viaticos/Index" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page-1)">Anterior</a>
        <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-page="/Viaticos/Index" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page+1)">Siguiente</a>
    </div>
</div>
