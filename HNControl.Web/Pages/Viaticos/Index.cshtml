@page
@model HNControl.Web.Pages.Viaticos.IndexModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Mis viáticos</h1>
        <div class="text-muted small">Gestión semanal y solicitudes foráneas</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-6">
        <div class="card shadow-sm hn-hover h-100">
            <div class="card-body">
                <div class="fw-semibold fs-5 mb-2">Apoyo Gastos/Transporte</div>
                <form method="post">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label">Fecha de la semana (elige cualquier día)</label>
                            <input class="form-control" asp-for="AnyDayInWeek" type="date" />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary w-100" type="submit">Crear / abrir semana</button>
                        </div>
                    </div>
                </form>
                <div class="text-muted small mt-2">Se guarda por lunes automáticamente.</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card shadow-sm hn-hover h-100">
            <div class="card-body">
                <div class="fw-semibold fs-5 mb-2">Solicitud de Gastos</div>
                <form method="post" asp-page-handler="CreateTravelAdvance">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Semana del viaje</label>
                            <input class="form-control" asp-for="TravelAnyDayInWeek" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cliente (opcional)</label>
                            <select id="travelClientSelect" class="form-select" asp-for="TravelClientId" asp-items="Model.ClientOptions"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Orden de servicio (opcional)</label>
                            <select class="form-select" asp-for="RelatedServiceOrderId" asp-items="Model.ServiceOrderOptions"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Monto solicitado</label>
                            <input class="form-control" asp-for="RequestedAdvanceAmount" type="number" min="0.01" step="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Destino</label>
                            <input class="form-control" asp-for="TripDestination" maxlength="220" placeholder="Ciudad / sucursal" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Motivo del viaje</label>
                            <textarea class="form-control" asp-for="TripPurpose" rows="2" maxlength="1200" placeholder="Actividad, alcance, días estimados"></textarea>
                        </div>
                        <div class="col-12 d-flex justify-content-between align-items-center">
                            <div class="text-muted small">Cliente y orden son opcionales.</div>
                            <button class="btn btn-success" type="submit">Solicitar viático anticipado</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<form method="get" class="card shadow-soft hn-hover mb-3">
    <div class="card-body row g-2 align-items-end">
        <input type="hidden" name="TravelClientId" value="@Model.TravelClientId" />
        <div class="col-md-3"><label class="form-label">Desde</label><input class="form-control" type="date" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-3"><label class="form-label">Hasta</label><input class="form-control" type="date" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-2"><label class="form-label">Por página</label><select class="form-select" name="PageSize">@foreach (var s in new[] { 10,20,50,100 }) {<option value="@s" selected="@(Model.PageSize==s)">@s</option>}</select></div>
        <div class="col-md-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Filtrar</button><a class="btn btn-outline-secondary" asp-page="/Viaticos/Index">Limpiar</a></div>
    </div>
</form>

@if (!Model.Weeks.Any())
{
    <div class="alert alert-light border">No hay semanas para los filtros seleccionados.</div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
        @foreach (var w in Model.Weeks)
        {
            var wkKey = w.Status.GetDisplayName().ToLowerInvariant();
            var wkChip = wkKey.Contains("aprob")
                ? "hn-chip-status-up"
                : wkKey.Contains("rechaz")
                    ? "hn-chip-status-down"
                    : wkKey.Contains("envi")
                        ? "hn-chip-status-progress"
                        : "hn-chip-neutral";

            var flowChip = w.FlowType == HNControl.Web.Models.ViaticFlowType.TravelAdvance
                ? "hn-chip-status-progress"
                : "hn-chip-neutral";

            <div class="col d-flex">
                <div class="card shadow-soft hn-hover w-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="fw-bold fs-5">Semana @w.WeekStartDate.ToString("yyyy-MM-dd")</div>
                            <span class="hn-chip @flowChip">@w.FlowType.GetDisplayName()</span>
                        </div>
                        <div class="small mt-2">Estado: <span class="hn-chip @wkChip">@w.Status.GetDisplayName()</span></div>
                        <div class="small">Total cargado: <b>@w.Total.ToString("C")</b></div>
                        <div class="mt-auto pt-3">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Viaticos/Week" asp-route-id="@w.Id">Abrir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Total: @Model.TotalCount · Página @Model.Page de @Model.TotalPages</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-page="/Viaticos/Index" asp-route-TravelClientId="@Model.TravelClientId" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page-1)">Anterior</a>
        <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-page="/Viaticos/Index" asp-route-TravelClientId="@Model.TravelClientId" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page+1)">Siguiente</a>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const select = document.getElementById('travelClientSelect');
            if (!select) return;
            select.addEventListener('change', function () {
                const url = new URL(window.location.href);
                const val = select.value || '';
                if (val) {
                    url.searchParams.set('TravelClientId', val);
                } else {
                    url.searchParams.delete('TravelClientId');
                }
                window.location.href = url.toString();
            });
        })();
    </script>
}
