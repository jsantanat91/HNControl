@page
@model HNControl.Web.Pages.Clients.IndexModel
@{
    Layout = "_Layout";
    var isLeads = string.Equals(Model.View, "leads", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isLeads ? "Prospectos" : "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">@(isLeads ? "Prospectos" : "Clientes")</h1>
        <div class="text-muted small">@(isLeads ? "Control comercial temporal (prospectos)" : "Alta y control interno")</div>
    </div>
    @if (Model.CanEdit && !isLeads)
    {
        <a class="btn btn-primary" asp-page="/Clients/Create">+ Nuevo cliente</a>
    }
</div>

@if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success py-2">@ok</div>
}
@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger py-2">@err</div>
}

@if (isLeads && Model.CanCreateLead)
{
    <div class="card shadow-soft hn-hover mb-3">
        <div class="card-body">
            <div class="fw-semibold mb-2">Nuevo prospecto</div>
            <form method="post" asp-page-handler="CreateLead" class="row g-2">
                <input type="hidden" name="name" value="@Model.Name" />
                <input type="hidden" name="view" value="leads" />
                <input type="hidden" name="page" value="@Model.Page" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="col-md-3">
                    <label class="form-label">Contacto</label>
                    <input class="form-control" asp-for="Lead.ContactName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Empresa (opcional)</label>
                    <input class="form-control" asp-for="Lead.CompanyName" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Correo</label>
                    <input class="form-control" asp-for="Lead.Email" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" asp-for="Lead.Phone" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ubicación</label>
                    <input class="form-control" asp-for="Lead.Location" />
                </div>
                <div class="col-md-10">
                    <label class="form-label">Notas (opcional)</label>
                    <input class="form-control" asp-for="Lead.Notes" />
                </div>
                <div class="col-md-2 d-grid align-items-end">
                    <button class="btn btn-primary" type="submit">Agregar prospecto</button>
                </div>
            </form>
        </div>
    </div>
}

<form method="get" class="card shadow-soft hn-hover mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Nombre cliente</label>
            <input class="form-control" type="text" name="Name" value="@Model.Name" placeholder="Buscar por nombre..." />
            <input type="hidden" name="View" value="@Model.View" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Por p&aacute;gina</label>
            <select class="form-select" name="PageSize">
                @foreach (var s in new[] { 10, 20, 50, 100 })
                {
                    <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Filtrar</button>
            <a class="btn btn-outline-secondary" asp-page="/Clients/Index" asp-route-View="@Model.View">Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Rows.Any())
{
    <div class="alert alert-light border">No hay clientes para los filtros seleccionados.</div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
        @foreach (var c in Model.Rows)
        {
            <div class="col d-flex">
                <div class="card shadow-soft hn-hover w-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary px-2 py-1 fw-semibold">@c.ClientCode</span>
                                <div class="fw-bold fs-5 mt-2">@c.Name</div>
                                <div class="text-muted small">@c.Kind</div>
                                <div class="mt-1">
                                    <span class="badge @(c.IsActive ? "text-bg-success" : "text-bg-secondary")">@(c.IsActive ? "Activo" : "Inactivo")</span>
                                    @if (c.IsTemporaryLead)
                                    {
                                        <span class="badge text-bg-warning">Prospecto</span>
                                    }
                                    else if (c.IsConvertedFromLead)
                                    {
                                        <span class="badge text-bg-info">Convertido de prospecto</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-primary">Alta manual</span>
                                    }
                                </div>
                            </div>
                            <div class="text-muted small">@c.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</div>
                        </div>
                        <div class="small mt-2 text-muted">RFC: @(string.IsNullOrWhiteSpace(c.Rfc) ? "-" : c.Rfc)</div>
                        <div class="small text-muted">Correo: @(string.IsNullOrWhiteSpace(c.Email) ? "-" : c.Email)</div>
                        <div class="small mt-2">@c.ContractsSummary</div>
                        <div class="mt-auto pt-3 d-flex flex-wrap gap-1 client-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Clients/Details" asp-route-id="@c.Id">Ver</a>
                            @if (Model.CanEdit)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Clients/Edit" asp-route-id="@c.Id">Editar</a>
                                @if (c.IsTemporaryLead)
                                {
                                    @if (Model.IsSuperAdmin)
                                    {
                                        <form method="post" asp-page-handler="ConvertLeadToFormal" class="d-inline">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <input type="hidden" name="name" value="@Model.Name" />
                                            <input type="hidden" name="view" value="@Model.View" />
                                            <input type="hidden" name="page" value="@Model.Page" />
                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                            <button class="btn btn-sm btn-outline-info client-action-btn" type="submit">Convertir a cliente</button>
                                        </form>
                                    }
                                }
                                <form method="post" asp-page-handler="ToggleActive" class="d-inline">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <input type="hidden" name="name" value="@Model.Name" />
                                    <input type="hidden" name="view" value="@Model.View" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <button class="btn btn-sm client-action-btn @(c.IsActive ? "btn-outline-warning" : "btn-outline-success")" type="submit">
                                        @(c.IsActive ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                                @if (Model.CanDelete)
                                {
                                    <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este cliente?');">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <input type="hidden" name="name" value="@Model.Name" />
                                        <input type="hidden" name="view" value="@Model.View" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                        <button class="btn btn-sm btn-outline-danger client-action-btn" type="submit">Eliminar</button>
                                    </form>
                                }
                                @if (Model.IsSuperAdmin && !c.IsTemporaryLead)
                                {
                                    <form method="post" asp-page-handler="RevertToLead" class="d-inline" onsubmit="return confirm('¿Regresar este cliente a prospecto?');">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <input type="hidden" name="name" value="@Model.Name" />
                                        <input type="hidden" name="view" value="@Model.View" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                            <button class="btn btn-sm btn-outline-info client-action-btn" type="submit">Prospecto</button>
                        </form>
                    }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Total: @Model.TotalCount · P&aacute;gina @Model.Page de @Model.TotalPages</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
           asp-page="/Clients/Index"
           asp-route-Name="@Model.Name"
           asp-route-View="@Model.View"
           asp-route-PageSize="@Model.PageSize"
           asp-route-Page="@(Model.Page - 1)">Anterior</a>
        <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
           asp-page="/Clients/Index"
           asp-route-Name="@Model.Name"
           asp-route-View="@Model.View"
           asp-route-PageSize="@Model.PageSize"
           asp-route-Page="@(Model.Page + 1)">Siguiente</a>
    </div>
</div>

@section Styles {
    <style>
        .client-actions .btn {
            padding: .24rem .44rem;
            font-size: .70rem;
            line-height: 1rem;
            border-radius: .6rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .client-action-btn {
            white-space: nowrap;
            letter-spacing: -.01em;
        }

        .client-actions .btn-outline-primary:hover,
        .client-actions .btn-outline-primary:focus-visible {
            color: #fff;
            background: #2563eb;
            border-color: #2563eb;
        }

        .client-actions .btn-outline-secondary:hover,
        .client-actions .btn-outline-secondary:focus-visible {
            color: #fff;
            background: #64748b;
            border-color: #64748b;
        }
    </style>
}
