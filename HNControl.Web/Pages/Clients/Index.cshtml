@page
@model HNControl.Web.Pages.Clients.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Clientes</h1>
        <div class="text-muted small">Alta y control interno</div>
    </div>
    <a class="btn btn-primary" asp-page="/Clients/Create">+ Nuevo cliente</a>
</div>

<div class="card shadow-soft hn-hover mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted me-2">Vista:</span>
        <a class="btn btn-sm @(Model.View == "normal" ? "btn-primary" : "btn-outline-primary")"
           asp-page="/Clients/Index"
           asp-route-Name="@Model.Name"
           asp-route-PageSize="@Model.PageSize"
           asp-route-View="normal">Clientes formales</a>
        <a class="btn btn-sm @(Model.View == "leads" ? "btn-warning" : "btn-outline-warning")"
           asp-page="/Clients/Index"
           asp-route-Name="@Model.Name"
           asp-route-PageSize="@Model.PageSize"
           asp-route-View="leads">Leads de venta</a>
    </div>
</div>

<form method="get" class="card shadow-soft hn-hover mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Nombre cliente</label>
            <input class="form-control" type="text" name="Name" value="@Model.Name" placeholder="Buscar por nombre..." />
            <input type="hidden" name="View" value="@Model.View" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Por p&aacute;gina</label>
            <select class="form-select" name="PageSize">
                @foreach (var s in new[] { 10, 20, 50, 100 })
                {
                    <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Filtrar</button>
            <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Rows.Any())
{
    <div class="alert alert-light border">No hay clientes para los filtros seleccionados.</div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
        @foreach (var c in Model.Rows)
        {
            <div class="col d-flex">
                <div class="card shadow-soft hn-hover w-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary px-2 py-1 fw-semibold">@c.ClientCode</span>
                                <div class="fw-bold fs-5 mt-2">@c.Name</div>
                                <div class="text-muted small">@c.Kind</div>
                                <div class="mt-1">
                                    <span class="badge @(c.IsActive ? "text-bg-success" : "text-bg-secondary")">@(c.IsActive ? "Activo" : "Inactivo")</span>
                                    @if (c.IsTemporaryLead)
                                    {
                                        <span class="badge text-bg-warning">Lead venta</span>
                                    }
                                </div>
                            </div>
                            <div class="text-muted small">@c.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</div>
                        </div>
                        <div class="small mt-2 text-muted">RFC: @(string.IsNullOrWhiteSpace(c.Rfc) ? "-" : c.Rfc)</div>
                        <div class="small text-muted">Correo: @(string.IsNullOrWhiteSpace(c.Email) ? "-" : c.Email)</div>
                        <div class="small mt-2">@c.ContractsSummary</div>
                        <div class="mt-auto pt-3 d-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Clients/Details" asp-route-id="@c.Id">Ver</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Clients/Edit" asp-route-id="@c.Id">Editar</a>
                            <form method="post" asp-page-handler="ToggleActive" class="d-inline">
                                <input type="hidden" name="id" value="@c.Id" />
                                <input type="hidden" name="name" value="@Model.Name" />
                                <input type="hidden" name="view" value="@Model.View" />
                                <input type="hidden" name="page" value="@Model.Page" />
                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                <button class="btn btn-sm @(c.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                                    @(c.IsActive ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Total: @Model.TotalCount · P&aacute;gina @Model.Page de @Model.TotalPages</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
           asp-page="/Clients/Index"
           asp-route-Name="@Model.Name"
           asp-route-View="@Model.View"
           asp-route-PageSize="@Model.PageSize"
           asp-route-Page="@(Model.Page - 1)">Anterior</a>
        <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
           asp-page="/Clients/Index"
           asp-route-Name="@Model.Name"
           asp-route-View="@Model.View"
           asp-route-PageSize="@Model.PageSize"
           asp-route-Page="@(Model.Page + 1)">Siguiente</a>
    </div>
</div>
