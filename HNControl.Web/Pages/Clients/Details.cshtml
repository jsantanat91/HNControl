@page "{id:guid}"
@using System.Text.Json
@model HNControl.Web.Pages.Clients.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ficha del cliente";
    var latestProject = Model.Projects.FirstOrDefault();
    var latestQuote = Model.Quotes.FirstOrDefault();
    var latestTicket = Model.Tickets.FirstOrDefault();
    string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Sin registrar" : value;
}
@if (Model.Client == null) { <div class="alert alert-warning">Cliente no encontrado.</div> return; }
<link rel="stylesheet" href="~/css/hn-clients.css" asp-append-version="true" />
<div class="hn-clients hn-client-profile" data-client-id="@Model.Client.Id">
    <div class="hn-client-toolbar"><a class="hn-client-back" asp-page="/Clients/Index" data-module-panel-close><i class="bi bi-arrow-left" aria-hidden="true"></i>Clientes</a><div class="d-flex flex-wrap gap-2">
        @if (Model.CanEdit) {
            <a class="btn btn-outline-secondary" asp-page="/Clients/Edit" asp-route-id="@Model.Client.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Editar ficha</a>
            <a class="btn btn-outline-secondary" asp-page="/Clients/Documents" asp-route-clientId="@Model.Client.Id"><i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i>Contrato / NDA</a>
            <a class="btn btn-outline-primary" asp-page="/Clients/Welcome" asp-route-clientId="@Model.Client.Id"><i class="bi bi-envelope me-2" aria-hidden="true"></i>Correo de bienvenida</a>
            <a class="btn btn-primary" asp-page="/Clients/Services/Create" asp-route-clientId="@Model.Client.Id"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Agregar contrato</a>
        }
    </div></div>
    <header class="hn-client-hero"><div class="hn-client-hero-identity"><div class="hn-client-hero-avatar" aria-hidden="true"><i class="bi bi-buildings"></i></div><div><div class="hn-eyebrow">Ficha del cliente · @Model.Client.ClientCode</div><h1>@Model.Client.Name</h1><p>@(Model.Client.Kind.ToString() == "Moral" ? "Persona moral" : "Persona física") · RFC: @Display(Model.Client.Rfc)</p><div class="hn-client-hero-contact"><span><i class="bi bi-envelope" aria-hidden="true"></i>@Display(Model.Client.Email)</span><span><i class="bi bi-telephone" aria-hidden="true"></i>@Display(Model.Client.Phone)</span></div></div></div><span class="hn-client-state @(Model.Client.IsActive ? "is-active" : "is-inactive")"><i aria-hidden="true"></i>@(Model.Client.IsActive ? "Activo" : "Inactivo")</span></header>
    @if (TempData["ClientDetailsInfo"] is string info) { var infoType = (TempData["ClientDetailsInfoType"] as string) ?? "info"; <div class="alert alert-@infoType mt-3" role="status">@info</div> }
    <div class="mt-3"><partial name="_ContractExpiryNotice" model="@(new ContractExpiryNotice(Model.Expiring, Model.CanEdit, InClientFile: true))" /></div>
    <nav class="nav hn-client-tabs" role="tablist" aria-label="Secciones del cliente">
        <button class="btn active" id="client-contracts-tab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#client-contracts" aria-controls="client-contracts" aria-selected="true">Contratos <span>@Model.Contracts.Count</span></button>
        <button class="btn" id="client-data-tab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#client-data" aria-controls="client-data" aria-selected="false">Datos y facturación</button>
        <button class="btn" id="client-contacts-tab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#client-contacts" aria-controls="client-contacts" aria-selected="false">Contactos <span>@Model.Contacts.Count</span></button>
        <button class="btn" id="client-activity-tab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#client-activity" aria-controls="client-activity" aria-selected="false">Actividad</button>
        <button class="btn" id="client-access-tab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#client-access" aria-controls="client-access" aria-selected="false">Enlaces y acceso</button>
    </nav>
    <div class="tab-content">
        <section class="tab-pane fade show active" id="client-contracts" role="tabpanel" aria-labelledby="client-contracts-tab" tabindex="0">
    <div class="col-12">
        <div class="card hn-client-contract-panel">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Servicios contratados</div>
                <div class="text-muted small">@Model.Contracts.Count contrato(s)</div>
            </div>

            <div class="card-body">
                @if (!Model.Contracts.Any())
                {
                    <div class="text-muted">A&uacute;n no hay contratos. Dale al bot&oacute;n "Agregar contrato".</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var c in Model.Contracts)
                        {
                            <div class="col-12 col-lg-6">
                                <div class="card border h-100 contract-card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                            <div class="d-flex gap-2 flex-wrap">
                                                @foreach (var serviceType in c.ServiceTypes)
                                                {
                                                    <span class="badge text-bg-light border">@serviceType</span>
                                                }
                                                <span class="badge @c.StatusBadgeClass">@c.StatusText</span>
                                            </div>
                                            @if (c.ContractEndDateText != "-") { <div class="text-muted small" title="Fin de vigencia">@c.ContractEndDateText</div> }
                                        </div>

                                        <div class="hn-client-contract-name">@c.Label</div>

                                        <div class="d-flex gap-2 flex-wrap mb-2">
                                            @if (!string.IsNullOrWhiteSpace(c.Branch))
                                            {
                                                <span class="hn-chip hn-chip-ref hn-chip-branch" title="@c.Branch">Sucursal: @c.Branch</span>
                                            }
                                            <span class="badge text-bg-light border">Recurrencia: @c.BillingRecurrence</span>
                                            <span class="badge text-bg-light border">Plazo: @c.ContractTermText</span>
                                        </div>

                                        <dl class="hn-contract-facts">
                                            <div><dt>@(c.BillingRecurrence == "Eventual" || c.BillingRecurrence == "Unica" ? "Importe único antes de IVA" : c.BillingRecurrence == "Mensual" ? "Mensualidad antes de IVA" : "Importe antes de IVA")</dt><dd>@c.MonthlyAmountText</dd></div>
                                            @if (!string.IsNullOrWhiteSpace(c.ContractNumber))
                                            {
                                                <div><dt>Contrato</dt><dd>@c.ContractNumber</dd></div>
                                            }
                                        </dl>
                                        @if (!string.IsNullOrWhiteSpace(c.BranchAddress))
                                        {
                                            <div class="small text-muted">@c.BranchAddress</div>
                                        }
                                        <details class="hn-contract-more">
                                            <summary>Datos técnicos y referencias</summary>
                                            @if (!string.IsNullOrWhiteSpace(c.Provider)) { <div class="small mb-1">Proveedor: <b>@c.Provider</b></div> }
                                            @if (!string.IsNullOrWhiteSpace(c.AccountNumber) && c.AccountNumber != Model.Client.ClientCode) { <div class="small text-muted mb-1">Cuenta: @c.AccountNumber</div> }
                                            @if (!string.IsNullOrWhiteSpace(c.SalesReference) && c.SalesReference != "-") { <div class="small text-muted mb-1">Venta: @c.SalesReference</div> }
                                        @if (c.TechnicalSummary.Any())
                                        {
                                            <div class="small text-muted mb-1">
                                                @foreach (var item in c.TechnicalSummary)
                                                {
                                                    <div>@item</div>
                                                }
                                            </div>
                                        }
                                            @if (!string.IsNullOrWhiteSpace(c.ProjectTitle) && c.ProjectTitle != "-") { <div class="small text-muted">Proyecto: @c.ProjectTitle</div> }
                                        </details>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 pt-0 d-flex flex-wrap gap-2 justify-content-end">
                                        @if (User.IsInRole(AppRoles.Admin) && Model.Client.IsActive && !Model.Client.IsTemporaryLead)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/ServiceOrders/Create" asp-route-clientId="@Model.Client.Id" asp-route-contractId="@c.Id">Crear orden</a>
                                        }
                                        @if (c.HasContractFile)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary"
                                               asp-page="/Clients/Services/Download"
                                               asp-route-id="@c.Id">Contrato</a>
                                        }
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-page="/Clients/Services/Edit"
                                           asp-route-id="@c.Id">Editar</a>
                                        <a class="btn btn-sm btn-outline-success"
                                           asp-page="/Clients/Services/InternalPdf"
                                           asp-route-id="@c.Id">PDF</a>
                                        @if (Model.CanEdit)
                                        {
                                            <form method="post"
                                                  asp-page-handler="DeleteContract"
                                                  asp-route-id="@Model.Client.Id"
                                                  asp-route-contractId="@c.Id"
                                                  onsubmit="return confirm('¿Eliminar este contrato? Se quitarán las ligas con facturación, tickets, órdenes, monitoreo y documentos, pero no se borrarán esos registros.');"
                                                  class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="card-footer text-muted small">
                Crea una orden desde el contrato para conservar el cliente, servicio y proyecto vinculados.
            </div>
        </div>
    </div>

        </section>
        <section class="tab-pane fade" id="client-data" role="tabpanel" aria-labelledby="client-data-tab" tabindex="0"><div class="hn-client-data-grid">
            <article class="hn-client-panel"><h2><i class="bi bi-person" aria-hidden="true"></i>Contacto y representación</h2><dl class="hn-client-data"><div><dt>Contacto principal</dt><dd>@Display(Model.Client.ContactName)</dd></div><div><dt>Representante legal</dt><dd>@Display(Model.Client.LegalRepresentative)</dd></div><div><dt>Correo legal</dt><dd>@Display(Model.Client.LegalEmail)</dd></div><div><dt>Puesto del representante</dt><dd>@Display(Model.Client.LegalPosition)</dd></div><div><dt>Correo</dt><dd>@Display(Model.Client.Email)</dd></div><div><dt>Teléfono</dt><dd>@Display(Model.Client.Phone)</dd></div><div><dt>Responsable comercial</dt><dd>@Model.OwnerDisplayName</dd></div><div><dt>Giro</dt><dd>@Display(Model.Client.BusinessLine)</dd></div></dl></article>
            <article class="hn-client-panel"><h2><i class="bi bi-receipt" aria-hidden="true"></i>Facturación</h2><dl class="hn-client-data"><div><dt>RFC</dt><dd>@Display(Model.Client.Rfc)</dd></div><div><dt>Correo de facturación</dt><dd>@Display(Model.Client.BillingEmail)</dd></div><div><dt>Régimen fiscal</dt><dd>@Display(Model.Client.FiscalRegimeCode)</dd></div><div><dt>Uso de CFDI</dt><dd>@Display(Model.Client.CfdiUseCodeDefault)</dd></div><div><dt>Código postal fiscal</dt><dd>@Display(Model.Client.FiscalZipCode)</dd></div><div class="hn-client-span"><dt>Domicilio fiscal</dt><dd>@Display(Model.Client.FiscalAddress)</dd></div></dl></article>
            <article class="hn-client-panel"><h2><i class="bi bi-geo-alt" aria-hidden="true"></i>Domicilio</h2><dl class="hn-client-data"><div class="hn-client-span"><dt>Dirección</dt><dd>@Display(Model.Client.Address)</dd></div><div><dt>Estado</dt><dd>@Display(Model.Client.State)</dd></div><div><dt>Municipio</dt><dd>@Display(Model.Client.Municipality)</dd></div></dl></article>
        </div></section>
        <section class="tab-pane fade" id="client-contacts" role="tabpanel" aria-labelledby="client-contacts-tab" tabindex="0">
        <div class="card shadow-sm hn-hover mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Contactos del cliente</div>
                <span class="text-muted small">@Model.Contacts.Count registro(s)</span>
            </div>
            <div class="card-body"><div asp-validation-summary="All" class="text-danger small"></div>
                @if (!Model.Contacts.Any())
                {
                    <div class="text-muted small mb-3">No hay contactos registrados.</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var c in Model.Contacts)
                        {
                            <div class="border rounded p-2">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">
                                            @c.Name
                                            @if (c.IsPrimary)
                                            {
                                                <span class="badge text-bg-success ms-1">Principal</span>
                                            }
                                        </div>
                                        <div class="small text-muted">@(!string.IsNullOrWhiteSpace(c.Role) ? c.Role : "Soporte")</div>
                                        <div class="small">@(!string.IsNullOrWhiteSpace(c.Email) ? c.Email : "-")</div>
                                        <div class="small">@(!string.IsNullOrWhiteSpace(c.Phone) ? c.Phone : "-")</div>
                                    </div>
                                    @if (Model.CanEdit)
                                    {
                                        <form method="post" asp-page-handler="DeleteContact" asp-route-id="@Model.Client.Id" asp-route-contactId="@c.Id">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Quitar</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (Model.CanEdit)
                {
                <form method="post" asp-page-handler="AddContact" asp-route-id="@Model.Client.Id" class="row g-3 hn-client-contact-form">
                    <div class="col-12">
                        <label class="form-label small mb-1" for="ContactInput_Name">Nombre</label>
                        <input asp-for="ContactInput.Name" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-7">
                        <label class="form-label small mb-1" for="ContactInput_Email">Correo</label>
                        <input asp-for="ContactInput.Email" type="email" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-1" for="ContactInput_Phone">Teléfono</label>
                        <input asp-for="ContactInput.Phone" type="tel" class="form-control form-control-sm" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-1" for="ContactInput_Role">Rol (opcional)</label>
                        <input asp-for="ContactInput.Role" class="form-control form-control-sm" placeholder="Soporte, administracion, operaciones..." />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="ContactInput.IsPrimary" />
                            <label class="form-check-label small" asp-for="ContactInput.IsPrimary">Marcar como principal</label>
                        </div>
                    </div>
                    <div class="col-12 d-grid">
                        <button class="btn btn-sm btn-primary" type="submit">Agregar contacto</button>
                    </div>
                </form>
                }
            </div>
        </div>

        </section>
        <section class="tab-pane fade" id="client-activity" role="tabpanel" aria-labelledby="client-activity-tab" tabindex="0">
    <div class="col-12">
        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <div class="card shadow-soft hn-hover h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="fw-semibold">Proyectos</div>
                        <span class="text-muted small">@Model.Projects.Count registro(s)</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        @if (latestProject == null)
                        {
                            <div class="text-muted small">Sin proyectos.</div>
                        }
                        else
                        {
                            <div class="fw-semibold">@latestProject.Title</div>
                            <div class="small text-muted">Inicio: @latestProject.StartDate · Est: @latestProject.EstEnd</div>
                            <div class="small text-muted">Estado: @latestProject.Status</div>
                        }
                        <div class="mt-auto pt-3 d-flex gap-2">
                            @if (Model.CanEdit)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Projects/Create" asp-route-clientId="@Model.Client.Id">+ Nuevo</a>
                            }
                            <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#projectsModal">Abrir</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card shadow-soft hn-hover h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="fw-semibold">Cotizaciones</div>
                        <span class="text-muted small">@Model.Quotes.Count registro(s)</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        @if (latestQuote == null)
                        {
                            <div class="text-muted small">Sin cotizaciones.</div>
                        }
                        else
                        {
                            <div class="fw-semibold">@latestQuote.Folio</div>
                            <div class="small text-muted">@latestQuote.Segment · @latestQuote.CreatedAt</div>
                            <div class="small text-muted">Total: @latestQuote.Total.ToString("C")</div>
                        }
                        <div class="mt-auto pt-3">
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#quotesModal">Abrir</button>
                                <button class="btn btn-sm btn-outline-primary"
                                        type="button"
                                        data-quote-modal-open="true"
                                        data-quote-modal-size="xl"
                                        href="@Model.PublicQuoteUrl"
                                        onclick="return false;">
                                    + Nueva
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card shadow-soft hn-hover h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="fw-semibold">Histórico de tickets</div>
                        <span class="text-muted small">@Model.Tickets.Count registro(s)</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        @if (latestTicket == null)
                        {
                            <div class="text-muted small">Sin tickets históricos.</div>
                        }
                        else
                        {
                            <div class="fw-semibold">@latestTicket.Number</div>
                            <div class="small text-muted">@latestTicket.Title</div>
                            <div class="small text-muted">@latestTicket.Status · @latestTicket.Priority</div>
                        }
                        <div class="mt-auto pt-3">
                            <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#ticketsModal">Abrir</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>        </section>
        <section class="tab-pane fade" id="client-access" role="tabpanel" aria-labelledby="client-access-tab" tabindex="0"><div class="hn-client-data-grid">
        <div class="card shadow-sm hn-hover mb-3">
            <div class="card-body">
                <div class="fw-semibold mb-1">Cotizador para el cliente</div>
                <div class="input-group">
                    <input id="quotePublicLink" class="form-control" value="@Model.PublicQuoteUrl" readonly />
                    <button class="btn btn-outline-primary" type="button" data-copy-target="quotePublicLink">Copiar</button>
                    <a class="btn btn-primary" href="@Model.PublicQuoteUrl" target="_blank" rel="noopener">Abrir</a>
                </div>
                <div class="text-muted small mt-2">Este enlace carga los datos del cliente para solicitar una cotización.</div>
            </div>
        </div>

        @if (Model.IsSuperAdmin)
        {
            <div class="card shadow-sm hn-hover mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">Acceso portal cliente</div>
                    <span class="text-muted small">Solo superadmin</span>
                </div>
                <div class="card-body">
                    @if (Model.PortalCredentials == null)
                    {
                        <div class="text-muted small">No hay credenciales disponibles para este cliente.</div>
                    }
                    else
                    {
                        <div class="small text-muted mb-1">Usuario</div>
                        <div class="fw-semibold mb-2">@Model.PortalCredentials.Username</div>
                        <div class="small text-muted mb-1">Contraseña</div>
                        <div class="input-group mb-2"><input id="clientPortalPassword" class="form-control" type="password" value="@Model.PortalCredentials.Password" readonly aria-label="Contraseña del portal" autocomplete="off" /><button type="button" class="btn btn-outline-secondary" data-copy-target="clientPortalPassword">Copiar</button><button type="button" class="btn btn-outline-secondary" data-password-toggle="clientPortalPassword" aria-label="Mostrar contraseña" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                        <div class="small text-muted mb-3">
                            Último acceso:
                            @(Model.PortalCredentials.LastLoginAt.HasValue ? Model.PortalCredentials.LastLoginAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Nunca")
                        </div>
                        <div class="input-group mb-2">
                            <input id="portalLoginLink" class="form-control" value="@Model.ClientPortalLoginUrl" readonly />
                            <button class="btn btn-outline-primary" type="button"
                                    data-copy-target="portalLoginLink">
                                Copiar
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-secondary" href="@Model.ClientPortalLoginUrl" target="_blank" rel="noopener">Abrir portal</a>
                            <form method="post" asp-page-handler="ResetPortalAccess" asp-route-id="@Model.Client.Id">
                                <button class="btn btn-sm btn-primary" type="submit">Regenerar contraseña</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card shadow-sm hn-hover mb-3">
            <div class="card-body">
                <div class="fw-semibold mb-1">Soporte y atención NOC</div>
                <div class="input-group">
                    <input id="ticketPublicLink" class="form-control" value="https://support.hubnet-solutions.net" readonly />
                    <button class="btn btn-outline-primary" type="button" data-copy-target="ticketPublicLink">Copiar</button>
                    <a class="btn btn-primary" href="https://support.hubnet-solutions.net" target="_blank" rel="noopener">Abrir</a>
                </div>
                <div class="text-muted small mt-2">Portal externo de soporte. Atención preferente por WhatsApp al 55 2601 4566.</div>
            </div>
        </div>
        </div></section>
    </div>
</div>
<div class="modal fade" id="projectsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Proyectos del cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="projectsList"></div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <button id="projectsPrev" class="btn btn-sm btn-outline-secondary" type="button">Anterior</button>
                    <small id="projectsPage" class="text-muted"></small>
                    <button id="projectsNext" class="btn btn-sm btn-outline-secondary" type="button">Siguiente</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="quotesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cotizaciones del cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="quotesList"></div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <button id="quotesPrev" class="btn btn-sm btn-outline-secondary" type="button">Anterior</button>
                    <small id="quotesPage" class="text-muted"></small>
                    <button id="quotesNext" class="btn btn-sm btn-outline-secondary" type="button">Siguiente</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ticketsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tickets del cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="ticketsList"></div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <button id="ticketsPrev" class="btn btn-sm btn-outline-secondary" type="button">Anterior</button>
                    <small id="ticketsPage" class="text-muted"></small>
                    <button id="ticketsNext" class="btn btn-sm btn-outline-secondary" type="button">Siguiente</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hn-chip-branch {
            max-width: 100%;
            display: inline-block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .contract-card {
            border-radius: 1rem;
        }
    </style>
}

@section Scripts {
    <script src="~/js/hn-clients.js" asp-append-version="true"></script>
    <script>
        function escapeHtml(value) { const span=document.createElement('span'); span.textContent=String(value ?? ''); return span.innerHTML.replaceAll('"','&quot;').replaceAll("'",'&#39;'); }

        const projectData = @Html.Raw(JsonSerializer.Serialize(Model.Projects));
        const quoteData = @Html.Raw(JsonSerializer.Serialize(Model.Quotes));
        const ticketData = @Html.Raw(JsonSerializer.Serialize(Model.Tickets));
        const pageSize = 10;

        function renderPaged(data, page, listId, pageId, prevId, nextId, renderItem) {
            const list = document.getElementById(listId);
            const pageEl = document.getElementById(pageId);
            const prev = document.getElementById(prevId);
            const next = document.getElementById(nextId);
            if (!list || !pageEl || !prev || !next) return { page: 1, totalPages: 1 };

            const totalPages = Math.max(1, Math.ceil(data.length / pageSize));
            const current = Math.min(Math.max(page, 1), totalPages);
            const start = (current - 1) * pageSize;
            const items = data.slice(start, start + pageSize);

            if (items.length === 0) {
                list.innerHTML = '<div class="text-muted">Sin registros.</div>';
            } else {
                list.innerHTML = items.map(renderItem).join('');
            }

            pageEl.textContent = `Página ${current} de ${totalPages}`;
            prev.disabled = current <= 1;
            next.disabled = current >= totalPages;

            return { page: current, totalPages: totalPages };
        }

        let projectPage = 1;
        let quotePage = 1;
        let ticketPage = 1;

        function renderProjects() {
            const result = renderPaged(
                projectData,
                projectPage,
                'projectsList',
                'projectsPage',
                'projectsPrev',
                'projectsNext',
                p => `<div class="border rounded p-2 mb-2">
                        <div class="fw-semibold">${escapeHtml(p.Title)}</div>
                        <div class="small text-muted">Inicio: ${escapeHtml(p.StartDate)} · Est: ${escapeHtml(p.EstEnd)}</div>
                        <div class="small text-muted">Estado: ${escapeHtml(p.Status)}</div>
                        <div class="mt-2"><a class="btn btn-sm btn-outline-primary" href="/Projects/Details/${encodeURIComponent(p.Id)}">Abrir</a></div>
                      </div>`);
            projectPage = result.page;
        }

        function renderQuotes() {
            const result = renderPaged(
                quoteData,
                quotePage,
                'quotesList',
                'quotesPage',
                'quotesPrev',
                'quotesNext',
                q => `<div class="border rounded p-2 mb-2">
                        <div class="fw-semibold">${escapeHtml(q.Folio)}</div>
                        <div class="small text-muted">${escapeHtml(q.Segment)} · ${escapeHtml(q.CreatedAt)}</div>
                        <div class="small text-muted">Total: ${escapeHtml(q.Total)}</div>
                      </div>`);
            quotePage = result.page;
        }

        function renderTickets() {
            const result = renderPaged(
                ticketData,
                ticketPage,
                'ticketsList',
                'ticketsPage',
                'ticketsPrev',
                'ticketsNext',
                t => `<div class="border rounded p-2 mb-2">
                        <div class="fw-semibold">${escapeHtml(t.Number)}</div>
                        <div class="small text-muted">${escapeHtml(t.Title)}</div>
                        <div class="small text-muted">${escapeHtml(t.Status)} · ${escapeHtml(t.Priority)} · ${escapeHtml(t.CreatedAt)}</div>
                      </div>`);
            ticketPage = result.page;
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('projectsPrev')?.addEventListener('click', () => { projectPage--; renderProjects(); });
            document.getElementById('projectsNext')?.addEventListener('click', () => { projectPage++; renderProjects(); });
            document.getElementById('quotesPrev')?.addEventListener('click', () => { quotePage--; renderQuotes(); });
            document.getElementById('quotesNext')?.addEventListener('click', () => { quotePage++; renderQuotes(); });
            document.getElementById('ticketsPrev')?.addEventListener('click', () => { ticketPage--; renderTickets(); });
            document.getElementById('ticketsNext')?.addEventListener('click', () => { ticketPage++; renderTickets(); });

            document.getElementById('projectsModal')?.addEventListener('show.bs.modal', renderProjects);
            document.getElementById('quotesModal')?.addEventListener('show.bs.modal', renderQuotes);
            document.getElementById('ticketsModal')?.addEventListener('show.bs.modal', renderTickets);
        });
    </script>
}

