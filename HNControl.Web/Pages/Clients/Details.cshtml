@page "{id:guid}"
@model HNControl.Web.Pages.Clients.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cliente";
}

@if (Model.Client == null)
{
    <div class="alert alert-warning">Cliente no encontrado.</div>
    return;
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 m-0">@Model.Client.Name</h1>
        <div class="mt-1">
            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary px-3 py-2 fw-semibold">@Model.Client.ClientCode</span>
        </div>
        <div class="text-muted small">
            @(Model.Client.Kind.ToString()) &middot; RFC: <b>@(Model.Client.Rfc ?? "-")</b>
            &middot; <span class="text-muted">@(Model.Client.Email ?? "-")</span>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Volver</a>
        <a class="btn btn-outline-primary" asp-page="/Clients/Edit" asp-route-id="@Model.Client.Id">Editar</a>
        <a class="btn btn-primary" asp-page="/Clients/Services/Create" asp-route-clientId="@Model.Client.Id">+ Agregar contrato</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-soft hn-hover">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Servicios contratados</div>
                <div class="text-muted small">@Model.Contracts.Count contrato(s)</div>
            </div>

            <div class="card-body table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Categor&iacute;a</th>
                            <th>Contrato</th>
                            <th>Proveedor</th>
                            <th class="text-nowrap">Vence</th>
                            <th>Proyecto</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Contracts.Any())
                    {
                        <tr><td colspan="6" class="text-muted">A&uacute;n no hay contratos. Dale al bot&oacute;n "Agregar contrato".</td></tr>
                    }
                    else
                    {
                        foreach (var c in Model.Contracts)
                        {
                            <tr>
                                <td>
                                    <span class="badge text-bg-light border">@c.ServiceType</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@c.Label</div>
                                    <div class="text-muted small">
                                        Cuenta: @(string.IsNullOrWhiteSpace(c.AccountNumber) ? "-" : c.AccountNumber)
                                        &middot; #Contrato: @(string.IsNullOrWhiteSpace(c.ContractNumber) ? "-" : c.ContractNumber)
                                        @if (c.MonthlyAmount.HasValue)
                                        {
                                            <span> &middot; Mensual: <b>@c.MonthlyAmount.Value.ToString("C")</b></span>
                                        }
                                        @if (c.HasPortalAccess)
                                        {
                                            <span> &middot; <span class="badge bg-info text-dark">Acceso portal</span></span>
                                        }
                                    </div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(c.Provider) ? "-" : c.Provider)</td>
                                <td class="text-nowrap">
                                    <div>@(c.ContractEndDateText)</div>
                                    <div>
                                        <span class="badge @c.StatusBadgeClass">@c.StatusText</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@c.ProjectTitle</td>
                                <td class="text-end text-nowrap">
                                    @if (c.HasContractFile)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-page="/Clients/Services/Download"
                                           asp-route-id="@c.Id">Contrato</a>
                                    }
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-page="/Clients/Services/Edit"
                                       asp-route-id="@c.Id">Editar</a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>

            <div class="card-footer text-muted small">
                Tip pro: liga el contrato a un <b>Proyecto</b> para que las &Oacute;rdenes de Servicio queden trazables (mantenimientos vs servicio espec&iacute;fico).
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm hn-hover mb-3">
            <div class="card-body">
                <div class="fw-semibold mb-1">Contacto</div>
                <div class="text-muted small">
                    Contacto: <b>@(string.IsNullOrWhiteSpace(Model.Client.ContactName) ? "-" : Model.Client.ContactName)</b><br />
                    Tel: <b>@(Model.Client.Phone ?? "-")</b><br />
                    Direcci&oacute;n: @(Model.Client.Address ?? "-")
                </div>
            </div>
        </div>

        <div class="card shadow-sm hn-hover mb-3">
            <div class="card-body">
                <div class="fw-semibold mb-1">Link publico de cotizacion</div>
                <div class="input-group">
                    <input id="quotePublicLink" class="form-control" value="@Model.PublicQuoteUrl" readonly />
                    <button class="btn btn-outline-primary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('quotePublicLink').value)">Copiar</button>
                    <a class="btn btn-primary" href="@Model.PublicQuoteUrl" target="_blank" rel="noopener">Abrir</a>
                </div>
                <div class="text-muted small mt-2">Este link ya carga los datos del cliente y solo completa la cotizacion.</div>
            </div>
        </div>

        <div class="card shadow-soft hn-hover">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Proyectos</div>
                <a class="btn btn-sm btn-outline-primary" asp-page="/Projects/Create" asp-route-clientId="@Model.Client.Id">+ Nuevo</a>
            </div>

            <div class="card-body table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Proyecto</th>
                            <th>Status</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Projects.Any())
                    {
                        <tr><td colspan="3" class="text-muted">Sin proyectos todav&iacute;a.</td></tr>
                    }
                    else
                    {
                        foreach (var p in Model.Projects)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@p.Title</div>
                                    <div class="text-muted small">@p.StartDate &middot; Est: @p.EstEnd</div>
                                </td>
                                <td><span class="badge text-bg-light border">@p.Status</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Projects/Details" asp-route-id="@p.Id">Abrir</a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

