@page "{id:guid}"
@model HNControl.Web.Pages.Clients.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cliente";
}

@if (Model.Client == null)
{
    <div class="alert alert-warning">Cliente no encontrado.</div>
    return;
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 m-0">@Model.Client.Name</h1>
        <div class="mt-1">
            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary px-3 py-2 fw-semibold">@Model.Client.ClientCode</span>
        </div>
        <div class="text-muted small">
            @(Model.Client.Kind.ToString()) &middot; RFC: <b>@(Model.Client.Rfc ?? "-")</b>
            &middot; <span class="text-muted">@(Model.Client.Email ?? "-")</span>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Volver</a>
        <a class="btn btn-outline-primary" asp-page="/Clients/Edit" asp-route-id="@Model.Client.Id">Editar</a>
        <a class="btn btn-primary" asp-page="/Clients/Services/Create" asp-route-clientId="@Model.Client.Id">+ Agregar contrato</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card shadow-soft hn-hover">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Servicios contratados</div>
                <div class="text-muted small">@Model.Contracts.Count contrato(s)</div>
            </div>

            <div class="card-body">
                @if (!Model.Contracts.Any())
                {
                    <div class="text-muted">A&uacute;n no hay contratos. Dale al bot&oacute;n "Agregar contrato".</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var c in Model.Contracts)
                        {
                            <div class="col-12 col-lg-6">
                                <div class="card border h-100 contract-card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                            <div class="d-flex gap-2 flex-wrap">
                                                <span class="badge text-bg-light border">@c.ServiceType</span>
                                                <span class="badge @c.StatusBadgeClass">@c.StatusText</span>
                                            </div>
                                            <div class="text-muted small">@c.ContractEndDateText</div>
                                        </div>

                                        <div class="fw-semibold mb-1">@c.Label</div>

                                        <div class="d-flex gap-2 flex-wrap mb-2">
                                            @if (!string.IsNullOrWhiteSpace(c.Branch))
                                            {
                                                <span class="hn-chip hn-chip-ref hn-chip-branch" title="@c.Branch">Sucursal: @c.Branch</span>
                                            }
                                            @if (c.HasPortalAccess)
                                            {
                                                <span class="badge bg-info text-dark">Acceso portal</span>
                                            }
                                        </div>

                                        <div class="small text-muted mb-1">
                                            Cuenta: @(string.IsNullOrWhiteSpace(c.AccountNumber) ? "-" : c.AccountNumber)
                                            &middot; #Contrato: @(string.IsNullOrWhiteSpace(c.ContractNumber) ? "-" : c.ContractNumber)
                                        </div>
                                        <div class="small mb-1">
                                            Proveedor: <b>@(string.IsNullOrWhiteSpace(c.Provider) ? "-" : c.Provider)</b>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(c.BranchAddress))
                                        {
                                            <div class="small text-muted mb-1">Direcci&oacute;n sucursal: @c.BranchAddress</div>
                                        }
                                        <div class="small text-muted">Proyecto: @c.ProjectTitle</div>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 pt-0 d-flex gap-2 justify-content-end">
                                        @if (c.HasContractFile)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary"
                                               asp-page="/Clients/Services/Download"
                                               asp-route-id="@c.Id">Contrato</a>
                                        }
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-page="/Clients/Services/Edit"
                                           asp-route-id="@c.Id">Editar</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="card-footer text-muted small">
                Tip pro: liga el contrato a un <b>Proyecto</b> para que las &Oacute;rdenes de Servicio queden trazables (mantenimientos vs servicio espec&iacute;fico).
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card shadow-sm hn-hover mb-3">
            <div class="card-body">
                <div class="fw-semibold mb-1">Contacto</div>
                <div class="text-muted small">
                    Contacto: <b>@(string.IsNullOrWhiteSpace(Model.Client.ContactName) ? "-" : Model.Client.ContactName)</b><br />
                    Tel: <b>@(Model.Client.Phone ?? "-")</b><br />
                    Direcci&oacute;n: @(Model.Client.Address ?? "-")
                </div>
            </div>
        </div>

        <div class="card shadow-sm hn-hover mb-3">
            <div class="card-body">
                <div class="fw-semibold mb-1">Link publico de cotizacion</div>
                <div class="input-group">
                    <input id="quotePublicLink" class="form-control" value="@Model.PublicQuoteUrl" readonly />
                    <button class="btn btn-outline-primary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('quotePublicLink').value)">Copiar</button>
                    <a class="btn btn-primary" href="@Model.PublicQuoteUrl" target="_blank" rel="noopener">Abrir</a>
                </div>
                <div class="text-muted small mt-2">Este link ya carga los datos del cliente y solo completa la cotizacion.</div>
            </div>
        </div>

        <div class="card shadow-sm hn-hover mb-3">
            <div class="card-body">
                <div class="fw-semibold mb-1">Link publico de tickets</div>
                <div class="input-group">
                    <input id="ticketPublicLink" class="form-control" value="@Model.PublicTicketUrl" readonly />
                    <button class="btn btn-outline-primary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('ticketPublicLink').value)">Copiar</button>
                    <a class="btn btn-primary" href="@Model.PublicTicketUrl" target="_blank" rel="noopener">Abrir</a>
                </div>
                <div class="text-muted small mt-2">El cliente captura su ID (ej: HN-0001), selecciona sucursal y levanta ticket ITIL.</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card shadow-soft hn-hover">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Proyectos</div>
                <a class="btn btn-sm btn-outline-primary" asp-page="/Projects/Create" asp-route-clientId="@Model.Client.Id">+ Nuevo</a>
            </div>

            <div class="card-body table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Proyecto</th>
                            <th>Status</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Projects.Any())
                    {
                        <tr><td colspan="3" class="text-muted">Sin proyectos todav&iacute;a.</td></tr>
                    }
                    else
                    {
                        foreach (var p in Model.Projects)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@p.Title</div>
                                    <div class="text-muted small">@p.StartDate &middot; Est: @p.EstEnd</div>
                                </td>
                                <td><span class="badge text-bg-light border">@p.Status</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Projects/Details" asp-route-id="@p.Id">Abrir</a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card shadow-soft hn-hover mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Cotizaciones</div>
                <div class="text-muted small">@Model.Quotes.Count registro(s)</div>
            </div>
            <div class="card-body table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Segmento</th>
                            <th>Total</th>
                            <th>Manual</th>
                            <th>Fecha</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Quotes.Any())
                    {
                        <tr><td colspan="6" class="text-muted">Sin cotizaciones todavía.</td></tr>
                    }
                    else
                    {
                        foreach (var q in Model.Quotes)
                        {
                            <tr>
                                <td class="fw-semibold">@q.Folio</td>
                                <td><span class="badge text-bg-light border">@q.Segment</span></td>
                                <td>@q.Total.ToString("C")</td>
                                <td>
                                    <span class="badge @(q.ManualItems > 0 ? "text-bg-warning" : "text-bg-success")">
                                        @q.ManualItems
                                    </span>
                                </td>
                                <td class="text-muted small">@q.CreatedAt</td>
                                <td class="text-end">
                                    @if (q.HasPdf)
                                    {
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-page="/Admin/Quotes/Requests"
                                           asp-page-handler="DownloadPdf"
                                           asp-route-id="@q.Id">PDF</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-soft hn-hover mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Tickets</div>
                <div class="text-muted small">@Model.Tickets.Count registro(s)</div>
            </div>
            <div class="card-body table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>Asunto</th>
                            <th>Estado</th>
                            <th>Prioridad</th>
                            <th>Asignado</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Tickets.Any())
                    {
                        <tr><td colspan="6" class="text-muted">Sin tickets todavia.</td></tr>
                    }
                    else
                    {
                        foreach (var t in Model.Tickets)
                        {
                            <tr>
                                <td class="fw-semibold">@t.Number</td>
                                <td>@t.Title</td>
                                <td><span class="hn-chip hn-chip-neutral">@t.Status</span></td>
                                <td><span class="hn-chip hn-chip-ref">@t.Priority</span></td>
                                <td>@t.AssignedTo</td>
                                <td class="text-muted small">@t.CreatedAt</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hn-chip-branch {
            max-width: 100%;
            display: inline-block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .contract-card {
            border-radius: 1rem;
        }
    </style>
}

