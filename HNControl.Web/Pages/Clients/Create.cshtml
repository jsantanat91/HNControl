@page
@model HNControl.Web.Pages.Clients.CreateModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Nuevo cliente</h1>
        <div class="text-muted small">Primero creas el cliente; luego agregas sus contratos/servicios.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Volver</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <select class="form-select" asp-for="Input.Kind" asp-items="Model.KindItems"></select>
            </div>

            <div class="col-md-8">
                <label class="form-label">Nombre</label>
                <input class="form-control" asp-for="Input.Name" />
            </div>

            <div class="col-md-6">
                <label class="form-label">RFC</label>
                <input class="form-control" asp-for="Input.Rfc" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Correo</label>
                <input class="form-control" asp-for="Input.Email" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Telefono</label>
                <input class="form-control" asp-for="Input.Phone" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Nombre de contacto</label>
                <input class="form-control" asp-for="Input.ContactName" placeholder="Ej: Juan Perez" />
            </div>

            <div class="col-12">
                <label class="form-label">Direccion</label>
                <input class="form-control" asp-for="Input.Address" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Representante legal</label>
                <input class="form-control" asp-for="Input.LegalRepresentative" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Correo legal</label>
                <input class="form-control" asp-for="Input.LegalEmail" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Puesto representante</label>
                <input class="form-control" asp-for="Input.LegalPosition" placeholder="Ej: Director General" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Giro / actividad</label>
                <input class="form-control" asp-for="Input.BusinessLine" placeholder="Ej: Manufactura / Retail" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Correo facturacion</label>
                <input class="form-control" asp-for="Input.BillingEmail" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Domicilio fiscal</label>
                <input class="form-control" asp-for="Input.FiscalAddress" />
            </div>

            <div class="col-md-4">
                <label class="form-label">CP fiscal</label>
                <input class="form-control" asp-for="Input.FiscalZipCode" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Regimen fiscal SAT</label>
                <select class="form-select" asp-for="Input.FiscalRegimeCode">
                    @foreach (var it in HNControl.Web.Models.SatCatalogs.RegimenFiscal)
                    {
                        <option value="@it.Code">@it.Code - @it.Label</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Uso CFDI por defecto</label>
                <select class="form-select" asp-for="Input.CfdiUseCodeDefault">
                    @foreach (var it in HNControl.Web.Models.SatCatalogs.UsoCfdi)
                    {
                        <option value="@it.Code">@it.Code - @it.Label</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Crear</button>
        <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
