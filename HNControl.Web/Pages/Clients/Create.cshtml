@page
@model HNControl.Web.Pages.Clients.CreateModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Nuevo cliente</h1>
        <div class="text-muted small">Primero creas el cliente; luego agregas sus contratos/servicios.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Volver</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <select class="form-select" asp-for="Input.Kind" asp-items="Model.KindItems"></select>
            </div>

            <div class="col-md-8">
                <label class="form-label">Nombre</label>
                <input class="form-control" asp-for="Input.Name" />
            </div>

            <div class="col-md-6">
                <label class="form-label">RFC</label>
                <input class="form-control" asp-for="Input.Rfc" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Correo</label>
                <input class="form-control" asp-for="Input.Email" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Teléfono</label>
                <input class="form-control" asp-for="Input.Phone" />
            </div>

            <div class="col-12">
                <label class="form-label">Dirección</label>
                <input class="form-control" asp-for="Input.Address" />
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Crear</button>
        <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
