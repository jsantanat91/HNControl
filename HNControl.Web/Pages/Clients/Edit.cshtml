@page "{id:guid}"
@model HNControl.Web.Pages.Clients.EditModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar cliente";
}

<link rel="stylesheet" href="~/css/hn-clients.css" asp-append-version="true" />
<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center hn-client-form-heading">
    <div>
        <h1 class="h4 m-0">Editar cliente</h1>
        <div class="text-muted small">Los contratos/servicios se gestionan en la ficha del cliente.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Volver</a>
        @if (Model.Input != null)
        {
            <a class="btn btn-outline-primary" asp-page="/Clients/Details" asp-route-id="@Model.Input.Id">Ficha</a>
        }
    </div>
            </div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Input == null)
{
    <div class="alert alert-warning">Cliente no encontrado.</div>
    return;
}

<div class="mb-2">
    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary px-3 py-2 fw-semibold">@Model.Input.ClientCode</span>
            </div>

<form method="post" class="card shadow-soft hn-workflow-form hn-client-form">
    <div class="card-body">
<div asp-validation-summary="All" class="text-danger small"></div>
        <input type="hidden" asp-for="Input.Id" />

        <section class="hn-form-section">
            <header class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">01</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Identidad y contacto</span>
                    <span class="hn-form-section-hint">Los datos principales que usarás en contratos y comunicaciones.</span>
                </span>
            </header>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-md-4">
                <label class="form-label" asp-for="Input.Kind">Tipo</label>
                <select class="form-select" asp-for="Input.Kind" asp-items="Model.KindItems"></select>
            </div>
            <div class="col-md-8">
                <label class="form-label" asp-for="Input.Name">Razón Social</label>
                <input class="form-control" asp-for="Input.Name" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.Rfc">RFC</label>
                <input class="form-control" asp-for="Input.Rfc" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.ContactName">Nombre de contacto</label>
                <input class="form-control" asp-for="Input.ContactName" placeholder="Ej: Juan Perez" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.Email">Correo</label>
                <input class="form-control" asp-for="Input.Email" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.Phone">Teléfono</label>
                <input class="form-control" asp-for="Input.Phone" />
            </div>
            </div>
        </section>
        <section class="hn-form-section">
            <header class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">02</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Domicilio y atención</span>
                    <span class="hn-form-section-hint">Ubicación del cliente y responsable comercial.</span>
                </span>
            </header>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-12">
                <label class="form-label" asp-for="Input.Address">Dirección</label>
                <input class="form-control" asp-for="Input.Address" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.State">Estado</label>
                <select class="form-select" asp-for="Input.State" asp-items="Model.StateItems">
                    <option value="">Selecciona estado...</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.Municipality">Municipio / Alcaldia</label>
                <input class="form-control" asp-for="Input.Municipality" list="municipalityOptions" />
                <datalist id="municipalityOptions"></datalist>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Input.OwnerUserId">Responsable comercial</label>
                <select class="form-select" asp-for="Input.OwnerUserId" asp-items="Model.OwnerItems"></select>
            </div>
            </div>
        </section>
        <section class="hn-form-section">
            <header class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">03</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Facturación y datos legales</span>
                    <span class="hn-form-section-hint">Reutiliza la información de contacto cuando corresponda.</span>
                </span>
            </header>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.BillingEmail">Correo de facturación</label>
                <input class="form-control" asp-for="Input.BillingEmail" />
<button type="button" class="hn-field-action" data-copy-target="Input_BillingEmail" data-copy-source="Input_Email">Usar correo de contacto</button><span class="hn-field-feedback" data-copy-feedback role="status"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.LegalRepresentative">Representante legal (opcional)</label>
                <input class="form-control" asp-for="Input.LegalRepresentative" />
<button type="button" class="hn-field-action" data-copy-target="Input_LegalRepresentative" data-copy-source="Input_ContactName">Usar nombre de contacto</button><span class="hn-field-feedback" data-copy-feedback role="status"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.BusinessLine">Giro / actividad</label>
                <input class="form-control" asp-for="Input.BusinessLine" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="fiscalAddressInput">Domicilio Fiscal</label>
                <input class="form-control" asp-for="Input.FiscalAddress" id="fiscalAddressInput" />
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="copyAddressCheck" />
                    <label class="form-check-label small" for="copyAddressCheck">Mismo que Domicilio</label>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Input.FiscalZipCode">Código Postal</label>
                <input class="form-control" asp-for="Input.FiscalZipCode" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Input.FiscalRegimeCode">Régimen Fiscal</label>
                <select class="form-select" asp-for="Input.FiscalRegimeCode">
                    @foreach (var it in HNControl.Web.Models.SatCatalogs.RegimenFiscal)
                    {
                        <option value="@it.Code">@it.Code - @it.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Input.CfdiUseCodeDefault">Uso de CFDI</label>
                <select class="form-select" asp-for="Input.CfdiUseCodeDefault">
                    @foreach (var it in HNControl.Web.Models.SatCatalogs.UsoCfdi)
                    {
                        <option value="@it.Code">@it.Code - @it.Label</option>
                    }
                </select>
            </div>
            </div>
        </section>
    </div>

    <div class="card-footer d-flex flex-wrap gap-2 hn-form-actions">
        <button class="btn btn-primary" type="submit">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-page="/Clients/Details" asp-route-id="@Model.Input.Id">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const stateSelect = document.getElementById('Input_State');
            const municipalityInput = document.getElementById('Input_Municipality');
            const municipalityOptions = document.getElementById('municipalityOptions');
            const check = document.getElementById('copyAddressCheck');
            const address = document.getElementById('Input_Address');
            const fiscal = document.getElementById('fiscalAddressInput');
            const map = @Html.Raw(Model.MunicipalitiesByStateJson);

            function fillMunicipalities() {
                if (!stateSelect || !municipalityOptions) return;
                const selected = stateSelect.value || '';
                const items = (map && map[selected]) ? map[selected] : [];
                municipalityOptions.innerHTML = '';
                items.forEach(function (name) {
                    const option = document.createElement('option');
                    option.value = name;
                    municipalityOptions.appendChild(option);
                });
                // Importante: no limpiar automáticamente el municipio capturado.
                // Hay estados sin catálogo completo y el usuario puede escribir manualmente
                // (ej. Papantla en Veracruz).
                if (municipalityInput) {
                    municipalityInput.placeholder = items.length === 0
                        ? 'Escribe municipio'
                        : 'Selecciona o escribe municipio';
                }
            }

            if (stateSelect) {
                stateSelect.addEventListener('change', fillMunicipalities);
                fillMunicipalities();
            }

            if (check && address && fiscal) {
                const syncFiscal = () => {
                    if (!check.checked) return;
                    fiscal.value = address.value || '';
                };
                check.addEventListener('change', () => {
                    if (check.checked) {
                        syncFiscal();
                        fiscal.readOnly = true;
                        fiscal.classList.add('bg-light');
                    } else {
                        fiscal.readOnly = false;
                        fiscal.classList.remove('bg-light');
                    }
                });
                address.addEventListener('input', syncFiscal);
            }
        })();
    </script>
}
