@page "{id:guid}"
@model HNControl.Web.Pages.Clients.EditModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Editar cliente</h1>
        <div class="text-muted small">Los contratos/servicios se gestionan en la ficha del cliente.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Volver</a>
        @if (Model.Input != null)
        {
            <a class="btn btn-outline-primary" asp-page="/Clients/Details" asp-route-id="@Model.Input.Id">Ficha</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Input == null)
{
    <div class="alert alert-warning">Cliente no encontrado.</div>
    return;
}

<form method="post" class="card shadow-soft hn-hover">
    <div class="card-body">
        <input type="hidden" asp-for="Input.Id" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <select class="form-select" asp-for="Input.Kind" asp-items="Model.KindItems"></select>
            </div>

            <div class="col-md-8">
                <label class="form-label">Nombre</label>
                <input class="form-control" asp-for="Input.Name" />
            </div>

            <div class="col-md-6">
                <label class="form-label">RFC</label>
                <input class="form-control" asp-for="Input.Rfc" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Correo</label>
                <input class="form-control" asp-for="Input.Email" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Teléfono</label>
                <input class="form-control" asp-for="Input.Phone" />
            </div>

            <div class="col-12">
                <label class="form-label">Dirección</label>
                <input class="form-control" asp-for="Input.Address" />
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-page="/Clients/Details" asp-route-id="@Model.Input.Id">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
