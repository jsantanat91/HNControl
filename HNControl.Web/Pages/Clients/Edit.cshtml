@page "{id:guid}"
@model HNControl.Web.Pages.Clients.EditModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Editar cliente</h1>
        <div class="text-muted small">Los contratos/servicios se gestionan en la ficha del cliente.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Clients/Index">Volver</a>
        @if (Model.Input != null)
        {
            <a class="btn btn-outline-primary" asp-page="/Clients/Details" asp-route-id="@Model.Input.Id">Ficha</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Input == null)
{
    <div class="alert alert-warning">Cliente no encontrado.</div>
    return;
}

<div class="mb-2">
    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary px-3 py-2 fw-semibold">@Model.Input.ClientCode</span>
</div>

<form method="post" class="card shadow-soft hn-hover">
    <div class="card-body">
        <input type="hidden" asp-for="Input.Id" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <select class="form-select" asp-for="Input.Kind" asp-items="Model.KindItems"></select>
            </div>

            <div class="col-md-8">
                <label class="form-label">Razón Social</label>
                <input class="form-control" asp-for="Input.Name" />
            </div>

            <div class="col-md-6">
                <label class="form-label">RFC</label>
                <input class="form-control" asp-for="Input.Rfc" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Correo</label>
                <input class="form-control" asp-for="Input.Email" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Telefono</label>
                <input class="form-control" asp-for="Input.Phone" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Nombre de contacto</label>
                <input class="form-control" asp-for="Input.ContactName" placeholder="Ej: Juan Perez" />
            </div>

            <div class="col-12">
                <label class="form-label">Direccion</label>
                <input class="form-control" asp-for="Input.Address" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Estado</label>
                <select class="form-select" asp-for="Input.State" asp-items="Model.StateItems">
                    <option value="">Selecciona estado...</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Municipio / Alcaldia</label>
                <input class="form-control" asp-for="Input.Municipality" list="municipalityOptions" />
                <datalist id="municipalityOptions"></datalist>
            </div>

            <div class="col-md-6">
                <label class="form-label">Representante legal (opcional)</label>
                <input class="form-control" asp-for="Input.LegalRepresentative" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Giro / actividad</label>
                <input class="form-control" asp-for="Input.BusinessLine" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Correo facturacion</label>
                <input class="form-control" asp-for="Input.BillingEmail" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Domicilio Fiscal</label>
                <input class="form-control" asp-for="Input.FiscalAddress" id="fiscalAddressInput" />
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="copyAddressCheck" />
                    <label class="form-check-label small" for="copyAddressCheck">Mismo que Domicilio</label>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Código Postal</label>
                <input class="form-control" asp-for="Input.FiscalZipCode" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Régimen Fiscal</label>
                <select class="form-select" asp-for="Input.FiscalRegimeCode">
                    @foreach (var it in HNControl.Web.Models.SatCatalogs.RegimenFiscal)
                    {
                        <option value="@it.Code">@it.Code - @it.Label</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Uso de CFDI</label>
                <select class="form-select" asp-for="Input.CfdiUseCodeDefault">
                    @foreach (var it in HNControl.Web.Models.SatCatalogs.UsoCfdi)
                    {
                        <option value="@it.Code">@it.Code - @it.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Vendedor (Owner)</label>
                <select class="form-select" asp-for="Input.OwnerUserId" asp-items="Model.OwnerItems"></select>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-page="/Clients/Details" asp-route-id="@Model.Input.Id">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const stateSelect = document.getElementById('Input_State');
            const municipalityInput = document.getElementById('Input_Municipality');
            const municipalityOptions = document.getElementById('municipalityOptions');
            const check = document.getElementById('copyAddressCheck');
            const address = document.getElementById('Input_Address');
            const fiscal = document.getElementById('fiscalAddressInput');
            const map = @Html.Raw(Model.MunicipalitiesByStateJson);

            function fillMunicipalities() {
                if (!stateSelect || !municipalityOptions) return;
                const selected = stateSelect.value || '';
                const items = (map && map[selected]) ? map[selected] : [];
                municipalityOptions.innerHTML = '';
                items.forEach(function (name) {
                    const option = document.createElement('option');
                    option.value = name;
                    municipalityOptions.appendChild(option);
                });
                if (municipalityInput && (!municipalityInput.value || !items.includes(municipalityInput.value))) {
                    municipalityInput.value = '';
                }
            }

            if (stateSelect) {
                stateSelect.addEventListener('change', fillMunicipalities);
                fillMunicipalities();
            }

            if (check && address && fiscal) {
                const syncFiscal = () => {
                    if (!check.checked) return;
                    fiscal.value = address.value || '';
                };
                check.addEventListener('change', () => {
                    if (check.checked) {
                        syncFiscal();
                        fiscal.readOnly = true;
                        fiscal.classList.add('bg-light');
                    } else {
                        fiscal.readOnly = false;
                        fiscal.classList.remove('bg-light');
                    }
                });
                address.addEventListener('input', syncFiscal);
            }
        })();
    </script>
}
