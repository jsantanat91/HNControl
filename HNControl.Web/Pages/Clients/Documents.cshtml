@page "{clientId:guid}"
@using HNControl.Web.Models
@model HNControl.Web.Pages.Clients.DocumentsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Documentos legales";
}

@if (Model.Client == null)
{
    <div class="alert alert-warning">Cliente no encontrado.</div>
    return;
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 m-0">Documentos legales</h1>
        <div class="text-muted small">@Model.Client.Name - @Model.Client.ClientCode</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Clients/Details" asp-route-id="@Model.Client.Id">Volver cliente</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Flash))
{
    <div class="alert alert-@(Model.FlashType ?? "info")">@Model.Flash</div>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-6">
        <form method="post" asp-page-handler="Generate" class="card shadow-soft hn-hover h-100">
            <div class="card-header fw-semibold">Generar contrato</div>
            <div class="card-body">
                <input type="hidden" name="clientId" value="@Model.Client.Id" />
                <input type="hidden" name="type" value="@ClientLegalDocumentType.Contract" />
                <label class="form-label">Contrato base (opcional)</label>
                <select class="form-select mb-3" name="contractId">
                    <option value="">-- Sin contrato ligado --</option>
                    @foreach (var c in Model.Contracts)
                    {
                        <option value="@c.Id">@c.Label - @c.Provider - @c.MonthlyAmount?.ToString("C")</option>
                    }
                </select>
                <div class="small text-muted">
                    Los datos del cliente se llenan autom&aacute;ticamente desde su ficha (raz&oacute;n social, RFC, estado, municipio, correo de facturaci&oacute;n y datos del contrato).
                    Si ya existe un PDF previo para este contrato, se reemplaza por el nuevo.
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-primary" type="submit">Generar contrato (PDF)</button>
            </div>
        </form>
    </div>

    <div class="col-12 col-xl-6">
        <form method="post" asp-page-handler="Generate" class="card shadow-soft hn-hover h-100">
            <div class="card-header fw-semibold">Generar NDA</div>
            <div class="card-body">
                <input type="hidden" name="clientId" value="@Model.Client.Id" />
                <input type="hidden" name="type" value="@ClientLegalDocumentType.NDA" />
                <label class="form-label">Contrato base (opcional)</label>
                <select class="form-select mb-3" name="contractId">
                    <option value="">-- Sin contrato ligado --</option>
                    @foreach (var c in Model.Contracts)
                    {
                        <option value="@c.Id">@c.Label - @c.Provider</option>
                    }
                </select>
                <div class="small text-muted">
                    NDA autocompletado con datos del cliente y contrato ligado. Siempre genera/reemplaza el PDF final.
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-outline-primary" type="submit">Generar NDA (PDF)</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-soft hn-hover">
    <div class="card-header fw-semibold">Documentos del cliente</div>
    <div class="card-body">
        @if (!Model.Docs.Any())
        {
            <div class="text-muted">Aun no hay documentos generados.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Titulo</th>
                            <th>Estatus</th>
                            <th>Firmado</th>
                            <th>Creado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Docs)
                        {
                            var badge = d.Status == "Firmado" ? "text-bg-success" : d.Status == "En firma" ? "text-bg-warning" : "text-bg-secondary";
                            <tr>
                                <td><span class="badge text-bg-light border">@d.Type</span></td>
                                <td>
                                    <div class="fw-semibold">@d.Title</div>
                                    @if (d.ContractId.HasValue)
                                    {
                                        <div class="small text-muted">Ligado a contrato</div>
                                    }
                                </td>
                                <td><span class="badge @badge">@d.Status</span></td>
                                <td>
                                    @if (d.IsSigned)
                                    {
                                        <div class="small">@d.SignedBy</div>
                                        <div class="small text-muted">@d.SignedAt</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Pendiente</span>
                                    }
                                </td>
                                <td class="small text-muted">@d.CreatedAt</td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <form method="post" asp-page-handler="RegeneratePdf">
                                            <input type="hidden" name="clientId" value="@Model.Client.Id" />
                                            <input type="hidden" name="docId" value="@d.Id" />
                                            <button class="btn btn-sm btn-outline-secondary" type="submit">Regenerar PDF</button>
                                        </form>
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-primary js-open-sign-modal"
                                            data-doc-id="@d.Id"
                                            data-doc-title="@d.Title">
                                            Enviar firma
                                        </button>
                                        <form method="post" asp-page-handler="Download">
                                            <input type="hidden" name="clientId" value="@Model.Client.Id" />
                                            <input type="hidden" name="docId" value="@d.Id" />
                                            <button class="btn btn-sm btn-primary" type="submit" @(d.HasPdf ? "" : "disabled")>Descargar PDF</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="sendSignatureModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="SendForSignature">
                <div class="modal-header">
                    <h5 class="modal-title">Enviar firma digital</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="clientId" value="@Model.Client.Id" />
                    <input type="hidden" name="docId" id="signDocId" />

                    <div class="small text-muted mb-2" id="signDocTitle"></div>

                    <label class="form-label" for="signContactId">Contacto que firmar&aacute;</label>
                    <select class="form-select" id="signContactId" name="contactId">
                        <option value="">Contacto principal del cliente (ficha)</option>
                        @foreach (var c in Model.SignContacts)
                        {
                            var hint = string.IsNullOrWhiteSpace(c.Email) ? "sin correo" : c.Email;
                            <option value="@c.Id">
                                @(c.IsPrimary ? "Principal: " : "")@c.Label - @hint
                            </option>
                        }
                    </select>
                    <div class="form-text">
                        Si eliges un contacto sin correo, se usar&aacute; el correo del cliente (facturaci&oacute;n/principal).
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Enviar firma</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modalEl = document.getElementById("sendSignatureModal");
            if (!modalEl || !window.bootstrap) return;

            const modal = new bootstrap.Modal(modalEl);
            const docIdInput = document.getElementById("signDocId");
            const docTitle = document.getElementById("signDocTitle");

            document.querySelectorAll(".js-open-sign-modal").forEach(btn => {
                btn.addEventListener("click", () => {
                    const docId = btn.getAttribute("data-doc-id") || "";
                    const title = btn.getAttribute("data-doc-title") || "";
                    if (docIdInput) docIdInput.value = docId;
                    if (docTitle) docTitle.textContent = `Documento: ${title}`;
                    modal.show();
                });
            });
        })();
    </script>
}
