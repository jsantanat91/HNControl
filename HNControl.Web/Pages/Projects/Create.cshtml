@page
@model HNControl.Web.Pages.Projects.CreateModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Nuevo proyecto</h1>
        <div class="text-muted small">Ligado a cliente, responsable, SLA y contratos del cliente.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Projects/Index">Volver</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Nombre del proyecto</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Responsable</label>
                <select class="form-select" asp-for="Input.ResponsibleUserId" asp-items="Model.EmployeeItems"></select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Cliente</label>
                <select id="clientSelect" class="form-select" asp-for="Input.ClientId" asp-items="Model.ClientItems"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Contratos ligados (herencia)</label>
                <select id="contractSelect" class="form-select" asp-for="Input.ContractIds" asp-items="Model.ContractItems" multiple size="4"></select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Fecha y hora de inicio</label>
                <input class="form-control" asp-for="Input.StartDate" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Fecha y hora de termino estimado (SLA)</label>
                <input class="form-control" asp-for="Input.EstimatedEndDate" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" />
            </div>

            <div class="col-12">
                <label class="form-label">Objetivo (opcional)</label>
                <input class="form-control" asp-for="Input.Objective" />
            </div>

            <div class="col-12">
                <label class="form-label">Alcance (opcional)</label>
                <textarea class="form-control" asp-for="Input.Scope" rows="2"></textarea>
            </div>

            <div class="col-12">
                <label class="form-label">Descripcion de actividad (opcional)</label>
                <textarea class="form-control" asp-for="Input.Description" rows="3"></textarea>
            </div>

            <div class="col-12">
                <label class="form-label">Notas internas de acceso (opcional)</label>
                <textarea class="form-control" asp-for="Input.AccessNotes" rows="3" placeholder="Solo excepciones del proyecto. Lo base debe vivir en contratos."></textarea>
            </div>

            <div class="col-12">
                <label class="form-label">Comentarios adicionales (opcional)</label>
                <textarea class="form-control" asp-for="Input.Comments" rows="2"></textarea>
            </div>

            <div class="col-12"><hr class="my-1" /></div>
            <div class="col-12">
                <div class="fw-semibold">Actividad inicial para Gantt (opcional)</div>
                <div class="text-muted small">Puedes cargar una actividad desde aqui y luego agregar mas en la vista del proyecto.</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Asignado a</label>
                <input class="form-control" asp-for="Input.InitialActivityAssignedTo" placeholder="Tecnico responsable" />
            </div>
            <div class="col-md-7">
                <label class="form-label">Actividad</label>
                <input class="form-control" asp-for="Input.InitialActivityDescription" placeholder="Descripcion de actividad" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Tiempo (dias)</label>
                <input class="form-control" asp-for="Input.InitialActivityDays" type="number" min="1" max="365" />
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Crear proyecto</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const clientSelect = document.getElementById('clientSelect');
            const contractSelect = document.getElementById('contractSelect');

            async function reloadContracts() {
                const clientId = clientSelect?.value;
                if (!clientId || !contractSelect) return;
                const url = `?handler=Contracts&clientId=${encodeURIComponent(clientId)}`;
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) return;
                const data = await res.json();
                contractSelect.innerHTML = '';
                for (const row of data) {
                    const opt = document.createElement('option');
                    opt.value = row.id;
                    opt.textContent = row.text;
                    contractSelect.appendChild(opt);
                }
            }

            if (clientSelect) {
                clientSelect.addEventListener('change', reloadContracts);
            }
        })();
    </script>
}
