@page
@model HNControl.Web.Pages.Projects.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nuevo proyecto";
}

<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Nuevo proyecto</h1>
        <div class="text-muted small">Ligado a cliente, responsable, SLA y contratos del cliente.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Projects/Index">Volver</a>
            </div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="card shadow-soft hn-workflow-form">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

        <section class="hn-form-section">
            <header class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">01</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Proyecto y cliente</span>
                    <span class="hn-form-section-hint">Vincula contratos existentes para consultar sus datos sin recapturarlos.</span>
                </span>
            </header>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-md-12">
                <label class="form-label" asp-for="Input.Title">Nombre del proyecto</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div class="col-12">
                <label class="form-label" for="clientSelect">Cliente</label>
                <select id="clientSelect" class="form-select" asp-for="Input.ClientId" asp-items="Model.ClientItems"><option value="">Selecciona un cliente</option></select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="contractSelect">Contratos del cliente</label>
                <select id="contractSelect" class="form-select" asp-for="Input.ContractIds" asp-items="Model.ContractItems" multiple size="4"></select>
                <div class="hn-related-context mt-2" id="relatedDataStatus" role="status" aria-live="polite"></div>
                <button type="button" id="relatedDataRetry" class="hn-field-action" hidden>Reintentar consulta</button>
            </div>
            </div>
        </section>
        <section class="hn-form-section">
            <header class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">02</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Responsable y programación</span>
                    <span class="hn-form-section-hint">Define quién coordina el proyecto y cuándo se realizará.</span>
                </span>
            </header>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-md-12">
                <label class="form-label" asp-for="Input.ResponsibleUserId">Responsable</label>
                <select class="form-select" asp-for="Input.ResponsibleUserId" asp-items="Model.EmployeeItems"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.StartDate">Fecha y hora de inicio</label>
                <input class="form-control" asp-for="Input.StartDate" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.EstimatedEndDate">Fecha y hora de termino estimado (SLA)</label>
                <input class="form-control" asp-for="Input.EstimatedEndDate" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" />
            </div>
            </div>
        </section>
        <section class="hn-form-section">
            <header class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">03</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Objetivo y alcance</span>
                    <span class="hn-form-section-hint">Qué se busca lograr y qué trabajo incluye el proyecto.</span>
                </span>
            </header>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-12">
                <label class="form-label" asp-for="Input.Objective">Objetivo (opcional)</label>
                <input class="form-control" asp-for="Input.Objective" />
            </div>
            <div class="col-12">
                <label class="form-label" asp-for="Input.Scope">Alcance (opcional)</label>
                <textarea class="form-control" asp-for="Input.Scope" rows="2"></textarea>
            </div>
            </div>
        </section>
        <details class="hn-form-section" open data-form-optional>
            <summary class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">04</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Detalles adicionales</span>
                    <span class="hn-form-section-hint">Descripción, excepciones de acceso y comentarios internos.</span>
                </span>
            </summary>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-12">
                <label class="form-label" asp-for="Input.Description">Descripcion de actividad (opcional)</label>
                <textarea class="form-control" asp-for="Input.Description" rows="3"></textarea>
            </div>
            <div class="col-12">
                <label class="form-label" asp-for="Input.AccessNotes">Notas internas de acceso (opcional)</label>
                <textarea class="form-control" asp-for="Input.AccessNotes" rows="3" placeholder="Solo excepciones del proyecto. Lo base debe vivir en contratos."></textarea>
            </div>
            <div class="col-12">
                <label class="form-label" asp-for="Input.Comments">Comentarios adicionales (opcional)</label>
                <textarea class="form-control" asp-for="Input.Comments" rows="2"></textarea>
            </div>
            </div>
        </details>
        <details class="hn-form-section" open data-form-optional>
            <summary class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">05</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Primera actividad del Gantt</span>
                    <span class="hn-form-section-hint">Opcional. También puedes agregar actividades desde el proyecto.</span>
                </span>
            </summary>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-md-3">
                <label class="form-label" asp-for="Input.InitialActivityAssignedTo">Otro responsable, si aplica</label>
                <input class="form-control" asp-for="Input.InitialActivityAssignedTo" placeholder="Vacío: usa el responsable del proyecto" />
            </div>
            <div class="col-md-7">
                <label class="form-label" asp-for="Input.InitialActivityDescription">Actividad</label>
                <input class="form-control" asp-for="Input.InitialActivityDescription" placeholder="Descripcion de actividad" />
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="Input.InitialActivityDays">Tiempo (dias)</label>
                <input class="form-control" asp-for="Input.InitialActivityDays" type="number" min="1" max="365" />
            </div>
            </div>
        </details>
    </div>
    <div class="card-footer d-flex flex-wrap gap-2 hn-form-actions">
        <button class="btn btn-primary" type="submit">Crear proyecto</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/hn-related-records.js" asp-append-version="true"></script>
}
