@page
@model HNControl.Web.Pages.Projects.CreateModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Nuevo proyecto</h1>
        <div class="text-muted small">Ligado a cliente · responsable · SLA</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Projects/Index">Volver</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="row g-3">
    <div class="col-lg-9">
        <form method="post" class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Proyecto</span>
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#clientModal">
                    + Nuevo cliente
                </button>
            </div>
            <div class="card-body">

                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                <div class="row g-3">

                    <div class="col-12">
                        <label class="form-label">Nombre del proyecto</label>
                        <input class="form-control" asp-for="Input.Title" />
                        <span class="text-danger small" asp-validation-for="Input.Title"></span>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Cliente</label>
                        <select class="form-select" asp-for="Input.ClientId" asp-items="Model.ClientItems"></select>
                        <span class="text-danger small" asp-validation-for="Input.ClientId"></span>
                        <div class="text-muted small mt-1">Si no existe, usa <b>+ Nuevo cliente</b>.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Responsable</label>
                        <select class="form-select" asp-for="Input.ResponsibleUserId" asp-items="Model.EmployeeItems"></select>
                        <span class="text-danger small" asp-validation-for="Input.ResponsibleUserId"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Fecha inicio</label>
                        <input class="form-control" asp-for="Input.StartDate" type="date" />
                        <span class="text-danger small" asp-validation-for="Input.StartDate"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Término estimado (SLA)</label>
                        <input class="form-control" asp-for="Input.EstimatedEndDate" type="date" />
                        <span class="text-danger small" asp-validation-for="Input.EstimatedEndDate"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Objetivo (opcional)</label>
                        <input class="form-control" asp-for="Input.Objective" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Alcance (opcional)</label>
                        <textarea class="form-control" asp-for="Input.Scope" rows="2"></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Descripción de la actividad (opcional)</label>
                        <textarea class="form-control" asp-for="Input.Description" rows="3"></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Accesos del cliente (opcional)</label>
                        <textarea class="form-control" asp-for="Input.AccessNotes" rows="4" placeholder="Cámaras / WiFi / DVR / IPs / Credenciales..."></textarea>
                        <div class="text-muted small mt-1">Tip: si esto no se cifra, es un buffet para hackers.</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Comentarios adicionales (opcional)</label>
                        <textarea class="form-control" asp-for="Input.Comments" rows="2"></textarea>
                    </div>

                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button class="btn btn-primary" type="submit">Crear proyecto</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Crear cliente -->
<div class="modal fade" id="clientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="clientModalForm" method="post" asp-page-handler="CreateClientAjax">
                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div id="clientModalErrors" class="alert alert-danger d-none"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" asp-for="NewClient.Type">
                                <option value="Moral">Moral</option>
                                <option value="Fisica">Física</option>
                            </select>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Razón Social / Nombre</label>
                            <input class="form-control" asp-for="NewClient.Name" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">RFC</label>
                            <input class="form-control" asp-for="NewClient.Rfc" maxlength="13" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Correo</label>
                            <input class="form-control" asp-for="NewClient.Email" type="email" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Teléfono</label>
                            <input class="form-control" asp-for="NewClient.Phone" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Dirección</label>
                            <textarea class="form-control" asp-for="NewClient.Address" rows="2"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="clientModalSubmit">Crear y seleccionar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const form = document.getElementById('clientModalForm');
            const errorsBox = document.getElementById('clientModalErrors');
            const submitBtn = document.getElementById('clientModalSubmit');
            const clientSelect = document.getElementById('Input_ClientId');

            if (!form || !clientSelect) return;

            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                errorsBox.classList.add('d-none');
                errorsBox.innerHTML = '';

                submitBtn.disabled = true;

                try {
                    const fd = new FormData(form);

                    const res = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: fd
                    });

                    const data = await res.json();

                    if (!data.ok) {
                        const msgs = [];
                        if (data.errors) {
                            for (const k in data.errors) {
                                for (const m of data.errors[k]) msgs.push(m);
                            }
                        }
                        errorsBox.innerHTML = msgs.length ? msgs.map(m => `<div>• ${m}</div>`).join('') : 'Revisa los campos.';
                        errorsBox.classList.remove('d-none');
                        return;
                    }

                    // Agrega opción y selecciónala
                    const opt = new Option(data.name, data.id, true, true);
                    clientSelect.add(opt);
                    clientSelect.value = data.id;

                    // Cierra modal
                    const modalEl = document.getElementById('clientModal');
                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.hide();

                    // Limpia form
                    form.reset();
                }
                catch (err) {
                    errorsBox.innerHTML = 'No se pudo crear el cliente. ' + (err?.message ?? '');
                    errorsBox.classList.remove('d-none');
                }
                finally {
                    submitBtn.disabled = false;
                }
            });
        })();
    </script>
}
