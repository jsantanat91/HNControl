@page "{id:guid}"
@model HNControl.Web.Pages.Projects.CloseModel
@{
    Layout = "_Layout";
}

<h1 class="h4 mb-3">Cerrar proyecto</h1>

<div class="alert alert-warning">
    Vas a cerrar el proyecto: <b>@Model.Title</b>
</div>

<form method="post" class="d-flex gap-2">
    <input type="hidden" asp-for="ProjectId" />
    <button class="btn btn-danger" type="submit">Sí, cerrar</button>
    <a class="btn btn-outline-secondary" asp-page="/Projects/Details" asp-route-id="@Model.ProjectId">Cancelar</a>
</form>
