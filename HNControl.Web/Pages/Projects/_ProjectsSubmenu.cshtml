@inject HNControl.Web.Services.IActionAccessService ActionAccess
@{
    var path = Context?.Request?.Path.Value ?? "";
    bool IsActive(string p) => path.StartsWith(p, StringComparison.OrdinalIgnoreCase);
    var canBase = User.IsInRole(HNControl.Web.Models.AppRoles.SuperAdmin) || User.IsInRole(HNControl.Web.Models.AppRoles.Admin) || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.ProjectsView);
    var canInvest = User.IsInRole(HNControl.Web.Models.AppRoles.SuperAdmin) || User.IsInRole(HNControl.Web.Models.AppRoles.Admin) || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.ProjectsInvestmentsView);
    var canReseller = User.IsInRole(HNControl.Web.Models.AppRoles.SuperAdmin) || User.IsInRole(HNControl.Web.Models.AppRoles.Admin) || await ActionAccess.HasActionAsync(User, HNControl.Web.Models.AppActions.ProjectsResellersView);
}

<nav class="hn-context-tabs" aria-label="Subm&oacute;dulos de proyectos">
        @if (canBase)
        {
            <a class="hn-tab-link @(IsActive("/Projects/Index") ? "active" : "")"
               asp-page="/Projects/Index"><i class="bi bi-kanban hn-tab-icon"></i> Proyectos</a>
        }

        @if (canInvest)
        {
            <a class="hn-tab-link @(IsActive("/Projects/Investments") ? "active" : "")"
               asp-page="/Projects/Investments/Index"><i class="bi bi-cash-coin hn-tab-icon"></i> Inversiones</a>
        }

        @if (canReseller)
        {
            <a class="hn-tab-link @(IsActive("/Projects/Resellers") ? "active" : "")"
               asp-page="/Projects/Resellers/Index"><i class="bi bi-diagram-3 hn-tab-icon"></i> Reseller</a>
        }

</nav>
