@{
    var path = Context?.Request?.Path.Value ?? "";
    bool IsActive(string p) => path.StartsWith(p, StringComparison.OrdinalIgnoreCase);
}

<div class="card shadow-soft hn-hover mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted me-2">Submodulos de proyectos:</span>

        <a class="btn btn-lg project-sub-btn @(IsActive("/Projects/Index") ? "project-sub-btn-active" : "project-sub-btn-projects")"
           asp-page="/Projects/Index">Proyectos</a>

        <a class="btn btn-lg project-sub-btn @(IsActive("/Projects/Investments") ? "project-sub-btn-active" : "project-sub-btn-invest")"
           asp-page="/Projects/Investments/Index">Inversiones</a>

        <a class="btn btn-lg project-sub-btn @(IsActive("/Projects/Resellers") ? "project-sub-btn-active" : "project-sub-btn-reseller")"
           asp-page="/Projects/Resellers/Index">Reseller</a>

        <a class="btn btn-lg project-sub-btn @(IsActive("/Projects/Delivery") ? "project-sub-btn-active" : "project-sub-btn-delivery")"
           asp-page="/Projects/Delivery/Index">Formato de entrega</a>

        <a class="btn btn-lg project-sub-btn @(IsActive("/Projects/Sales") ? "project-sub-btn-active" : "project-sub-btn-sales")"
           asp-page="/Projects/Sales/Index">Ventas</a>

        <a class="btn btn-lg project-sub-btn @(IsActive("/Projects/Billing") ? "project-sub-btn-active" : "project-sub-btn-billing")"
           asp-page="/Projects/Billing/Index">Facturacion</a>
    </div>
</div>

<style>
    .project-sub-btn {
        border-radius: 999px;
        padding: .55rem 1.05rem;
        font-weight: 700;
        letter-spacing: .02em;
    }

    .project-sub-btn-projects {
        border-color: #2563eb;
        color: #1d4ed8;
        background: linear-gradient(135deg, rgba(59,130,246,.17), rgba(96,165,250,.10));
    }

    .project-sub-btn-invest {
        border-color: #0f766e;
        color: #0f766e;
        background: linear-gradient(135deg, rgba(20,184,166,.17), rgba(45,212,191,.08));
    }

    .project-sub-btn-reseller {
        border-color: #9333ea;
        color: #7e22ce;
        background: linear-gradient(135deg, rgba(168,85,247,.15), rgba(196,181,253,.08));
    }

    .project-sub-btn-delivery {
        border-color: #b45309;
        color: #92400e;
        background: linear-gradient(135deg, rgba(245,158,11,.22), rgba(251,191,36,.10));
    }

    .project-sub-btn-sales {
        border-color: #be123c;
        color: #9f1239;
        background: linear-gradient(135deg, rgba(244,63,94,.20), rgba(251,113,133,.10));
    }

    .project-sub-btn-billing {
        border-color: #1d4ed8;
        color: #1e3a8a;
        background: linear-gradient(135deg, rgba(14,116,144,.20), rgba(59,130,246,.11));
    }

    .project-sub-btn-active {
        border-color: #1d4ed8;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 10px 24px rgba(37,99,235,.26);
    }
</style>
