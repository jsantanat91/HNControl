@page
@using HNControl.Web.Models
@using System.Text.Json
@model HNControl.Web.Pages.Projects.Billing.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Facturacion";
    var openModal = (Model.OpenModal ?? string.Empty).Trim();
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 m-0">Facturacion</h1>
        <div class="text-muted small">Programacion, sincronizacion CFDI SAT, cancelacion y envio con PDF.</div>
    </div>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoPlanModal">+ Nuevo plan</button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Flash))
{
    <div class="alert alert-@(Model.FlashType ?? "info")">@Model.Flash</div>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Planes activos</div><div class="fs-4 fw-bold">@Model.ActivePlans</div></div></div></div>
    <div class="col-12 col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Facturas pendientes</div><div class="fs-4 fw-bold">@Model.PendingRuns</div></div></div></div>
    <div class="col-12 col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Proyeccion mensual</div><div class="fs-4 fw-bold">@Model.MonthlyProjection.ToString("C")</div></div></div></div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button class="btn btn-outline-success" type="button" data-bs-toggle="modal" data-bs-target="#emitidasModal">Facturas emitidas</button>
    <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#ejecucionesModal">Ejecuciones</button>
    <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#bitacoraModal">Bitacora</button>
</div>

<div class="row g-3">
@if (!Model.Plans.Any())
{
    <div class="col-12"><div class="card"><div class="card-body text-muted">Sin planes activos.</div></div></div>
}
else
{
    @foreach (var p in Model.Plans)
    {
        <div class="col-12 col-lg-6">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-semibold">@p.Client</div>
                            <div class="small text-muted">@p.Concept</div>
                            @if (!string.IsNullOrWhiteSpace(p.ContractName))
                            {
                                <div class="small"><span class="badge text-bg-light border">Contrato: @p.ContractName</span></div>
                            }
                        </div>
                        <div class="text-end">
                            <div class="fw-semibold">@p.Total.ToString("C")</div>
                            <span class="badge @(p.Status == nameof(BillingPlanStatus.Active) ? "text-bg-success" : "text-bg-secondary")">@p.Status</span>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        @p.Periodicity · Fecha factura: @p.InvoiceIssueDate.ToString("yyyy-MM-dd") · Proxima: @p.NextRunDate.ToString("yyyy-MM-dd")
                    </div>
                    <div class="small text-muted">@p.SendToEmail · Lineas: @p.LinesCount · Contrato (meses): @p.ContractMonths</div>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <form method="post" asp-page-handler="MarkSent">
                            <input type="hidden" name="planId" value="@p.Id" />
                            <button class="btn btn-sm btn-outline-primary" type="submit">Marcar enviado</button>
                        </form>
                        <form method="post" asp-page-handler="ToggleStatus">
                            <input type="hidden" name="planId" value="@p.Id" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Pausar</button>
                        </form>
                        <button class="btn btn-sm btn-outline-warning"
                                type="button"
                                data-edit-plan-btn
                                data-plan-id="@p.Id"
                                data-concept="@p.Concept"
                                data-periodicity="@p.Periodicity"
                                data-start="@p.StartDate.ToString("yyyy-MM-dd")"
                                data-issue="@p.InvoiceIssueDate.ToString("yyyy-MM-dd")"
                                data-contract-months="@p.ContractMonths"
                                data-email="@p.SendToEmail"
                                data-cc="@p.CcEmails"
                                data-notes="@p.Notes"
                                data-bs-toggle="modal"
                                data-bs-target="#editarPlanModal">Editar</button>
                        <form method="post" asp-page-handler="DeletePlan" onsubmit="return confirm('Eliminar plan?')">
                            <input type="hidden" name="planId" value="@p.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                        </form>
                        <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="modal" data-bs-target="#planDetailModal-@p.Id">Ver detalle</button>
                        @if (p.LatestPdfRunId.HasValue)
                        {
                            <a class="btn btn-sm btn-outline-success" asp-page="./Index" asp-page-handler="DownloadPdf" asp-route-runId="@p.LatestPdfRunId.Value">PDF</a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <script type="application/json" id="plan-lines-@p.Id">@Html.Raw(JsonSerializer.Serialize(p.Lines.Select(x => new { category = x.Category, concept = x.Concept, quantity = x.Quantity, unitPrice = x.UnitPrice, vatRate = x.Subtotal > 0 ? (x.VatAmount / x.Subtotal) : 0.16m })))</script>
    }
}
</div>

@if (Model.PlansTotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm">
        @for (var i = 1; i <= Model.PlansTotalPages; i++)
        {
            <li class="page-item @(i == Model.PlansPage ? "active" : "")">
                <a class="page-link" asp-page="./Index" asp-route-plansPage="@i" asp-route-runsPage="@Model.RunsPage" asp-route-auditPage="@Model.AuditPage">@i</a>
            </li>
        }
    </ul></nav>
}

@foreach (var p in Model.Plans)
{
    <div class="modal fade" id="planDetailModal-@p.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalle del plan · @p.Client</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="small text-muted mb-2">@p.Concept</div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Categoria</th><th>Concepto</th><th class="text-end">Cant</th><th class="text-end">P. Unit</th><th class="text-end">Subtotal</th><th class="text-end">IVA</th><th class="text-end">Total</th></tr></thead>
                            <tbody>
                            @if (p.Lines.Count == 0)
                            {
                                <tr><td colspan="7" class="text-muted small">Sin lineas registradas.</td></tr>
                            }
                            else
                            {
                                @foreach (var line in p.Lines)
                                {
                                    <tr>
                                        <td>@line.Category</td>
                                        <td>@line.Concept</td>
                                        <td class="text-end">@line.Quantity</td>
                                        <td class="text-end">@line.UnitPrice.ToString("C")</td>
                                        <td class="text-end">@line.Subtotal.ToString("C")</td>
                                        <td class="text-end">@line.VatAmount.ToString("C")</td>
                                        <td class="text-end fw-semibold">@line.Total.ToString("C")</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="nuevoPlanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo plan de facturacion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CreatePlan">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-4"><label class="form-label">Cliente</label><select class="form-select" asp-for="Input.ClientId" asp-items="Model.ClientItems"></select></div>
                        <div class="col-12 col-md-4"><label class="form-label">Origen venta</label><select class="form-select" asp-for="Input.SalesOpportunityId" asp-items="Model.OpportunityItems"><option value="">-- Sin oportunidad --</option></select></div>
                        <div class="col-12 col-md-4"><label class="form-label">Contrato (origen)</label><select class="form-select" asp-for="Input.ContractId" asp-items="Model.ContractItems"><option value="">-- Sin contrato --</option></select></div>
                        <div class="col-12 col-md-4"><label class="form-label">Cotizacion (opcional)</label><select class="form-select" asp-for="Input.QuoteRequestId" asp-items="Model.QuoteItems"><option value="">-- Sin cotizacion --</option></select></div>
                        <div class="col-12 col-md-8"><label class="form-label">Concepto general</label><input class="form-control" asp-for="Input.Concept" /></div>

                        <div class="col-12"><label class="form-label fw-semibold">Lineas del plan</label></div>
                        <div class="col-12">
                            <div id="billing-lines">
                                <div class="row g-2 billing-line mb-2">
                                    <div class="col-12 col-md-2"><input class="form-control" name="InputLines[0].Category" placeholder="Categoria" value="Servicio" /></div>
                                    <div class="col-12 col-md-5"><input class="form-control" name="InputLines[0].Concept" placeholder="Concepto" /></div>
                                    <div class="col-6 col-md-1"><input class="form-control" name="InputLines[0].Quantity" type="number" min="1" value="1" /></div>
                                    <div class="col-6 col-md-2"><input class="form-control" name="InputLines[0].UnitPrice" type="number" step="0.01" min="0" value="0" /></div>
                                    <div class="col-6 col-md-1"><input class="form-control" name="InputLines[0].VatRate" type="number" step="0.01" min="0" max="1" value="0.16" /></div>
                                    <div class="col-6 col-md-1 d-grid"><button class="btn btn-outline-danger" type="button" data-remove-line>×</button></div>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" type="button" id="add-billing-line">+ Agregar linea</button>
                        </div>

                        <div class="col-12">
                            <div class="row g-2">
                                <div class="col-12 col-md-4"><div class="border rounded-3 p-2"><div class="small text-muted">Subtotal (preview)</div><div class="fw-semibold" id="preview-subtotal">$0.00</div></div></div>
                                <div class="col-12 col-md-4"><div class="border rounded-3 p-2"><div class="small text-muted">IVA (preview)</div><div class="fw-semibold" id="preview-iva">$0.00</div></div></div>
                                <div class="col-12 col-md-4"><div class="border rounded-3 p-2"><div class="small text-muted">Total (preview)</div><div class="fw-bold text-primary" id="preview-total">$0.00</div></div></div>
                            </div>
                        </div>

                        <div class="col-12 col-md-3"><label class="form-label">Periodicidad</label><select class="form-select" asp-for="Input.Periodicity" asp-items="Model.PeriodicityItems"></select></div>
                        <div class="col-12 col-md-3"><label class="form-label">Inicio</label><input class="form-control" asp-for="Input.StartDate" type="date" /></div>
                        <div class="col-12 col-md-3"><label class="form-label">Fecha de factura</label><input class="form-control" asp-for="Input.InvoiceIssueDate" type="date" /></div>
                        <div class="col-12 col-md-3"><label class="form-label">Contrato (meses)</label><input class="form-control" asp-for="Input.ContractMonths" type="number" min="1" /></div>

                        <div class="col-12 col-md-3"><label class="form-label">Tipo CFDI (SAT)</label><select class="form-select" asp-for="Input.InvoiceType" asp-items="Html.GetEnumSelectList<BillingInvoiceType>()"></select></div>
                        <div class="col-12 col-md-3"><label class="form-label">Uso CFDI</label><select class="form-select" asp-for="Input.CfdiUseCode">@foreach (var it in SatCatalogs.UsoCfdi){<option value="@it.Code">@it.Code - @it.Label</option>}</select></div>
                        <div class="col-12 col-md-3"><label class="form-label">Regimen fiscal</label><select class="form-select" asp-for="Input.FiscalRegimeCode">@foreach (var it in SatCatalogs.RegimenFiscal){<option value="@it.Code">@it.Code - @it.Label</option>}</select></div>
                        <div class="col-12 col-md-3"><label class="form-label">Metodo pago</label><select class="form-select" asp-for="Input.PaymentMethodCode">@foreach (var it in SatCatalogs.MetodoPago){<option value="@it.Code">@it.Code - @it.Label</option>}</select></div>
                        <div class="col-12 col-md-3"><label class="form-label">Forma pago</label><select class="form-select" asp-for="Input.PaymentFormCode">@foreach (var it in SatCatalogs.FormaPago){<option value="@it.Code">@it.Code - @it.Label</option>}</select></div>
                        <div class="col-12 col-md-4"><label class="form-label">Correo destino</label><input class="form-control" asp-for="Input.SendToEmail" /></div>
                        <div class="col-12 col-md-5"><label class="form-label">CC (separados por coma)</label><input class="form-control" asp-for="Input.CcEmails" /></div>
                        <div class="col-12"><label class="form-label">Notas</label><textarea class="form-control" asp-for="Input.Notes" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary" type="submit">Crear plan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editarPlanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar plan de facturación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="UpdatePlan" id="editPlanForm">
                <input type="hidden" name="planId" id="edit-plan-id" />
                <input type="hidden" name="linesJson" id="edit-lines-json" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-8"><label class="form-label">Concepto general</label><input class="form-control" name="concept" id="edit-concept" /></div>
                        <div class="col-12 col-md-4"><label class="form-label">Periodicidad</label><select class="form-select" name="periodicity" id="edit-periodicity" asp-items="Model.PeriodicityItems"></select></div>
                        <div class="col-12 col-md-4"><label class="form-label">Inicio</label><input class="form-control" name="startDate" id="edit-start" type="date" /></div>
                        <div class="col-12 col-md-4"><label class="form-label">Fecha de factura</label><input class="form-control" name="invoiceIssueDate" id="edit-issue" type="date" /></div>
                        <div class="col-12 col-md-4"><label class="form-label">Contrato (meses)</label><input class="form-control" name="contractMonths" id="edit-contract-months" type="number" min="1" /></div>
                        <div class="col-12 col-md-6"><label class="form-label">Correo destino</label><input class="form-control" name="sendToEmail" id="edit-email" /></div>
                        <div class="col-12 col-md-6"><label class="form-label">CC (separados por coma)</label><input class="form-control" name="ccEmails" id="edit-cc" /></div>
                        <div class="col-12"><label class="form-label">Notas</label><textarea class="form-control" name="notes" id="edit-notes" rows="2"></textarea></div>

                        <div class="col-12"><label class="form-label fw-semibold">Líneas del plan</label></div>
                        <div class="col-12">
                            <div id="edit-billing-lines"></div>
                            <button class="btn btn-sm btn-outline-primary" type="button" id="add-edit-billing-line">+ Agregar línea</button>
                        </div>

                        <div class="col-12">
                            <div class="row g-2">
                                <div class="col-12 col-md-4"><div class="border rounded-3 p-2"><div class="small text-muted">Subtotal (preview)</div><div class="fw-semibold" id="edit-preview-subtotal">$0.00</div></div></div>
                                <div class="col-12 col-md-4"><div class="border rounded-3 p-2"><div class="small text-muted">IVA (preview)</div><div class="fw-semibold" id="edit-preview-iva">$0.00</div></div></div>
                                <div class="col-12 col-md-4"><div class="border rounded-3 p-2"><div class="small text-muted">Total (preview)</div><div class="fw-bold text-primary" id="edit-preview-total">$0.00</div></div></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary" type="submit">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="ejecucionesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Ejecuciones (historial)</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Cliente</th><th>Periodo</th><th>Fecha</th><th>Status</th><th>CFDI SAT</th><th>Correo</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Runs)
                    {
                        <tr>
                            <td>@r.Client<div class="small text-muted">@r.Concept</div></td>
                            <td>@r.PeriodLabel</td>
                            <td>@r.ScheduledFor.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge @(r.Status == nameof(BillingRunStatus.Sent) ? "text-bg-success" : "text-bg-warning")">@r.Status</span></td>
                            <td><span class="badge text-bg-light border">@r.CfdiStatus</span></td>
                            <td>@r.Email</td>
                            <td class="text-end">
                                @if (r.HasPdf){<a class="btn btn-sm btn-outline-primary" asp-page="./Index" asp-page-handler="DownloadPdf" asp-route-runId="@r.Id">PDF</a>}
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.RunsTotalPages > 1)
            {
                <nav class="mt-3"><ul class="pagination pagination-sm">
                    @for (var i = 1; i <= Model.RunsTotalPages; i++)
                    {
                        <li class="page-item @(i == Model.RunsPage ? "active" : "")"><a class="page-link" asp-page="./Index" asp-route-plansPage="@Model.PlansPage" asp-route-runsPage="@i" asp-route-auditPage="@Model.AuditPage" asp-route-openModal="runs">@i</a></li>
                    }
                </ul></nav>
            }
        </div>
    </div></div>
</div>

<div class="modal fade" id="emitidasModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Facturas emitidas</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            @if (!Model.EmittedRuns.Any())
            {
                <div class="text-muted small">No hay facturas emitidas.</div>
            }
            else
            {
                <div class="row g-2">
                    @foreach (var r in Model.EmittedRuns)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="card border h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-semibold">@r.Client</div>
                                            <div class="small text-muted">@r.Concept</div>
                                        </div>
                                        <span class="badge @(r.IsPaid ? "text-bg-success" : "text-bg-warning")">@(r.IsPaid ? "Pagada" : "Pendiente pago")</span>
                                    </div>
                                    <div class="small mt-2">Periodo: @r.PeriodLabel · Fecha: @r.ScheduledFor.ToString("yyyy-MM-dd")</div>
                                    <div class="small text-muted">CFDI: @r.CfdiStatus @(string.IsNullOrWhiteSpace(r.CfdiUuid) ? "" : $"· {r.CfdiUuid}")</div>
                                    @if (r.IsPaid && r.PaidAt.HasValue)
                                    {
                                        <div class="small text-success">Pagada: @r.PaidAt.Value.ToString("yyyy-MM-dd") · Forma @r.PaymentFormCode · Método @r.PaymentMethodCode</div>
                                    }
                                    <div class="d-flex flex-wrap gap-2 mt-3">
                                        @if (r.HasPdf)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" asp-page="./Index" asp-page-handler="DownloadPdf" asp-route-runId="@r.Id">PDF</a>
                                        }
                                        @if (!r.IsPaid)
                                        {
                                            <button class="btn btn-sm btn-outline-success"
                                                    type="button"
                                                    data-mark-paid-btn
                                                    data-run-id="@r.Id"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#marcarPagadaModal">Pagada</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div></div>
</div>

<div class="modal fade" id="marcarPagadaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Registrar pago</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <form method="post" asp-page-handler="MarkPaid">
            <div class="modal-body">
                <input type="hidden" asp-for="PaymentInput.RunId" id="payment-run-id" />
                <div class="mb-2">
                    <label class="form-label">Fecha de pago</label>
                    <input class="form-control" asp-for="PaymentInput.PaidAt" type="date" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Forma de pago (SAT)</label>
                    <select class="form-select" asp-for="PaymentInput.PaymentFormCode">
                        @foreach (var it in SatCatalogs.FormaPago)
                        {
                            <option value="@it.Code">@it.Code - @it.Label</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Método de pago (SAT)</label>
                    <select class="form-select" asp-for="PaymentInput.PaymentMethodCode">
                        @foreach (var it in SatCatalogs.MetodoPago)
                        {
                            <option value="@it.Code">@it.Code - @it.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label">Notas (opcional)</label>
                    <textarea class="form-control" asp-for="PaymentInput.Notes" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" type="submit">Guardar pago</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="bitacoraModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Bitacora de facturacion</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            @if (!Model.Audits.Any())
            {
                <div class="text-muted small">Sin eventos.</div>
            }
            else
            {
                <div class="vstack gap-2">
                    @foreach (var a in Model.Audits)
                    {
                        <div class="border rounded-3 p-2">
                            <div class="d-flex justify-content-between gap-2">
                                <span class="fw-semibold">@a.EventType</span>
                                <span class="small text-muted">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <div class="small">@a.Client</div>
                            <div class="small text-muted">@a.Details</div>
                            <div class="small text-muted">Usuario: @a.UserName</div>
                        </div>
                    }
                </div>
            }
            @if (Model.AuditsTotalPages > 1)
            {
                <nav class="mt-3"><ul class="pagination pagination-sm">
                    @for (var i = 1; i <= Model.AuditsTotalPages; i++)
                    {
                        <li class="page-item @(i == Model.AuditPage ? "active" : "")"><a class="page-link" asp-page="./Index" asp-route-plansPage="@Model.PlansPage" asp-route-runsPage="@Model.RunsPage" asp-route-auditPage="@i" asp-route-openModal="audit">@i</a></li>
                    }
                </ul></nav>
            }
        </div>
    </div></div>
</div>

@section Scripts{
<script>
(() => {
  const openModal = '@openModal';
  const container = document.getElementById('billing-lines');
  const addBtn = document.getElementById('add-billing-line');
  const subtotalEl = document.getElementById('preview-subtotal');
  const ivaEl = document.getElementById('preview-iva');
  const totalEl = document.getElementById('preview-total');
  const editContainer = document.getElementById('edit-billing-lines');
  const editAddBtn = document.getElementById('add-edit-billing-line');
  const editSubtotalEl = document.getElementById('edit-preview-subtotal');
  const editIvaEl = document.getElementById('edit-preview-iva');
  const editTotalEl = document.getElementById('edit-preview-total');
  const editLinesJsonInput = document.getElementById('edit-lines-json');

  const currency = (v) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v || 0);
  const numberOrZero = (v) => {
    const n = parseFloat(v);
    return Number.isFinite(n) ? n : 0;
  };

  const calcPreview = () => {
    if (!container || !subtotalEl || !ivaEl || !totalEl) return;
    let subtotal = 0;
    let iva = 0;
    container.querySelectorAll('.billing-line').forEach((row) => {
      const qty = Math.max(1, numberOrZero(row.querySelector('input[name*=".Quantity"]')?.value));
      const unit = Math.max(0, numberOrZero(row.querySelector('input[name*=".UnitPrice"]')?.value));
      const vat = Math.max(0, Math.min(1, numberOrZero(row.querySelector('input[name*=".VatRate"]')?.value)));
      const lineSubtotal = qty * unit;
      subtotal += lineSubtotal;
      iva += lineSubtotal * vat;
    });
    subtotalEl.textContent = currency(subtotal);
    ivaEl.textContent = currency(iva);
    totalEl.textContent = currency(subtotal + iva);
  };

  const calcPreviewFor = (targetContainer, targetSubtotalEl, targetIvaEl, targetTotalEl) => {
    if (!targetContainer || !targetSubtotalEl || !targetIvaEl || !targetTotalEl) return { subtotal: 0, iva: 0, total: 0 };
    let subtotal = 0;
    let iva = 0;
    targetContainer.querySelectorAll('.billing-line').forEach((row) => {
      const qty = Math.max(1, numberOrZero(row.querySelector('input[name*=\".Quantity\"]')?.value));
      const unit = Math.max(0, numberOrZero(row.querySelector('input[name*=\".UnitPrice\"]')?.value));
      const vat = Math.max(0, Math.min(1, numberOrZero(row.querySelector('input[name*=\".VatRate\"]')?.value)));
      const lineSubtotal = qty * unit;
      subtotal += lineSubtotal;
      iva += lineSubtotal * vat;
    });
    targetSubtotalEl.textContent = currency(subtotal);
    targetIvaEl.textContent = currency(iva);
    targetTotalEl.textContent = currency(subtotal + iva);
    return { subtotal, iva, total: subtotal + iva };
  };

  const makeLineHtml = (idx, line = {}) => `
    <div class=\"row g-2 billing-line mb-2\">
      <div class=\"col-12 col-md-2\"><input class=\"form-control\" name=\"InputLines[${idx}].Category\" placeholder=\"Categoria\" value=\"${line.category ?? 'Servicio'}\" /></div>
      <div class=\"col-12 col-md-5\"><input class=\"form-control\" name=\"InputLines[${idx}].Concept\" placeholder=\"Concepto\" value=\"${line.concept ?? ''}\" /></div>
      <div class=\"col-6 col-md-1\"><input class=\"form-control\" name=\"InputLines[${idx}].Quantity\" type=\"number\" min=\"1\" value=\"${line.quantity ?? 1}\" /></div>
      <div class=\"col-6 col-md-2\"><input class=\"form-control\" name=\"InputLines[${idx}].UnitPrice\" type=\"number\" step=\"0.01\" min=\"0\" value=\"${line.unitPrice ?? 0}\" /></div>
      <div class=\"col-6 col-md-1\"><input class=\"form-control\" name=\"InputLines[${idx}].VatRate\" type=\"number\" step=\"0.01\" min=\"0\" max=\"1\" value=\"${line.vatRate ?? 0.16}\" /></div>
      <div class=\"col-6 col-md-1 d-grid\"><button class=\"btn btn-outline-danger\" type=\"button\" data-remove-line>×</button></div>
    </div>`;

  if (container && addBtn) {
    let idx = container.querySelectorAll('.billing-line').length;
    addBtn.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'row g-2 billing-line mb-2';
      row.innerHTML = `
        <div class="col-12 col-md-2"><input class="form-control" name="InputLines[${idx}].Category" placeholder="Categoria" value="Servicio" /></div>
        <div class="col-12 col-md-5"><input class="form-control" name="InputLines[${idx}].Concept" placeholder="Concepto" /></div>
        <div class="col-6 col-md-1"><input class="form-control" name="InputLines[${idx}].Quantity" type="number" min="1" value="1" /></div>
        <div class="col-6 col-md-2"><input class="form-control" name="InputLines[${idx}].UnitPrice" type="number" step="0.01" min="0" value="0" /></div>
        <div class="col-6 col-md-1"><input class="form-control" name="InputLines[${idx}].VatRate" type="number" step="0.01" min="0" max="1" value="0.16" /></div>
        <div class="col-6 col-md-1 d-grid"><button class="btn btn-outline-danger" type="button" data-remove-line>×</button></div>`;
      container.appendChild(row);
      idx++;
      calcPreview();
    });

    container.addEventListener('click', (ev) => {
      const btn = ev.target.closest('[data-remove-line]');
      if (!btn) return;
      const line = btn.closest('.billing-line');
      if (line && container.querySelectorAll('.billing-line').length > 1) line.remove();
      calcPreview();
    });

    container.addEventListener('input', (ev) => {
      if (ev.target.closest('.billing-line')) calcPreview();
    });

    calcPreview();
  }

  const buildEditLinesPayload = () => {
    if (!editContainer) return [];
    return [...editContainer.querySelectorAll('.billing-line')].map((row) => ({
      category: row.querySelector('input[name*=\".Category\"]')?.value || 'Servicio',
      concept: row.querySelector('input[name*=\".Concept\"]')?.value || '',
      quantity: Math.max(1, numberOrZero(row.querySelector('input[name*=\".Quantity\"]')?.value)),
      unitPrice: Math.max(0, numberOrZero(row.querySelector('input[name*=\".UnitPrice\"]')?.value)),
      vatRate: Math.max(0, Math.min(1, numberOrZero(row.querySelector('input[name*=\".VatRate\"]')?.value)))
    })).filter(x => (x.concept || '').trim() !== '');
  };

  if (editContainer && editAddBtn) {
    let editIdx = 0;
    const recalcEdit = () => {
      calcPreviewFor(editContainer, editSubtotalEl, editIvaEl, editTotalEl);
      const payload = buildEditLinesPayload();
      if (editLinesJsonInput) editLinesJsonInput.value = JSON.stringify(payload);
    };

    editAddBtn.addEventListener('click', () => {
      const wrapper = document.createElement('div');
      wrapper.innerHTML = makeLineHtml(editIdx++);
      editContainer.appendChild(wrapper.firstElementChild);
      recalcEdit();
    });

    editContainer.addEventListener('click', (ev) => {
      const btn = ev.target.closest('[data-remove-line]');
      if (!btn) return;
      const line = btn.closest('.billing-line');
      if (line && editContainer.querySelectorAll('.billing-line').length > 1) line.remove();
      recalcEdit();
    });

    editContainer.addEventListener('input', (ev) => {
      if (ev.target.closest('.billing-line')) recalcEdit();
    });

    document.querySelectorAll('[data-edit-plan-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const planId = btn.getAttribute('data-plan-id');
        const linesScript = document.getElementById(`plan-lines-${planId}`);
        let lines = [];
        if (linesScript?.textContent) {
          try { lines = JSON.parse(linesScript.textContent); } catch { lines = []; }
        }
        if (!Array.isArray(lines) || lines.length === 0) lines = [{ category: 'Servicio', concept: '', quantity: 1, unitPrice: 0, vatRate: 0.16 }];

        document.getElementById('edit-plan-id').value = planId || '';
        document.getElementById('edit-concept').value = btn.getAttribute('data-concept') || '';
        document.getElementById('edit-periodicity').value = btn.getAttribute('data-periodicity') || 'Monthly';
        document.getElementById('edit-start').value = btn.getAttribute('data-start') || '';
        document.getElementById('edit-issue').value = btn.getAttribute('data-issue') || '';
        document.getElementById('edit-contract-months').value = btn.getAttribute('data-contract-months') || '';
        document.getElementById('edit-email').value = btn.getAttribute('data-email') || '';
        document.getElementById('edit-cc').value = btn.getAttribute('data-cc') || '';
        document.getElementById('edit-notes').value = btn.getAttribute('data-notes') || '';

        editContainer.innerHTML = '';
        editIdx = 0;
        lines.forEach((line) => {
          const wrapper = document.createElement('div');
          wrapper.innerHTML = makeLineHtml(editIdx++, line);
          editContainer.appendChild(wrapper.firstElementChild);
        });
        recalcEdit();
      });
    });

    const editForm = document.getElementById('editPlanForm');
    if (editForm) {
      editForm.addEventListener('submit', () => {
        const payload = buildEditLinesPayload();
        if (editLinesJsonInput) editLinesJsonInput.value = JSON.stringify(payload);
      });
    }
  }

  if (window.bootstrap && openModal) {
    if (openModal === 'runs') {
      const modal = document.getElementById('ejecucionesModal');
      if (modal) bootstrap.Modal.getOrCreateInstance(modal).show();
    } else if (openModal === 'emitted') {
      const modal = document.getElementById('emitidasModal');
      if (modal) bootstrap.Modal.getOrCreateInstance(modal).show();
    } else if (openModal === 'audit') {
      const modal = document.getElementById('bitacoraModal');
      if (modal) bootstrap.Modal.getOrCreateInstance(modal).show();
    } else if (openModal === 'newPlan') {
      const modal = document.getElementById('nuevoPlanModal');
      if (modal) bootstrap.Modal.getOrCreateInstance(modal).show();
    }
  }

  document.querySelectorAll('[data-mark-paid-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const runId = btn.getAttribute('data-run-id') || '';
      const input = document.getElementById('payment-run-id');
      if (input) input.value = runId;
    });
  });
})();
</script>
}


