@page
@model HNControl.Web.Pages.Projects.IndexModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Proyectos</h1>
        <div class="text-muted small">SLA por fecha estimada + responsable</div>
    </div>

    @if (User.IsInRole(AppRoles.Admin))
    {
        <a class="btn btn-primary" asp-page="/Projects/Create">+ Nuevo proyecto</a>
    }
</div>

<div class="card shadow-sm hn-hover hn-hover">
    <div class="card-body table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Cliente</th>
                    <th>Responsable</th>
                    <th>Inicio</th>
                    <th>Estimado</th>
                    <th>Status</th>
                    <th>SLA</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Rows)
                {
                    <tr class="@(p.IsOverdue ? "table-warning" : "")">
                        <td>@p.Title</td>
                        <td>@p.ClientName</td>
                        <td>@p.Responsible</td>
                        <td>@p.StartDate</td>
                        <td>@p.EstEnd</td>
                        <td>@p.Status</td>
                        <td>@(p.IsOverdue ? "Vencido" : "OK")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Projects/Details" asp-route-id="@p.Id">Abrir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
