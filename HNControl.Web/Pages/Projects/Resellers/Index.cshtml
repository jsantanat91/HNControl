@page
@model HNControl.Web.Pages.Projects.Resellers.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reseller";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Reseller</h1>
        <div class="text-muted small">Comisiones de ventas ligadas a ordenes y cotizaciones.</div>
    </div>
</div>

<partial name="/Pages/Projects/_ProjectsSubmenu.cshtml" />

@if (!string.IsNullOrWhiteSpace(Model.Flash))
{
    <div class="alert alert-info py-2">@Model.Flash</div>
}

<div class="card shadow-soft hn-hover mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2" id="resellerSectionNav">
            <button class="btn btn-lg btn-primary section-btn" type="button" data-section="sectionPartner">Nuevo reseller</button>
            <button class="btn btn-lg btn-outline-primary section-btn" type="button" data-section="sectionCommission">Nuevo plan de comision</button>
            <button class="btn btn-lg btn-outline-success section-btn" type="button" data-section="sectionPartnersList">Resellers</button>
            <button class="btn btn-lg btn-outline-info section-btn" type="button" data-section="sectionCommissions">Comisiones</button>
            <button class="btn btn-lg btn-outline-warning section-btn" type="button" data-section="sectionPayments">Pagos</button>
        </div>
    </div>
</div>

<section id="sectionPartner" class="reseller-section">
    <form method="post" asp-page-handler="CreatePartner" class="card shadow-soft hn-hover">
        <div class="card-header fw-semibold">Nuevo reseller</div>
        <div class="card-body row g-2">
            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <select class="form-select" asp-for="InputPartner.PartyType" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.ResellerPartyType>()"></select>
            </div>
            <div class="col-md-8">
                <label class="form-label">Empleado (si aplica)</label>
                <select class="form-select" asp-for="InputPartner.EmployeeUserId" asp-items="Model.EmployeeItems">
                    <option value="">-- No aplica --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Nombre externo</label>
                <input class="form-control" asp-for="InputPartner.FullName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Correo</label>
                <input class="form-control" asp-for="InputPartner.Email" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Telefono</label>
                <input class="form-control" asp-for="InputPartner.Phone" />
            </div>
            <div class="col-12">
                <label class="form-label">Notas</label>
                <input class="form-control" asp-for="InputPartner.Notes" />
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-primary" type="submit">Guardar reseller</button>
        </div>
    </form>
</section>

<section id="sectionCommission" class="reseller-section d-none">
    <form method="post" asp-page-handler="CreateCommission" class="card shadow-soft hn-hover">
        <div class="card-header fw-semibold">Nuevo plan de comision</div>
        <div class="card-body row g-2">
            <div class="col-md-6">
                <label class="form-label">Reseller</label>
                <select class="form-select" asp-for="InputCommission.PartnerId" asp-items="Model.PartnerItems"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Origen</label>
                <select class="form-select" asp-for="InputCommission.SourceType" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.ResellerSourceType>()"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Orden de servicio</label>
                <select class="form-select" asp-for="InputCommission.ServiceOrderId" asp-items="Model.ServiceOrderItems">
                    <option value="">-- Selecciona --</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Cotizacion</label>
                <select class="form-select" asp-for="InputCommission.QuoteRequestId" asp-items="Model.QuoteItems">
                    <option value="">-- Selecciona --</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Descripcion</label>
                <input class="form-control" asp-for="InputCommission.Description" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Monto base</label>
                <input class="form-control" asp-for="InputCommission.BaseAmount" />
            </div>
            <div class="col-md-3">
                <label class="form-label">% comision</label>
                <input class="form-control" asp-for="InputCommission.CommissionPercentHuman" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Periodicidad</label>
                <select class="form-select" asp-for="InputCommission.Periodicity" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.ResellerCommissionPeriodicity>()"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label">N. periodos</label>
                <input class="form-control" asp-for="InputCommission.PeriodCount" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Inicio</label>
                <input class="form-control" asp-for="InputCommission.StartDate" type="date" />
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-primary" type="submit">Crear comision</button>
        </div>
    </form>
</section>

<section id="sectionPartnersList" class="reseller-section d-none">
    <div class="row g-3">
        @foreach (var p in Model.Partners)
        {
            <div class="col-12 col-lg-6 col-xxl-4">
                <div class="card shadow-soft hn-hover h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div class="fw-semibold">@p.Name</div>
                            <span class="badge @(p.Type == HNControl.Web.Models.ResellerPartyType.Employee ? "bg-primary" : "bg-secondary")">@p.Type</span>
                        </div>
                        <div class="small text-muted">@p.Email</div>
                        <div class="small text-muted mb-2">Pendiente: @p.PendingAmount.ToString("C")</div>
                        <div class="d-flex gap-2">
                            <span class="hn-chip hn-chip-type">Planes: @p.ActivePlans</span>
                            <span class="hn-chip hn-chip-neutral">Contacto: @(string.IsNullOrWhiteSpace(p.Email) ? "Sin correo" : "Con correo")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section id="sectionCommissions" class="reseller-section d-none">
    <div class="row g-3">
        @foreach (var c in Model.Commissions)
        {
            <div class="col-12 col-xl-6">
                <div class="card shadow-soft hn-hover h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="fw-semibold">@c.PartnerName</div>
                                <div class="text-muted small">@c.Description</div>
                            </div>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cerrado</span>
                            }
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="hn-chip hn-chip-type">@c.SourceType</span>
                            <span class="hn-chip hn-chip-neutral">Inicio: @c.StartDate.ToString("yyyy-MM-dd")</span>
                            <span class="hn-chip hn-chip-neutral">Comision: @c.CommissionAmount.ToString("C")</span>
                            <span class="hn-chip hn-chip-neutral">Avance: @c.PaidPeriods / @c.TotalPeriods</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section id="sectionPayments" class="reseller-section d-none">
    <div class="card shadow-soft hn-hover">
        <div class="card-header fw-semibold">Pagos de comision (periodicidad)</div>
        <div class="card-body table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Reseller</th>
                        <th>Comision</th>
                        <th>Periodo</th>
                        <th>Vence</th>
                        <th>Vencimiento</th>
                        <th class="text-end">Monto</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Payments)
                {
                    <tr>
                        <td>@p.PartnerName</td>
                        <td>@p.Description</td>
                        <td>#@p.PeriodNumber</td>
                        <td>@p.DueDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge @p.DueBadgeCss">@p.DueBadgeText</span></td>
                        <td class="text-end fw-semibold">@p.Amount.ToString("C")</td>
                        <td>
                            @if (p.IsPaid)
                            {
                                <span class="badge bg-success">Pagado</span>
                                <div class="small text-muted">@p.PaidAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pendiente</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!p.IsPaid)
                            {
                                <form method="post" asp-page-handler="MarkPaid" class="d-inline">
                                    <input type="hidden" name="paymentId" value="@p.PaymentId" />
                                    <button class="btn btn-sm btn-success" type="submit">Pagado</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const nav = document.getElementById('resellerSectionNav');
            if (!nav) return;
            const buttons = Array.from(nav.querySelectorAll('.section-btn'));
            const sections = Array.from(document.querySelectorAll('.reseller-section'));

            function showSection(targetId) {
                sections.forEach(s => s.classList.toggle('d-none', s.id !== targetId));
                buttons.forEach(btn => {
                    const isActive = btn.dataset.section === targetId;
                    btn.classList.toggle('btn-primary', isActive);
                    btn.classList.toggle('btn-outline-primary', !isActive && btn.dataset.section !== 'sectionPartnersList' && btn.dataset.section !== 'sectionCommissions' && btn.dataset.section !== 'sectionPayments');
                    btn.classList.toggle('btn-outline-success', !isActive && btn.dataset.section === 'sectionPartnersList');
                    btn.classList.toggle('btn-outline-info', !isActive && btn.dataset.section === 'sectionCommissions');
                    btn.classList.toggle('btn-outline-warning', !isActive && btn.dataset.section === 'sectionPayments');
                });
            }

            buttons.forEach(btn => btn.addEventListener('click', () => showSection(btn.dataset.section)));
            showSection('sectionPartner');
        })();
    </script>
}
