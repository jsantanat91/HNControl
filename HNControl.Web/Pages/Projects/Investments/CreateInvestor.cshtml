@page
@model HNControl.Web.Pages.Projects.Investments.CreateInvestorModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nuevo inversionista";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Nuevo inversionista</h1>
        <div class="text-muted small">Registro de persona para inversiones.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Projects/Investments/Index">Volver</a>
</div>

<partial name="/Pages/Projects/_ProjectsSubmenu.cshtml" />

<form method="post" class="card shadow-soft hn-hover">
    <div class="card-body row g-3">
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="col-md-6">
            <label class="form-label">Nombre completo</label>
            <input class="form-control" asp-for="Input.FullName" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Correo</label>
            <input class="form-control" asp-for="Input.Email" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Teléfono</label>
            <input class="form-control" asp-for="Input.Phone" />
        </div>
        <div class="col-md-8">
            <label class="form-label">Notas</label>
            <input class="form-control" asp-for="Input.Notes" />
        </div>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" type="submit">Guardar inversionista</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
