@page
@model HNControl.Web.Pages.Projects.Investments.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inversiones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Inversiones</h1>
        <div class="text-muted small">Control de inversionistas, amortización y estado de cuenta.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Projects/Investments/CreateInvestor">+ Persona</a>
        <a class="btn btn-primary" asp-page="/Projects/Investments/CreatePlan">+ Plan de inversión</a>
    </div>
</div>
@if (!Model.Investors.Any())
{
    <div class="alert alert-light border">Todavía no hay inversionistas registrados.</div>
}
else
{
    <div class="row g-3">
        @foreach (var i in Model.Investors)
        {
            <div class="col-12 col-lg-6 col-xxl-4">
                <div class="card shadow-soft hn-hover h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="fw-semibold">@i.FullName</div>
                            <div class="d-flex gap-1">
                                <span class="hn-chip @(i.InvestorType == HNControl.Web.Models.InvestmentInvestorType.Employee ? "hn-chip-neutral" : "hn-chip-type")">
                                    @(i.InvestorType == HNControl.Web.Models.InvestmentInvestorType.Employee ? "Empleado" : "Externo")
                                </span>
                                <span class="hn-chip hn-chip-type">@i.ActivePlans plan(es)</span>
                            </div>
                        </div>
                        <div class="small text-muted mb-1">@i.Email</div>
                        <div class="small text-muted mb-2">Alta: @i.CreatedAt.ToString("yyyy-MM-dd")</div>
                        <div class="small">Saldo pendiente: <strong>@i.PendingBalance.ToString("C")</strong></div>
                        <div class="mt-auto pt-3">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Projects/Investments/Details" asp-route-id="@i.Id">Abrir detalle</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

