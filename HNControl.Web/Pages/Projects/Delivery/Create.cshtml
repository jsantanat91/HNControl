@page
@model HNControl.Web.Pages.Projects.Delivery.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nuevo formato de entrega";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 m-0">Nuevo formato de entrega</h1>
        <div class="text-muted small">Selecciona cliente/proyecto y captura servicios y hardware (hasta 5 renglones por area).</div>
    </div>
    @if (Model.BackClientId.HasValue)
    {
        <a class="btn btn-outline-secondary" asp-page="/Clients/Details" asp-route-id="@Model.BackClientId.Value">Volver cliente</a>
    }
    else
    {
        <a class="btn btn-outline-secondary" asp-page="/Projects/Delivery/Index">Volver</a>
    }
</div>
<form method="post" enctype="multipart/form-data" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Cliente</label>
                <select class="form-select" asp-for="Input.ClientId" asp-items="Model.ClientItems"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Proyecto (opcional)</label>
                <select class="form-select" asp-for="Input.ProjectId" id="projectSelect">
                    <option value="">-- Sin proyecto --</option>
                    @foreach (var p in Model.ProjectItems)
                    {
                        <option value="@p.Id" data-client-id="@p.ClientId">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Titulo</label>
                <input class="form-control" asp-for="Input.Title" placeholder="Ej: Acta entrega de servicios - Sucursal Norte" />
            </div>
            <div class="col-md-6">
                <label class="form-label">NOMBREPROYECTO</label>
                <input class="form-control" asp-for="Input.ProjectTemplateName" placeholder="Nombre para el documento" />
            </div>
            <div class="col-md-6">
                <label class="form-label">NOMBRETECNICO</label>
                <input class="form-control" asp-for="Input.AssignedTechnicianName" placeholder="Tecnico asignado" />
            </div>
            <div class="col-md-6">
                <label class="form-label">SEGMENTOLAN</label>
                <input class="form-control" asp-for="Input.SegmentoLan" placeholder="Ej: 192.168.10.0/24" />
            </div>
            <div class="col-md-6">
                <label class="form-label">IPPUBLICA</label>
                <input class="form-control" asp-for="Input.IpPublica" placeholder="Ej: 201.xxx.xxx.xxx" />
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">Area de Servicios</label>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 34%;">SERVICIO01-05</th>
                                <th style="width: 33%;">SMODAL01-05</th>
                                <th style="width: 33%;">SPLAZO01-05</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < 5; i++)
                            {
                                <tr>
                                    <td><input class="form-control form-control-sm" asp-for="Input.ServiceNames[i]" /></td>
                                    <td><input class="form-control form-control-sm" asp-for="Input.ServiceModes[i]" /></td>
                                    <td><input class="form-control form-control-sm" asp-for="Input.ServiceTerms[i]" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">Area de Hardware</label>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 65%;">EQUIPO01-05</th>
                                <th style="width: 35%;">ECANTIDAD01-05</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < 5; i++)
                            {
                                <tr>
                                    <td><input class="form-control form-control-sm" asp-for="Input.EquipmentNames[i]" /></td>
                                    <td><input class="form-control form-control-sm" asp-for="Input.EquipmentQty[i]" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Ubicacion de entrega</label>
                <input class="form-control" asp-for="Input.DeliveryLocation" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Fecha de entrega</label>
                <input class="form-control" asp-for="Input.DeliveryDate" type="date" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Recibe (nombre)</label>
                <input class="form-control" asp-for="Input.ReceiverName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Recibe (correo)</label>
                <input class="form-control" asp-for="Input.ReceiverEmail" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Recibe (telefono)</label>
                <input class="form-control" asp-for="Input.ReceiverPhone" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Evidencia fotográfica</label>
                <input class="form-control" type="file" asp-for="EvidenceFiles" accept=".jpg,.jpeg,.png,image/jpeg,image/png" multiple />
                <div class="form-text">Puedes subir hasta 5 imágenes. Se anexan al PDF final con el mismo tamaño.</div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" type="submit">Crear formato</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const clientSelect = document.getElementById('Input_ClientId');
            const projectSelect = document.getElementById('projectSelect');
            if (!clientSelect || !projectSelect) return;

            const filterProjects = () => {
                const clientId = clientSelect.value;
                const current = projectSelect.value;
                let currentStillVisible = false;
                Array.from(projectSelect.options).forEach((opt, idx) => {
                    if (idx === 0) {
                        opt.hidden = false;
                        return;
                    }
                    const belongs = !clientId || opt.dataset.clientId === clientId;
                    opt.hidden = !belongs;
                    if (belongs && opt.value === current) currentStillVisible = true;
                });
                if (!currentStillVisible) projectSelect.value = '';
            };

            clientSelect.addEventListener('change', filterProjects);
            filterProjects();
        })();
    </script>
}
