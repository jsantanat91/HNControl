@page "{id:guid}"
@model HNControl.Web.Pages.Projects.Delivery.EditModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar formato de entrega";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 m-0">Editar formato de entrega</h1>
        <div class="text-muted small">Actualiza servicios, hardware, receptor y fecha del acta.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Projects/Delivery/Details" asp-route-id="@Model.DeliveryId">Volver</a>
</div>

<form method="post" enctype="multipart/form-data" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Cliente</label>
                <select class="form-select" asp-for="Input.ClientId" asp-items="Model.ClientItems"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Proyecto (opcional)</label>
                <select class="form-select" asp-for="Input.ProjectId" id="projectSelect">
                    <option value="">-- Sin proyecto --</option>
                    @foreach (var p in Model.ProjectItems)
                    {
                        <option value="@p.Id" data-client-id="@p.ClientId">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">T&iacute;tulo</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Nombre del proyecto en documento</label>
                <input class="form-control" asp-for="Input.ProjectTemplateName" />
            </div>
            <div class="col-md-6">
                <label class="form-label">T&eacute;cnico asignado</label>
                <input class="form-control" asp-for="Input.AssignedTechnicianName" />
            </div>
            <div class="col-md-6">
                <label class="form-label">SEGMENTOLAN</label>
                <input class="form-control" asp-for="Input.SegmentoLan" placeholder="Ej: 192.168.10.0/24" />
            </div>
            <div class="col-md-6">
                <label class="form-label">IPPUBLICA</label>
                <input class="form-control" asp-for="Input.IpPublica" placeholder="Ej: 201.xxx.xxx.xxx" />
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">&Aacute;rea de Servicios</label>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 34%;">Servicio</th>
                                <th style="width: 33%;">Modalidad</th>
                                <th style="width: 33%;">Plazo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < 5; i++)
                            {
                                <tr>
                                    <td><input class="form-control form-control-sm" asp-for="Input.ServiceNames[i]" /></td>
                                    <td><input class="form-control form-control-sm" asp-for="Input.ServiceModes[i]" /></td>
                                    <td><input class="form-control form-control-sm" asp-for="Input.ServiceTerms[i]" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">&Aacute;rea de Hardware</label>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 65%;">Equipo</th>
                                <th style="width: 35%;">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < 5; i++)
                            {
                                <tr>
                                    <td><input class="form-control form-control-sm" asp-for="Input.EquipmentNames[i]" /></td>
                                    <td><input class="form-control form-control-sm" asp-for="Input.EquipmentQty[i]" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Ubicaci&oacute;n de entrega</label>
                <input class="form-control" asp-for="Input.DeliveryLocation" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Fecha de entrega</label>
                <input class="form-control" asp-for="Input.DeliveryDate" type="date" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Recibe (nombre)</label>
                <input class="form-control" asp-for="Input.ReceiverName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Recibe (correo)</label>
                <input class="form-control" asp-for="Input.ReceiverEmail" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Recibe (tel&eacute;fono)</label>
                <input class="form-control" asp-for="Input.ReceiverPhone" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Agregar evidencia fotogr&aacute;fica</label>
                <input class="form-control" type="file" asp-for="EvidenceFiles" accept=".jpg,.jpeg,.png,image/jpeg,image/png" multiple />
                <div class="form-text">Puedes conservar/subir hasta 5 im&aacute;genes en total. Al guardar, el PDF se regenerar&aacute; con anexos.</div>
            </div>
            @if (Model.ExistingEvidences.Count > 0)
            {
                <div class="col-12">
                    <div class="small fw-semibold mb-2">Evidencias actuales</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var ev in Model.ExistingEvidences)
                        {
                            <span class="badge rounded-pill text-bg-light border d-inline-flex align-items-center gap-2">
                                @(ev.OriginalFileName ?? "Evidencia")
                                <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                        type="submit"
                                        formaction="?handler=RemoveEvidence&id=@Model.DeliveryId&storagePath=@Uri.EscapeDataString(ev.StoragePath ?? "")"
                                        formnovalidate>
                                    Quitar
                                </button>
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-page="/Projects/Delivery/Details" asp-route-id="@Model.DeliveryId">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const clientSelect = document.getElementById('Input_ClientId');
            const projectSelect = document.getElementById('projectSelect');
            if (!clientSelect || !projectSelect) return;

            const filterProjects = () => {
                const clientId = clientSelect.value;
                const current = projectSelect.value;
                let currentStillVisible = false;
                Array.from(projectSelect.options).forEach((opt, idx) => {
                    if (idx === 0) {
                        opt.hidden = false;
                        return;
                    }
                    const belongs = !clientId || opt.dataset.clientId === clientId;
                    opt.hidden = !belongs;
                    if (belongs && opt.value === current) currentStillVisible = true;
                });
                if (!currentStillVisible) projectSelect.value = '';
            };

            clientSelect.addEventListener('change', filterProjects);
            filterProjects();
        })();
    </script>
}
