@page "{id:guid}"
@model HNControl.Web.Pages.Projects.DetailsModel
@{
    Layout = "_Layout";
}

@if (Model.Project == null)
{
    <div class="alert alert-warning">Proyecto no encontrado o sin permisos.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">@Model.Project.Title</h1>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <span class="badge bg-primary">Cliente: @Model.ClientName</span>
            <span class="badge bg-dark">Responsable: @Model.Responsible</span>
            <span class="badge @Model.SlaCss">@Model.SlaLabel</span>
            <span class="badge @(Model.Project.Status == ProjectStatus.Closed ? "bg-secondary" : "bg-success")">@(Model.Project.Status == ProjectStatus.Closed ? "Cerrado" : "Abierto")</span>
        </div>
        <div class="text-muted small mt-1">Inicio: @Model.Project.StartDate.ToString("yyyy-MM-dd") · Estimado: @Model.Project.EstimatedEndDate.ToString("yyyy-MM-dd")</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Projects/Index">Volver</a>
        @if (User.IsInRole(AppRoles.Admin))
        {
            <a class="btn btn-outline-primary" asp-page="/Projects/Edit" asp-route-id="@Model.Project.Id">Editar</a>
        }
        @if (User.IsInRole(AppRoles.Admin) && Model.Project.Status == ProjectStatus.Open)
        {
            <a class="btn btn-outline-danger" asp-page="/Projects/Close" asp-route-id="@Model.Project.Id">Cerrar</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Resumen tecnico</div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">Objetivo</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Project.Objective) ? "-" : Model.Project.Objective)</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Alcance</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Project.Scope) ? "-" : Model.Project.Scope)</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Descripcion</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Project.ActivityDescription) ? "-" : Model.Project.ActivityDescription)</div>
                </div>
                <div>
                    <div class="text-muted small">Comentarios</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Project.AdditionalComments) ? "-" : Model.Project.AdditionalComments)</div>
                </div>
            </div>
        </div>

        <div class="card shadow-soft hn-hover mt-3">
            <div class="card-header fw-semibold">Contratos heredados del cliente</div>
            <div class="card-body">
                @if (!Model.LinkedContracts.Any())
                {
                    <div class="text-muted">Sin contratos ligados al proyecto.</div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-2">
                        @foreach (var c in Model.LinkedContracts)
                        {
                            <div class="col">
                                <div class="border rounded p-2 h-100">
                                    <div class="fw-semibold">@c.Label</div>
                                    <div class="small text-muted">@c.ServiceType · @c.Provider</div>
                                    <div class="small">Cuenta: @(string.IsNullOrWhiteSpace(c.AccountNumber) ? "-" : c.AccountNumber)</div>
                                    <div class="small">Contrato: @(string.IsNullOrWhiteSpace(c.ContractNumber) ? "-" : c.ContractNumber)</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-soft hn-hover">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Accesos (heredados + proyecto)</div>
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="btn btn-sm btn-primary" asp-page="/Projects/AddAccess" asp-route-id="@Model.Project.Id">+ Agregar</a>
                }
            </div>
            <div class="card-body table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Origen</th>
                            <th>Etiqueta</th>
                            <th>Host/URL</th>
                            <th>User</th>
                            <th>Password</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.AccessRows.Any())
                        {
                            <tr><td colspan="5" class="text-muted">Sin accesos.</td></tr>
                        }
                        else
                        {
                            foreach (var a in Model.AccessRows)
                            {
                                <tr>
                                    <td><span class="badge @(a.Source == "Contrato" ? "bg-info text-dark" : "bg-primary")">@a.Source</span></td>
                                    <td>
                                        <div class="fw-semibold">@a.Label</div>
                                        @if (!string.IsNullOrWhiteSpace(a.Notes))
                                        {
                                            <div class="small text-muted">@a.Notes</div>
                                        }
                                    </td>
                                    <td class="small text-muted">@a.HostOrUrl</td>
                                    <td>@a.Username</td>
                                    <td>
                                        @if (a.CanViewPassword)
                                        {
                                            <code>@(string.IsNullOrWhiteSpace(a.PasswordPlain) ? "-" : a.PasswordPlain)</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">••••••</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
