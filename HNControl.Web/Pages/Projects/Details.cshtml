@page "{id:guid}"
@model HNControl.Web.Pages.Projects.DetailsModel
@{
    Layout = "_Layout";
}

@if (Model.Project == null)
{
    <div class="alert alert-warning">Proyecto no encontrado o sin permisos.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">@Model.Project.Title</h1>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <span class="badge bg-primary">Cliente: @Model.ClientName</span>
            <span class="badge bg-dark">Responsable: @Model.Responsible</span>
            <span class="badge @Model.SlaCss">@Model.SlaLabel</span>
            <span class="badge @(Model.Project.Status == ProjectStatus.Closed ? "bg-secondary" : "bg-success")">@(Model.Project.Status == ProjectStatus.Closed ? "Cerrado" : "Abierto")</span>
        </div>
        <div class="text-muted small mt-1">Inicio: @Model.Project.StartDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · Estimado: @Model.Project.EstimatedEndDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Projects/Index">Volver</a>
        <a class="btn btn-outline-dark" asp-page-handler="ExportPdf" asp-route-id="@Model.Project.Id">PDF</a>
        @if (User.IsInRole(AppRoles.Admin))
        {
            <a class="btn btn-outline-primary" asp-page="/Projects/Edit" asp-route-id="@Model.Project.Id">Editar</a>
        }
        @if (User.IsInRole(AppRoles.Admin) && Model.Project.Status == ProjectStatus.Open)
        {
            <a class="btn btn-outline-danger" asp-page="/Projects/Close" asp-route-id="@Model.Project.Id">Cerrar</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Resumen técnico</div>
            <div class="card-body">
                <div class="mb-3">
                    <div><strong>Objetivo:</strong></div>
                    <div class="mt-1">@(string.IsNullOrWhiteSpace(Model.Project.Objective) ? "-" : Model.Project.Objective)</div>
                </div>
                <div class="mb-3">
                    <div><strong>Alcance:</strong></div>
                    <div class="mt-1">@(string.IsNullOrWhiteSpace(Model.Project.Scope) ? "-" : Model.Project.Scope)</div>
                </div>
                <div class="mb-3">
                    <div><strong>Descripción:</strong></div>
                    <div class="mt-1">@(string.IsNullOrWhiteSpace(Model.Project.ActivityDescription) ? "-" : Model.Project.ActivityDescription)</div>
                </div>
                <div>
                    <div><strong>Comentarios:</strong></div>
                    <div class="mt-1">@(string.IsNullOrWhiteSpace(Model.Project.AdditionalComments) ? "-" : Model.Project.AdditionalComments)</div>
                </div>
            </div>
        </div>

        <div class="card shadow-soft hn-hover mt-3">
            <div class="card-header fw-semibold">Gantt (calendario)</div>
            <div class="card-body">
                <div class="small text-muted mb-2">
                    Avance por ejecución: @Model.GanttProgressPercent% (@Model.GanttElapsedDays / @Model.GanttTotalDays horas)
                </div>
                <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.GanttProgressPercent">
                    <div class="progress-bar" style="width:@Model.GanttProgressPercent%"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted mt-2">
                    <span>Inicio: @Model.Project.StartDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    <span>Fin estimado: @Model.Project.EstimatedEndDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                </div>

                <hr />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="fw-semibold">Actividades planificadas</div>
                </div>

                @if (User.IsInRole(AppRoles.Admin))
                {
                    <form method="post" asp-page-handler="AddActivity" class="row g-2 mb-3 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="InputActivity.ProjectId" value="@Model.Project.Id" />
                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label small mb-1">Asignado a</label>
                            <select class="form-select form-select-sm" name="InputActivity.AssignedToUserId">
                                <option value="">Seleccionar</option>
                                @foreach (var emp in Model.EmployeeOptions)
                                {
                                    <option value="@emp.UserId">@emp.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label small mb-1">Actividad</label>
                            <input class="form-control form-control-sm" name="InputActivity.Description" placeholder="Actividad" />
                        </div>
                        <div class="col-12 col-md-6 col-xl-2">
                            <label class="form-label small mb-1">Tiempo</label>
                            <div class="d-flex gap-2">
                            <input class="form-control form-control-sm" name="InputActivity.DurationValue" type="number" min="1" max="3650" value="1" />
                            <select class="form-select form-select-sm" name="InputActivity.DurationUnit">
                                <option value="hours" selected>Horas</option>
                                <option value="days">Dias</option>
                            </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-2">
                            <label class="form-label small mb-1">Fecha inicio</label>
                            <input class="form-control form-control-sm" name="InputActivity.StartDateLocal" type="datetime-local" title="Fecha inicio" />
                        </div>
                        <div class="col-12 col-md-6 col-xl-2">
                            <label class="form-label small mb-1">Fecha fin</label>
                            <input class="form-control form-control-sm" name="InputActivity.EndDateLocal" type="datetime-local" title="Fecha fin" />
                        </div>
                        <div class="col-12 col-md-6 col-xl-12 d-grid d-xl-block mt-xl-2">
                            <button class="btn btn-sm btn-primary" type="submit">Agregar</button>
                        </div>
                    </form>
                }

                @if (!Model.Activities.Any())
                {
                    <div class="small text-muted">Sin actividades capturadas.</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var a in Model.Activities)
                        {
                            <div class="border rounded p-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@a.AssignedTo</div>
                                        <div class="small">@a.Description</div>
                                        <div class="small text-muted">@a.DurationLabel · @a.StartText → @a.EndText</div>
                                        @if (a.IsCompleted)
                                        {
                                            <div class="small text-success">Realizado: @a.CompletedText</div>
                                        }
                                    </div>
                                    @if (User.IsInRole(AppRoles.Admin))
                                    {
                                        <div class="ms-2 d-flex gap-2 flex-wrap">
                                            <form method="post" asp-page-handler="ToggleActivityDone">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Project.Id" />
                                                <input type="hidden" name="activityId" value="@a.Id" />
                                                <input type="hidden" name="done" value="@(!a.IsCompleted)" />
                                                <button class="btn btn-sm @(a.IsCompleted ? "btn-outline-secondary" : "btn-outline-success")" type="submit">
                                                    @(a.IsCompleted ? "Marcar pendiente" : "Marcar realizado")
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="DeleteActivity">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Project.Id" />
                                                <input type="hidden" name="activityId" value="@a.Id" />
                                                <button class="btn btn-sm btn-outline-danger" type="submit">Quitar</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                                <div class="progress mt-2" style="height:10px;">
                                    <div class="progress-bar" style="background:@a.ColorHex; margin-left:@a.OffsetPercent%; width:@a.WidthPercent%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-soft hn-hover mt-3">
            <div class="card-header fw-semibold">Contratos heredados del cliente</div>
            <div class="card-body">
                @if (!Model.LinkedContracts.Any())
                {
                    <div class="text-muted">Sin contratos ligados al proyecto.</div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-2">
                        @foreach (var c in Model.LinkedContracts)
                        {
                            <div class="col">
                                <div class="border rounded p-2 h-100">
                                    <div class="fw-semibold">@c.Label</div>
                                    <div class="small text-muted">@c.ServiceType · @c.Provider</div>
                                    <div class="small">Cuenta: @(string.IsNullOrWhiteSpace(c.AccountNumber) ? "-" : c.AccountNumber)</div>
                                    <div class="small">Contrato: @(string.IsNullOrWhiteSpace(c.ContractNumber) ? "-" : c.ContractNumber)</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-soft hn-hover">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Accesos (heredados + proyecto)</div>
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="btn btn-sm btn-primary" asp-page="/Projects/AddAccess" asp-route-id="@Model.Project.Id">+ Agregar</a>
                }
            </div>
            <div class="card-body table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Origen</th>
                            <th>Etiqueta</th>
                            <th>Host/URL</th>
                            <th>User</th>
                            <th>Password</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.AccessRows.Any())
                        {
                            <tr><td colspan="5" class="text-muted">Sin accesos.</td></tr>
                        }
                        else
                        {
                            foreach (var a in Model.AccessRows)
                            {
                                <tr>
                                    <td><span class="badge @(a.Source == "Contrato" ? "bg-info text-dark" : "bg-primary")">@a.Source</span></td>
                                    <td>
                                        <div class="fw-semibold">@a.Label</div>
                                        @if (!string.IsNullOrWhiteSpace(a.Notes))
                                        {
                                            <div class="small text-muted">@a.Notes</div>
                                        }
                                    </td>
                                    <td class="small text-muted">@a.HostOrUrl</td>
                                    <td>@a.Username</td>
                                    <td>
                                        @if (a.CanViewPassword)
                                        {
                                            <code>@(string.IsNullOrWhiteSpace(a.PasswordPlain) ? "-" : a.PasswordPlain)</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">••••••</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
