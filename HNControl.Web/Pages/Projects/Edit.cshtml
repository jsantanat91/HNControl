@page "{id:guid}"
@model HNControl.Web.Pages.Projects.EditModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Editar proyecto</h1>
        <div class="text-muted small">Ajusta datos base y contratos heredados.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Projects/Details" asp-route-id="@Model.Input.Id">Volver</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="card shadow-soft hn-hover">
    <div class="card-body">
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Nombre del proyecto</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Estado</label>
                <select class="form-select" asp-for="Input.Status">
                    <option value="@ProjectStatus.Open">Abierto</option>
                    <option value="@ProjectStatus.Closed">Cerrado</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Cliente</label>
                <select id="clientSelect" class="form-select" asp-for="Input.ClientId" asp-items="Model.ClientItems"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Responsable</label>
                <select class="form-select" asp-for="Input.ResponsibleUserId" asp-items="Model.EmployeeItems"></select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Fecha inicio</label>
                <input class="form-control" asp-for="Input.StartDate" type="date" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Termino estimado (SLA)</label>
                <input class="form-control" asp-for="Input.EstimatedEndDate" type="date" />
            </div>

            <div class="col-12">
                <label class="form-label">Contratos ligados (herencia)</label>
                <select id="contractSelect" class="form-select" asp-for="Input.ContractIds" asp-items="Model.ContractItems" multiple size="6"></select>
                <div class="form-text">Selecciona los contratos que alimentan este proyecto (datos/accesos del cliente).</div>
            </div>

            <div class="col-12">
                <label class="form-label">Objetivo</label>
                <input class="form-control" asp-for="Input.Objective" />
            </div>
            <div class="col-12">
                <label class="form-label">Alcance</label>
                <textarea class="form-control" asp-for="Input.Scope" rows="2"></textarea>
            </div>
            <div class="col-12">
                <label class="form-label">Descripcion</label>
                <textarea class="form-control" asp-for="Input.Description" rows="3"></textarea>
            </div>
            <div class="col-12">
                <label class="form-label">Notas de acceso internas</label>
                <textarea class="form-control" asp-for="Input.AccessNotes" rows="3"></textarea>
            </div>
            <div class="col-12">
                <label class="form-label">Comentarios</label>
                <textarea class="form-control" asp-for="Input.Comments" rows="2"></textarea>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-page="/Projects/Details" asp-route-id="@Model.Input.Id">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const clientSelect = document.getElementById('clientSelect');
            const contractSelect = document.getElementById('contractSelect');

            async function reloadContracts() {
                const clientId = clientSelect?.value;
                if (!clientId || !contractSelect) return;
                const url = `?handler=Contracts&clientId=${encodeURIComponent(clientId)}`;
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) return;
                const data = await res.json();
                contractSelect.innerHTML = '';
                for (const row of data) {
                    const opt = document.createElement('option');
                    opt.value = row.id;
                    opt.textContent = row.text;
                    contractSelect.appendChild(opt);
                }
            }

            if (clientSelect) {
                clientSelect.addEventListener('change', reloadContracts);
            }
        })();
    </script>
}
