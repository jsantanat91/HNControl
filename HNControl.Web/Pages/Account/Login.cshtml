@page
@model HNControl.Web.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Ingreso";
}

<div class="row justify-content-center align-items-stretch g-4">
    <div class="col-lg-6 d-none d-lg-flex">
        <div class="w-100 p-4 p-xl-5">
            <span class="hn-auth-kicker mb-3">Plataforma interna</span>

            <div class="display-5 hn-auth-brand mb-2">
                <span style="color:var(--hn-text)">HN</span> <span style="color:var(--hn-blue)">Control</span>
            </div>

            <div class="hn-auth-sub fs-5">
                Operación, KPI, viáticos, órdenes y 360.
            </div>

            <div class="hn-auth-divider"></div>

            <ul class="text-muted mb-0">
                <li class="mb-2">Admin: control total, trazabilidad por cliente/proyecto/servicio.</li>
                <li class="mb-2">Empleado: ficha, viáticos, órdenes y evaluaciones.</li>
                
            </ul>
        </div>
    </div>

    <div class="col-12 col-md-8 col-lg-5">
        <div class="card hn-auth-card">
            <div class="card-body p-4 p-lg-5">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="text-muted small">Acceso</div>
                        <h1 class="h3 m-0">Iniciar sesión</h1>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }

                <form method="post" class="mt-3">
                    <div class="form-floating mb-3">
                        <input class="form-control" asp-for="Input.Email" placeholder="correo@dominio.com" autocomplete="username" />
                        <label asp-for="Input.Email">Correo</label>
                        <span class="text-danger small" asp-validation-for="Input.Email"></span>
                    </div>

                    <div class="form-floating mb-2">
                        <input class="form-control" asp-for="Input.Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                        <label asp-for="Input.Password">Contraseña</label>
                        <span class="text-danger small" asp-validation-for="Input.Password"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">Recordarme</label>
                        </div>
                        <span class="text-muted small">Nota: usa contraseñas seguras.</span>
                    </div>

                    <button class="btn btn-primary w-100 py-2" type="submit">Entrar</button>

                    <div class="text-center text-muted small mt-3">
                        Si no tienes acceso, pídeselo al administrador.
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center text-muted small mt-3">
            &copy; @DateTime.Now.Year · HN Control
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
