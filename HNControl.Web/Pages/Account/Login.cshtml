@page
@model HNControl.Web.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Ingreso";
    ViewData["RefreshLogin"] = true;
}

<div class="hn-login-grid">
    <section class="hn-login-story" aria-label="HN Control">
        <div class="hn-login-brand"><span>HN</span><div><strong>HN Control</strong><small>GESTIÓN Y OPERACIÓN</small></div></div>
        <div class="hn-login-story-content">
            <div class="hn-eyebrow">TU OPERACIÓN, A LA VISTA</div>
            <h1>Cada servicio.<br />Cada persona.<br /><span>En un solo lugar.</span></h1>
            <p>Conecta a tu equipo con lo que importa. Clientes, servicios y proyectos, desde una misma plataforma.</p>
            <div class="hn-login-modules" aria-hidden="true">
                <strong><i class="bi bi-grid me-2"></i>Tu centro de operación</strong>
                <div class="hn-login-module-grid"><div><i class="bi bi-people"></i><small>EQUIPO</small></div><div><i class="bi bi-clipboard-check"></i><small>SERVICIOS</small></div><div><i class="bi bi-kanban"></i><small>PROYECTOS</small></div></div>
            </div>
        </div>
        <div class="hn-login-story-footer"><span><i class="bi bi-lock me-1" aria-hidden="true"></i>Acceso privado a tu operación</span><span>HUBNET SOLUTIONS</span></div>
    </section>
    <section class="hn-login-panel" aria-labelledby="login-title">
        <div class="hn-login-form-wrap">
            <div class="hn-login-symbol" aria-hidden="true"><i class="bi bi-grid-1x2"></i></div>
            <div class="hn-eyebrow">BIENVENIDO A HN CONTROL</div>
            <h2 id="login-title">Todo bajo control.</h2>
            <p>Inicia sesión para acceder a tu plataforma de operación.</p>
                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Info))
                {
                    <div class="alert alert-info">@Model.Info</div>
                }

                <form method="post">
                    <input type="hidden" asp-for="Input.AwaitingTwoFactor" />
                    <input type="hidden" asp-for="Input.ChallengeId" />

                    <div class="form-floating mb-3">
                        <input class="form-control" asp-for="Input.Email" placeholder="correo@dominio.com" autocomplete="username" />
                        <label asp-for="Input.Email">Nombre de usuario / correo</label>
                        <span class="text-danger small" asp-validation-for="Input.Email"></span>
                    </div>

                    @if (!Model.Input.AwaitingTwoFactor)
                    {
                        <div class="form-floating mb-3">
                            <input class="form-control" asp-for="Input.Password" type="password" placeholder="********" autocomplete="current-password" />
                            <label asp-for="Input.Password">Contraseña</label>
                            <span class="text-danger small" asp-validation-for="Input.Password"></span>
                        </div>
                    }
                    else
                    {
                        <div class="form-floating mb-3">
                            <input class="form-control" asp-for="Input.TwoFactorCode" maxlength="8" placeholder="00000000" autocomplete="one-time-code" />
                            <label asp-for="Input.TwoFactorCode">Código de seguridad (8 dígitos)</label>
                            <span class="text-danger small" asp-validation-for="Input.TwoFactorCode"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-2 mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">Recordarme</label>
                        </div>
                        <span class="text-muted small">Acceso seguro</span>
                    </div>

                    <button class="btn btn-primary w-100 py-2 fw-semibold" type="submit">@(Model.Input.AwaitingTwoFactor ? "Validar código" : "Iniciar sesión")</button>
                </form>
            <div class="hn-login-help"><i class="bi bi-shield-lock" aria-hidden="true"></i><span>Acceso restringido. Si necesitas ayuda con tu cuenta, contacta al administrador de tu plataforma.</span></div>
        </div>
        <div class="hn-login-panel-footer"><span>HN Control · v@(HNControl.Web.Services.ApplicationRelease.Version)</span><span>Una plataforma de Hubnet Solutions</span></div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const remembered = '@(Model.Input?.Email?.Replace("'", "\\'") ?? "")';
            if (!remembered) return;
            const emailInput = document.getElementById('Input_Email');
            if (!emailInput) return;
            emailInput.value = remembered;
        })();
    </script>
}
