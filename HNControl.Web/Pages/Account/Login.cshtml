@page
@model HNControl.Web.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Ingreso";
}

<div class="row justify-content-between align-items-center g-4">
    <div class="col-lg-6 d-none d-lg-flex">
        <div class="w-100 p-4 p-xl-5 hn-auth-intro">
            <span class="hn-auth-kicker mb-3">Plataforma interna</span>

            <h1 class="display-4 fw-bold lh-sm mb-3">
                BIENVENIDO A<br />
                <span class="text-white">HN CONTROL</span>
            </h1>

            <p class="fs-5 mb-2">Gestiona operación, tickets, proyectos e inventario desde un solo panel.</p>
            <p class="mb-0">Seguimiento completo para clientes, técnicos y administración.</p>
        </div>
    </div>

    <div class="col-12 col-md-8 col-lg-5 col-xl-4">
        <div class="card hn-auth-card">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-4">
                    <h1 class="h2 m-0 fw-bold text-white">INICIAR SESIÓN</h1>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }

                <form method="post">
                    <div class="form-floating mb-3">
                        <input class="form-control" asp-for="Input.Email" placeholder="correo@dominio.com" autocomplete="username" />
                        <label asp-for="Input.Email">Nombre de usuario / correo</label>
                        <span class="text-danger small" asp-validation-for="Input.Email"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input class="form-control" asp-for="Input.Password" type="password" placeholder="********" autocomplete="current-password" />
                        <label asp-for="Input.Password">Contraseña</label>
                        <span class="text-danger small" asp-validation-for="Input.Password"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2 mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">Recordarme</label>
                        </div>
                        <span class="text-muted small">Acceso seguro</span>
                    </div>

                    <button class="btn btn-primary w-100 py-2 fw-semibold" type="submit">Iniciar sesión</button>
                </form>
            </div>
        </div>

        <div class="text-center text-light small mt-3">
            &copy; @DateTime.Now.Year · HN Control
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
