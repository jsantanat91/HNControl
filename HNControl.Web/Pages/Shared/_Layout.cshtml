@using HNControl.Web.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IModuleAccessService ModuleAccess

@{
    var path = Context?.Request?.Path.Value ?? "";
    string Active(string startsWith)
        => path.StartsWith(startsWith, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // Permisos por módulo (solo aplica a Employees). Admin bypass.
    var allowedModules = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    if (SignInManager.IsSignedIn(User) && !User.IsInRole(AppRoles.Admin))
    {
        allowedModules = await ModuleAccess.GetAllowedModulesAsync(User);
    }
    bool Has(string key) => User.IsInRole(AppRoles.Admin) || allowedModules.Contains(key);

    var pageTitle = (ViewData["Title"] as string) ?? "HN Control";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - HN Control</title>

    <meta name="theme-color" content="#1e40af" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hn-ui.css" asp-append-version="true" />
</head>
<body>
@if (SignInManager.IsSignedIn(User))
{
    <div class="hn-app">
        <!-- Sidebar (desktop) -->
        <aside class="hn-sidebar d-none d-lg-block">
            <a class="hn-brand" asp-page="/Index">
                <span class="hn-brand-mark">HN</span>
                <span>
                    <div class="hn-brand-name">HN Control</div>
                    <div class="hn-brand-sub">Operación · KPI · Órdenes</div>
                </span>
            </a>

            <div class="hn-side-section">
                <div class="hn-side-title">Menú</div>

                @* ADMIN *@
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="hn-side-link @Active("/Admin/Dashboard")" asp-page="/Admin/Dashboard">
                        <span class="hn-side-icon"><i class="bi bi-speedometer2"></i></span>
                        <span class="hn-side-text">Panel</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Employees")" asp-page="/Admin/Employees/Index">
                        <span class="hn-side-icon"><i class="bi bi-people"></i></span>
                        <span class="hn-side-text">Empleados</span>
                    </a>
                    <a class="hn-side-link @Active("/Clients")" asp-page="/Clients/Index">
                        <span class="hn-side-icon"><i class="bi bi-person-badge"></i></span>
                        <span class="hn-side-text">Clientes</span>
                    </a>
                    <a class="hn-side-link @Active("/Projects")" asp-page="/Projects/Index">
                        <span class="hn-side-icon"><i class="bi bi-kanban"></i></span>
                        <span class="hn-side-text">Proyectos</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/ServiceOrders")" asp-page="/Admin/ServiceOrders/Index">
                        <span class="hn-side-icon"><i class="bi bi-clipboard-check"></i></span>
                        <span class="hn-side-text">Órdenes</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Viaticos")" asp-page="/Admin/Viaticos/Index">
                        <span class="hn-side-icon"><i class="bi bi-cash-stack"></i></span>
                        <span class="hn-side-text">Viáticos</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Performance")" asp-page="/Admin/Performance/Dashboard">
                        <span class="hn-side-icon"><i class="bi bi-graph-up-arrow"></i></span>
                        <span class="hn-side-text">KPI (80/20)</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Eval360")" asp-page="/Admin/Eval360/Campaigns/Index">
                        <span class="hn-side-icon"><i class="bi bi-diagram-3"></i></span>
                        <span class="hn-side-text">Evaluación 360</span>
                    </a>
                    <a class="hn-side-link @Active("/Knowledge")" asp-page="/Knowledge/Index">
                        <span class="hn-side-icon"><i class="bi bi-journal-text"></i></span>
                        <span class="hn-side-text">Documentos</span>
                    </a>
                    <a class="hn-side-link @Active("/Carriers")" asp-page="/Carriers/Index">
                        <span class="hn-side-icon"><i class="bi bi-broadcast"></i></span>
                        <span class="hn-side-text">Carriers</span>
                    </a>
                    <a class="hn-side-link @Active("/Inventory")" asp-page="/Inventory/Index">
                        <span class="hn-side-icon"><i class="bi bi-box-seam"></i></span>
                        <span class="hn-side-text">Inventario</span>
                    </a>
                    <a class="hn-side-link @Active("/Monitoring")" asp-page="/Monitoring/Index">
                        <span class="hn-side-icon"><i class="bi bi-activity"></i></span>
                        <span class="hn-side-text">Monitoreo</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Security")" asp-page="/Admin/Security/Roles/Index">
                        <span class="hn-side-icon"><i class="bi bi-shield-lock"></i></span>
                        <span class="hn-side-text">Seguridad</span>
                    </a>
                }
                else
                {
                    @* EMPLEADO *@
                    <a class="hn-side-link @Active("/Employees/MyProfile")" asp-page="/Employees/MyProfile">
                        <span class="hn-side-icon"><i class="bi bi-person-lines-fill"></i></span>
                        <span class="hn-side-text">Mi ficha</span>
                    </a>

                    @if (Has(AppModules.ServiceOrders))
                    {
                        <a class="hn-side-link @Active("/ServiceOrders")" asp-page="/ServiceOrders/Index">
                            <span class="hn-side-icon"><i class="bi bi-clipboard-check"></i></span>
                            <span class="hn-side-text">Mis órdenes</span>
                        </a>
                    }
                    @if (Has(AppModules.Viaticos))
                    {
                        <a class="hn-side-link @Active("/Viaticos")" asp-page="/Viaticos/Index">
                            <span class="hn-side-icon"><i class="bi bi-cash-stack"></i></span>
                            <span class="hn-side-text">Mis viáticos</span>
                        </a>
                    }
                    @if (Has(AppModules.Eval360))
                    {
                        <a class="hn-side-link @Active("/Eval360")" asp-page="/Eval360/Index">
                            <span class="hn-side-icon"><i class="bi bi-diagram-3"></i></span>
                            <span class="hn-side-text">Evaluación 360</span>
                        </a>
                    }
                    @if (Has(AppModules.Projects))
                    {
                        <a class="hn-side-link @Active("/Projects")" asp-page="/Projects/Index">
                            <span class="hn-side-icon"><i class="bi bi-kanban"></i></span>
                            <span class="hn-side-text">Proyectos</span>
                        </a>
                    }
                    @if (Has(AppModules.Knowledge))
                    {
                        <a class="hn-side-link @Active("/Knowledge")" asp-page="/Knowledge/Index">
                            <span class="hn-side-icon"><i class="bi bi-journal-text"></i></span>
                            <span class="hn-side-text">Documentos</span>
                        </a>
                    }
                    @if (Has(AppModules.Carriers))
                    {
                        <a class="hn-side-link @Active("/Carriers")" asp-page="/Carriers/Index">
                            <span class="hn-side-icon"><i class="bi bi-broadcast"></i></span>
                            <span class="hn-side-text">Carriers</span>
                        </a>
                    }
                    @if (Has(AppModules.Inventory))
                    {
                        <a class="hn-side-link @Active("/Inventory")" asp-page="/Inventory/Index">
                            <span class="hn-side-icon"><i class="bi bi-box-seam"></i></span>
                            <span class="hn-side-text">Inventario</span>
                        </a>
                    }
                    @if (Has(AppModules.Monitoring))
                    {
                        <a class="hn-side-link @Active("/Monitoring")" asp-page="/Monitoring/Index">
                            <span class="hn-side-icon"><i class="bi bi-activity"></i></span>
                            <span class="hn-side-text">Monitoreo</span>
                        </a>
                    }
                }
            </div>

            <div class="hn-side-footer mt-auto">
                <div class="hn-side-user">@User.Identity?.Name</div>
                <div class="hn-side-user-sub">Sesión activa</div>

                <form asp-page="/Account/Logout" method="post" class="mt-2">
                    <button class="btn btn-sm hn-navbtn-danger w-100" type="submit">
                        <i class="bi bi-box-arrow-right me-1"></i> Salir
                    </button>
                </form>
            </div>
        </aside>

        <!-- Content -->
        <div class="hn-content">
            <div class="hn-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#hnMobileNav" aria-controls="hnMobileNav" aria-label="Menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <div class="hn-page-title">@pageTitle</div>
                        <div class="hn-page-sub d-none d-md-block">Vista actual</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="hn-user d-none d-md-inline">@User.Identity?.Name</span>
                    <form asp-page="/Account/Logout" method="post" class="d-none d-lg-block">
                        <button class="btn btn-sm hn-navbtn-danger" type="submit">
                            <i class="bi bi-box-arrow-right me-1"></i> Salir
                        </button>
                    </form>
                </div>
            </div>

            <main class="hn-main">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </main>

            <footer class="hn-footer">
                &copy; @DateTime.Now.Year · HN Control
            </footer>
        </div>
    </div>

    <!-- Mobile offcanvas sidebar -->
    <div class="offcanvas offcanvas-start hn-offcanvas d-lg-none" tabindex="-1" id="hnMobileNav" aria-labelledby="hnMobileNavLabel">
        <div class="offcanvas-header">
            <a class="hn-brand" asp-page="/Index" id="hnMobileNavLabel">
                <span class="hn-brand-mark">HN</span>
                <span>
                    <div class="hn-brand-name">HN Control</div>
                    <div class="hn-brand-sub">Menú</div>
                </span>
            </a>
            <button type="button" class="btn btn-outline-light" data-bs-dismiss="offcanvas" aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="offcanvas-body">
            <div class="hn-side-section">
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="hn-side-link @Active("/Admin/Dashboard")" asp-page="/Admin/Dashboard"><span class="hn-side-icon"><i class="bi bi-speedometer2"></i></span><span class="hn-side-text">Panel</span></a>
                    <a class="hn-side-link @Active("/Admin/Employees")" asp-page="/Admin/Employees/Index"><span class="hn-side-icon"><i class="bi bi-people"></i></span><span class="hn-side-text">Empleados</span></a>
                    <a class="hn-side-link @Active("/Clients")" asp-page="/Clients/Index"><span class="hn-side-icon"><i class="bi bi-person-badge"></i></span><span class="hn-side-text">Clientes</span></a>
                    <a class="hn-side-link @Active("/Projects")" asp-page="/Projects/Index"><span class="hn-side-icon"><i class="bi bi-kanban"></i></span><span class="hn-side-text">Proyectos</span></a>
                    <a class="hn-side-link @Active("/Admin/ServiceOrders")" asp-page="/Admin/ServiceOrders/Index"><span class="hn-side-icon"><i class="bi bi-clipboard-check"></i></span><span class="hn-side-text">Órdenes</span></a>
                    <a class="hn-side-link @Active("/Admin/Viaticos")" asp-page="/Admin/Viaticos/Index"><span class="hn-side-icon"><i class="bi bi-cash-stack"></i></span><span class="hn-side-text">Viáticos</span></a>
                    <a class="hn-side-link @Active("/Admin/Performance")" asp-page="/Admin/Performance/Dashboard"><span class="hn-side-icon"><i class="bi bi-graph-up-arrow"></i></span><span class="hn-side-text">KPI (80/20)</span></a>
                    <a class="hn-side-link @Active("/Admin/Eval360")" asp-page="/Admin/Eval360/Campaigns/Index"><span class="hn-side-icon"><i class="bi bi-diagram-3"></i></span><span class="hn-side-text">Evaluación 360</span></a>
                    <a class="hn-side-link @Active("/Knowledge")" asp-page="/Knowledge/Index"><span class="hn-side-icon"><i class="bi bi-journal-text"></i></span><span class="hn-side-text">Documentos</span></a>
                    <a class="hn-side-link @Active("/Carriers")" asp-page="/Carriers/Index"><span class="hn-side-icon"><i class="bi bi-broadcast"></i></span><span class="hn-side-text">Carriers</span></a>
                    <a class="hn-side-link @Active("/Inventory")" asp-page="/Inventory/Index"><span class="hn-side-icon"><i class="bi bi-box-seam"></i></span><span class="hn-side-text">Inventario</span></a>
                    <a class="hn-side-link @Active("/Monitoring")" asp-page="/Monitoring/Index"><span class="hn-side-icon"><i class="bi bi-activity"></i></span><span class="hn-side-text">Monitoreo</span></a>
                    <a class="hn-side-link @Active("/Admin/Security")" asp-page="/Admin/Security/Roles/Index"><span class="hn-side-icon"><i class="bi bi-shield-lock"></i></span><span class="hn-side-text">Seguridad</span></a>
                }
                else
                {
                    <a class="hn-side-link @Active("/Employees/MyProfile")" asp-page="/Employees/MyProfile"><span class="hn-side-icon"><i class="bi bi-person-lines-fill"></i></span><span class="hn-side-text">Mi ficha</span></a>
                    @if (Has(AppModules.ServiceOrders))
                    { <a class="hn-side-link @Active("/ServiceOrders")" asp-page="/ServiceOrders/Index"><span class="hn-side-icon"><i class="bi bi-clipboard-check"></i></span><span class="hn-side-text">Mis órdenes</span></a> }
                    @if (Has(AppModules.Viaticos))
                    { <a class="hn-side-link @Active("/Viaticos")" asp-page="/Viaticos/Index"><span class="hn-side-icon"><i class="bi bi-cash-stack"></i></span><span class="hn-side-text">Mis viáticos</span></a> }
                    @if (Has(AppModules.Eval360))
                    { <a class="hn-side-link @Active("/Eval360")" asp-page="/Eval360/Index"><span class="hn-side-icon"><i class="bi bi-diagram-3"></i></span><span class="hn-side-text">Evaluación 360</span></a> }
                    @if (Has(AppModules.Projects))
                    { <a class="hn-side-link @Active("/Projects")" asp-page="/Projects/Index"><span class="hn-side-icon"><i class="bi bi-kanban"></i></span><span class="hn-side-text">Proyectos</span></a> }
                    @if (Has(AppModules.Knowledge))
                    { <a class="hn-side-link @Active("/Knowledge")" asp-page="/Knowledge/Index"><span class="hn-side-icon"><i class="bi bi-journal-text"></i></span><span class="hn-side-text">Documentos</span></a> }
                    @if (Has(AppModules.Carriers))
                    { <a class="hn-side-link @Active("/Carriers")" asp-page="/Carriers/Index"><span class="hn-side-icon"><i class="bi bi-broadcast"></i></span><span class="hn-side-text">Carriers</span></a> }
                    @if (Has(AppModules.Inventory))
                    { <a class="hn-side-link @Active("/Inventory")" asp-page="/Inventory/Index"><span class="hn-side-icon"><i class="bi bi-box-seam"></i></span><span class="hn-side-text">Inventario</span></a> }
                    @if (Has(AppModules.Monitoring))
                    { <a class="hn-side-link @Active("/Monitoring")" asp-page="/Monitoring/Index"><span class="hn-side-icon"><i class="bi bi-activity"></i></span><span class="hn-side-text">Monitoreo</span></a> }
                }

                <hr class="border-light opacity-25 my-3" />

                <div class="hn-side-user">@User.Identity?.Name</div>
                <form asp-page="/Account/Logout" method="post" class="mt-2">
                    <button class="btn btn-sm btn-danger w-100" type="submit"><i class="bi bi-box-arrow-right me-1"></i> Salir</button>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <!-- Sin sesión: se usa normalmente _AuthLayout, pero dejamos fallback -->
    <main class="container py-4">
        @RenderBody()
    </main>
}

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/hn-charts.js" asp-append-version="true"></script>
    <script src="~/js/hn-ui.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
