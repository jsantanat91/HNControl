@using HNControl.Web.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IModuleAccessService ModuleAccess
@inject IActionAccessService ActionAccess

@{
    var path = Context?.Request?.Path.Value ?? "";
    string Active(string startsWith)
        => path.StartsWith(startsWith, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string ActiveExact(string exact)
        => string.Equals(path, exact, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var isSalesPath = path.StartsWith("/Ventas", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/Admin/Quotes", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/Sales/My", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/Ventas/Cotizaciones", StringComparison.OrdinalIgnoreCase);
    var isSystemPath = path.StartsWith("/Admin/System", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/Admin/Security", StringComparison.OrdinalIgnoreCase);
    var isSystemConfigPath = path.StartsWith("/Admin/System/Configuration", StringComparison.OrdinalIgnoreCase);
    var isSystemBackupPath = path.StartsWith("/Admin/System/Backup", StringComparison.OrdinalIgnoreCase);
    var isSecurityPath = path.StartsWith("/Admin/Security", StringComparison.OrdinalIgnoreCase);
    var isAdminOrgChartPath = path.StartsWith("/Admin/Employees/OrgChart", StringComparison.OrdinalIgnoreCase);
    var isAdminEmployeesPath = path.StartsWith("/Admin/Employees", StringComparison.OrdinalIgnoreCase) && !isAdminOrgChartPath;

    // Permisos por m&oacute;dulo (solo aplica a Employees). Admin bypass.
    var allowedModules = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var allowedActions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    if (SignInManager.IsSignedIn(User) && !AppRoles.IsGlobalAdmin(User))
    {
        allowedModules = await ModuleAccess.GetAllowedModulesAsync(User);
        allowedActions = await ActionAccess.GetAllowedActionsAsync(User);
    }
    bool Has(string key) => AppRoles.IsGlobalAdmin(User) || allowedModules.Contains(key);
    bool CanAction(string key) => AppRoles.IsGlobalAdmin(User) || allowedActions.Contains(key);

    var pageTitle = (ViewData["Title"] as string) ?? "HN Control";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - HN Control</title>

    <meta name="theme-color" content="#1e40af" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hn-ui.css" asp-append-version="true" />

    <!-- Charts: algunos pages traen <script> inline (fuera de section Scripts),
         as&iacute; que Chart.js debe estar disponible antes de parsear el body. -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/hn-charts.js" asp-append-version="true"></script>
    @RenderSection("Styles", required: false)
</head>
<body>
@if (SignInManager.IsSignedIn(User))
{
    <div class="hn-app">
        <!-- Sidebar (desktop) -->
        <aside class="hn-sidebar d-none d-lg-block">
            <a class="hn-brand" asp-page="/Index">
                <span class="hn-brand-mark">HN</span>
                <span>
                    <div class="hn-brand-name">HN Control</div>
                </span>
            </a>
            <div class="hn-sidebar-toggle-wrap">
                <button class="hn-sidebar-toggle" type="button" data-hn-sidebar-toggle title="Compactar men&uacute;">
                    <i class="bi bi-layout-sidebar-inset"></i>
                </button>
            </div>

            <div class="hn-side-section">
                <div class="hn-side-title">Men&uacute;</div>

                @* ADMIN *@
                @if (AppRoles.IsGlobalAdmin(User))
                {
                    <a class="hn-side-link @Active("/Admin/Dashboard")" asp-page="/Admin/Dashboard">
                        <span class="hn-side-icon"><i class="bi bi-speedometer2"></i></span>
                        <span class="hn-side-text">Panel</span>
                    </a>
                    <a class="hn-side-link @(isAdminEmployeesPath ? "active" : "")" asp-page="/Admin/Employees/Index">
                        <span class="hn-side-icon"><i class="bi bi-people"></i></span>
                        <span class="hn-side-text">Empleados</span>
                    </a>
                    <a class="hn-side-link @(isAdminOrgChartPath ? "active" : "")" asp-page="/Admin/Employees/OrgChart">
                        <span class="hn-side-icon"><i class="bi bi-diagram-2"></i></span>
                        <span class="hn-side-text">Organigrama</span>
                    </a>
                    <a class="hn-side-link @Active("/Clients")" asp-page="/Clients/Index">
                        <span class="hn-side-icon"><i class="bi bi-person-badge"></i></span>
                        <span class="hn-side-text">Clientes</span>
                    </a>
                    <details class="hn-side-group" @(path.StartsWith("/Projects", StringComparison.OrdinalIgnoreCase) ? "open" : "")>
                        <summary class="hn-side-link @Active("/Projects")">
                            <span class="hn-side-icon"><i class="bi bi-kanban"></i></span>
                            <span class="hn-side-text">Proyectos</span>
                        </summary>
                        <div class="hn-side-sub">
                            <a class="hn-side-sublink @Active("/Projects/Index")" asp-page="/Projects/Index">Proyectos</a>
                            <a class="hn-side-sublink @Active("/Projects/Investments")" asp-page="/Projects/Investments/Index">Inversiones</a>
                            <a class="hn-side-sublink @Active("/Projects/Resellers")" asp-page="/Projects/Resellers/Index">Reseller</a>
                            <a class="hn-side-sublink @Active("/Projects/Delivery")" asp-page="/Projects/Delivery/Index">Formato de entrega</a>
                        </div>
                    </details>
                    <a class="hn-side-link @Active("/Admin/ServiceOrders")" asp-page="/Admin/ServiceOrders/Index">
                        <span class="hn-side-icon"><i class="bi bi-clipboard-check"></i></span>
                        <span class="hn-side-text">&Oacute;rdenes</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Viaticos")" asp-page="/Admin/Viaticos/Index">
                        <span class="hn-side-icon"><i class="bi bi-cash-stack"></i></span>
                        <span class="hn-side-text">Viáticos</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Performance")" asp-page="/Admin/Performance/Dashboard">
                        <span class="hn-side-icon"><i class="bi bi-graph-up-arrow"></i></span>
                        <span class="hn-side-text">KPI (80/20)</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Eval360")" asp-page="/Admin/Eval360/Campaigns/Index">
                        <span class="hn-side-icon"><i class="bi bi-diagram-3"></i></span>
                        <span class="hn-side-text">Evaluaci&oacute;n 360</span>
                    </a>
                    <a class="hn-side-link @Active("/Knowledge")" asp-page="/Knowledge/Index">
                        <span class="hn-side-icon"><i class="bi bi-journal-text"></i></span>
                        <span class="hn-side-text">Documentos</span>
                    </a>
                    <details class="hn-side-group" @((path.StartsWith("/Carriers", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Monitoring", StringComparison.OrdinalIgnoreCase)) ? "open" : "")>
                        <summary class="hn-side-link @((Active("/Carriers")))">
                            <span class="hn-side-icon"><i class="bi bi-broadcast"></i></span>
                            <span class="hn-side-text">Carriers</span>
                        </summary>
                        <div class="hn-side-sub">
                            <a class="hn-side-sublink @Active("/Carriers")" asp-page="/Carriers/Index">Carriers</a>
                            <a class="hn-side-sublink @Active("/Monitoring")" asp-page="/Monitoring/Index">Monitoreo</a>
                        </div>
                    </details>
                    <details class="hn-side-group" @(path.StartsWith("/Inventory", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Admin/Inventory", StringComparison.OrdinalIgnoreCase) ? "open" : "")>
                        <summary class="hn-side-link @Active("/Inventory")">
                            <span class="hn-side-icon"><i class="bi bi-box-seam"></i></span>
                            <span class="hn-side-text">Inventario</span>
                        </summary>
                        <div class="hn-side-sub">
                            <a class="hn-side-sublink @Active("/Inventory")" asp-page="/Inventory/Index">Inventario</a>
                            <a class="hn-side-sublink @Active("/Admin/Inventory/Services")" asp-page="/Admin/Inventory/Services/Index">Servicios</a>
                            <a class="hn-side-sublink @Active("/Admin/Inventory/Items")" asp-page="/Admin/Inventory/Items/Index">Admin stock</a>
                            <a class="hn-side-sublink @Active("/Admin/Inventory/Approvals")" asp-page="/Admin/Inventory/Approvals/Index">Aprobaciones</a>
                        </div>
                    </details>
                    <a class="hn-side-link @Active("/Tickets")" asp-page="/Tickets/Index">
                        <span class="hn-side-icon"><i class="bi bi-life-preserver"></i></span>
                        <span class="hn-side-text">Tickets</span>
                    </a>
                    <details class="hn-side-group" @(isSalesPath ? "open" : "")>
                        <summary class="hn-side-link @Active("/Ventas")">
                            <span class="hn-side-icon"><i class="bi bi-graph-up-arrow"></i></span>
                            <span class="hn-side-text">Ventas</span>
                        </summary>
                        <div class="hn-side-sub">
                            <a class="hn-side-sublink @ActiveExact("/Ventas")" href="/Ventas">Dashboard</a>
                            <a class="hn-side-sublink @Active("/Ventas/Prospectos")" href="/Ventas/Prospectos">Prospecto</a>
                            <a class="hn-side-sublink @Active("/Admin/Quotes/Requests")" asp-page="/Admin/Quotes/Requests">Cotizacion</a>
                            <a class="hn-side-sublink @Active("/Ventas/Workflow")" href="/Ventas/Workflow">Workflow</a>
                            <a class="hn-side-sublink @Active("/Ventas/Gestion")" href="/Ventas/Gestion">Gestión</a>
                            <a class="hn-side-sublink @Active("/Ventas/Plantillas")" href="/Ventas/Plantillas">Plantillas</a>
                            @if (CanAction(HNControl.Web.Models.AppActions.SalesCatalogView)
                                || CanAction(HNControl.Web.Models.AppActions.SalesCatalogManage))
                            {
                                <a class="hn-side-sublink @Active("/Admin/Quotes/Catalog")" asp-page="/Admin/Quotes/Catalog">Catalogo</a>
                            }
                        </div>
                    </details>
                    <a class="hn-side-link @Active("/Facturacion")" href="/Facturacion">
                        <span class="hn-side-icon"><i class="bi bi-receipt-cutoff"></i></span>
                        <span class="hn-side-text">Facturación</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Leaves")" asp-page="/Admin/Leaves/Index">
                        <span class="hn-side-icon"><i class="bi bi-calendar2-week"></i></span>
                        <span class="hn-side-text">Vacaciones</span>
                    </a>
                    <a class="hn-side-link @Active("/Admin/Exams")" asp-page="/Admin/Exams/Index">
                        <span class="hn-side-icon"><i class="bi bi-ui-checks"></i></span>
                        <span class="hn-side-text">Ex&aacute;menes</span>
                    </a>
                    <details class="hn-side-group" @(isSystemPath ? "open" : "")>
                        <summary class="hn-side-link @Active("/Admin/System")">
                            <span class="hn-side-icon"><i class="bi bi-database"></i></span>
                            <span class="hn-side-text">Sistema</span>
                        </summary>
                        <div class="hn-side-sub">
                            <a class="hn-side-sublink @(isSystemConfigPath ? "active" : "")" asp-page="/Admin/System/Configuration">Configuración</a>
                            <a class="hn-side-sublink @(isSystemBackupPath ? "active" : "")" asp-page="/Admin/System/Backup">Respaldo DB</a>
                            <a class="hn-side-sublink @(isSecurityPath ? "active" : "")" asp-page="/Admin/Security/Roles/Index">Seguridad</a>
                        </div>
                    </details>
                }
                else
                {
                    @* EMPLEADO *@
                    <a class="hn-side-link @Active("/Employees/MyProfile")" asp-page="/Employees/MyProfile">
                        <span class="hn-side-icon"><i class="bi bi-person-lines-fill"></i></span>
                        <span class="hn-side-text">Mi ficha</span>
                    </a>
                    @if (CanAction(HNControl.Web.Models.AppActions.EmployeesOrgChartView))
                    {
                        <a class="hn-side-link @Active("/Employees/OrgChart")" asp-page="/Employees/OrgChart">
                            <span class="hn-side-icon"><i class="bi bi-diagram-2"></i></span>
                            <span class="hn-side-text">Organigrama</span>
                        </a>
                    }
                    @if (Has(AppModules.Clients))
                    {
                        <a class="hn-side-link @Active("/Clients")" asp-page="/Clients/Index">
                            <span class="hn-side-icon"><i class="bi bi-person-badge"></i></span>
                            <span class="hn-side-text">Clientes</span>
                        </a>
                    }
                    @if (Has(HNControl.Web.Models.AppModules.Sales))
                    {
                        <details class="hn-side-group" @(isSalesPath ? "open" : "")>
                            <summary class="hn-side-link @Active("/Ventas")">
                                <span class="hn-side-icon"><i class="bi bi-funnel"></i></span>
                                <span class="hn-side-text">Ventas</span>
                            </summary>
                            <div class="hn-side-sub">
                                <a class="hn-side-sublink @Active("/Ventas/Prospectos")" href="/Ventas/Prospectos">Prospecto</a>
                                <a class="hn-side-sublink @Active("/Ventas/Cotizaciones")" href="/Ventas/Cotizaciones">Cotizacion</a>
                                @if (CanAction(HNControl.Web.Models.AppActions.SalesCatalogView)
                                    || CanAction(HNControl.Web.Models.AppActions.SalesCatalogManage))
                                {
                                    <a class="hn-side-sublink @Active("/Admin/Quotes/Catalog")" asp-page="/Admin/Quotes/Catalog">Catalogo</a>
                                }
                            </div>
                        </details>
                    }
                    @if (User.IsInRole(HNControl.Web.Models.AppRoles.Seller) && Has(HNControl.Web.Models.AppModules.Sales))
                    {
                        <a class="hn-side-link @Active("/Ventas/Cotizaciones")" href="/Ventas/Cotizaciones">
                            <span class="hn-side-icon"><i class="bi bi-cash-coin"></i></span>
                            <span class="hn-side-text">Mis cotizaciones</span>
                        </a>
                    }

                    @if (Has(AppModules.ServiceOrders))
                    {
                        <a class="hn-side-link @Active("/ServiceOrders")" asp-page="/ServiceOrders/Index">
                            <span class="hn-side-icon"><i class="bi bi-clipboard-check"></i></span>
                            <span class="hn-side-text">Mis &oacute;rdenes</span>
                        </a>
                    }
                    @if (Has(AppModules.Viaticos))
                    {
                        <a class="hn-side-link @Active("/Viaticos")" asp-page="/Viaticos/Index">
                            <span class="hn-side-icon"><i class="bi bi-cash-stack"></i></span>
                            <span class="hn-side-text">Mis viáticos</span>
                        </a>
                    }
                    @if (Has(AppModules.Eval360))
                    {
                        <a class="hn-side-link @Active("/Eval360")" asp-page="/Eval360/Index">
                            <span class="hn-side-icon"><i class="bi bi-diagram-3"></i></span>
                            <span class="hn-side-text">Evaluaci&oacute;n 360</span>
                        </a>
                    }
                    @if (Has(AppModules.Projects))
                    {
                        <details class="hn-side-group" @(path.StartsWith("/Projects", StringComparison.OrdinalIgnoreCase) ? "open" : "")>
                            <summary class="hn-side-link @Active("/Projects")">
                                <span class="hn-side-icon"><i class="bi bi-kanban"></i></span>
                                <span class="hn-side-text">Proyectos</span>
                            </summary>
                            <div class="hn-side-sub">
                                @if (CanAction(HNControl.Web.Models.AppActions.ProjectsView))
                                {
                                    <a class="hn-side-sublink @Active("/Projects/Index")" asp-page="/Projects/Index">Proyectos</a>
                                }
                                @if (CanAction(HNControl.Web.Models.AppActions.ProjectsInvestmentsView))
                                {
                                    <a class="hn-side-sublink @Active("/Projects/Investments")" asp-page="/Projects/Investments/Index">Inversiones</a>
                                }
                                @if (CanAction(HNControl.Web.Models.AppActions.ProjectsResellersView))
                                {
                                    <a class="hn-side-sublink @Active("/Projects/Resellers")" asp-page="/Projects/Resellers/Index">Reseller</a>
                                }
                                @if (CanAction(HNControl.Web.Models.AppActions.ProjectsDeliveryView))
                                {
                                    <a class="hn-side-sublink @Active("/Projects/Delivery")" asp-page="/Projects/Delivery/Index">Formato entrega</a>
                                }
                            </div>
                        </details>
                    }
                    @if (Has(AppModules.Knowledge))
                    {
                        <a class="hn-side-link @Active("/Knowledge")" asp-page="/Knowledge/Index">
                            <span class="hn-side-icon"><i class="bi bi-journal-text"></i></span>
                            <span class="hn-side-text">Documentos</span>
                        </a>
                    }
                    @if (Has(AppModules.Carriers) || Has(AppModules.Monitoring))
                    {
                        <details class="hn-side-group" @((path.StartsWith("/Carriers", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Monitoring", StringComparison.OrdinalIgnoreCase)) ? "open" : "")>
                            <summary class="hn-side-link @Active("/Carriers")">
                                <span class="hn-side-icon"><i class="bi bi-broadcast"></i></span>
                                <span class="hn-side-text">Carriers</span>
                            </summary>
                            <div class="hn-side-sub">
                                @if (Has(AppModules.Carriers) && CanAction(HNControl.Web.Models.AppActions.CarriersView))
                                {
                                    <a class="hn-side-sublink @Active("/Carriers")" asp-page="/Carriers/Index">Carriers</a>
                                }
                                @if (Has(AppModules.Monitoring) && CanAction(HNControl.Web.Models.AppActions.MonitoringView))
                                {
                                    <a class="hn-side-sublink @Active("/Monitoring")" asp-page="/Monitoring/Index">Monitoreo</a>
                                }
                            </div>
                        </details>
                    }
                    @if (Has(AppModules.Inventory))
                    {
                        <details class="hn-side-group" @(path.StartsWith("/Inventory", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Admin/Inventory", StringComparison.OrdinalIgnoreCase) ? "open" : "")>
                            <summary class="hn-side-link @Active("/Inventory")">
                                <span class="hn-side-icon"><i class="bi bi-box-seam"></i></span>
                                <span class="hn-side-text">Inventario</span>
                            </summary>
                            <div class="hn-side-sub">
                                <a class="hn-side-sublink @Active("/Inventory")" asp-page="/Inventory/Index">Inventario</a>
                                @if (User.IsInRole(HNControl.Web.Models.AppRoles.InventoryManager))
                                {
                                    <a class="hn-side-sublink @Active("/Admin/Inventory/Services")" asp-page="/Admin/Inventory/Services/Index">Servicios</a>
                                }
                            </div>
                        </details>
                    }
                    @if (Has(AppModules.Tickets))
                    {
                        <a class="hn-side-link @Active("/Tickets")" asp-page="/Tickets/Index">
                            <span class="hn-side-icon"><i class="bi bi-life-preserver"></i></span>
                            <span class="hn-side-text">Tickets</span>
                        </a>
                    }
                    @if (Has(AppModules.Leaves))
                    {
                        <a class="hn-side-link @Active("/Leaves")" asp-page="/Leaves/Index">
                            <span class="hn-side-icon"><i class="bi bi-calendar2-week"></i></span>
                            <span class="hn-side-text">Vacaciones</span>
                        </a>
                    }
                    @if (Has(AppModules.Exams))
                    {
                        <a class="hn-side-link @Active("/Exams")" asp-page="/Exams/Index">
                            <span class="hn-side-icon"><i class="bi bi-ui-checks"></i></span>
                            <span class="hn-side-text">Ex&aacute;menes</span>
                        </a>
                    }
                }
            </div>

            <div class="hn-side-footer mt-auto">
                <div class="hn-side-user">@User.Identity?.Name</div>
                <div class="hn-side-user-sub">Sesi&oacute;n activa</div>

                <form asp-page="/Account/Logout" method="post" class="mt-2">
                    <button class="btn btn-sm hn-navbtn-danger w-100" type="submit">
                        <i class="bi bi-box-arrow-right me-1"></i> Salir
                    </button>
                </form>
            </div>
        </aside>

        <!-- Content -->
        <div class="hn-content">
            <div class="hn-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#hnMobileNav" aria-controls="hnMobileNav" aria-label="Men&uacute;">
                        <i class="bi bi-list"></i>
                    </button>
                    <button class="btn btn-outline-secondary d-none d-lg-inline-flex" type="button" data-hn-sidebar-toggle title="Compactar men&uacute;">
                        <i class="bi bi-layout-sidebar-inset"></i>
                    </button>
                    <div>
                        <div class="hn-page-title">@pageTitle</div>
                        <div class="hn-page-sub d-none d-md-block">Vista actual</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="hn-user d-none d-md-inline">@User.Identity?.Name</span>
                    <form asp-page="/Account/Logout" method="post" class="d-none d-lg-block">
                        <button class="btn btn-sm hn-navbtn-danger" type="submit">
                            <i class="bi bi-box-arrow-right me-1"></i> Salir
                        </button>
                    </form>
                </div>
            </div>

            <main class="hn-main">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </main>

            <footer class="hn-footer">
                &copy; @DateTime.Now.Year &middot; HN Control
            </footer>
        </div>
    </div>

    <!-- Mobile offcanvas sidebar -->
    <div class="offcanvas offcanvas-start hn-offcanvas d-lg-none" tabindex="-1" id="hnMobileNav" aria-labelledby="hnMobileNavLabel">
        <div class="offcanvas-header">
            <a class="hn-brand" asp-page="/Index" id="hnMobileNavLabel">
                <span class="hn-brand-mark">HN</span>
                <span>
                    <div class="hn-brand-name">HN Control</div>
                    <div class="hn-brand-sub">Men&uacute;</div>
                </span>
            </a>
            <button type="button" class="btn btn-outline-light" data-bs-dismiss="offcanvas" aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="offcanvas-body">
            <div class="hn-side-section">
                @if (AppRoles.IsGlobalAdmin(User))
                {
                    <a class="hn-side-link @Active("/Admin/Dashboard")" asp-page="/Admin/Dashboard"><span class="hn-side-icon"><i class="bi bi-speedometer2"></i></span><span class="hn-side-text">Panel</span></a>
                    <a class="hn-side-link @(isAdminEmployeesPath ? "active" : "")" asp-page="/Admin/Employees/Index"><span class="hn-side-icon"><i class="bi bi-people"></i></span><span class="hn-side-text">Empleados</span></a>
                    <a class="hn-side-link @(isAdminOrgChartPath ? "active" : "")" asp-page="/Admin/Employees/OrgChart"><span class="hn-side-icon"><i class="bi bi-diagram-2"></i></span><span class="hn-side-text">Organigrama</span></a>
                    <a class="hn-side-link @Active("/Clients")" asp-page="/Clients/Index"><span class="hn-side-icon"><i class="bi bi-person-badge"></i></span><span class="hn-side-text">Clientes</span></a>
                    <details class="hn-side-group" @(path.StartsWith("/Projects", StringComparison.OrdinalIgnoreCase) ? "open" : "")>
                        <summary class="hn-side-link @Active("/Projects")"><span class="hn-side-icon"><i class="bi bi-kanban"></i></span><span class="hn-side-text">Proyectos</span></summary>
