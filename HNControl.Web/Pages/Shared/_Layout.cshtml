<div class="modal fade" id="quoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 94vw;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nueva cotización</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0" style="height: 84vh;">
                <iframe id="quoteModalFrame" src="about:blank" style="width:100%;height:100%;border:0;" loading="lazy"></iframe>
            </div>
        </div>
    </div>
</div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/hn-ui.js" asp-append-version="true"></script>
    <script>
        (() => {
            const modalEl = document.getElementById('quoteModal');
            const frame = document.getElementById('quoteModalFrame');
            if (!modalEl || !frame || typeof bootstrap === 'undefined') return;

            const modal = new bootstrap.Modal(modalEl);

            document.addEventListener('click', (ev) => {
                const trigger = ev.target instanceof Element ? ev.target.closest('[data-quote-modal-open="true"]') : null;
                if (!trigger) return;
                ev.preventDefault();
                const href = trigger.getAttribute('href') || '/cotizar';
                frame.setAttribute('src', href);
                modal.show();
            });

            modalEl.addEventListener('hidden.bs.modal', () => {
                frame.setAttribute('src', 'about:blank');
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>



