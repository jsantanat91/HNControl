@using HNControl.Web.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IModuleAccessService ModuleAccess

@{
    var path = Context?.Request?.Path.Value ?? "";
    string Active(string startsWith)
        => path.StartsWith(startsWith, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // Permisos por módulo (solo aplica a Employees). Admin bypass.
    var allowedModules = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    if (SignInManager.IsSignedIn(User) && !User.IsInRole(AppRoles.Admin))
    {
        allowedModules = await ModuleAccess.GetAllowedModulesAsync(User);
    }

    bool Has(string key) => User.IsInRole(AppRoles.Admin) || allowedModules.Contains(key);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HN Control</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hn-ui.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm hn-nav">
            <div class="container-fluid">
                <a class="navbar-brand hn-brand" asp-page="/Index">
                    <span class="hn-brand-mark">HN</span><span class="hn-brand-name"> Control</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2 flex-wrap">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item"><a class="hn-navbtn @Active("/Admin/Dashboard")" asp-page="/Admin/Dashboard">Dashboard</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Admin/Employees")" asp-page="/Admin/Employees/Index">Empleados</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Clients")" asp-page="/Clients/Index">Clientes</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Projects")" asp-page="/Projects/Index">Proyectos</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Admin/ServiceOrders")" asp-page="/Admin/ServiceOrders/Index">Órdenes</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Admin/Viaticos")" asp-page="/Admin/Viaticos/Index">Viáticos</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Admin/Performance")" asp-page="/Admin/Performance/Dashboard">KPI</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Admin/Eval360")" asp-page="/Admin/Eval360/Campaigns/Index">360</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Knowledge")" asp-page="/Knowledge/Index">Documentos</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Carriers")" asp-page="/Carriers/Index">Carriers</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Inventory")" asp-page="/Inventory/Index">Inventarios</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Monitoring")" asp-page="/Monitoring/Index">Monitoreo</a></li>
                                <li class="nav-item"><a class="hn-navbtn @Active("/Admin/Security")" asp-page="/Admin/Security/Roles/Index">Seguridad</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="hn-navbtn @Active("/Employees/MyProfile")" asp-page="/Employees/MyProfile">Mi ficha</a></li>
                                @if (Has(AppModules.ServiceOrders))
                                {
                                    <li class="nav-item"><a class="hn-navbtn @Active("/ServiceOrders")" asp-page="/ServiceOrders/Index">Mis órdenes</a></li>
                                }
                                @if (Has(AppModules.Viaticos))
                                {
                                    <li class="nav-item"><a class="hn-navbtn @Active("/Viaticos")" asp-page="/Viaticos/Index">Mis viáticos</a></li>
                                }
                                @if (Has(AppModules.Eval360))
                                {
                                    <li class="nav-item"><a class="hn-navbtn @Active("/Eval360")" asp-page="/Eval360/Index">360</a></li>
                                }
                                @if (Has(AppModules.Projects))
                                {
                                    <li class="nav-item"><a class="hn-navbtn @Active("/Projects")" asp-page="/Projects/Index">Proyectos</a></li>
                                }
                                @if (Has(AppModules.Knowledge))
                                {
                                    <li class="nav-item"><a class="hn-navbtn @Active("/Knowledge")" asp-page="/Knowledge/Index">Documentos</a></li>
                                }
                                @if (Has(AppModules.Carriers))
                                {
                                    <li class="nav-item"><a class="hn-navbtn @Active("/Carriers")" asp-page="/Carriers/Index">Carriers</a></li>
                                }
                                @if (Has(AppModules.Inventory))
                                {
                                    <li class="nav-item"><a class="hn-navbtn @Active("/Inventory")" asp-page="/Inventory/Index">Inventarios</a></li>
                                }
                                @if (Has(AppModules.Monitoring))
                                {
                                    <li class="nav-item"><a class="hn-navbtn @Active("/Monitoring")" asp-page="/Monitoring/Index">Monitoreo</a></li>
                                }
                            }

                            <li class="nav-item hn-sep d-none d-lg-block"></li>

                            <li class="nav-item d-none d-lg-flex align-items-center">
                                <span class="hn-user">@User.Identity?.Name</span>
                            </li>

                            <li class="nav-item">
                                <form asp-page="/Account/Logout" method="post" class="d-inline">
                                    <button class="btn btn-sm hn-navbtn hn-navbtn-danger" type="submit">Salir</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="hn-navbtn @Active("/Account/Login")" asp-page="/Account/Login">Entrar</a>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <main class="container py-4 hn-main">
        @RenderBody()
    </main>

    <footer class="border-top text-muted hn-footer">
        <div class="container py-3">
            &copy; @DateTime.Now.Year - HN Control
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
