@model HNControl.Web.Services.ClientServiceAnnexData
<div class="border rounded-3 p-3 mt-2">
    <h3 class="h6 mb-1">Condiciones del servicio de Internet</h3>
    <p class="form-text mb-3">La capacidad, ubicación y vigencia se toman de los datos del servicio. Selecciona la modalidad contratada para completar el contrato.</p>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" asp-for="Modality">Modalidad contratada</label>
            <select class="form-select" asp-for="Modality"><option value="">Seleccionar</option><option value="Dedicado">Internet Dedicado</option><option value="BestEffort">Best Effort</option></select>
            <span asp-validation-for="Modality" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="UploadCapacity">Velocidad de subida <span class="text-muted">(opcional)</span></label>
            <input class="form-control" asp-for="UploadCapacity" maxlength="30" placeholder="Ej. 100 Mbps" />
            <span asp-validation-for="UploadCapacity" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="Symmetry">Simetría del enlace <span class="text-muted">(opcional)</span></label>
            <select class="form-select" asp-for="Symmetry"><option value="">Sin especificar</option><option value="Simetrico">Simétrico</option><option value="Asimetrico">Asimétrico</option></select>
            <span asp-validation-for="Symmetry" class="text-danger"></span>
        </div>
        <div class="col-12 mt-1"><div class="form-text">Indica la subida y la simetría solo cuando estén pactadas; completa ambos datos.</div></div>
        <div class="col-md-6">
            <label class="form-label" asp-for="InstallationDate">Fecha pactada de instalación o activación <span class="text-muted">(opcional)</span></label>
            <input class="form-control" asp-for="InstallationDate" type="date" asp-format="{0:yyyy-MM-dd}" />
            <span class="text-danger" asp-validation-for="InstallationDate"></span>
            <div class="form-text">Captúrala cuando exista una fecha acordada con el cliente.</div>
        </div>
        <div class="col-12">
            <details>
                <summary class="fw-semibold">Referencias regulatorias <span class="text-muted fw-normal">(opcionales)</span></summary>
                <div class="row g-3 mt-1">
                    <div class="col-md-6"><label class="form-label" asp-for="AuthorizationHolder">Titular de la autorización o concesión</label><input class="form-control" asp-for="AuthorizationHolder" maxlength="100" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="AuthorizationReference">Folio y tipo de título vigente</label><input class="form-control" asp-for="AuthorizationReference" maxlength="70" /></div>
                    <div class="col-12"><label class="form-label" asp-for="ProfecoRegistration">Registro PROFECO del modelo de contrato</label><input class="form-control" asp-for="ProfecoRegistration" maxlength="60" placeholder="Folio verificado, cuando se cuente con él" /></div>
                </div>
                <p class="form-text mb-0">Captura únicamente referencias verificadas de documentos vigentes.</p>
            </details>
        </div>
    </div>
</div>
