@using HNControl.Web.Models
@using Microsoft.AspNetCore.Identity

@{
    // Layout sin sidebar, pensado para Login / Denied / etc.
    var title = (ViewData["Title"] as string) ?? "HN Control";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - HN Control</title>

    <meta name="theme-color" content="#1e40af" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hn-ui.css" asp-append-version="true" />

    <style>
        body{
            min-height:100vh;
            background:
              linear-gradient(110deg, rgba(2,8,22,.86) 0%, rgba(2,8,22,.48) 48%, rgba(2,8,22,.65) 100%),
              url('/img/login-tech.svg') center/cover no-repeat fixed,
              #07172e;
        }
        .hn-auth-wrap{
            min-height:100vh;
            display:flex;
            align-items:center;
        }
        .hn-auth-card{
            border-radius: 22px;
            border: 1px solid rgba(255,255,255,.24);
            background: rgba(10, 20, 36, 0.58);
            backdrop-filter: blur(8px);
            box-shadow: 0 26px 60px rgba(2,6,23,.34);
            color: #e8eefc;
        }
        .hn-auth-brand{
            font-weight: 900;
            letter-spacing: -.03em;
            color: #f8fafc;
        }
        .hn-auth-sub{
            color: rgba(226,232,240,.86);
        }
        .hn-auth-kicker{
            display:inline-flex;
            gap:.5rem;
            align-items:center;
            padding:.35rem .65rem;
            border-radius:999px;
            border:1px solid rgba(148,163,184,.40);
            background: rgba(15,23,42,.32);
            color: #dbeafe;
            font-weight: 800;
            font-size: .78rem;
        }
        .hn-auth-divider{
            height:1px;
            background: rgba(226,232,240,.26);
            margin: 1rem 0;
        }
        .hn-auth-intro{
            color:#f8fafc;
            text-shadow: 0 2px 18px rgba(2,6,23,.35);
        }
        .hn-auth-intro p,
        .hn-auth-intro li{
            color: rgba(226,232,240,.88);
        }
        .hn-auth-card .text-muted{
            color: rgba(226,232,240,.78) !important;
        }
        .hn-auth-card .form-control{
            background: rgba(255,255,255,.94);
        }
        .hn-auth-card .form-check-label{
            color: rgba(226,232,240,.9);
        }
        @@media (max-width: 991.98px){
            .hn-auth-card{
                background: rgba(10, 20, 36, 0.72);
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="hn-auth-wrap">
        <main class="container py-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
