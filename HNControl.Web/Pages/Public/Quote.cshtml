    background:#f7f9ff;
    color:#64748b;
    border-radius:999px;
    text-align:center;
    padding:.45rem .6rem;
    font-weight:700;
    font-size:.86rem;
}
.quote-step-pill.active{ border-color:#1d4ed8; background:#e8efff; color:#1d4ed8; }
