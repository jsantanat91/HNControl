@page "/cotizar/{token?}"
@model HNControl.Web.Pages.Public.QuoteModel
@using System.Text.Json
@{
    Layout = "_QuoteLayout";
    ViewData["Title"] = "Cotiza con HN Solutions";

    var catalogJson = JsonSerializer.Serialize(Model.CatalogPayload);
    var prospectsJson = JsonSerializer.Serialize(Model.ProspectOptions);
    var contactsJson = JsonSerializer.Serialize(Model.ClientContactsPayload);
    var initialManualLinesJson = Model.InitialManualLinesJson;
}

<div class="row justify-content-center quote-workspace">
    <div class="col-xl-11">
        <div class="card shadow-soft mb-3">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h1 class="h3 mb-1">@(Model.IsInternal ? "Prepara tu cotización" : "Conectamos tu siguiente proyecto")</h1>
                        <div class="text-muted">@(Model.IsInternal ? "Selecciona servicios, confirma el contacto y envía tu propuesta." : "Elige lo que necesitas. Te ayudaremos a definir la solución adecuada.")</div>
                    </div>
                    <span class="badge text-bg-light border">@(Model.IsEditMode ? $"Editando {Model.EditFolio}" : "Nueva cotizacion")</span>
                </div>

                @if (Model.HasClientContext)
                {
                    <div class="alert alert-info py-2">
                        Cliente detectado: <strong>@Model.ClientName</strong>.
                        <span>Puedes ajustar los datos de contacto en Contacto.</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <div class="quote-steps mb-3">
                    <button type="button" class="quote-step-pill active" data-step-pill="2">1. Servicios</button>
                    <button type="button" class="quote-step-pill" data-step-pill="3">2. Contacto</button>
                    <button type="button" class="quote-step-pill" data-step-pill="4">3. Revisar y enviar</button>
                </div>

                <form method="post" id="quoteForm" class="row g-3" novalidate>
                    <input type="hidden" asp-for="PublicMode" />
                    <div id="quoteFeedback" class="alert alert-warning d-none" role="alert" tabindex="-1"></div>
                    <input type="hidden" asp-for="Input.ClientToken" />
                    <input type="hidden" asp-for="Input.EditQuoteId" />
                    <input type="hidden" asp-for="Input.SelectedClientId" id="selectedClientId" />
                    <input type="hidden" asp-for="Input.LinesJson" id="linesJson" />
                    <input type="hidden" asp-for="Input.ManualLinesJson" id="manualLinesJson" />
                    <input type="hidden" asp-for="Input.GlobalDiscountType" id="globalDiscountTypeHidden" />
                    <input type="hidden" asp-for="Input.GlobalDiscountValue" id="globalDiscountValueHidden" />
                    <input type="hidden" id="skipClientDataStep" value="@(Model.SkipClientDataStep ? "1" : "0")" />

                    <section class="quote-step-panel" data-step="2">
                        <div class="quote-segment-bar mb-4">
                            <div><label class="form-label" for="segmentSelect">¿Para qué necesitas el servicio?</label>
                            <select class="form-select" asp-for="Input.Segment" id="segmentSelect"><option value="Residential">Mi hogar</option><option value="Business">Mi empresa</option><option value="Events">Un evento</option></select></div>
                            <div class="flex-grow-1"><label class="form-label" for="serviceSearch">Encuentra un servicio</label><input type="search" id="serviceSearch" class="form-control" placeholder="Internet, WiFi, cámaras…" /></div>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-lg-8">
                                <div class="card border-0 bg-light-subtle">
                                    <div class="card-body">
                                        <div class="fw-semibold mb-2">Categorias</div>
                                        <div id="categoryCards" class="hn-grid-cards"></div>
                                    </div>
                                </div>

                                <div class="card border-0 bg-light-subtle mt-3">
                                    <div class="card-body">
                                        <div class="fw-semibold mb-2">Servicios</div>
                                        <div id="serviceCards" class="hn-grid-cards"></div>
                                    </div>
                                </div>

                                <div class="card border-0 bg-light-subtle mt-3">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="fw-semibold">Configura tu selección</div>
                                            <span class="small text-muted">Cantidad y características</span>
                                        </div>
                                        <div id="subproductCards" class="hn-grid-cards"></div>
                                        <div class="row g-2 mt-2">
                                            <div class="col-sm-4 col-md-3">
                                                <label class="form-label mb-1">Cantidad</label>
                                                <input class="form-control" type="number" id="qtyInput" min="1" value="1" />
                                            </div>
                                            <div class="col-sm-8 col-md-5 d-flex align-items-end">
                                                <button class="btn btn-primary w-100" type="button" id="addLineBtn">Agregar a mi selección</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <details class="card border-0 bg-light-subtle mt-3 @(Model.IsInternal ? "" : "d-none")">
                                    <summary class="p-3 fw-semibold">Agregar un concepto personalizado</summary>
                                    <div class="card-body">
                                        <div class="row g-2">
                                            <div class="col-md-2">
                                                <input id="manualService" class="form-control" placeholder="Servicio" />
                                            </div>
                                            <div class="col-md-4">
                                                <input id="manualDescription" class="form-control" placeholder="Descripcion del concepto" />
                                            </div>
                                            <div class="col-md-2">
                                                <select id="manualRecurrence" class="form-select">
                                                    <option value="Unica">Unica</option>
                                                    <option value="Semanal">Semanal</option>
                                                    <option value="Mensual">Mensual</option>
                                                    <option value="Anual">Anual</option>
                                                    <option value="Otro">Otro</option>
                                                </select>
                                            </div>
                                            <div class="col-md-1">
                                                <input id="manualQty" class="form-control" type="number" min="1" value="1" />
                                            </div>
                                            <div class="col-md-3">
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input id="manualPrice" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" />
                                                </div>
                                            </div>
                                            <div class="col-12 d-grid d-md-flex justify-content-md-end">
                                                <button class="btn btn-outline-primary" type="button" id="addManualBtn">Agregar libre</button>
                                            </div>
                                        </div>
                                        <hr />
                                        <div class="small text-muted mt-2">Solo para personal autorizado. Importes sin IVA.</div>
                                    </div>
                                </details>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="card border-primary-subtle quote-summary">
                                    <div class="card-header bg-white fw-semibold">Tu selección</div>
                                    <div class="card-body">
                                        <div id="cartLines" class="vstack gap-2"></div>
                                        <div id="emptyCart" class="text-muted">Selecciona un servicio y agrégalo aquí.</div>
                                        <hr />
                                        <div class="row g-2 mb-2 @(Model.IsInternal ? "" : "d-none")">
                                            <div class="col-6">
                                                <label class="form-label mb-1 small">Descuento global</label>
                                                <select class="form-select form-select-sm" id="discountType">
                                                    <option value="none">Sin descuento</option>
                                                    <option value="percent">Porcentaje (%)</option>
                                                    <option value="amount">Monto ($)</option>
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label mb-1 small">Valor</label>
                                                <input class="form-control form-control-sm" type="number" id="discountValue" min="0" step="0.01" value="0" />
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between small"><span class="text-muted">Subtotal</span><strong id="sumBase">$0.00</strong></div>
                                        <div class="d-flex justify-content-between small"><span class="text-muted">IVA 16%</span><strong id="sumVat">$0.00</strong></div>
                                        <div class="d-flex justify-content-between small @(Model.IsInternal ? "" : "d-none")"><span class="text-muted">Descuento global</span><strong id="sumDiscount">-$0.00</strong></div>
                                        <div class="d-flex justify-content-between mt-1 pt-1 border-top"><span class="fw-semibold">Total</span><strong class="text-primary" id="sumTotal">$0.00</strong></div>
                                        <div class="mt-2"><span class="badge text-bg-warning" id="manualBadge">Por confirmar: 0</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="quote-step-panel d-none" data-step="3">
                        <div class="row g-3">
                                <div class="col-12 @(Model.IsInternal ? "" : "d-none")">
                                    <label class="form-label">Usar datos de un cliente o prospecto</label>
                                    <select class="form-select" id="prospectSelect">
                                        <option value="">Nuevo cliente</option>
                                        @foreach (var p in Model.ProspectOptions)
                                        {
                                            <option value="@p.Id">
                                                [@(p.IsTemporaryLead ? "Prospecto" : "Cliente")] @p.Name
                                            </option>
                                        }
                                    </select>
                                    <div class="small text-muted">Selecciona un prospecto o cliente propio, o usa "Nuevo cliente".</div>
                                </div>
                                <div class="col-12 d-none" id="clientContactWrap">
                                    <label class="form-label">Contacto de envío</label>
                                    <select class="form-select" id="clientContactSelect">
                                        <option value="">Selecciona contacto</option>
                                        <option value="__manual__">Otro contacto (captura manual)</option>
                                    </select>
                                    <div class="small text-muted">Si el cliente tiene varios contactos, selecciona aquí a quién enviar la cotización.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Nombre</label>
                                    <input class="form-control" asp-for="Input.CustomerName" autocomplete="name" maxlength="180" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Correo</label>
                                    <input class="form-control" asp-for="Input.CustomerEmail" type="email" autocomplete="email" maxlength="254" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Telefono</label>
                                    <input class="form-control" asp-for="Input.CustomerPhone" type="tel" autocomplete="tel" maxlength="40" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Ubicacion</label>
                                    <input class="form-control" asp-for="Input.CustomerLocation" autocomplete="street-address" maxlength="500" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Empresa (opcional)</label>
                                    <input class="form-control" asp-for="Input.CompanyName" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Comentarios (opcional)</label>
                                    <textarea class="form-control" asp-for="Input.Notes" rows="3"></textarea>
                                </div>
                                <div class="col-md-8 @(Model.IsInternal ? "" : "d-none")">
                                    <label class="form-label">Condiciones generales</label>
                                    <textarea class="form-control" asp-for="Input.GeneralTerms" rows="3" placeholder="Alcances, terminos de soporte, garantias y condiciones comerciales."></textarea>
                                </div>
                                <div class="col-md-4 @(Model.IsInternal ? "" : "d-none")">
                                    <label class="form-label">Tiempo de contrato</label>
                                    <select class="form-select" asp-for="Input.ContractTermMonths">
                                        <option value="">Sin plazo fijo</option>
                                        <option value="12">12 meses</option>
                                        <option value="18">18 meses</option>
                                        <option value="24">24 meses</option>
                                        <option value="36">36 meses</option>
                                    </select>
                                </div>
                            </div>
                    </section>

                    <section class="quote-step-panel d-none" data-step="4">
                        <div class="alert alert-light border">
                            <div class="fw-semibold">Confirmacion final</div>
                            <div class="text-muted">@(Model.IsInternal ? "Confirma los conceptos y el destinatario antes de enviar." : "Revisa tu selección y el correo donde recibirás la cotización. Los servicios sin precio requieren confirmación comercial.")</div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Conceptos</div><div class="fw-semibold" id="confirmLinesCount">0</div></div></div>
                            <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Subtotal sin IVA</div><div class="fw-semibold" id="confirmBase">$0.00</div></div></div>
                            <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">IVA 16%</div><div class="fw-semibold" id="confirmVat">$0.00</div></div></div>
                            <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Total c/IVA</div><div class="fw-semibold" id="confirmTotal">$0.00</div></div></div>
                        </div>

                        <div id="confirmSelection" class="vstack gap-2 mb-3"></div>
                        <div id="confirmContact" class="border rounded-3 p-3 mb-3"></div>
                        <div class="d-flex justify-content-end @(Model.IsInternal ? "" : "d-none")">
                            <button type="submit" class="btn btn-outline-primary" formaction="?handler=Preview" formtarget="_blank" id="previewBtn">Ver PDF previo</button>
                        </div>
                    </section>

                    <div class="col-12 d-flex justify-content-between align-items-center mt-3">
                        <button type="button" class="btn btn-outline-secondary" id="prevStepBtn">Anterior</button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary" id="nextStepBtn">Siguiente</button>
                            <button type="submit" class="btn btn-success d-none" id="submitBtn">@(Model.IsInternal ? "Generar y enviar cotización" : "Enviar solicitud de cotización")</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const payload = @Html.Raw(catalogJson);
    const prospects = @Html.Raw(prospectsJson);
    const contactsByClient = @Html.Raw(contactsJson);
    const safeParse = value => { try { return JSON.parse(value); } catch { return []; } };
    const initialManual = safeParse(@Html.Raw(JsonSerializer.Serialize(Model.InitialManualLinesJson)));
    const initialPicks = safeParse(@Html.Raw(JsonSerializer.Serialize(Model.Input.LinesJson)));
    const internalMode = @Html.Raw(Model.IsInternal ? "true" : "false");
    // Nunca saltar el paso de datos del cliente, aunque llegue token precargado.
    const skipClientDataStep = false;
    const IVA = 0.16;
    const lines = [];
    const manualLines = Array.isArray(initialManual)
        ? initialManual.map(x => ({
            categoryName: x.categoryName ?? x.CategoryName ?? 'Libre',
            serviceName: x.serviceName ?? x.ServiceName ?? 'Servicio',
            description: x.description ?? x.Description ?? '',
            quantity: x.quantity ?? x.Quantity ?? 1,
            unitPrice: x.unitPrice ?? x.UnitPrice ?? 0,
            recurrence: x.recurrence ?? x.Recurrence ?? 'Unica'
        }))
        : [];

    const allSteps = [2,3,4];
    const navSteps = allSteps;
    let currentStep = navSteps[0];

    const seg = document.getElementById('segmentSelect');
    const qty = document.getElementById('qtyInput');
    const addBtn = document.getElementById('addLineBtn');
    const linesJson = document.getElementById('linesJson');
    const manualLinesJson = document.getElementById('manualLinesJson');
    const addManualBtn = document.getElementById('addManualBtn');
    const manualService = document.getElementById('manualService');
    const manualDescription = document.getElementById('manualDescription');
    const manualRecurrence = document.getElementById('manualRecurrence');
    const manualQty = document.getElementById('manualQty');
    const manualPrice = document.getElementById('manualPrice');
    const prospectSelect = document.getElementById('prospectSelect');
    const clientContactWrap = document.getElementById('clientContactWrap');
    const clientContactSelect = document.getElementById('clientContactSelect');
    const selectedClientId = document.getElementById('selectedClientId');
    const inputCustomerName = document.getElementById('Input_CustomerName');
    const inputCustomerEmail = document.getElementById('Input_CustomerEmail');
    const inputCustomerPhone = document.getElementById('Input_CustomerPhone');
    const inputCustomerLocation = document.getElementById('Input_CustomerLocation');
    const inputCompanyName = document.getElementById('Input_CompanyName');
    const categoryCards = document.getElementById('categoryCards');
    const serviceCards = document.getElementById('serviceCards');
    const subproductCards = document.getElementById('subproductCards');
    const cartLines = document.getElementById('cartLines');
    const emptyCart = document.getElementById('emptyCart');

    const manualBadge = document.getElementById('manualBadge');
    const sumBase = document.getElementById('sumBase');
    const sumVat = document.getElementById('sumVat');
    const sumDiscount = document.getElementById('sumDiscount');
    const sumTotal = document.getElementById('sumTotal');
    const discountType = document.getElementById('discountType');
    const discountValue = document.getElementById('discountValue');
    const globalDiscountTypeHidden = document.getElementById('globalDiscountTypeHidden');
    const globalDiscountValueHidden = document.getElementById('globalDiscountValueHidden');
    const prevStepBtn = document.getElementById('prevStepBtn');
    const nextStepBtn = document.getElementById('nextStepBtn');
    const submitBtn = document.getElementById('submitBtn');

    let selectedCategoryId = null;
    let selectedServiceId = null;
    let selectedSubproductId = null;

    if(skipClientDataStep){
        ['Input_CustomerName','Input_CustomerEmail','Input_CustomerPhone','Input_CustomerLocation','Input_CompanyName']
            .forEach(id => {
                const el = document.getElementById(id);
                if(el) el.readOnly = true;
            });
        const pill3 = document.querySelector('[data-step-pill="3"]');
        if(pill3) pill3.classList.add('is-skipped');
    }

    function lockCustomerFields(lock){
        [inputCustomerName, inputCustomerEmail, inputCustomerPhone, inputCustomerLocation, inputCompanyName]
            .forEach(el => {
                if(!el) return;
                el.readOnly = !!lock;
                el.classList.toggle('bg-light', !!lock);
            });
    }

    function onProspectChange(){
        if(!prospectSelect || skipClientDataStep) return;
        const selectedId = prospectSelect.value;
        if(!selectedId){
            if(selectedClientId) selectedClientId.value = '';
            if(clientContactWrap) clientContactWrap.classList.add('d-none');
            if(clientContactSelect) clientContactSelect.value = '';
            lockCustomerFields(false);
            return;
        }
        const p = (prospects || []).find(x => String(x.id || x.Id) === String(selectedId));
        if(!p){
            if(selectedClientId) selectedClientId.value = '';
            if(clientContactWrap) clientContactWrap.classList.add('d-none');
            if(clientContactSelect) clientContactSelect.value = '';
            lockCustomerFields(false);
            return;
        }
        if(selectedClientId) selectedClientId.value = selectedId;
        if(inputCustomerName) inputCustomerName.value = p.mainContactName || p.MainContactName || p.name || p.Name || '';
        if(inputCustomerEmail) inputCustomerEmail.value = p.email || p.Email || '';
        if(inputCustomerPhone) inputCustomerPhone.value = p.phone || p.Phone || '';
        if(inputCustomerLocation) inputCustomerLocation.value = p.location || p.Location || '';
        if(inputCompanyName) inputCompanyName.value = p.companyName || p.CompanyName || '';
        const clientContacts = contactsByClient?.[selectedId] || contactsByClient?.[String(selectedId)] || [];
        if(clientContactSelect){
            const keepFirst = '<option value="">Selecciona contacto</option>';
            const keepManual = '<option value="__manual__">Otro contacto (captura manual)</option>';
            clientContactSelect.innerHTML = keepFirst + keepManual;
            (clientContacts || []).forEach(c => {
                const id = c.id || c.Id;
                const name = c.name || c.Name || 'Contacto';
                const email = c.email || c.Email || '';
                const phone = c.phone || c.Phone || '';
                const role = c.role || c.Role || 'Contacto';
                const opt = document.createElement('option');
                opt.value = String(id);
                opt.textContent = `${name} · ${role}${email ? ' · ' + email : ''}`;
                opt.dataset.name = name;
                opt.dataset.email = email;
                opt.dataset.phone = phone;
                clientContactSelect.appendChild(opt);
            });
            if((clientContacts || []).length > 0){
                clientContactSelect.value = String(clientContacts[0].id || clientContacts[0].Id || '');
            } else {
                clientContactSelect.value = '__manual__';
            }
        }
        if(clientContactWrap){
            clientContactWrap.classList.remove('d-none');
        }
        onClientContactChange();
    }

    function onClientContactChange(){
        if(!clientContactSelect || skipClientDataStep) return;
        const v = clientContactSelect.value;
        if(v === '__manual__'){
            lockCustomerFields(false);
            return;
        }
        if(!v){
            lockCustomerFields(false);
            return;
        }
        const opt = clientContactSelect.options[clientContactSelect.selectedIndex];
        if(!opt){
            lockCustomerFields(false);
            return;
        }
        if(inputCustomerName) inputCustomerName.value = opt.dataset.name || inputCustomerName.value;
        if(inputCustomerEmail) inputCustomerEmail.value = opt.dataset.email || inputCustomerEmail.value;
        if(inputCustomerPhone) inputCustomerPhone.value = opt.dataset.phone || inputCustomerPhone.value;
        lockCustomerFields(false);
    }

    if(prospectSelect && !skipClientDataStep){
        prospectSelect.addEventListener('change', onProspectChange);
    }
    if(clientContactSelect && !skipClientDataStep){
        clientContactSelect.addEventListener('change', onClientContactChange);
    }
    if(discountType){
        discountType.addEventListener('change', recalc);
    }
    if(discountValue){
        discountValue.addEventListener('input', recalc);
    }

    function toMoney(v){
        return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v || 0);
    }

    function labelOffer(offer){
        if(offer === 'MonthlyRent') return 'Renta mensual';
        if(offer === 'Lease') return 'Arrendamiento';
        return 'Venta';
    }

    function getSegmentData(){
        return payload[seg.value] || { categories: [], services: [], subproducts: [], rules: [] };
    }

    function selectedIdsSet(){
        const ids = new Set();
        lines.forEach(x => {
            ids.add(String(x.categoryId));
            ids.add(String(x.serviceId));
            if(x.subproductId) ids.add(String(x.subproductId));
        });
        return ids;
    }

    function isAllowedByRules(itemId){
        const s = getSegmentData();
        const rules = (s.rules || []).filter(r => String(r.targetItemId) === String(itemId));
        if (rules.length === 0) return true;
        const selected = selectedIdsSet();
        return rules.some(r => selected.has(String(r.requiredItemId)));
    }

    function escapeHtml(value){ const el = document.createElement('span'); el.textContent = String(value ?? ''); return el.innerHTML.replaceAll('"','&quot;').replaceAll("'",'&#39;'); }
    function safeImage(value){ try { const u = new URL(value, location.origin); return ['http:','https:'].includes(u.protocol) ? escapeHtml(u.href) : ''; } catch { return ''; } }
    function feedback(message){ const box = document.getElementById('quoteFeedback'); box.textContent = message; box.classList.remove('d-none'); box.focus(); }
    function cardHtml(item, active, extra){
        const img = item.imageUrl ? `<img src="${safeImage(item.imageUrl)}" alt="img" />` : `<div class="hn-thumb-fallback">${escapeHtml(item.name.substring(0,2).toUpperCase())}</div>`;
        return `
        <button type="button" class="hn-card-select ${active ? 'is-active' : ''}" data-id="${item.id}">
            <div class="hn-thumb">${img}</div>
            <div class="hn-body">
                <div class="hn-name">${escapeHtml(item.name)}</div>
                ${item.description ? `<div class="hn-desc">${escapeHtml(item.description)}</div>` : ''}
                ${extra || ''}
            </div>
        </button>`;
    }

    function renderCategories(){
        const s = getSegmentData();
        const rows = s.categories.filter(x => isAllowedByRules(x.id));
        if(!rows.length){ categoryCards.innerHTML = '<div class="text-muted">Sin categorias para este segmento.</div>'; return; }
        if(!selectedCategoryId && rows[0]) selectedCategoryId = rows[0].id;
        categoryCards.innerHTML = rows.map(x => cardHtml(x, String(selectedCategoryId) === String(x.id), '')).join('');
        categoryCards.querySelectorAll('button[data-id]').forEach(btn => {
            btn.addEventListener('click', () => {
                selectedCategoryId = btn.dataset.id;
                document.getElementById('serviceSearch').value = '';
                selectedServiceId = null;
                selectedSubproductId = null;
                renderCategories();
                renderServices();
                renderSubproducts();
            });
        });
        if(!selectedCategoryId && rows[0]) selectedCategoryId = rows[0].id;
    }

    function renderServices(){
        const s = getSegmentData();
        const term = document.getElementById('serviceSearch').value.trim().toLocaleLowerCase('es');
        const rows = s.services.filter(x => (term || x.parentId === selectedCategoryId) && isAllowedByRules(x.id) && (!term || (x.name + ' ' + (x.description || '')).toLocaleLowerCase('es').includes(term)));
        if(!rows.length){ serviceCards.innerHTML = '<div class="text-muted">No encontramos servicios. Prueba otra búsqueda o categoría.</div>'; selectedServiceId = null; return; }
        if(!selectedServiceId && rows[0]) { selectedServiceId = rows[0].id; if(term) { selectedCategoryId = rows[0].parentId; renderCategories(); } }
        serviceCards.innerHTML = rows.map(x => {
            const price = x.isManualPrice || x.unitPrice == null ? 'Por confirmar' : toMoney(Number(x.unitPrice) * (x.unitPriceIncludesVat ? 1 : 1 + IVA)) + ' IVA incluido';
            const extra = `<div class="mt-2 fw-semibold text-primary">${price}</div><div class="mt-1"><span class="badge text-bg-light border">${labelOffer(x.offerType)}</span></div>`;
            return cardHtml(x, String(selectedServiceId) === String(x.id), extra);
        }).join('');
        serviceCards.querySelectorAll('button[data-id]').forEach(btn => {
            btn.addEventListener('click', () => {
                selectedServiceId = btn.dataset.id;
                selectedCategoryId = find(s.services, selectedServiceId)?.parentId;
                renderCategories();
                selectedSubproductId = null;
                renderServices();
                renderSubproducts();
            });
        });
        if(!selectedServiceId && rows[0]) selectedServiceId = rows[0].id;
    }

    function renderSubproducts(){
        const s = getSegmentData();
        const rows = s.subproducts.filter(x => x.parentId === selectedServiceId && isAllowedByRules(x.id));
        if(!selectedServiceId){ subproductCards.innerHTML = '<div class="text-muted">Selecciona un servicio.</div>'; return; }
        if(!rows.length){ subproductCards.innerHTML = '<div class="text-muted">Indica cuántos necesitas y agrega el servicio a tu selección.</div>'; return; }
        if(!selectedSubproductId && rows[0]) selectedSubproductId = rows[0].id;
        subproductCards.innerHTML = rows.map(x => {
            const priceTxt = x.isManualPrice || x.unitPrice == null ? 'Precio por confirmar' : `${toMoney(x.unitPrice)} ${x.unitPriceIncludesVat ? '(IVA incl.)' : '+ IVA'}`;
            const variantTxt = (x.variantGroup || x.variantValue) ? `<span class="badge text-bg-light border">${escapeHtml((x.variantGroup || 'Variante'))}: ${escapeHtml(x.variantValue || '-')}</span>` : '';
            const extra = `<div class="d-flex gap-1 flex-wrap mt-1"><span class="badge text-bg-light border">${labelOffer(x.offerType)}</span>${variantTxt}<span class="badge text-bg-secondary">${priceTxt}</span></div>`;
            return cardHtml(x, String(selectedSubproductId) === String(x.id), extra);
        }).join('');
        subproductCards.querySelectorAll('button[data-id]').forEach(btn => {
            btn.addEventListener('click', () => {
                selectedSubproductId = btn.dataset.id;
                renderSubproducts();
            });
        });
        if(!selectedSubproductId && rows[0]) selectedSubproductId = rows[0].id;
    }

    function readProp(obj, camel, pascal){
        if(!obj) return undefined;
        return obj[camel] ?? obj[pascal];
    }

    function find(arr, id){
        return arr.find(x => String(readProp(x, 'id', 'Id')) === String(id));
    }

    function toNumber(value){
        if (value == null) return 0;
        if (typeof value === 'number') return Number.isFinite(value) ? value : 0;
        const normalized = String(value).replace(/,/g, '').trim();
        const parsed = Number(normalized);
        return Number.isFinite(parsed) ? parsed : 0;
    }

    function totals(){
        const catalogBase = lines.filter(x => !x.isManual).reduce((a,b) => a + b.base, 0);
        const catalogVat = lines.filter(x => !x.isManual).reduce((a,b) => a + b.vat, 0);
        const catalogTotal = lines.filter(x => !x.isManual).reduce((a,b) => a + b.total, 0);
        const manualBase = manualLines.reduce((a, b) => a + (toNumber(b.unitPrice) * Math.max(1, toNumber(b.quantity))), 0);
        const manualVat = manualBase * IVA;
        const manualTotal = manualBase + manualVat;
        const manual = lines.filter(x => x.isManual).length + manualLines.length;
        const preDiscountTotal = catalogTotal + manualTotal;
        const mode = String(discountType?.value || 'none').toLowerCase();
        const value = Number(discountValue?.value || 0);
        let discount = 0;
        if (mode === 'percent' && value > 0) {
            discount = Math.min(preDiscountTotal, preDiscountTotal * (value / 100));
        } else if (mode === 'amount' && value > 0) {
            discount = Math.min(preDiscountTotal, value);
        }
        return {
            base: (catalogBase + manualBase) - discount,
            vat: catalogVat + manualVat,
            total: preDiscountTotal - discount,
            manual,
            discount,
            discountMode: mode,
            discountValue: value
        };
    }

    function recalc(){
        const t = totals();
        if(sumBase) sumBase.textContent = toMoney(t.base);
        if(sumVat) sumVat.textContent = toMoney(t.vat);
        if(sumDiscount) sumDiscount.textContent = '-' + toMoney(t.discount || 0);
        if(sumTotal) sumTotal.textContent = lines.length && lines.every(x=>x.isManual) && !manualLines.length ? 'Por confirmar' : toMoney(t.total);
        manualBadge.textContent = 'Precio por confirmar: ' + lines.filter(x => x.isManual).length;
        manualBadge.classList.toggle('d-none', !lines.some(x => x.isManual));
        if(globalDiscountTypeHidden) globalDiscountTypeHidden.value = t.discountMode || 'none';
        if(globalDiscountValueHidden) globalDiscountValueHidden.value = String(t.discountValue || 0);
        linesJson.value = JSON.stringify(lines.map(x => ({
            categoryId: x.categoryId,
            serviceId: x.serviceId,
            subproductId: x.subproductId || null,
            quantity: x.quantity
        })));
        manualLinesJson.value = JSON.stringify(manualLines.map(x => ({
            categoryName: x.categoryName,
            serviceName: x.serviceName,
            description: x.description,
            quantity: x.quantity,
            unitPrice: x.unitPrice,
            recurrence: x.recurrence
        })));

        const cLines = document.getElementById('confirmLinesCount');
        const cBase = document.getElementById('confirmBase');
        const cVat = document.getElementById('confirmVat');
        const cTotal = document.getElementById('confirmTotal');
        if(cLines) cLines.textContent = String(lines.length + manualLines.length);
        if(cBase) cBase.textContent = toMoney(t.base);
        if(cVat) cVat.textContent = toMoney(t.vat);
        if(cTotal) cTotal.textContent = sumTotal.textContent;
    }

    function renderCart(){
        cartLines.innerHTML = '';
        if(!lines.length && !manualLines.length){ emptyCart.classList.remove('d-none'); recalc(); return; }
        emptyCart.classList.add('d-none');
        lines.forEach((l, idx) => {
            const div = document.createElement('div');
            div.className = 'hn-cart-line';
            div.innerHTML = `
                <div class="d-flex justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">${escapeHtml(l.serviceName)}</div>
                        <div class="small text-muted">${escapeHtml(l.categoryName)}${escapeHtml(l.subproductName ? ' · ' + l.subproductName : '')}</div>
                        <div class="small d-flex gap-1 flex-wrap">
                            <span class="badge text-bg-light border">${labelOffer(l.offerType)}</span>
                            <span class="badge text-bg-info">${escapeHtml(l.recurrence || 'Unica')}</span>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-del="${idx}">Quitar</button>
                </div>
                <div class="small mt-1 d-flex justify-content-between text-muted"><span>Cant: ${l.quantity}</span><span>${l.isManual ? 'Por confirmar' : toMoney(l.total)}</span></div>
            `;
            cartLines.appendChild(div);
        });
        cartLines.querySelectorAll('button[data-del]').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = Number(btn.getAttribute('data-del'));
                lines.splice(idx, 1);
                renderCart();
                renderServices();
                renderSubproducts();
            });
        });

        manualLines.forEach((l, idx) => {
            const div = document.createElement('div');
            div.className = 'hn-cart-line';
            div.innerHTML = `
                <div class="d-flex justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">${escapeHtml(l.serviceName || 'Concepto libre')}</div>
                        <div class="small text-muted">${escapeHtml(l.categoryName || 'Libre')} · ${escapeHtml(l.description || '')}</div>
                        <div class="small d-flex gap-1 flex-wrap">
                            <span class="badge text-bg-warning">Manual</span>
                            <span class="badge text-bg-info">${escapeHtml(l.recurrence || 'Unica')}</span>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-del-manual="${idx}">Quitar</button>
                </div>
                <div class="small mt-1 d-flex justify-content-between text-muted"><span>Cant: ${l.quantity} · + IVA</span><span>${toMoney((toNumber(l.unitPrice) * Math.max(1, toNumber(l.quantity))) * (1 + IVA))}</span></div>
            `;
            cartLines.appendChild(div);
        });
        cartLines.querySelectorAll('button[data-del-manual]').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = Number(btn.getAttribute('data-del-manual'));
                manualLines.splice(idx, 1);
                renderCart();
            });
        });
        recalc();
    }

    function showStep(step){
        currentStep = step;
        document.getElementById('quoteFeedback').classList.add('d-none');
        if(step === 4){
            const review = document.getElementById('confirmSelection'); review.replaceChildren();
            [...lines, ...manualLines].forEach(x => { const row = document.createElement('div'); row.className = 'border rounded-3 p-3'; row.textContent = `${x.quantity} × ${x.serviceName}${x.subproductName ? ' · '+x.subproductName : ''}`; review.append(row); });
            document.getElementById('confirmContact').textContent = `${inputCustomerName.value} · ${inputCustomerEmail.value} · ${inputCustomerPhone.value} · ${inputCustomerLocation.value}`;
        }
        document.querySelectorAll('.quote-step-panel').forEach(p => {
            p.classList.toggle('d-none', Number(p.getAttribute('data-step')) !== currentStep);
        });
        document.querySelectorAll('[data-step-pill]').forEach(p => {
            p.classList.toggle('active', Number(p.getAttribute('data-step-pill')) === currentStep);
        });

        const idx = navSteps.indexOf(currentStep);
        prevStepBtn.disabled = idx <= 0;
        nextStepBtn.classList.toggle('d-none', idx === navSteps.length - 1);
        submitBtn.classList.toggle('d-none', idx !== navSteps.length - 1);
        recalc();
    }

    function validateStep(step){
        if(step === 2 && lines.length === 0 && manualLines.length === 0){
            feedback('Agrega al menos un servicio antes de continuar.');
            return false;
        }
        if(step === 3 && !skipClientDataStep){
            const required = ['Input_CustomerName','Input_CustomerEmail','Input_CustomerPhone','Input_CustomerLocation'];
            for(const id of required){
                const el = document.getElementById(id);
                if(!el || !String(el.value || '').trim() || !el.checkValidity()){
                    feedback('Completa los campos obligatorios de contacto.'); el?.focus();
                    return false;
                }
            }
        }
        return true;
    }

    function goNext(){
        const idx = navSteps.indexOf(currentStep);
        if(idx < 0 || idx >= navSteps.length - 1) return;
        if(!validateStep(currentStep)) return;
        showStep(navSteps[idx + 1]);
    }

    function goPrev(){
        const idx = navSteps.indexOf(currentStep);
        if(idx <= 0) return;
        showStep(navSteps[idx - 1]);
    }

    addBtn.addEventListener('click', () => {
        const s = getSegmentData();
        const category = find(s.categories, selectedCategoryId);
        const service = find(s.services, selectedServiceId);
        if(!category || !service){
            feedback('Selecciona una categoría y un servicio.');
            return;
        }

        const subItem = selectedSubproductId ? find(s.subproducts, selectedSubproductId) : null;
        const selected = subItem || service;
        const isManual = !!selected.isManualPrice || selected.unitPrice == null;
        const unit = Number(selected.unitPrice || 0);
        const q = Number(qty.value || 1);
        if(!Number.isInteger(q) || q < 1 || q > 10000){feedback('Usa una cantidad entera entre 1 y 10,000.'); return;}
        const includesVat = !!selected.unitPriceIncludesVat;

        let base = 0, vat = 0, total = 0;
        if(!isManual){
            const raw = unit * q;
            if(includesVat){
                total = raw;
                base = total / (1 + IVA);
                vat = total - base;
            } else {
                base = raw;
                vat = base * IVA;
                total = base + vat;
            }
        }

        lines.push({
            categoryId: category.id,
            serviceId: service.id,
            subproductId: subItem ? subItem.id : null,
            categoryName: category.name,
            serviceName: service.name,
            subproductName: subItem ? subItem.name : '',
            quantity: q,
            unitPrice: unit,
            includesVat,
            base,
            vat,
            total,
            isManual,
            offerType: selected.offerType || 'Sale',
            recurrence: selected.offerType === 'MonthlyRent'
                ? 'Mensual'
                : (selected.offerType === 'Lease' ? 'Mensual' : 'Unica')
        });

        renderCart();
        renderServices();
        renderSubproducts();
    });

    addManualBtn.addEventListener('click', () => {
        const serviceTxt = String(manualService.value || '').trim();
        const description = String(manualDescription.value || '').trim();
        if(!description && !serviceTxt){
            alert('Escribe al menos servicio o descripcion.');
            return;
        }
        const qtyVal = Math.max(1, Number(manualQty.value || 1));
        const priceVal = Math.max(0, Number(manualPrice.value || 0));
        manualLines.push({
            categoryName: 'Libre',
            serviceName: serviceTxt,
            description: description || serviceTxt || 'Concepto libre',
            quantity: qtyVal,
            unitPrice: priceVal,
            recurrence: String(manualRecurrence?.value || 'Unica')
        });
        manualDescription.value = '';
        manualPrice.value = '';
        manualQty.value = '1';
        renderCart();
    });

    document.getElementById('serviceSearch').addEventListener('input', () => { selectedServiceId = null; selectedSubproductId = null; renderServices(); renderSubproducts(); });
    document.querySelectorAll('[data-step-pill]').forEach(button => button.addEventListener('click', () => { const target = Number(button.dataset.stepPill); if(target > currentStep && (!validateStep(2) || (target === 4 && !validateStep(3)))) return; showStep(target); }));
    document.getElementById('quoteForm').addEventListener('submit', e => {
        if(!validateStep(2)){e.preventDefault(); showStep(2); feedback('Agrega al menos un servicio.'); return;}
        if(!validateStep(3)){e.preventDefault(); showStep(3); feedback('Revisa los datos de contacto y el formato del correo.'); return;}
        if(e.submitter?.id !== 'previewBtn') { if(currentStep !== 4){e.preventDefault();showStep(4);return;} submitBtn.disabled = true; submitBtn.textContent = 'Enviando…'; }
    });
    prevStepBtn.addEventListener('click', goPrev);
    nextStepBtn.addEventListener('click', goNext);

    let previousSegment = seg.value;
    seg.addEventListener('change', () => {
        if(lines.length && !confirm('Cambiar de tipo vaciará los servicios seleccionados. ¿Continuar?')){seg.value = previousSegment;return;}
        previousSegment = seg.value;
        document.getElementById('serviceSearch').value = '';
        lines.length = 0;
        selectedCategoryId = null;
        selectedServiceId = null;
        selectedSubproductId = null;
        renderCategories();
        renderServices();
        renderSubproducts();
        renderCart();
    });

    renderCategories(); renderServices(); renderSubproducts();
    if(Array.isArray(initialPicks)) initialPicks.forEach(p => {
        selectedCategoryId = p.categoryId ?? p.CategoryId; selectedServiceId = p.serviceId ?? p.ServiceId; selectedSubproductId = p.subproductId ?? p.SubproductId;
        qty.value = p.quantity ?? p.Quantity ?? 1; addBtn.click();
    });
    qty.value = 1; renderCategories(); renderServices(); renderSubproducts(); renderCart();
    if(prospectSelect && selectedClientId.value) prospectSelect.value = selectedClientId.value;
    showStep(navSteps[0]);
})();
</script>

<style>
.quote-workspace .quote-summary{position:sticky;top:20px}.quote-segment-bar{display:flex;gap:1rem;padding:1.2rem;background:#edf4ff;border-radius:14px}.quote-segment-bar>div:first-child{min-width:230px}.quote-workspace h1{letter-spacing:-.04em;font-weight:800}.quote-workspace .card{border-radius:16px}.quote-workspace .hn-card-select{text-align:left;transition:border-color .15s,box-shadow .15s}.quote-workspace .hn-card-select.is-active{box-shadow:0 0 0 2px #2463eb}.quote-workspace .quote-step-pill{cursor:pointer}.quote-workspace .form-label{font-weight:600}.quote-workspace .hn-desc{overflow-wrap:anywhere}
@@media(max-width:767px){.quote-segment-bar{flex-direction:column}.quote-steps{gap:.25rem}.quote-step-pill{font-size:.75rem!important;padding:.6rem .25rem!important}.quote-workspace .card-body.p-4{padding:1rem!important}.quote-workspace .quote-summary{position:static}}

.quote-steps{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:.5rem;
}
.quote-step-pill{
    border:1px solid #dbe3f4;
    background:#f7f9ff;
    color:#64748b;
    border-radius:999px;
    text-align:center;
    padding:.45rem .6rem;
    font-weight:700;
    font-size:.86rem;
}
.quote-step-pill.active{ border-color:#1d4ed8; background:#e8efff; color:#1d4ed8; }
.quote-step-pill.is-skipped{ opacity:.55; }
.quote-step-panel{ min-height: 220px; }
.quote-step-panel .input-group-text{
    background:#eef2ff;
    border-color:#c7d2fe;
    font-weight:700;
    color:#1e3a8a;
}

.hn-grid-cards{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
    gap:.65rem;
}
.hn-card-select{
    width:100%;
    border:1px solid #dbe3f4;
    border-radius:14px;
    background:#fff;
    text-align:left;
    padding:.6rem;
    display:flex;
    gap:.65rem;
    transition:.15s ease;
}
.hn-card-select:hover{ border-color:#93c5fd; box-shadow:0 6px 16px rgba(30,64,175,.08); }
.hn-card-select.is-active{ border-color:#1d4ed8; box-shadow:0 0 0 2px rgba(29,78,216,.12) inset; }
.hn-thumb{ width:62px; min-width:62px; height:62px; border-radius:10px; overflow:hidden; border:1px solid #dbe3f4; background:#f8fafc; display:flex; align-items:center; justify-content:center; }
.hn-thumb img{ width:100%; height:100%; object-fit:cover; }
.hn-thumb-fallback{ font-weight:700; color:#64748b; }
.hn-body{ min-width:0; }
.hn-name{ font-weight:700; color:#0f172a; }
.hn-desc{ font-size:.82rem; color:#64748b; line-height:1.2; margin-top:.2rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }

.hn-cart-line{ border:1px solid #dbe3f4; border-radius:12px; padding:.55rem; }
</style>
}
