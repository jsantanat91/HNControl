@page "/cotizar/{token?}"
@model HNControl.Web.Pages.Public.QuoteModel
@using System.Text.Json
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Cotizacion a la medida";

    var catalogJson = JsonSerializer.Serialize(Model.CatalogPayload);
}

<div class="row justify-content-center">
    <div class="col-xl-11">
        <div class="card shadow-soft mb-3">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h1 class="h3 mb-1">Cotizacion a la medida</h1>
                        <div class="text-muted">Modo tienda: selecciona productos como carrito y recibe PDF por correo.</div>
                    </div>
                    <span class="badge text-bg-light border">Kiosk publico</span>
                </div>

                @if (Model.HasClientContext)
                {
                    <div class="alert alert-info py-2">
                        Cliente detectado: <strong>@Model.ClientName</strong>.
                        @if (Model.SkipClientDataStep)
                        {
                            <span>Datos precargados desde el link.</span>
                        }
                        else
                        {
                            <span>Faltan datos de contacto, completalos en el paso 3.</span>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <div class="quote-steps mb-3">
                    <div class="quote-step-pill active" data-step-pill="1">1. Segmento</div>
                    <div class="quote-step-pill" data-step-pill="2">2. Tienda / carrito</div>
                    <div class="quote-step-pill" data-step-pill="3">3. Datos cliente</div>
                    <div class="quote-step-pill" data-step-pill="4">4. Confirmacion</div>
                </div>

                <form method="post" id="quoteForm" class="row g-3">
                    <input type="hidden" asp-for="Input.ClientToken" />
                    <input type="hidden" asp-for="Input.LinesJson" id="linesJson" />
                    <input type="hidden" asp-for="Input.ManualLinesJson" id="manualLinesJson" />
                    <input type="hidden" id="skipClientDataStep" value="@(Model.SkipClientDataStep ? "1" : "0")" />

                    <section class="quote-step-panel" data-step="1">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Selecciona el tipo de cliente</label>
                                <select class="form-select" asp-for="Input.Segment" id="segmentSelect">
                                    <option value="Residential">Residencial</option>
                                    <option value="Business">Empresarial</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded p-3 h-100 bg-light-subtle">
                                    <div class="fw-semibold">Paso 1 de 4</div>
                                    <div class="text-muted small">Define segmento para mostrar el catalogo correcto (residencial/empresarial).</div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="quote-step-panel d-none" data-step="2">
                        <div class="row g-3">
                            <div class="col-12 col-xxl-8">
                                <div class="card border-0 bg-light-subtle">
                                    <div class="card-body">
                                        <div class="fw-semibold mb-2">Categorias</div>
                                        <div id="categoryCards" class="hn-grid-cards"></div>
                                    </div>
                                </div>

                                <div class="card border-0 bg-light-subtle mt-3">
                                    <div class="card-body">
                                        <div class="fw-semibold mb-2">Servicios</div>
                                        <div id="serviceCards" class="hn-grid-cards"></div>
                                    </div>
                                </div>

                                <div class="card border-0 bg-light-subtle mt-3">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="fw-semibold">Opciones del producto</div>
                                            <span class="small text-muted">Ejemplo: color, tecnologia, capacidad, modalidad</span>
                                        </div>
                                        <div id="subproductCards" class="hn-grid-cards"></div>
                                        <div class="row g-2 mt-2">
                                            <div class="col-sm-4 col-md-3">
                                                <label class="form-label mb-1">Cantidad</label>
                                                <input class="form-control" type="number" id="qtyInput" min="1" value="1" />
                                            </div>
                                            <div class="col-sm-8 col-md-5 d-flex align-items-end">
                                                <button class="btn btn-primary w-100" type="button" id="addLineBtn">Agregar al carrito</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card border-0 bg-light-subtle mt-3">
                                    <div class="card-body">
                                        <div class="fw-semibold mb-2">Concepto libre (manual)</div>
                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <input id="manualCategory" class="form-control" placeholder="Categoria" />
                                            </div>
                                            <div class="col-md-3">
                                                <input id="manualService" class="form-control" placeholder="Servicio" />
                                            </div>
                                            <div class="col-md-4">
                                                <input id="manualDescription" class="form-control" placeholder="Descripcion del concepto" />
                                            </div>
                                            <div class="col-md-1">
                                                <input id="manualQty" class="form-control" type="number" min="1" value="1" />
                                            </div>
                                            <div class="col-md-1">
                                                <input id="manualPrice" class="form-control" type="number" min="0" step="0.01" placeholder="$" />
                                            </div>
                                            <div class="col-12 d-grid d-md-flex justify-content-md-end">
                                                <button class="btn btn-outline-primary" type="button" id="addManualBtn">Agregar libre</button>
                                            </div>
                                        </div>
                                        <hr />
                                        <div class="fw-semibold mb-2">Agregar hardware (inventario)</div>
                                        <div class="row g-2">
                                            <div class="col-md-8">
                                                <select id="inventoryHardwareSelect" class="form-select">
                                                    <option value="">-- Selecciona hardware de inventario --</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <input id="inventoryHardwareQty" class="form-control" type="number" min="1" value="1" />
                                            </div>
                                            <div class="col-md-2 d-grid">
                                                <button class="btn btn-outline-dark" type="button" id="addHardwareBtn">Agregar hardware</button>
                                            </div>
                                        </div>
                                        <div class="fw-semibold mb-2 mt-3">Agregar servicio (catálogo de servicios)</div>
                                        <div class="row g-2">
                                            <div class="col-md-8">
                                                <select id="inventoryServiceSelect" class="form-select">
                                                    <option value="">-- Selecciona servicio --</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <input id="inventoryServiceQty" class="form-control" type="number" min="1" value="1" />
                                            </div>
                                            <div class="col-md-2 d-grid">
                                                <button class="btn btn-outline-primary" type="button" id="addServiceBtn">Agregar servicio</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-xxl-4">
                                <div class="card border-primary-subtle h-100">
                                    <div class="card-header bg-white fw-semibold">Carrito</div>
                                    <div class="card-body">
                                        <div id="cartLines" class="vstack gap-2"></div>
                                        <div id="emptyCart" class="text-muted">Aun no agregas conceptos.</div>
                                        <hr />
                                        <div class="d-flex justify-content-between small"><span class="text-muted">Subtotal</span><strong id="sumBase">$0.00</strong></div>
                                        <div class="d-flex justify-content-between small"><span class="text-muted">IVA 16%</span><strong id="sumVat">$0.00</strong></div>
                                        <div class="d-flex justify-content-between mt-1 pt-1 border-top"><span class="fw-semibold">Total</span><strong class="text-primary" id="sumTotal">$0.00</strong></div>
                                        <div class="mt-2"><span class="badge text-bg-warning" id="manualBadge">Manuales: 0</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="quote-step-panel d-none" data-step="3">
                        @if (Model.SkipClientDataStep)
                        {
                            <div class="alert alert-success mb-0">Los datos del cliente ya vienen cargados por el link publico. Este paso se omite automaticamente.</div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Nombre</label>
                                    <input class="form-control" asp-for="Input.CustomerName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Correo</label>
                                    <input class="form-control" asp-for="Input.CustomerEmail" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Telefono</label>
                                    <input class="form-control" asp-for="Input.CustomerPhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Ubicacion</label>
                                    <input class="form-control" asp-for="Input.CustomerLocation" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Empresa (opcional)</label>
                                    <input class="form-control" asp-for="Input.CompanyName" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Comentarios (opcional)</label>
                                    <textarea class="form-control" asp-for="Input.Notes" rows="3"></textarea>
                                </div>
                            </div>
                        }
                    </section>

                    <section class="quote-step-panel d-none" data-step="4">
                        <div class="alert alert-light border">
                            <div class="fw-semibold">Confirmacion final</div>
                            <div class="text-muted">Revisa resumen, abre PDF previo y luego envia la cotizacion.</div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Conceptos</div><div class="fw-semibold" id="confirmLinesCount">0</div></div></div>
                            <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Subtotal sin IVA</div><div class="fw-semibold" id="confirmBase">$0.00</div></div></div>
                            <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">IVA 16%</div><div class="fw-semibold" id="confirmVat">$0.00</div></div></div>
                            <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Total c/IVA</div><div class="fw-semibold" id="confirmTotal">$0.00</div></div></div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-outline-primary" formaction="?handler=Preview" formtarget="_blank" id="previewBtn">Ver PDF previo</button>
                        </div>
                    </section>

                    <div class="col-12 d-flex justify-content-between align-items-center mt-3">
                        <button type="button" class="btn btn-outline-secondary" id="prevStepBtn">Anterior</button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary" id="nextStepBtn">Siguiente</button>
                            <button type="submit" class="btn btn-success d-none" id="submitBtn">Generar y enviar cotizacion</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const payload = @Html.Raw(catalogJson);
    const skipClientDataStep = document.getElementById('skipClientDataStep')?.value === '1';
    const IVA = 0.16;
    const inventoryHardwareItems = payload.inventoryHardwareItems || [];
    const inventoryServiceItems = payload.inventoryServiceItems || [];
    const lines = [];
    const manualLines = [];

    const allSteps = [1,2,3,4];
    const navSteps = skipClientDataStep ? [1,2,4] : allSteps;
    let currentStep = navSteps[0];

    const seg = document.getElementById('segmentSelect');
    const qty = document.getElementById('qtyInput');
    const addBtn = document.getElementById('addLineBtn');
    const linesJson = document.getElementById('linesJson');
    const manualLinesJson = document.getElementById('manualLinesJson');
    const addManualBtn = document.getElementById('addManualBtn');
    const manualCategory = document.getElementById('manualCategory');
    const manualService = document.getElementById('manualService');
    const manualDescription = document.getElementById('manualDescription');
    const manualQty = document.getElementById('manualQty');
    const manualPrice = document.getElementById('manualPrice');
    const inventoryHardwareSelect = document.getElementById('inventoryHardwareSelect');
    const inventoryHardwareQty = document.getElementById('inventoryHardwareQty');
    const addHardwareBtn = document.getElementById('addHardwareBtn');
    const inventoryServiceSelect = document.getElementById('inventoryServiceSelect');
    const inventoryServiceQty = document.getElementById('inventoryServiceQty');
    const addServiceBtn = document.getElementById('addServiceBtn');
    const categoryCards = document.getElementById('categoryCards');
    const serviceCards = document.getElementById('serviceCards');
    const subproductCards = document.getElementById('subproductCards');
    const cartLines = document.getElementById('cartLines');
    const emptyCart = document.getElementById('emptyCart');

    const manualBadge = document.getElementById('manualBadge');
    const sumBase = document.getElementById('sumBase');
    const sumVat = document.getElementById('sumVat');
    const sumTotal = document.getElementById('sumTotal');
    const prevStepBtn = document.getElementById('prevStepBtn');
    const nextStepBtn = document.getElementById('nextStepBtn');
    const submitBtn = document.getElementById('submitBtn');

    let selectedCategoryId = null;
    let selectedServiceId = null;
    let selectedSubproductId = null;

    if(skipClientDataStep){
        ['Input_CustomerName','Input_CustomerEmail','Input_CustomerPhone','Input_CustomerLocation','Input_CompanyName']
            .forEach(id => {
                const el = document.getElementById(id);
                if(el) el.readOnly = true;
            });
        const pill3 = document.querySelector('[data-step-pill="3"]');
        if(pill3) pill3.classList.add('is-skipped');
    }

    function toMoney(v){
        return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v || 0);
    }

    function fillInventorySelects(){
        if(inventoryHardwareSelect){
            inventoryHardwareSelect.innerHTML = '<option value="">-- Selecciona hardware de inventario --</option>';
        }
        inventoryHardwareItems.forEach(x => {
            const opt = document.createElement('option');
            opt.value = String(x.id);
            const stock = Number(x.quantityOnHand || 0);
            opt.textContent = `${x.name} · ${x.category || 'Sin categoría'} · Stock: ${stock} ${x.unit || 'pza'}`;
            inventoryHardwareSelect?.appendChild(opt);
        });
        if(inventoryServiceSelect){
            inventoryServiceSelect.innerHTML = '<option value="">-- Selecciona servicio --</option>';
        }
        inventoryServiceItems.forEach(x => {
            const opt = document.createElement('option');
            opt.value = String(x.id);
            const price = x.isManualPrice || x.unitPrice == null ? 'Precio manual' : toMoney(Number(x.unitPrice || 0));
            opt.textContent = `${x.name} · ${x.category || 'Servicios'} · ${price}`;
            inventoryServiceSelect?.appendChild(opt);
        });
    }

    function labelOffer(offer){
        if(offer === 'MonthlyRent') return 'Renta mensual';
        if(offer === 'Lease') return 'Arrendamiento';
        return 'Venta';
    }

    function getSegmentData(){
        return payload[seg.value] || { categories: [], services: [], subproducts: [], rules: [] };
    }

    function selectedIdsSet(){
        const ids = new Set();
        lines.forEach(x => {
            ids.add(String(x.categoryId));
            ids.add(String(x.serviceId));
            if(x.subproductId) ids.add(String(x.subproductId));
        });
        return ids;
    }

    function isAllowedByRules(itemId){
        const s = getSegmentData();
        const rules = (s.rules || []).filter(r => String(r.targetItemId) === String(itemId));
        if (rules.length === 0) return true;
        const selected = selectedIdsSet();
        return rules.some(r => selected.has(String(r.requiredItemId)));
    }

    function cardHtml(item, active, extra){
        const img = item.imageUrl ? `<img src="${item.imageUrl}" alt="img" />` : `<div class="hn-thumb-fallback">${item.name.substring(0,2).toUpperCase()}</div>`;
        return `
        <button type="button" class="hn-card-select ${active ? 'is-active' : ''}" data-id="${item.id}">
            <div class="hn-thumb">${img}</div>
            <div class="hn-body">
                <div class="hn-name">${item.name}</div>
                ${item.description ? `<div class="hn-desc">${item.description}</div>` : ''}
                ${extra || ''}
            </div>
        </button>`;
    }

    function renderCategories(){
        const s = getSegmentData();
        const rows = s.categories.filter(x => isAllowedByRules(x.id));
        if(!rows.length){ categoryCards.innerHTML = '<div class="text-muted">Sin categorias para este segmento.</div>'; return; }
        categoryCards.innerHTML = rows.map(x => cardHtml(x, String(selectedCategoryId) === String(x.id), '')).join('');
        categoryCards.querySelectorAll('button[data-id]').forEach(btn => {
            btn.addEventListener('click', () => {
                selectedCategoryId = btn.dataset.id;
                selectedServiceId = null;
                selectedSubproductId = null;
                renderCategories();
                renderServices();
                renderSubproducts();
            });
        });
        if(!selectedCategoryId && rows[0]) selectedCategoryId = rows[0].id;
    }

    function renderServices(){
        const s = getSegmentData();
        const rows = s.services.filter(x => x.parentId === selectedCategoryId && isAllowedByRules(x.id));
        if(!rows.length){ serviceCards.innerHTML = '<div class="text-muted">Selecciona categoria para ver servicios.</div>'; return; }
        serviceCards.innerHTML = rows.map(x => {
            const extra = `<div class="d-flex gap-1 flex-wrap mt-1"><span class="badge text-bg-light border">${labelOffer(x.offerType)}</span>${x.referenceUrl ? `<span class="badge text-bg-info">Link</span>` : ''}</div>`;
            return cardHtml(x, String(selectedServiceId) === String(x.id), extra);
        }).join('');
        serviceCards.querySelectorAll('button[data-id]').forEach(btn => {
            btn.addEventListener('click', () => {
                selectedServiceId = btn.dataset.id;
                selectedSubproductId = null;
                renderServices();
                renderSubproducts();
            });
        });
        if(!selectedServiceId && rows[0]) selectedServiceId = rows[0].id;
    }

    function renderSubproducts(){
        const s = getSegmentData();
        const rows = s.subproducts.filter(x => x.parentId === selectedServiceId && isAllowedByRules(x.id));
        if(!selectedServiceId){ subproductCards.innerHTML = '<div class="text-muted">Selecciona un servicio.</div>'; return; }
        if(!rows.length){ subproductCards.innerHTML = '<div class="text-muted">Este servicio no tiene variantes; se agregara directo al carrito.</div>'; return; }
        subproductCards.innerHTML = rows.map(x => {
            const priceTxt = x.isManualPrice || x.unitPrice == null ? 'Precio manual' : `${toMoney(x.unitPrice)} ${x.unitPriceIncludesVat ? '(IVA incl.)' : '+ IVA'}`;
            const variantTxt = (x.variantGroup || x.variantValue) ? `<span class="badge text-bg-light border">${(x.variantGroup || 'Variante')}: ${x.variantValue || '-'}</span>` : '';
            const extra = `<div class="d-flex gap-1 flex-wrap mt-1"><span class="badge text-bg-light border">${labelOffer(x.offerType)}</span>${variantTxt}<span class="badge text-bg-secondary">${priceTxt}</span></div>`;
            return cardHtml(x, String(selectedSubproductId) === String(x.id), extra);
        }).join('');
        subproductCards.querySelectorAll('button[data-id]').forEach(btn => {
            btn.addEventListener('click', () => {
                selectedSubproductId = btn.dataset.id;
                renderSubproducts();
            });
        });
        if(!selectedSubproductId && rows[0]) selectedSubproductId = rows[0].id;
    }

    function find(arr, id){ return arr.find(x => String(x.id) === String(id)); }

    function totals(){
        const catalogBase = lines.filter(x => !x.isManual).reduce((a,b) => a + b.base, 0);
        const catalogVat = lines.filter(x => !x.isManual).reduce((a,b) => a + b.vat, 0);
        const catalogTotal = lines.filter(x => !x.isManual).reduce((a,b) => a + b.total, 0);
        const manualTotal = manualLines.reduce((a, b) => a + (Number(b.unitPrice || 0) * Number(b.quantity || 0)), 0);
        const manual = lines.filter(x => x.isManual).length + manualLines.length;
        return { base: catalogBase + manualTotal, vat: catalogVat, total: catalogTotal + manualTotal, manual };
    }

    function recalc(){
        const t = totals();
        if(sumBase) sumBase.textContent = toMoney(t.base);
        if(sumVat) sumVat.textContent = toMoney(t.vat);
        if(sumTotal) sumTotal.textContent = toMoney(t.total);
        manualBadge.textContent = 'Manuales: ' + t.manual;
        linesJson.value = JSON.stringify(lines.map(x => ({
            categoryId: x.categoryId,
            serviceId: x.serviceId,
            subproductId: x.subproductId || null,
            quantity: x.quantity
        })));
        manualLinesJson.value = JSON.stringify(manualLines.map(x => ({
            categoryName: x.categoryName,
            serviceName: x.serviceName,
            description: x.description,
            quantity: x.quantity,
            unitPrice: x.unitPrice
        })));

        const cLines = document.getElementById('confirmLinesCount');
        const cBase = document.getElementById('confirmBase');
        const cVat = document.getElementById('confirmVat');
        const cTotal = document.getElementById('confirmTotal');
        if(cLines) cLines.textContent = String(lines.length + manualLines.length);
        if(cBase) cBase.textContent = toMoney(t.base);
        if(cVat) cVat.textContent = toMoney(t.vat);
        if(cTotal) cTotal.textContent = toMoney(t.total);
    }

    function renderCart(){
        cartLines.innerHTML = '';
        if(!lines.length && !manualLines.length){ emptyCart.classList.remove('d-none'); recalc(); return; }
        emptyCart.classList.add('d-none');
        lines.forEach((l, idx) => {
            const div = document.createElement('div');
            div.className = 'hn-cart-line';
            div.innerHTML = `
                <div class="d-flex justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">${l.serviceName}</div>
                        <div class="small text-muted">${l.categoryName}${l.subproductName ? ' · ' + l.subproductName : ''}</div>
                        <div class="small"><span class="badge text-bg-light border">${labelOffer(l.offerType)}</span></div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-del="${idx}">Quitar</button>
                </div>
                <div class="small mt-1 d-flex justify-content-between text-muted"><span>Cant: ${l.quantity}</span><span>${l.isManual ? 'Manual' : toMoney(l.total)}</span></div>
            `;
            cartLines.appendChild(div);
        });
        cartLines.querySelectorAll('button[data-del]').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = Number(btn.getAttribute('data-del'));
                lines.splice(idx, 1);
                renderCart();
                renderServices();
                renderSubproducts();
            });
        });

        manualLines.forEach((l, idx) => {
            const div = document.createElement('div');
            div.className = 'hn-cart-line';
            div.innerHTML = `
                <div class="d-flex justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">${l.serviceName || 'Concepto libre'}</div>
                        <div class="small text-muted">${l.categoryName || 'Libre'} · ${l.description || ''}</div>
                        <div class="small"><span class="badge text-bg-warning">Manual</span></div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-del-manual="${idx}">Quitar</button>
                </div>
                <div class="small mt-1 d-flex justify-content-between text-muted"><span>Cant: ${l.quantity}</span><span>${toMoney((l.unitPrice || 0) * l.quantity)}</span></div>
            `;
            cartLines.appendChild(div);
        });
        cartLines.querySelectorAll('button[data-del-manual]').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = Number(btn.getAttribute('data-del-manual'));
                manualLines.splice(idx, 1);
                renderCart();
            });
        });
        recalc();
    }

    function showStep(step){
        currentStep = step;
        document.querySelectorAll('.quote-step-panel').forEach(p => {
            p.classList.toggle('d-none', Number(p.getAttribute('data-step')) !== currentStep);
        });
        document.querySelectorAll('[data-step-pill]').forEach(p => {
            p.classList.toggle('active', Number(p.getAttribute('data-step-pill')) === currentStep);
        });

        const idx = navSteps.indexOf(currentStep);
        prevStepBtn.disabled = idx <= 0;
        nextStepBtn.classList.toggle('d-none', idx === navSteps.length - 1);
        submitBtn.classList.toggle('d-none', idx !== navSteps.length - 1);
        recalc();
    }

    function validateStep(step){
        if(step === 2 && lines.length === 0 && manualLines.length === 0){
            alert('Agrega al menos un concepto al carrito antes de continuar.');
            return false;
        }
        if(step === 3 && !skipClientDataStep){
            const required = ['Input_CustomerName','Input_CustomerEmail','Input_CustomerPhone','Input_CustomerLocation'];
            for(const id of required){
                const el = document.getElementById(id);
                if(!el || !String(el.value || '').trim()){
                    alert('Completa los datos de contacto obligatorios.');
                    return false;
                }
            }
        }
        return true;
    }

    function goNext(){
        const idx = navSteps.indexOf(currentStep);
        if(idx < 0 || idx >= navSteps.length - 1) return;
        if(!validateStep(currentStep)) return;
        showStep(navSteps[idx + 1]);
    }

    function goPrev(){
        const idx = navSteps.indexOf(currentStep);
        if(idx <= 0) return;
        showStep(navSteps[idx - 1]);
    }

    addBtn.addEventListener('click', () => {
        const s = getSegmentData();
        const category = find(s.categories, selectedCategoryId);
        const service = find(s.services, selectedServiceId);
        if(!category || !service){
            alert('Selecciona categoria y servicio.');
            return;
        }

        const subItem = selectedSubproductId ? find(s.subproducts, selectedSubproductId) : null;
        const selected = subItem || service;
        const isManual = !!selected.isManualPrice || selected.unitPrice == null;
        const unit = Number(selected.unitPrice || 0);
        const q = Math.max(1, Number(qty.value || 1));
        const includesVat = !!selected.unitPriceIncludesVat;

        let base = 0, vat = 0, total = 0;
        if(!isManual){
            const raw = unit * q;
            if(includesVat){
                total = raw;
                base = total / (1 + IVA);
                vat = total - base;
            } else {
                base = raw;
                vat = base * IVA;
                total = base + vat;
            }
        }

        lines.push({
            categoryId: category.id,
            serviceId: service.id,
            subproductId: subItem ? subItem.id : null,
            categoryName: category.name,
            serviceName: service.name,
            subproductName: subItem ? subItem.name : '',
            quantity: q,
            unitPrice: unit,
            includesVat,
            base,
            vat,
            total,
            isManual,
            offerType: selected.offerType || 'Sale'
        });

        renderCart();
        renderServices();
        renderSubproducts();
    });

    addManualBtn.addEventListener('click', () => {
        const serviceTxt = String(manualService.value || '').trim();
        const categoryTxt = String(manualCategory.value || '').trim();
        const description = String(manualDescription.value || '').trim();
        if(!description && !serviceTxt && !categoryTxt){
            alert('Escribe al menos servicio, categoría o descripción.');
            return;
        }
        const qtyVal = Math.max(1, Number(manualQty.value || 1));
        const priceVal = Math.max(0, Number(manualPrice.value || 0));
        manualLines.push({
            categoryName: categoryTxt,
            serviceName: serviceTxt,
            description: description || serviceTxt || categoryTxt || 'Concepto libre',
            quantity: qtyVal,
            unitPrice: priceVal
        });
        manualDescription.value = '';
        manualPrice.value = '';
        manualQty.value = '1';
        renderCart();
    });

    addHardwareBtn?.addEventListener('click', () => {
        const id = String(inventoryHardwareSelect?.value || '');
        if(!id){
            alert('Selecciona un item de inventario.');
            return;
        }
        const item = inventoryHardwareItems.find(x => String(x.id) === id);
        if(!item){
            alert('No se encontró el item seleccionado.');
            return;
        }
        const qtyVal = Math.max(1, Number(inventoryHardwareQty?.value || 1));
        manualLines.push({
            categoryName: item.category || 'Inventario',
            serviceName: item.name || 'Item inventario',
            description: `Item inventario (${item.unit || 'pza'})`,
            quantity: qtyVal,
            unitPrice: 0
        });
        if(inventoryHardwareQty) inventoryHardwareQty.value = '1';
        if(inventoryHardwareSelect) inventoryHardwareSelect.value = '';
        renderCart();
    });

    addServiceBtn?.addEventListener('click', () => {
        const id = String(inventoryServiceSelect?.value || '');
        if(!id){
            alert('Selecciona un servicio.');
            return;
        }
        const item = inventoryServiceItems.find(x => String(x.id) === id);
        if(!item){
            alert('No se encontró el servicio seleccionado.');
            return;
        }
        const qtyVal = Math.max(1, Number(inventoryServiceQty?.value || 1));
        manualLines.push({
            categoryName: item.category || 'Servicios',
            serviceName: item.name || 'Servicio',
            description: `Servicio (${labelOffer(item.offerType || 'MonthlyRent')})`,
            quantity: qtyVal,
            unitPrice: Number(item.unitPrice || 0)
        });
        if(inventoryServiceQty) inventoryServiceQty.value = '1';
        if(inventoryServiceSelect) inventoryServiceSelect.value = '';
        renderCart();
    });

    prevStepBtn.addEventListener('click', goPrev);
    nextStepBtn.addEventListener('click', goNext);

    seg.addEventListener('change', () => {
        lines.length = 0;
        selectedCategoryId = null;
        selectedServiceId = null;
        selectedSubproductId = null;
        renderCategories();
        renderServices();
        renderSubproducts();
        renderCart();
    });

    renderCategories();
    fillInventorySelects();
    renderServices();
    renderSubproducts();
    renderCart();
    showStep(navSteps[0]);
})();
</script>

