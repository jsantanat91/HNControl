@page
@model HNControl.Web.Pages.Public.QuoteSuccessModel
@{
    Layout = "_QuoteLayout";
    ViewData["Title"] = "Solicitud enviada";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-soft">
            <div class="card-body p-4">
                <h1 class="h4 mb-2">Solicitud recibida</h1>
                <p class="text-muted mb-3">Folio: <strong>@Model.Folio</strong></p>

                @if (Model.SentOk)
                {
                    <div class="alert alert-success">Enviamos la cotización al correo que registraste. Nuestro equipo puede dar seguimiento a tu solicitud.</div>
                }
                else
                {
                    <div class="alert alert-warning">Tu solicitud quedó registrada, pero no pudimos confirmar el envío de correo. Conserva tu folio y descarga el PDF.</div>
                }

                <div class="d-flex gap-2 flex-wrap">
                    @if (Model.HasPdf && Model.Id.HasValue)
                    {
                        <a class="btn btn-outline-primary" asp-page="./QuoteSuccess" asp-page-handler="Download" asp-route-id="@Model.Id">Descargar PDF</a>
                    }
                    <a class="btn btn-primary" asp-page="/Public/Quote">Nueva cotización</a>
                </div>
            </div>
        </div>
    </div>
</div>
