@page "{token}"
@model HNControl.Web.Pages.Public.ServiceOrderModel
@{
    Layout = "_Layout";
}

@if (Model.Order == null)
{
    <div class="alert alert-warning">Orden no encontrada o token inválido.</div>
    return;
}

<div class="mb-3">
    <h1 class="h4 m-0">Orden de Servicio</h1>
    <div class="text-muted small">
        Cliente: <b>@Model.ClientName</b> · @Model.Order.Title · Tipo: <b>@Model.Order.Type</b> · Status: <b>@Model.Order.Status</b>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

<form method="post" enctype="multipart/form-data" class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Checklist</div>
    <div class="card-body">
        <input type="hidden" name="token" value="@Model.Token" />

        @for (int i = 0; i < Model.Items.Count; i++)
        {
            <div class="border rounded p-2 mb-2">
                <input type="hidden" name="Items[@i].Id" value="@Model.Items[i].Id" />
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Items[@i].IsDone" value="true" @(Model.Items[i].IsDone ? "checked" : "") />
                    <label class="form-check-label fw-semibold">@Model.Items[i].Title</label>
                </div>
                <div class="mt-2">
                    <input class="form-control form-control-sm" name="Items[@i].Notes" value="@Model.Items[i].Notes" placeholder="Notas (opcional)" />
                </div>
            </div>
        }

        <button class="btn btn-primary" type="submit" formaction="?handler=SaveChecklist">Guardar checklist</button>
    </div>
</form>

<form method="post" enctype="multipart/form-data" class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Evidencias</div>
    <div class="card-body">
        <input type="hidden" name="token" value="@Model.Token" />
        <input class="form-control" type="file" name="EvidenceFile" />
        <div class="text-muted small mt-1">Acepta: JPG/PNG/PDF (máx. 25MB).</div>
        <button class="btn btn-outline-primary mt-2" type="submit" formaction="?handler=UploadEvidence">Subir evidencia</button>

        <hr />
        <div class="text-muted small">Archivos:</div>
        <ul class="mb-0">
            @foreach (var e in Model.EvidenceNames)
            {
                <li>@e</li>
            }
        </ul>
    </div>
</form>

<form method="post" class="card shadow-sm">
    <div class="card-header fw-semibold">Firmas</div>
    <div class="card-body">
        <input type="hidden" name="token" value="@Model.Token" />

        <div class="row g-3">
            <div class="col-lg-6">
                <label class="form-label">Nombre del técnico</label>
                <input class="form-control" name="TechName" value="@Model.TechName" />
                <div class="mt-2">
                    <canvas id="techCanvas" width="520" height="180" style="border:1px solid #ddd; width:100%;"></canvas>
                    <input type="hidden" name="TechSigDataUrl" id="techSig" />
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearCanvas('techCanvas')">Limpiar</button>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <label class="form-label">Nombre del cliente</label>
                <input class="form-control" name="ClientName" value="@Model.ClientSignerName" />
                <div class="mt-2">
                    <canvas id="clientCanvas" width="520" height="180" style="border:1px solid #ddd; width:100%;"></canvas>
                    <input type="hidden" name="ClientSigDataUrl" id="clientSig" />
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearCanvas('clientCanvas')">Limpiar</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-outline-primary" type="submit" onclick="captureSigs()" formaction="?handler=SaveSignatures">Guardar firmas</button>
            <button class="btn btn-success" type="submit" onclick="captureSigs()" formaction="?handler=SubmitForReview">Enviar a revisión</button>
        </div>

        <div class="text-muted small mt-2">
            “Enviar a revisión” requiere firmas (técnico y cliente). El admin genera el PDF y lo manda por correo.
        </div>
    </div>
</form>

<script>
    function enableDraw(canvasId){
      const c = document.getElementById(canvasId);
      const ctx = c.getContext('2d');
      let drawing = false;

      function pos(e){
        const r = c.getBoundingClientRect();
        const x = (e.touches ? e.touches[0].clientX : e.clientX) - r.left;
        const y = (e.touches ? e.touches[0].clientY : e.clientY) - r.top;
        return {x,y};
      }

      function start(e){ drawing=true; const p=pos(e); ctx.beginPath(); ctx.moveTo(p.x,p.y); e.preventDefault(); }
      function move(e){ if(!drawing) return; const p=pos(e); ctx.lineTo(p.x,p.y); ctx.stroke(); e.preventDefault(); }
      function end(e){ drawing=false; e.preventDefault(); }

      c.addEventListener('mousedown', start);
      c.addEventListener('mousemove', move);
      c.addEventListener('mouseup', end);
      c.addEventListener('mouseleave', end);

      c.addEventListener('touchstart', start, {passive:false});
      c.addEventListener('touchmove', move, {passive:false});
      c.addEventListener('touchend', end, {passive:false});
    }

    function clearCanvas(canvasId){
      const c = document.getElementById(canvasId);
      const ctx = c.getContext('2d');
      ctx.clearRect(0,0,c.width,c.height);
    }

    function captureSigs(){
      document.getElementById('techSig').value = document.getElementById('techCanvas').toDataURL('image/png');
      document.getElementById('clientSig').value = document.getElementById('clientCanvas').toDataURL('image/png');
    }

    enableDraw('techCanvas');
    enableDraw('clientCanvas');
</script>
