@page "{token}"
@model HNControl.Web.Pages.Public.ServiceOrderModel
@{
    Layout = "_LayoutPublic";
    ViewData["Title"] = "Orden de Servicio";
}

@if (Model.Order == null)
{
    <div class="alert alert-danger">Link inválido o expirado.</div>
    return;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h2 class="mb-1">Orden de Servicio</h2>
            <div class="text-muted">
                Cliente: <strong>@(Model.Order.Client?.Name ?? "-")</strong>
                · Título: <strong>@Model.Order.Title</strong>
                · Tipo: <strong>@Model.Order.Type</strong>
                · Status: <strong>@Model.Order.Status</strong>
            </div>
        </div>

        <div>
            @if (Model.CanDownloadPdf)
            {
                <a class="btn btn-primary" href="?handler=DownloadPdf&token=@Model.Token">Descargar PDF</a>
            }
        </div>
    </div>

    @if (!Model.CanDownloadPdf)
    {
        <div class="alert alert-info">
            El PDF aún no está disponible. Cuando el admin apruebe la orden, aquí aparecerá el botón de descarga.
        </div>
    }
</div>
