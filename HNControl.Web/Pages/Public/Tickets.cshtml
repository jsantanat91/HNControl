@page "/ticket-publico"
@model HNControl.Web.Pages.Public.TicketsModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Portal de tickets";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card shadow-soft">
            <div class="card-body p-4">
                <h1 class="h3 mb-1">Portal de tickets</h1>
                <div class="text-muted mb-3">Flujo ITIL para levantar incidentes de cliente.</div>

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="alert @(Model.Success ? "alert-success" : "alert-warning")">@Model.Message</div>
                }

                @if (Model.Client == null)
                {
                    <form method="post" asp-page-handler="Lookup" class="row g-2 align-items-end mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Ingresa tu ID de Cliente</label>
                            <input asp-for="Input.ClientCode" class="form-control" placeholder="Ej. HN-0001" />
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100">Buscar cliente</button>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-outline-secondary w-100" asp-page-handler="History">Historial</button>
                        </div>
                    </form>
                }
                else
                {
                    <form method="post" class="row g-2 align-items-end mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Ingresa tu ID de Cliente</label>
                            <input asp-for="Input.ClientCode" class="form-control" readonly />
                        </div>
                        <div class="col-md-3">
                            @if (Model.Input.Mode == "history")
                            {
                                <button class="btn btn-success w-100" asp-page-handler="New">Nuevo ticket</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary w-100" asp-page-handler="History">Historial</button>
                            }
                        </div>
                        <div class="col-md-3">
                            <a class="btn btn-outline-danger w-100" href="/ticket-publico">Cancelar</a>
                        </div>
                    </form>
                }

                @if (Model.Client != null)
                {
                    <div class="alert alert-info py-2">
                        Cliente: <strong>@Model.Client.Name</strong> (@Model.Client.ClientCode)
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="hn-chip @(Model.Input.Mode == "new" ? "hn-chip-status-progress" : "hn-chip-neutral")">Nuevo ticket</span>
                        <span class="hn-chip @(Model.Input.Mode == "history" ? "hn-chip-status-progress" : "hn-chip-neutral")">Historial</span>
                    </div>

                    @if (Model.Input.Mode == "history")
                    {
                        <form method="post" asp-page-handler="History" class="card border-0 bg-light-subtle p-3 mb-3">
                            <input asp-for="Input.ClientCode" type="hidden" />
                            <input asp-for="Input.Mode" type="hidden" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label">Desde</label>
                                    <input asp-for="HistoryFrom" class="form-control" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Hasta</label>
                                    <input asp-for="HistoryTo" class="form-control" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <button class="btn btn-primary w-100">Filtrar historial</button>
                                </div>
                            </div>
                        </form>
                        @if (!Model.History.Any())
                        {
                            <div class="alert alert-light border mb-0">Sin tickets para ese rango de fechas.</div>
                        }
                        else
                        {
                            <div class="row g-3">
                                @foreach (var h in Model.History)
                                {
                                    <div class="col-12 col-lg-6">
                                        <div class="card shadow-soft h-100">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start gap-2">
                                                    <div>
                                                        <div class="small text-muted">@h.TicketNumber</div>
                                                        <div class="h5 mb-1">@h.Title</div>
                                                        <div class="text-muted small">Sucursal: @h.Contract</div>
                                                        <div class="text-muted small mt-1">@h.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                                                    </div>
                                                    <div class="text-end d-flex flex-column gap-1 align-items-end">
                                                        <span class="hn-chip hn-chip-neutral">@h.Status</span>
                                                        <span class="hn-chip hn-chip-ref">@h.Priority</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Create" class="row g-3">
                            <input asp-for="Input.ClientCode" type="hidden" />
                            <input asp-for="Input.Mode" type="hidden" />
                            <input asp-for="Input.CreateContactIfMissing" type="hidden" />

                            <div class="col-md-6">
                                <label class="form-label">Sucursal</label>
                                <select id="publicContractSelect" asp-for="Input.ContractId" class="form-select">
                                    <option value="">Sin sucursal especifica</option>
                                    @foreach (var c in Model.Contracts)
                                    {
                                        var carrierData = Model.ContractCarrierMap.TryGetValue(c.Id, out var summary) ? summary : "";
                                        <option value="@c.Id" data-address="@c.BranchAddress" data-carrier="@carrierData">@HNControl.Web.Pages.Public.TicketsModel.ContractToBranchLabel(c)</option>
                                    }
                                </select>
                                <div id="publicCarrierInfo" class="form-text">Selecciona una sucursal para ver datos carrier (cuenta/IP).</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Prioridad</label>
                                <select asp-for="Input.Priority" class="form-select">
                                    <option value="@HNControl.Web.Pages.Public.TicketsModel.PublicPriority.Low">Baja</option>
                                    <option value="@HNControl.Web.Pages.Public.TicketsModel.PublicPriority.Medium">Intermedia</option>
                                    <option value="@HNControl.Web.Pages.Public.TicketsModel.PublicPriority.Urge">Urge</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Asunto</label>
                                <input asp-for="Input.Title" class="form-control" placeholder="Sin internet en sucursal..." />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Quien abre el ticket</label>
                                <select id="publicContactSelect" asp-for="Input.ClientContactId" class="form-select">
                                    <option value="">Otro contacto (captura manual)</option>
                                    @foreach (var c in Model.ContactOptions)
                                    {
                                        var roleText = string.IsNullOrWhiteSpace(c.Role) ? "Contacto" : c.Role;
                                        var label = $"{c.Name} ({roleText})";
                                        if (c.IsPrimary)
                                        {
                                            label += " · Principal";
                                        }
                                        <option value="@c.Id" data-name="@c.Name" data-email="@c.Email" data-phone="@c.Phone">@label</option>
                                    }
                                </select>
                                <div class="form-text">Si eliges "Otro contacto", al levantar ticket se agregará automáticamente a la lista del cliente.</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Nombre de contacto</label>
                                <input asp-for="Input.RequesterName" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Correo</label>
                                <input asp-for="Input.RequesterEmail" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Telefono</label>
                                <input asp-for="Input.RequesterPhone" class="form-control" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Ubicacion / sitio</label>
                                <input id="publicLocationInput" asp-for="Input.RequesterLocation" class="form-control" placeholder="Si seleccionas sucursal, se toma direccion automaticamente." />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Descripcion del incidente</label>
                                <textarea asp-for="Input.Description" class="form-control" rows="5" placeholder="Describe falla, impacto y desde cuando ocurre..."></textarea>
                            </div>

                            <div class="col-12 d-flex justify-content-end">
                                <button class="btn btn-success">Levantar ticket</button>
                            </div>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function syncPublicTicketLocation() {
            const sel = document.getElementById('publicContractSelect');
            const input = document.getElementById('publicLocationInput');
            const carrier = document.getElementById('publicCarrierInfo');
            if (!sel || !input) return;
            const opt = sel.options[sel.selectedIndex];
            const address = (opt && opt.getAttribute('data-address')) ? opt.getAttribute('data-address') : '';
            const carrierSummary = (opt && opt.getAttribute('data-carrier')) ? opt.getAttribute('data-carrier') : '';
            if (address && address.trim().length > 0) {
                input.value = address;
            }
            if (carrier) {
                carrier.textContent = carrierSummary && carrierSummary.trim().length > 0
                    ? ("Datos carrier: " + carrierSummary)
                    : "Selecciona una sucursal para ver datos carrier (cuenta/IP).";
            }
        }
        function syncPublicTicketContact() {
            const sel = document.getElementById('publicContactSelect');
            const nameInput = document.getElementById('Input_RequesterName');
            const emailInput = document.getElementById('Input_RequesterEmail');
            const phoneInput = document.getElementById('Input_RequesterPhone');
            if (!sel || !nameInput || !emailInput || !phoneInput) return;
            const opt = sel.options[sel.selectedIndex];
            if (!opt || !opt.value) return;
            nameInput.value = opt.getAttribute('data-name') || '';
            emailInput.value = opt.getAttribute('data-email') || '';
            phoneInput.value = opt.getAttribute('data-phone') || '';
        }
        document.addEventListener('DOMContentLoaded', function() {
            const sel = document.getElementById('publicContractSelect');
            const contactSel = document.getElementById('publicContactSelect');
            if (!sel) return;
            sel.addEventListener('change', syncPublicTicketLocation);
            if (contactSel) {
                contactSel.addEventListener('change', syncPublicTicketContact);
            }
            syncPublicTicketLocation();
            syncPublicTicketContact();
        });
    </script>
}
