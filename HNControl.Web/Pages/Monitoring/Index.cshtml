@page
@model HNControl.Web.Pages.Monitoring.IndexModel
@{
    ViewData["Title"] = "Monitoreo";
}

<div class="hn-mon-hero mb-3">
    <div>
        <h1 class="h4 mb-1">Monitoreo</h1>
        <div class="text-muted small">Ping, TCP y HTTP por cliente con estado actual.</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-page="/Monitoring/CreateTarget">+ Nuevo target</a>
        @if (Model.IsAdmin)
        {
            <a class="btn btn-outline-primary" asp-page="/Admin/Monitoring/Targets/Index">Administrar targets</a>
        }
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-12 col-md-4">
        <div class="card shadow-soft hn-mon-stat up h-100">
            <div class="card-body py-2 px-3">
                <div class="text-muted small">En l&iacute;nea</div>
                <div class="fs-2 fw-bold lh-1">@Model.UpCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-soft hn-mon-stat down h-100">
            <div class="card-body py-2 px-3">
                <div class="text-muted small">Ca&iacute;dos</div>
                <div class="fs-2 fw-bold lh-1">@Model.DownCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-soft hn-mon-stat unknown h-100">
            <div class="card-body py-2 px-3">
                <div class="text-muted small">Sin datos</div>
                <div class="fs-2 fw-bold lh-1">@Model.UnknownCount</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Groups.Any())
{
    <div class="alert alert-info">A&uacute;n no hay targets registrados.</div>
}
else
{
    <div class="row g-3">
        @foreach (var g in Model.Groups)
        {
            <div class="col-12">
                <div class="card shadow-soft hn-hover">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div class="fw-semibold">@g.ClientName</div>
                        <span class="badge text-bg-light border">@g.Items.Count target(s)</span>
                    </div>

                    <div class="card-body">
                        <div class="row g-2">
                            @foreach (var t in g.Items)
                            {
                                var refLabel = t.CarrierServiceLabel;
                                if (string.IsNullOrWhiteSpace(refLabel))
                                {
                                    refLabel = t.ContractLabel;
                                }
                                else if (!string.IsNullOrWhiteSpace(t.ContractLabel) && string.Equals(t.CarrierServiceLabel.Trim(), t.ContractLabel.Trim(), StringComparison.OrdinalIgnoreCase))
                                {
                                    refLabel = t.ContractLabel;
                                }

                                <div class="col-12 col-md-6 col-xl-4">
                                    <div class="hn-target-card h-100" data-status="@t.LastStatus">
                                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                            <div class="hn-target-main">
                                                <div class="fw-semibold d-flex align-items-center gap-2">
                                                    <span class="hn-target-dot"></span>
                                                    <span class="hn-target-name" title="@t.Name">@t.Name</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(refLabel))
                                                {
                                                    <div class="text-muted small mt-1 hn-target-ref" title="@refLabel">@refLabel</div>
                                                }
                                                <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
                                                    <span class="hn-chip hn-chip-neutral">@t.ProbeType</span>
                                                    @if (!string.IsNullOrWhiteSpace(t.Branch))
                                                    {
                                                        <span class="hn-chip hn-chip-type">Sucursal: @t.Branch</span>
                                                    }
                                                    <span class="hn-chip hn-chip-ref">@t.Address</span>
                                                </div>
                                            </div>
                                            @{
                                                var statusChip = t.LastStatus switch
                                                {
                                                    HNControl.Web.Models.MonitorStatus.Up => "hn-chip-status-up",
                                                    HNControl.Web.Models.MonitorStatus.Down => "hn-chip-status-down",
                                                    _ => "hn-chip-neutral"
                                                };
                                                var statusText = t.LastStatus switch
                                                {
                                                    HNControl.Web.Models.MonitorStatus.Up => "Arriba",
                                                    HNControl.Web.Models.MonitorStatus.Down => "Abajo",
                                                    _ => "Sin datos"
                                                };
                                            }
                                            <span class="hn-chip @statusChip">@statusText</span>
                                        </div>

                                        <div class="mt-3 hn-target-meta">
                                            @if (t.LastCheckedAt == null)
                                            {
                                                <span>Sin check</span>
                                            }
                                            else
                                            {
                                                <span>@t.LastCheckedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                                @if (t.LastLatencyMs != null)
                                                {
                                                    <span class="hn-chip hn-chip-type ms-1">@t.LastLatencyMs.Value ms</span>
                                                }
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(t.LastError))
                                        {
                                            <div class="mt-2 small text-danger">@t.LastError</div>
                                        }

                                        @if (Model.IsAdmin)
                                        {
                                            <div class="mt-2 text-end">
                                                <form method="post" asp-page-handler="Run" class="m-0">
                                                    <input type="hidden" name="id" value="@t.Id" />
                                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Probar</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Styles
{
    <style>
        .hn-mon-hero {
            border-radius: 16px;
            padding: .85rem 1rem;
            background: linear-gradient(120deg, rgba(12, 100, 170, .08), rgba(0, 160, 120, .08));
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .hn-mon-stat { border-radius: 12px; }
        .hn-mon-stat.up { border-left: 4px solid #198754; }
        .hn-mon-stat.down { border-left: 4px solid #dc3545; }
        .hn-mon-stat.unknown { border-left: 4px solid #6c757d; }

        .hn-target-card {
            border: 1px solid rgba(15, 23, 42, .12);
            border-radius: 14px;
            padding: .85rem;
            background: linear-gradient(155deg, rgba(255,255,255,.95), rgba(248,251,255,.9));
            transition: box-shadow .2s ease, transform .2s ease;
            min-height: 165px;
            overflow: hidden;
        }

        .hn-target-card:hover {
            box-shadow: 0 .7rem 1.1rem rgba(15, 23, 42, .09);
            transform: translateY(-2px);
        }

        .hn-target-main {
            min-width: 0;
            flex: 1 1 210px;
            max-width: 100%;
        }

        .hn-target-meta {
            font-size: .84rem;
            color: #64748b;
            border-top: 1px dashed rgba(15, 23, 42, .12);
            padding-top: .5rem;
        }

        .hn-target-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            display: inline-block;
            background: #6c757d;
            box-shadow: 0 0 0 3px rgba(108, 117, 125, .15);
        }

        .hn-target-name {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .hn-target-ref {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            word-break: break-word;
            text-overflow: ellipsis;
        }

        .hn-target-card .hn-chip.hn-chip-ref {
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .hn-target-card[data-status="Up"] .hn-target-dot {
            background: #20c997;
            box-shadow: 0 0 0 3px rgba(32, 201, 151, .2);
        }
        .hn-target-card[data-status="Up"] {
            border-color: rgba(22, 163, 74, .35);
        }

        .hn-target-card[data-status="Down"] .hn-target-dot {
            background: #dc3545;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, .2);
        }
        .hn-target-card[data-status="Down"] {
            border-color: rgba(220, 53, 69, .38);
        }
    </style>
}
