@page
@model HNControl.Web.Pages.Monitoring.IndexModel
@{
    ViewData["Title"] = "Monitoreo";
}

<div class="hn-mon-hero mb-3">
    <div>
        <h1 class="h4 mb-1">Monitoreo</h1>
        <div class="text-muted small">Ping, TCP y HTTP por cliente con estado actual.</div>
    </div>
    @if (Model.IsAdmin)
    {
        <a class="btn btn-primary" asp-page="/Admin/Monitoring/Targets/Index">Administrar targets</a>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <div class="card shadow-soft hn-mon-stat up h-100">
            <div class="card-body">
                <div class="text-muted small">En linea</div>
                <div class="display-6 fw-bold">@Model.UpCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-soft hn-mon-stat down h-100">
            <div class="card-body">
                <div class="text-muted small">Caidos</div>
                <div class="display-6 fw-bold">@Model.DownCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-soft hn-mon-stat unknown h-100">
            <div class="card-body">
                <div class="text-muted small">Sin datos</div>
                <div class="display-6 fw-bold">@Model.UnknownCount</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Groups.Any())
{
    <div class="alert alert-info">Aun no hay targets registrados.</div>
}
else
{
    <div class="row g-3">
        @foreach (var g in Model.Groups)
        {
            <div class="col-12">
                <div class="card shadow-soft hn-hover">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div class="fw-semibold">@g.ClientName</div>
                        <span class="badge text-bg-light border">@g.Items.Count target(s)</span>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var t in g.Items)
                            {
                                <div class="col-12 col-md-6 col-xl-4">
                                    <div class="hn-target-card h-100" data-status="@t.LastStatus">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="fw-semibold d-flex align-items-center gap-2">
                                                    <span class="hn-target-dot"></span>
                                                    @t.Name
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(t.ContractLabel))
                                                {
                                                    <div class="text-muted small mt-1">@t.ContractLabel</div>
                                                }
                                                <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
                                                    <span class="badge rounded-pill bg-light text-dark border">@t.ProbeType</span>
                                                    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">@t.Address</span>
                                                </div>
                                            </div>
                                            <span class="badge @t.BadgeClass">@t.LastStatus</span>
                                        </div>

                                        <div class="mt-3 hn-target-meta">
                                            @if (t.LastCheckedAt == null)
                                            {
                                                <span>Sin check</span>
                                            }
                                            else
                                            {
                                                <span>@t.LastCheckedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                                @if (t.LastLatencyMs != null)
                                                {
                                                    <span class="badge rounded-pill bg-light text-dark border ms-1">@t.LastLatencyMs.Value ms</span>
                                                }
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(t.LastError))
                                        {
                                            <div class="mt-2 small text-danger">@t.LastError</div>
                                        }

                                        @if (Model.IsAdmin)
                                        {
                                            <div class="mt-3 text-end">
                                                <form method="post" asp-page-handler="Run" class="m-0">
                                                    <input type="hidden" name="id" value="@t.Id" />
                                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Probar</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Styles
{
    <style>
        .hn-mon-hero {
            border-radius: 16px;
            padding: 1rem 1.25rem;
            background: linear-gradient(120deg, rgba(12, 100, 170, .08), rgba(0, 160, 120, .08));
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .hn-mon-stat.up { border-left: 4px solid #198754; }
        .hn-mon-stat.down { border-left: 4px solid #dc3545; }
        .hn-mon-stat.unknown { border-left: 4px solid #6c757d; }

        .hn-target-card {
            border: 1px solid rgba(15, 23, 42, .12);
            border-radius: 16px;
            padding: 1rem;
            background: linear-gradient(155deg, rgba(255,255,255,.95), rgba(248,251,255,.9));
            transition: box-shadow .2s ease, transform .2s ease;
        }

        .hn-target-card:hover {
            box-shadow: 0 .8rem 1.4rem rgba(15, 23, 42, .10);
            transform: translateY(-2px);
        }

        .hn-target-meta {
            font-size: .88rem;
            color: #64748b;
            border-top: 1px dashed rgba(15, 23, 42, .12);
            padding-top: .55rem;
        }

        .hn-target-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            display: inline-block;
            background: #6c757d;
            box-shadow: 0 0 0 3px rgba(108, 117, 125, .15);
        }

        .hn-target-card[data-status="Up"] .hn-target-dot {
            background: #20c997;
            box-shadow: 0 0 0 3px rgba(32, 201, 151, .2);
        }
        .hn-target-card[data-status="Up"] {
            border-color: rgba(22, 163, 74, .35);
        }

        .hn-target-card[data-status="Down"] .hn-target-dot {
            background: #dc3545;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, .2);
        }
        .hn-target-card[data-status="Down"] {
            border-color: rgba(220, 53, 69, .38);
        }
    </style>
}
