@page
@model HNControl.Web.Pages.Portal.IndexModel
@{
    Layout = "_LayoutPublic";
    ViewData["Title"] = "Portal del cliente";
}

@if (Model.Client == null)
{
    <div class="container py-4">
        <div class="alert alert-warning">No fue posible cargar tu información de cliente.</div>
    </div>
    return;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 m-0">Portal cliente</h1>
            <div class="text-muted small">@Model.Client.Name · @Model.Client.ClientCode</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-warning" type="button" data-bs-toggle="modal" data-bs-target="#changePasswordModal">Cambiar contraseña</button>
            <form method="post" asp-page-handler="Logout">
                <button class="btn btn-outline-danger" type="submit">Cerrar sesión</button>
            </form>
        </div>
    </div>

    @if (TempData["PortalInfo"] is string info)
    {
        var infoType = (TempData["PortalInfoType"] as string) ?? "info";
        <div class="alert alert-@infoType py-2">@info</div>
    }

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-header fw-semibold">Estado de cuenta</div>
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-semibold">Pendiente</div>
                    <div class="h4 fw-bold text-danger mb-3">@Model.TotalPendiente.ToString("C")</div>
                    <div class="small text-muted text-uppercase fw-semibold">Pagado</div>
                    <div class="h5 fw-bold text-success">@Model.TotalPagado.ToString("C")</div>
                    <div class="text-muted small mt-2">Facturas ligadas a planes recurrentes del cliente.</div>
                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <span class="hn-status-badge is-pending">Pendiente</span>
                        <span class="hn-status-badge is-paid">Pagada</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-header fw-semibold">Domiciliar tarjeta</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="CreateDomiciliation" class="row g-2">
                        <div class="col-12">
                            <label class="form-label small mb-1">Correo pagador (autom&aacute;tico)</label>
                            <input class="form-control" value="@Model.PayerEmailHint" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-1">Monto referencia</label>
                            <input asp-for="DomiciliationForm.MontoReferencia" class="form-control" />
                        </div>
                        <div class="col-12 d-grid">
                            <button type="submit" class="btn btn-primary">Ir a Mercado Pago</button>
                        </div>
                    </form>
                    @if (Model.Domiciliations.Any())
                    {
                        <hr />
                        <div class="small fw-semibold mb-1">Intentos recientes</div>
                        @foreach (var d in Model.Domiciliations.Take(3))
                        {
                            <div class="small text-muted d-flex align-items-center gap-2">
                                <span>@d.Fecha</span>
                                <span class="hn-status-badge @(d.Estado.Equals("Approved", StringComparison.OrdinalIgnoreCase) || d.Estado.Equals("Authorized", StringComparison.OrdinalIgnoreCase) ? "is-paid" : d.Estado.Equals("Rejected", StringComparison.OrdinalIgnoreCase) || d.Estado.Equals("Failed", StringComparison.OrdinalIgnoreCase) ? "is-rejected" : "is-pending")">@d.Estado</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-header fw-semibold">Abrir ticket directo</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="CreateTicket" class="row g-2">
                        <div class="col-12">
                            <label class="form-label small mb-1">Asunto</label>
                            <input asp-for="TicketForm.Titulo" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-1">Descripción</label>
                            <textarea asp-for="TicketForm.Descripcion" rows="3" class="form-control"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-1">Contrato (opcional)</label>
                            <select asp-for="TicketForm.ContractId" class="form-select">
                                <option value="">-- Sin contrato --</option>
                                @foreach (var c in Model.ActiveContracts)
                                {
                                    <option value="@c.Id">@c.Tipo - @c.Nombre - @c.Sucursal</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-1">Contacto (opcional)</label>
                            <select asp-for="TicketForm.ClientContactId" id="portalTicketContact" class="form-select">
                                <option value="">-- Captura manual --</option>
                                @foreach (var contact in Model.Contacts)
                                {
                                    var label = contact.Principal ? $"Principal: {contact.Nombre}" : contact.Nombre;
                                    <option value="@contact.Id" data-name="@contact.Nombre" data-email="@contact.Correo" data-phone="@contact.Telefono">@label &middot; @contact.Correo</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-1">Nombre</label>
                            <input asp-for="TicketForm.ContactoNombre" id="portalTicketName" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-1">Teléfono</label>
                            <input asp-for="TicketForm.ContactoTelefono" id="portalTicketPhone" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-1">Correo</label>
                            <input asp-for="TicketForm.ContactoCorreo" id="portalTicketEmail" class="form-control" />
                        </div>
                        <div class="col-12 d-grid">
                            <button type="submit" class="btn btn-success">Crear ticket</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12 col-xl-7">
            <div class="card shadow-soft hn-hover">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">Facturas recurrentes</div>
                    <span class="text-muted small">@Model.AccountRuns.Count registro(s)</span>
                </div>
                <div class="card-body">
                    @if (!Model.AccountRuns.Any())
                    {
                        <div class="text-muted small">Sin facturas registradas.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Periodo</th>
                                        <th>Concepto</th>
                                        <th>Fecha</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">PDF</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var run in Model.AccountRuns.Take(20))
                                    {
                                        <tr>
                                            <td>@run.Periodo</td>
                                            <td>@run.Concepto</td>
                                            <td>@run.Fecha</td>
                                            <td class="text-end">@run.Total.ToString("C")</td>
                                            <td class="text-center">
                                                <span class="hn-status-badge @(run.Pagada ? "is-paid" : "is-pending")">@run.Estado</span>
                                            </td>
                                            <td class="text-center">
                                                @if (run.HasPdf)
                                                {
                                                    <a class="btn btn-sm btn-outline-primary"
                                                       asp-page="/Portal/Index"
                                                       asp-page-handler="DownloadInvoice"
                                                       asp-route-id="@run.Id">
                                                        Descargar
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card shadow-soft hn-hover">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">Contratos y cotización</div>
                    <span class="text-muted small">@Model.ActiveContracts.Count contrato(s)</span>
                </div>
                <div class="card-body">
                    <div class="border rounded p-2 mb-2">
                        <div class="fw-semibold">Liga pública para cotizar</div>
                        <div class="small text-muted">Comparte esta liga para capturar cotizaciones del cliente.</div>
                        <div class="input-group input-group-sm mt-2">
                            <input class="form-control" readonly value="@Model.PublicQuoteUrl" />
                            <a class="btn btn-outline-primary" href="@Model.PublicQuoteUrl" target="_blank" rel="noopener">Abrir</a>
                        </div>
                    </div>
                    @if (!Model.ActiveContracts.Any())
                    {
                        <div class="text-muted small">Sin contratos activos.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var c in Model.ActiveContracts)
                            {
                                <div class="border rounded p-2">
                                    <div class="fw-semibold">@c.Nombre</div>
                                    <div class="small text-muted">@c.Tipo · @c.Sucursal</div>
                                    <div class="small text-muted">Vigencia: @c.Vigencia</div>
                                    @if (c.HasFile)
                                    {
                                        <a class="btn btn-sm btn-outline-primary mt-2"
                                           asp-page="/Portal/Index"
                                           asp-page-handler="DownloadContract"
                                           asp-route-id="@c.Id">
                                            Descargar contrato
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ChangePassword">
                <div class="modal-header">
                    <h5 class="modal-title" id="changePasswordModalLabel">Cambiar contraseña</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Contraseña actual</label>
                        <input asp-for="PasswordForm.CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Nueva contraseña</label>
                        <input asp-for="PasswordForm.NewPassword" type="password" class="form-control" autocomplete="new-password" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Confirmar contraseña</label>
                        <input asp-for="PasswordForm.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    </div>
                    <div class="text-muted small">La nueva contraseña debe tener al menos 10 caracteres.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar contraseña</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const contact = document.getElementById('portalTicketContact');
            const name = document.getElementById('portalTicketName');
            const phone = document.getElementById('portalTicketPhone');
            const email = document.getElementById('portalTicketEmail');
            if (!contact || !name || !phone || !email) return;

            const syncFields = () => {
                const opt = contact.options[contact.selectedIndex];
                if (!opt || !opt.value) return;
                name.value = opt.dataset.name || '';
                phone.value = opt.dataset.phone || '';
                email.value = opt.dataset.email || '';
            };

            contact.addEventListener('change', syncFields);
        })();
    </script>
}

@section Styles {
    <style>
        .hn-status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 9999px;
            padding: .2rem .65rem;
            font-size: .72rem;
            font-weight: 700;
            line-height: 1;
            border: 1px solid transparent;
            white-space: nowrap;
        }
        .hn-status-badge.is-paid {
            background: #dcfce7;
            color: #166534;
            border-color: #86efac;
        }
        .hn-status-badge.is-pending {
            background: #fef9c3;
            color: #854d0e;
            border-color: #fde68a;
        }
        .hn-status-badge.is-rejected {
            background: #fee2e2;
            color: #991b1b;
            border-color: #fecaca;
        }
    </style>
}


