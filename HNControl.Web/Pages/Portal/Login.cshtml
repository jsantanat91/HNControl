@page
@model HNControl.Web.Pages.Portal.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Portal de clientes";
    var returnUrl = (ViewData["ReturnUrl"] as string) ?? "";
}

<div class="row justify-content-between align-items-center g-4">
    <div class="col-lg-6 d-none d-lg-flex">
        <div class="w-100 p-4 p-xl-5 hn-auth-intro">
            <span class="hn-auth-kicker mb-3">Acceso externo</span>

            <h1 class="display-4 fw-bold lh-sm mb-3">
                BIENVENIDO AL<br />
                <span class="text-white">PORTAL DE CLIENTES</span>
            </h1>

            <p class="fs-5 mb-2">Consulta tu estado de cuenta, contratos activos y abre tickets desde un solo lugar.</p>
            <p class="mb-0">Gestion simple y segura para seguimiento de tus servicios.</p>
        </div>
    </div>

    <div class="col-12 col-md-8 col-lg-5 col-xl-4">
        <div class="card hn-auth-card">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-4">
                    <h1 class="h2 m-0 fw-bold text-white">PORTAL DE CLIENTES</h1>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }

                <form method="post">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Usuario" class="form-control text-uppercase" placeholder="HN-CL-0001" autocomplete="username" />
                        <label asp-for="Input.Usuario">Usuario cliente</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" type="password" class="form-control" placeholder="********" autocomplete="current-password" />
                        <label asp-for="Input.Password">Contraseña</label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2 mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.Recordarme" />
                            <label class="form-check-label" asp-for="Input.Recordarme">Mantener sesión</label>
                        </div>
                        <span class="text-muted small">Acceso seguro</span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Entrar al portal</button>
                </form>
            </div>
        </div>

        <div class="text-center text-light small mt-3">
            &copy; @DateTime.Now.Year · Portal de clientes
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
