@page "{id:guid}"
@using HNControl.Web.Helpers
@using HNControl.Web.Models
@model HNControl.Web.Pages.Knowledge.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Documento";
}

@if (Model.Doc == null)
{
    <div class="alert alert-warning">Documento no encontrado.</div>
    return;
}

@{
    var status = UiBadges.KnowledgeStatusBadge(Model.Doc.Status);
    var type = UiBadges.KnowledgeTypeBadge(Model.Doc.DocType);
}

<div class="d-flex justify-content-between align-items-start mb-3 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge @type.css">@type.text</span>
            <span class="badge @status.css">@status.text</span>
            @if (Model.Doc.IsPinned)
            {
                <span class="badge rounded-pill text-bg-warning">Fijado</span>
            }
        </div>
        <h1 class="h4 m-0">@Model.Doc.Title</h1>
        <div class="text-muted small">@Model.Doc.Description</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Knowledge/Index">Volver</a>
        @if (User.IsInRole(AppRoles.Admin))
        {
            <a class="btn btn-outline-primary" asp-page="/Knowledge/Edit" asp-route-id="@Model.Doc.Id">Editar</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-soft hn-hover mb-3">
            <div class="card-header fw-semibold">Contenido</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.Doc.Body))
                {
                    <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@Model.Doc.Body</pre>
                }
                else
                {
                    <div class="text-muted">Sin contenido interno.</div>
                }
            </div>
        </div>

        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Recursos</div>
            <div class="card-body d-flex flex-wrap gap-2">
                @if (!string.IsNullOrWhiteSpace(Model.Doc.Url))
                {
                    <a class="btn btn-outline-primary" href="@Model.Doc.Url" target="_blank" rel="noopener">Abrir enlace</a>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Doc.AttachmentStoragePath))
                {
                    <a class="btn btn-outline-success" asp-page="/Knowledge/Download" asp-route-id="@Model.Doc.Id">Descargar archivo</a>
                }

                @if (string.IsNullOrWhiteSpace(Model.Doc.Url) && string.IsNullOrWhiteSpace(Model.Doc.AttachmentStoragePath))
                {
                    <span class="text-muted">Sin recursos externos adjuntos.</span>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm hn-hover mb-3">
            <div class="card-header fw-semibold">Ficha</div>
            <div class="card-body small">
                <div><b>Categoría:</b> @Model.Doc.Category</div>
                <div><b>Cliente:</b> @(Model.Doc.Client?.Name ?? "-")</div>
                <div><b>Contrato:</b> @(Model.Doc.ClientServiceContract?.Label ?? "-")</div>
                <div><b>Versión:</b> @Model.Doc.Version</div>
                <div><b>Responsable:</b> @(string.IsNullOrWhiteSpace(Model.Doc.OwnerName) ? "-" : Model.Doc.OwnerName)</div>
                <div><b>Actualizado:</b> @Model.Doc.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                <div><b>Publicado:</b> @(Model.Doc.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                <div><b>Vistas:</b> @Model.Doc.ViewCount</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Doc.AccessUsername) || !string.IsNullOrWhiteSpace(Model.Doc.AccessNotes))
        {
            <div class="card shadow-sm hn-hover mb-3">
                <div class="card-header fw-semibold">Acceso interno</div>
                <div class="card-body small">
                    <div><b>Usuario:</b> @(string.IsNullOrWhiteSpace(Model.Doc.AccessUsername) ? "-" : Model.Doc.AccessUsername)</div>
                    @if (User.IsInRole(AppRoles.Admin) && !string.IsNullOrWhiteSpace(Model.SecretValue))
                    {
                        <div><b>Secreto:</b> @Model.SecretValue</div>
                    }
                    <div class="mt-2"><b>Notas:</b></div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Doc.AccessNotes) ? "-" : Model.Doc.AccessNotes)</div>
                </div>
            </div>
        }

        @if (User.IsInRole(AppRoles.Admin))
        {
            <div class="card shadow-sm hn-hover">
                <div class="card-header fw-semibold">Acciones</div>
                <div class="card-body d-flex flex-wrap gap-2">
                    <form method="post" asp-page-handler="TogglePin" asp-route-id="@Model.Doc.Id">
                        <button class="btn btn-sm btn-outline-warning" type="submit">@(Model.Doc.IsPinned ? "Quitar fijado" : "Fijar")</button>
                    </form>
                    <form method="post" asp-page-handler="SetStatus" asp-route-id="@Model.Doc.Id" asp-route-status="Publicado">
                        <button class="btn btn-sm btn-outline-success" type="submit">Publicar</button>
                    </form>
                    <form method="post" asp-page-handler="SetStatus" asp-route-id="@Model.Doc.Id" asp-route-status="Borrador">
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Borrador</button>
                    </form>
                    <form method="post" asp-page-handler="SetStatus" asp-route-id="@Model.Doc.Id" asp-route-status="Archivado">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Archivar</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

