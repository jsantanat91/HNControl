@page
@using HNControl.Web.Helpers
@using HNControl.Web.Models
@model HNControl.Web.Pages.Knowledge.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Base de conocimiento";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Documentos</h1>
        <div class="text-muted small">Accesos de plataforma por cliente/contrato y manuales internos</div>
    </div>

    @if (User.IsInRole(AppRoles.Admin))
    {
        <a class="btn btn-primary" asp-page="/Knowledge/Create">+ Nuevo documento</a>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6 col-xl-2">
        <div class="card shadow-sm hn-hover h-100"><div class="card-body"><div class="text-muted small">Total</div><div class="h4 m-0">@Model.Stats.Total</div></div></div>
    </div>
    <div class="col-md-6 col-xl-2">
        <div class="card shadow-sm hn-hover h-100"><div class="card-body"><div class="text-muted small">Publicados</div><div class="h4 m-0 text-success">@Model.Stats.Publicados</div></div></div>
    </div>
    <div class="col-md-6 col-xl-2">
        <div class="card shadow-sm hn-hover h-100"><div class="card-body"><div class="text-muted small">Borradores</div><div class="h4 m-0 text-warning">@Model.Stats.Borradores</div></div></div>
    </div>
    <div class="col-md-6 col-xl-2">
        <div class="card shadow-sm hn-hover h-100"><div class="card-body"><div class="text-muted small">Revisi&oacute;n vencida</div><div class="h4 m-0 text-danger">@Model.Stats.Vencidos</div></div></div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card shadow-sm hn-hover h-100"><div class="card-body"><div class="text-muted small">Actualizados (7 d&iacute;as)</div><div class="h4 m-0">@Model.Stats.ActualizadosSemana</div></div></div>
    </div>
</div>

<form method="get" class="card shadow-soft hn-hover mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-lg-3">
                <input class="form-control" name="Q" value="@Model.Q" placeholder="Buscar por t&iacute;tulo, tag o contenido" />
            </div>
            <div class="col-lg-2">
                <select class="form-select" name="Category">
                    <option value="">Categor&iacute;a</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c" selected="@(Model.Category == c)">@c</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <select class="form-select" name="Type">
                    <option value="">Tipo</option>
                    @foreach (var t in Model.TypeOptions)
                    {
                        var text = t == KnowledgeDocType.AccesoPlataforma ? "Acceso Plataforma" : "Manual Interno";
                        <option value="@t" selected="@(Model.Type == t.ToString())">@text</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <select class="form-select" name="Status">
                    <option value="">Estado</option>
                    @foreach (var s in Html.GetEnumSelectList<KnowledgeStatus>())
                    {
                        <option value="@s.Value" selected="@(Model.Status == s.Value)">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <select class="form-select" name="Owner">
                    <option value="">Responsable</option>
                    @foreach (var o in Model.Owners)
                    {
                        <option value="@o" selected="@(Model.Owner == o)">@o</option>
                    }
                </select>
            </div>
            <div class="col-lg-1">
                <button class="btn btn-primary w-100" type="submit">Filtrar</button>
            </div>
        </div>
    </div>
</form>

@if (!Model.Rows.Any())
{
    <div class="alert alert-light border">No hay documentos con los filtros actuales.</div>
}
else
{
    <div class="row g-3">
        @foreach (var d in Model.Rows)
        {
            var status = UiBadges.KnowledgeStatusBadge(d.Status);
            var type = UiBadges.KnowledgeTypeBadge(d.DocType);
            <div class="col-12 col-lg-6 col-xxl-4">
                <div class="card shadow-soft hn-hover h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <div class="fw-semibold">@d.Title</div>
                                <div class="small text-muted">Actualizado: @d.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                            @if (d.IsPinned)
                            {
                                <span class="badge rounded-pill text-bg-warning">Fijado</span>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <span class="badge @type.css">@type.text</span>
                            <span class="badge @status.css">@status.text</span>
                            @if (d.HasAttachment)
                            {
                                <span class="badge bg-success">PDF/Archivo</span>
                            }
                            @if (d.HasUrl)
                            {
                                <span class="badge bg-primary">Link</span>
                            }
                        </div>

                        <div class="small text-muted">@d.Description</div>
                        <div class="small mt-2">Cliente: <b>@d.ClientName</b></div>
                        <div class="small text-muted">Contrato: @d.ContractLabel</div>
                        <div class="small text-muted">Responsable: @(string.IsNullOrWhiteSpace(d.OwnerName) ? "-" : d.OwnerName)</div>

                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var tag in (d.Tags ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Take(4))
                            {
                                <span class="badge rounded-pill bg-light text-dark border">@tag</span>
                            }
                        </div>

                        <div class="mt-auto pt-3 d-flex justify-content-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Knowledge/Details" asp-route-id="@d.Id">Abrir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

