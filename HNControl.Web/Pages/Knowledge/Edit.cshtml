@page "{id:guid}"
@using HNControl.Web.Models
@model HNControl.Web.Pages.Knowledge.EditModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar documento";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Editar documento</h1>
        <div class="text-muted small">Versión actual: @Model.Input.Version</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Knowledge/Index">Volver</a>
        <a class="btn btn-outline-primary" asp-page="/Knowledge/Details" asp-route-id="@Model.Input.Id">Ver ficha</a>
    </div>
</div>

<form method="post" enctype="multipart/form-data" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <input type="hidden" asp-for="Input.Id" />

        <div class="row g-3">
            <div class="col-lg-7">
                <label class="form-label">Título</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div class="col-lg-3">
                <label class="form-label">Categoría</label>
                <select class="form-select" asp-for="Input.Category">
                    @foreach (var c in Model.CategoryOptions)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Tipo</label>
                <select class="form-select" asp-for="Input.DocType">
                    @foreach (var t in Model.TypeOptions)
                    {
                        var text = t == KnowledgeDocType.AccesoPlataforma ? "Acceso Plataforma" : "Manual Interno";
                        <option value="@t">@text</option>
                    }
                </select>
            </div>

            <div class="col-lg-4">
                <label class="form-label">Cliente (para accesos)</label>
                <select id="knowledgeClientSelect" class="form-select" asp-for="Input.ClientId">
                    <option value="">No aplica</option>
                    @foreach (var c in Model.ClientOptions)
                    {
                        <option value="@c.Id">@c.Name (@c.Code)</option>
                    }
                </select>
            </div>
            <div class="col-lg-8">
                <label class="form-label">Contrato ligado (opcional)</label>
                <select id="knowledgeContractSelect" class="form-select" asp-for="Input.ClientServiceContractId">
                    <option value="">Sin contrato</option>
                    @foreach (var c in Model.ContractOptions)
                    {
                        <option value="@c.Id" data-client-id="@c.ClientId">@c.Label</option>
                    }
                </select>
            </div>

            <div class="col-lg-3">
                <label class="form-label">Estado</label>
                <select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<KnowledgeStatus>()"></select>
            </div>
            <div class="col-lg-9">
                <label class="form-label">Resumen</label>
                <input class="form-control" asp-for="Input.Description" />
            </div>

            <div class="col-12">
                <label class="form-label">Contenido</label>
                <textarea class="form-control" asp-for="Input.Body" rows="6"></textarea>
            </div>

            <div class="col-lg-8">
                <label class="form-label">URL externa</label>
                <input class="form-control" asp-for="Input.Url" />
            </div>
            <div class="col-lg-4">
                <label class="form-label">Reemplazar archivo</label>
                <input class="form-control" type="file" asp-for="Attachment" />
            </div>

            @if (Model.HasAttachment)
            {
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="RemoveAttachment" />
                        <label class="form-check-label" asp-for="RemoveAttachment">Eliminar adjunto actual (@Model.Input.ExistingAttachmentName)</label>
                    </div>
                </div>
            }

            <div class="col-lg-6">
                <label class="form-label">Usuario de acceso</label>
                <input class="form-control" asp-for="Input.AccessUsername" />
            </div>
            <div class="col-lg-6">
                <label class="form-label">Secreto</label>
                <input class="form-control" asp-for="Input.AccessSecret" />
            </div>

            <div class="col-12">
                <label class="form-label">Notas de acceso</label>
                <textarea class="form-control" asp-for="Input.AccessNotes" rows="3"></textarea>
            </div>

            <div class="col-12 d-flex align-items-center">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.IsPinned" />
                    <label class="form-check-label" asp-for="Input.IsPinned">Fijar en listado</label>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-page="/Knowledge/Details" asp-route-id="@Model.Input.Id">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function filterKnowledgeContracts() {
            const clientSelect = document.getElementById('knowledgeClientSelect');
            const contractSelect = document.getElementById('knowledgeContractSelect');
            if (!clientSelect || !contractSelect) return;
            const clientId = (clientSelect.value || '').toLowerCase();
            const options = Array.from(contractSelect.options);
            options.forEach((opt, idx) => {
                if (idx === 0) {
                    opt.hidden = false;
                    opt.disabled = false;
                    return;
                }
                const owner = (opt.getAttribute('data-client-id') || '').toLowerCase();
                const visible = !!clientId && owner === clientId;
                opt.hidden = !visible;
                opt.disabled = !visible;
            });
            if (contractSelect.options[contractSelect.selectedIndex]?.hidden) {
                contractSelect.value = '';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const clientSelect = document.getElementById('knowledgeClientSelect');
            if (clientSelect) {
                clientSelect.addEventListener('change', filterKnowledgeContracts);
            }
            filterKnowledgeContracts();
        });
    </script>
}
