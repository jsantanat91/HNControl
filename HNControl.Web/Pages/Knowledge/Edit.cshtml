@page "{id:guid}"
@using HNControl.Web.Models
@model HNControl.Web.Pages.Knowledge.EditModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar documento";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Editar documento</h1>
        <div class="text-muted small">Version actual: @Model.Input.Version</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Knowledge/Index">Volver</a>
        <a class="btn btn-outline-primary" asp-page="/Knowledge/Details" asp-route-id="@Model.Input.Id">Ver ficha</a>
    </div>
</div>

<form method="post" enctype="multipart/form-data" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <input type="hidden" asp-for="Input.Id" />

        <div class="row g-3">
            <div class="col-lg-6">
                <label class="form-label">Titulo</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div class="col-lg-3">
                <label class="form-label">Categoria</label>
                <select class="form-select" asp-for="Input.Category">
                    @foreach (var c in Model.CategoryOptions)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-lg-3">
                <label class="form-label">Tipo</label>
                <select class="form-select" asp-for="Input.DocType" asp-items="Html.GetEnumSelectList<KnowledgeDocType>()"></select>
            </div>

            <div class="col-lg-3">
                <label class="form-label">Estado</label>
                <select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<KnowledgeStatus>()"></select>
            </div>
            <div class="col-lg-3">
                <label class="form-label">Responsable</label>
                <input class="form-control" asp-for="Input.OwnerName" />
            </div>
            <div class="col-lg-3">
                <label class="form-label">Revisor</label>
                <input class="form-control" asp-for="Input.ReviewerName" />
                <div class="form-text">Quien valida el documento antes o despues de publicarlo.</div>
            </div>
            <div class="col-lg-3">
                <label class="form-label">Revision programada</label>
                <input class="form-control" asp-for="Input.ReviewDueAt" type="date" />
                <div class="form-text">Fecha para revisar si la info sigue vigente.</div>
            </div>

            <div class="col-12">
                <label class="form-label">Resumen</label>
                <input class="form-control" asp-for="Input.Description" />
            </div>

            <div class="col-12">
                <label class="form-label">Contenido interno</label>
                <textarea class="form-control" asp-for="Input.Body" rows="6"></textarea>
            </div>

            <div class="col-lg-8">
                <label class="form-label">URL externa</label>
                <input class="form-control" asp-for="Input.Url" />
            </div>
            <div class="col-lg-4">
                <label class="form-label">Reemplazar archivo</label>
                <input class="form-control" type="file" asp-for="Attachment" />
            </div>

            @if (Model.HasAttachment)
            {
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="RemoveAttachment" />
                        <label class="form-check-label" asp-for="RemoveAttachment">Eliminar adjunto actual (@Model.Input.ExistingAttachmentName)</label>
                    </div>
                </div>
            }

            <div class="col-12">
                <label class="form-label">Tags</label>
                <input class="form-control" asp-for="Input.Tags" />
            </div>

            <div class="col-lg-4">
                <label class="form-label">Usuario de acceso</label>
                <input class="form-control" asp-for="Input.AccessUsername" />
            </div>
            <div class="col-lg-4">
                <label class="form-label">Secreto</label>
                <input class="form-control" asp-for="Input.AccessSecret" />
            </div>
            <div class="col-lg-4 d-flex align-items-center pt-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.IsPinned" />
                    <label class="form-check-label" asp-for="Input.IsPinned">Fijar en listado</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">Notas de acceso</label>
                <textarea class="form-control" asp-for="Input.AccessNotes" rows="4" placeholder="Multiples accesos (uno por linea):&#10;DVR 1 | usuario | password | nota&#10;DVR 2 | usuario | password | nota"></textarea>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-page="/Knowledge/Details" asp-route-id="@Model.Input.Id">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
