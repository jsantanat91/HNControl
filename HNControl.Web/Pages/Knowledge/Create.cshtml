@page
@using HNControl.Web.Models
@model HNControl.Web.Pages.Knowledge.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nuevo documento";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Nuevo documento</h1>
        <div class="text-muted small">Base de conocimiento PRO</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Knowledge/Index">Volver</a>
</div>

<form method="post" enctype="multipart/form-data" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="row g-3">
            <div class="col-lg-6">
                <label class="form-label">Titulo</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div class="col-lg-3">
                <label class="form-label">Categoria</label>
                <select class="form-select" asp-for="Input.Category">
                    @foreach (var c in Model.CategoryOptions)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-lg-3">
                <label class="form-label">Tipo</label>
                <select class="form-select" asp-for="Input.DocType" asp-items="Html.GetEnumSelectList<KnowledgeDocType>()"></select>
            </div>

            <div class="col-lg-3">
                <label class="form-label">Estado</label>
                <select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<KnowledgeStatus>()"></select>
            </div>

            <div class="col-12">
                <label class="form-label">Resumen</label>
                <input class="form-control" asp-for="Input.Description" placeholder="Resumen corto para listados" />
            </div>

            <div class="col-12">
                <label class="form-label">Contenido interno</label>
                <textarea class="form-control" asp-for="Input.Body" rows="6" placeholder="Pasos, checklist, instrucciones, ruta de archivos, notas operativas..."></textarea>
            </div>

            <div class="col-lg-8">
                <label class="form-label">URL externa (opcional)</label>
                <input class="form-control" asp-for="Input.Url" placeholder="https://..." />
            </div>
            <div class="col-lg-4">
                <label class="form-label">Archivo adjunto (opcional)</label>
                <input class="form-control" type="file" asp-for="Attachment" />
                <div class="form-text">PDF, Office o imagen (max 25MB).</div>
            </div>

            <div class="col-12">
                <label class="form-label">Tags</label>
                <input class="form-control" asp-for="Input.Tags" placeholder="vpn, crm, fortinet, onboarding" />
            </div>
            <div class="col-12 d-flex align-items-center">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.IsPinned" />
                    <label class="form-check-label" asp-for="Input.IsPinned">Fijar en la parte superior</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">Notas de acceso (opcional)</label>
                <textarea class="form-control" asp-for="Input.AccessNotes" rows="4" placeholder="Multiples accesos (uno por linea):&#10;DVR 1 | usuario | password | nota&#10;DVR 2 | usuario | password | nota"></textarea>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar documento</button>
        <a class="btn btn-outline-secondary" asp-page="/Knowledge/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
