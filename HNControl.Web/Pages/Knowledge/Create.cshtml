@page
@model HNControl.Web.Pages.Knowledge.CreateModel
@{
    Layout = "_Layout";
}

<h1 class="h4 mb-3">Nuevo link</h1>

<form method="post" class="card shadow-sm hn-hover hn-hover">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Categoría</label>
                <input class="form-control" asp-for="Input.Category" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Título</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div class="col-12">
                <label class="form-label">URL</label>
                <input class="form-control" asp-for="Input.Url" />
            </div>
            <div class="col-12">
                <label class="form-label">Descripción</label>
                <input class="form-control" asp-for="Input.Description" />
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a class="btn btn-outline-secondary" asp-page="/Knowledge/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
