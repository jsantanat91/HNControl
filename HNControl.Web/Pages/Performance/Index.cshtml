@page
@model HNControl.Web.Pages.Performance.IndexModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Rendimiento</h1>
        <div class="text-muted small">Modelo 80/20 · calificación 1–5</div>
    </div>

    @if (User.IsInRole(HNControl.Web.Models.AppRoles.Admin))
    {
        <a class="btn btn-primary" asp-page="/Performance/Rate">+ Calificar empleado</a>
        <a class="btn btn-outline-primary" asp-page="/Performance/ExportPayroll">Exportar nómina (Excel)</a>
    }
    else
    {
        <a class="btn btn-outline-primary" asp-page="/Performance/My">Ver mi rendimiento</a>
    }
</div>

@if (User.IsInRole(HNControl.Web.Models.AppRoles.Admin))
{
    <div class="card shadow-sm hn-hover hn-hover">
        <div class="card-body table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>Puesto</th>
                        <th>Sueldo base</th>
                        <th>Última calificación</th>
                        <th>Variable %</th>
                        <th>Total quincenal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.AdminRows)
                    {
                        <tr>
                            <td>@r.Employee</td>
                            <td class="text-muted">@r.Position</td>
                            <td>@r.SalaryBase.ToString("C")</td>
                            <td>@r.LastPeriod</td>
                            <td>@(r.VariablePercent * 100m) %</td>
                            <td class="fw-semibold">@r.TotalPay.ToString("C")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Performance/Rate" asp-route-userId="@r.UserId">Calificar</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Performance/My" asp-route-userId="@r.UserId">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        Tu evaluación la califica el admin. Aquí verás tu historial y tu variable cuando exista.
    </div>
}
