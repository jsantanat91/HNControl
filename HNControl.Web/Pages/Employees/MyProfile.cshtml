@page
@model HNControl.Web.Pages.Employees.MyProfileModel
@{
    ViewData["Title"] = "Mi ficha";
}

<h1 class="h4 mb-3">Mi ficha</h1>

@if (Model.Profile == null)
{
    <div class="alert alert-warning">No hay perfil cargado. Dile al admin que te cree bien 😄</div>
}
else
{
    <div class="row g-3">
        <!-- Perfil -->
        <div class="col-12 col-lg-5 col-xl-4">
            <div class="card shadow-soft hn-hover">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small">Empleado</div>
                            <div class="fs-5 fw-semibold">@Model.Profile.FullName</div>
                            <div class="text-muted small">@Model.Profile.Position</div>
                        </div>
                        <span class="badge text-bg-secondary">Perfil</span>
                    </div>

                    <hr />

                    <dl class="row mb-0 small">
                        <dt class="col-4 text-muted">Correo</dt>
                        <dd class="col-8">@Model.Profile.Email</dd>

                        <dt class="col-4 text-muted">Teléfono</dt>
                        <dd class="col-8">@Model.Profile.Phone</dd>

                        <dt class="col-4 text-muted">NSS</dt>
                        <dd class="col-8">@Model.Profile.Nss</dd>

                        <dt class="col-4 text-muted">Sexo</dt>
                        <dd class="col-8">@Model.Profile.Gender</dd>

                        <dt class="col-4 text-muted">CURP</dt>
                        <dd class="col-8">@Model.Profile.Curp</dd>

                        <dt class="col-4 text-muted">Nacimiento</dt>
                        <dd class="col-8">@(Model.Profile.BirthDate?.ToString("yyyy-MM-dd") ?? "—")</dd>

                        <dt class="col-4 text-muted">Ingreso</dt>
                        <dd class="col-8">
                            @(Model.Profile.HireDate?.ToString("yyyy-MM-dd") ?? "—")
                            @if (!string.IsNullOrWhiteSpace(Model.SeniorityText))
                            {
                                <span class="text-muted">· @Model.SeniorityText</span>
                            }
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Profile.Address))
                        {
                            <dt class="col-4 text-muted">Dirección</dt>
                            <dd class="col-8">@Model.Profile.Address</dd>
                        }

                        <dt class="col-4 text-muted">Sueldo mensual</dt>
                        <dd class="col-8 fw-semibold">@Model.Profile.SalaryBase.ToString("C")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Dashboard -->
        <div class="col-12 col-lg-7 col-xl-8">
            <div class="row g-3">

                <!-- Eval 360 -->
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card shadow-sm hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">Evaluación 360</div>
                                    <div class="fw-semibold">Última campaña</div>
                                </div>
                                <span class="badge text-bg-info">Esperado vs Equipo</span>
                            </div>

                            @if (Model.LastEval360 == null)
                            {
                                <div class="text-muted small mt-2">Aún no hay campañas con resultados para ti.</div>
                            }
                            else if (!Model.LastEval360.VisibleToEmployee)
                            {
                                <div class="mt-2 small text-muted">@Model.LastEval360.Title · @Model.LastEval360.Start.ToString("yyyy-MM-dd") – @Model.LastEval360.End.ToString("yyyy-MM-dd")</div>
                                <div class="alert alert-warning py-2 mt-3 mb-0 small">
                                    Ya estás evaluado, pero <b>los resultados aún no están publicados</b> para empleados.
                                </div>
                            }
                            else
                            {
                                <div class="mt-2 small text-muted">@Model.LastEval360.Title · @Model.LastEval360.Start.ToString("yyyy-MM-dd") – @Model.LastEval360.End.ToString("yyyy-MM-dd")</div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div>
                                        <div class="text-muted small">Esperado</div>
                                        <div class="fs-4 fw-semibold">@Model.LastEval360.AutoPct.ToString("0")%</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small">Evaluadores (@Model.LastEval360.OthersCount)</div>
                                        <div class="fs-4 fw-semibold">@Model.LastEval360.OthersPct.ToString("0")%</div>
                                    </div>
                                </div>

                                <a class="btn btn-sm btn-outline-primary mt-3" asp-page="/Eval360/MyResults" asp-route-id="@Model.LastEval360.CampaignId">Ver detalle</a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Sueldo -->
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card shadow-sm hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">Sueldo variable</div>
                                    <div class="fw-semibold">80/20 (quincenal)</div>
                                </div>
                                <span class="badge text-bg-success">Nómina</span>
                            </div>

                            @if (Model.CurrentPay == null)
                            {
                                <div class="text-muted small mt-2">Sin evaluación registrada todavía.</div>
                            }
                            else
                            {
                                <div class="mt-2 small text-muted">Periodo: @Model.CurrentPay.Period</div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div>
                                        <div class="text-muted small">Variable</div>
                                        <div class="fs-4 fw-semibold">@((Model.CurrentPay.VariablePercent * 100m).ToString("0"))%</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small">Neto estimado</div>
                                        <div class="fs-4 fw-semibold">@Model.CurrentPay.NetQuincenal.ToString("C")</div>
                                    </div>
                                </div>

                                <div class="mt-3 small">
                                    <div class="d-flex justify-content-between text-muted">
                                        <span>Bruto quincena</span>
                                        <span>@Model.CurrentPay.TotalQuincenal.ToString("C")</span>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted">
                                        <span>Deducciones</span>
                                        <span>-@Model.CurrentPay.DeductionsQuincenal.ToString("C")</span>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted">
                                        <span>Bonos</span>
                                        <span>+@Model.CurrentPay.BonusesQuincenal.ToString("C")</span>
                                    </div>
                                </div>

                                <a class="btn btn-sm btn-outline-primary mt-3" asp-page="/Performance/My">Ver historial</a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Deducciones -->
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card shadow-sm hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">Nómina</div>
                                    <div class="fw-semibold">Ajustes activos</div>
                                </div>
                                <span class="badge text-bg-warning">Nómina</span>
                            </div>

                            @if (!Model.ActiveDeductions.Any())
                            {
                                <div class="text-muted small mt-2">No tienes ajustes activos. Disfruta mientras dure 😄</div>
                            }
                            else
                            {
                                <div class="table-responsive mt-3">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Concepto</th>
                                                <th class="text-end">Importe</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var d in Model.ActiveDeductions)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="fw-semibold">@d.Concept</div>
                                                        <div class="text-muted small">
                                                            @if (d.Direction == HNControl.Web.Models.EmployeeDeductionDirection.Bonus)
                                                            {
                                                                <span class="badge text-bg-success me-1">@d.Direction.GetDisplayName()</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge text-bg-warning me-1">@d.Direction.GetDisplayName()</span>
                                                            }
                                                            @d.Type.GetDisplayName() · @d.Mode.GetDisplayName()
                                                        </div>
                                                    </td>
                                                    <td class="text-end fw-semibold">
                                                        @(d.Direction == HNControl.Web.Models.EmployeeDeductionDirection.Bonus ? "+" : "-")@d.PeriodAmount.ToString("C")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td class="text-muted">Deducciones</td>
                                                <td class="text-end fw-semibold">-@Model.DeductionsTotal.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Bonos</td>
                                                <td class="text-end fw-semibold">+@Model.BonusesTotal.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Impacto neto</td>
                                                <td class="text-end fw-semibold">@Math.Round(Model.BonusesTotal - Model.DeductionsTotal, 2).ToString("C")</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Viáticos -->
                <div class="col-12">
                    <div class="card shadow-soft hn-hover">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-muted small">Viáticos</div>
                                    <div class="fw-semibold">Resumen</div>
                                </div>
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Viaticos/Index">Abrir módulo</a>
                            </div>

                            @if (Model.CurrentWeek != null)
                            {
                                <div class="mt-3 p-3 rounded-3" style="background: rgba(2,6,23,.03); border:1px solid rgba(15,23,42,.06);">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <div class="text-muted small">Semana</div>
                                            <div class="fw-semibold">@Model.CurrentWeek.WeekStart.ToString("yyyy-MM-dd")</div>
                                        </div>
                                        <div>
                                            <span class="badge text-bg-secondary">@Model.CurrentWeek.Status.GetDisplayName()</span>
                                        </div>
                                        <div class="text-end">
                                            <div class="text-muted small">Total</div>
                                            <div class="fw-semibold">@Model.CurrentWeek.Total.ToString("C")</div>
                                        </div>
                                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Viaticos/Week" asp-route-id="@Model.CurrentWeek.Id">Abrir semana</a>
                                    </div>
                                </div>
                            }

                            @if (Model.RecentWeeks.Any())
                            {
                                <div class="table-responsive mt-3">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Semana</th>
                                                <th>Estado</th>
                                                <th class="text-end">Total</th>
                                                <th class="text-end"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var w in Model.RecentWeeks)
                                            {
                                                <tr>
                                                    <td>@w.WeekStart.ToString("yyyy-MM-dd")</td>
                                                    <td>@w.Status.GetDisplayName()</td>
                                                    <td class="text-end">@w.Total.ToString("C")</td>
                                                    <td class="text-end">
                                                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Viaticos/Week" asp-route-id="@w.Id">Abrir</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small mt-2">Aún no has capturado viáticos.</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Vacaciones + Exámenes -->
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">Vacaciones</div>
                                    <div class="fw-semibold">@Model.VacYear</div>
                                </div>
                                <span class="badge text-bg-primary">RH</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div>
                                    <div class="text-muted small">Disponibles</div>
                                    <div class="fs-4 fw-semibold">@Model.VacationRemaining</div>
                                </div>
                                <div class="text-end">
                                    <div class="text-muted small">Usadas</div>
                                    <div class="fs-4 fw-semibold">@Model.VacationUsed</div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="text-muted small">Asignadas: @Model.VacationAllowance · Pendientes: @Model.VacationPending</div>
                                @if (Model.NextVacationStart.HasValue)
                                {
                                    <div class="text-muted small">Próximas: @Model.NextVacationStart.Value.ToString("yyyy-MM-dd") – @Model.NextVacationEnd?.ToString("yyyy-MM-dd")</div>
                                }
                            </div>

                            <div class="d-flex gap-2 mt-3">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Leaves/Index">Abrir módulo</a>
                                <a class="btn btn-sm btn-primary" asp-page="/Leaves/RequestVacation">Solicitar</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">Exámenes</div>
                                    <div class="fw-semibold">Estatus</div>
                                </div>
                                <span class="badge text-bg-success">Evaluación</span>
                            </div>

                            <div class="mt-3">
                                <canvas id="myExamsChart" height="160"></canvas>
                            </div>

                            <div class="text-muted small mt-2">Asignados: @Model.ExamsAssignedCount · En progreso: @Model.ExamsInProgressCount · En revisión: @Model.ExamsSubmittedCount · Calificados: @Model.ExamsGradedCount</div>

                            <a class="btn btn-sm btn-outline-primary mt-3" asp-page="/Exams/Index">Abrir módulo</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
        const myExamLabels = @Html.Raw(Model.ExamsLabelsJson);
        const myExamValues = @Html.Raw(Model.ExamsValuesJson);

        const myCfg = {
          type: 'doughnut',
          data: { labels: myExamLabels, datasets: [{ label: 'Exámenes', data: myExamValues }] },
          options: { plugins: { legend: { position: 'bottom' } } }
        };

        window.hnCharts?.decorate(myCfg);
        new Chart(document.getElementById('myExamsChart'), myCfg);
    </script>
}
@section Scripts {
    <script>
        (function () {
          const rawLabels = @Html.Raw(Model.ExamsLabelsJson);
          const values = @Html.Raw(Model.ExamsValuesJson);

          const map = { "Assigned":"Asignado", "InProgress":"En progreso", "Submitted":"En revisión", "Graded":"Calificado" };
          const labels = (rawLabels || []).map(x => map[x] ?? x);

          const canvas = document.getElementById('myExamsChart');
          if (!canvas) return;

          const pairs = labels.map((l, i) => ({ l, v: (values[i] ?? 0) })).filter(x => x.v > 0);

          if (pairs.length === 0) {
            canvas.parentElement.innerHTML = `<div class="text-muted small">Sin datos</div>`;
            return;
          }

          if (pairs.length === 1) {
            canvas.parentElement.innerHTML =
              `<div class="d-flex align-items-center justify-content-center" style="height:160px;">
                 <div class="text-center">
                   <div class="h2 fw-semibold mb-0">${pairs[0].v}</div>
                   <div class="text-muted">${pairs[0].l}</div>
                 </div>
               </div>`;
            return;
          }

          const cfg = {
            type: 'doughnut',
            data: { labels: pairs.map(x => x.l), datasets: [{ label: 'Exámenes', data: pairs.map(x => x.v) }] },
            options: { plugins: { legend: { position: 'bottom' } } }
          };

          window.hnCharts?.decorate(cfg);
          new Chart(canvas, cfg);
        })();
    </script>
}