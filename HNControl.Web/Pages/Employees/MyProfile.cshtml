@page
@model HNControl.Web.Pages.Employees.MyProfileModel
@using HNControl.Web.Models
@{
    ViewData["Title"] = "Mi ficha";
    var pendingExams = Model.ExamsAssignedCount + Model.ExamsInProgressCount + Model.ExamsSubmittedCount;
    var payrollImpact = Math.Round(Model.BonusesTotal - Model.DeductionsTotal, 2);
}

@if (Model.Profile == null)
{
    <div class="alert alert-warning">No hay perfil cargado. Pide al admin que revise tu alta.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0">Mi ficha</h1>
            <div class="text-muted small">Vista r&aacute;pida de n&oacute;mina, deducciones y estado operativo.</div>
        </div>
        <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary">@Model.Profile.Position</span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-body">
                    <div class="text-muted small">Neto quincenal estimado</div>
                    <div class="h3 mb-0">@((Model.CurrentPay?.NetQuincenal ?? 0m).ToString("C"))</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-body">
                    <div class="text-muted small">Ajustes activos</div>
                    <div class="h3 mb-0">@Model.ActiveDeductions.Count</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-body">
                    <div class="text-muted small">Vacaciones disponibles</div>
                    <div class="h3 mb-0">@Model.VacationRemaining</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-body">
                    <div class="text-muted small">Ex&aacute;menes pendientes</div>
                    <div class="h3 mb-0">@pendingExams</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-body">
                    <div class="text-muted small">Tickets asignados</div>
                    <div class="h3 mb-0">@Model.TicketsAssigned</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-body">
                    <div class="text-muted small">Tickets resueltos (mes)</div>
                    <div class="h3 mb-0">@Model.TicketsResolvedMonth</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-body">
                    <div class="text-muted small">Tickets con SLA vencido</div>
                    <div class="h3 mb-0 text-danger">@Model.TicketsSlaBreach</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-4">
            <div class="card shadow-soft hn-hover h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small">Empleado</div>
                            <div class="fs-5 fw-semibold">@Model.Profile.FullName</div>
                            <div class="text-muted small">@Model.Profile.Email</div>
                        </div>
                        <span class="hn-badge hn-badge-blue">Perfil</span>
                    </div>

                    <hr />

                    <dl class="row mb-0 small">
                        <dt class="col-5 text-muted">Tel&eacute;fono</dt>
                        <dd class="col-7">@Model.Profile.Phone</dd>

                        <dt class="col-5 text-muted">NSS</dt>
                        <dd class="col-7">@Model.Profile.Nss</dd>

                        <dt class="col-5 text-muted">CURP</dt>
                        <dd class="col-7">@Model.Profile.Curp</dd>

                        <dt class="col-5 text-muted">Ingreso</dt>
                        <dd class="col-7">
                            @(Model.Profile.HireDate?.ToString("yyyy-MM-dd") ?? "-")
                            @if (!string.IsNullOrWhiteSpace(Model.SeniorityText))
                            {
                                <span class="text-muted">&middot; @Model.SeniorityText</span>
                            }
                        </dd>

                        <dt class="col-5 text-muted">Sueldo mensual</dt>
                        <dd class="col-7 fw-semibold">@Model.Profile.SalaryBase.ToString("C")</dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Profile.Address))
                        {
                            <dt class="col-5 text-muted">Direcci&oacute;n</dt>
                            <dd class="col-7">@Model.Profile.Address</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-8">
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="card shadow-soft hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">N&oacute;mina 80/20</div>
                                    <div class="fw-semibold">Resumen quincenal</div>
                                </div>
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Performance/My">Historial</a>
                            </div>

                            @if (Model.CurrentPay == null)
                            {
                                <div class="text-muted small mt-3">Sin evaluaci&oacute;n registrada todav&iacute;a.</div>
                            }
                            else
                            {
                                <div class="small text-muted mt-2">Periodo: @Model.CurrentPay.Period</div>
                                <div class="d-flex justify-content-between mt-3">
                                    <div>
                                        <div class="text-muted small">Variable</div>
                                        <div class="fs-4 fw-semibold">@((Model.CurrentPay.VariablePercent * 100m).ToString("0"))%</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small">Bruto</div>
                                        <div class="fs-4 fw-semibold">@Model.CurrentPay.TotalQuincenal.ToString("C")</div>
                                    </div>
                                </div>

                                <div class="mt-3" style="max-width: 300px;">
                                    <canvas id="payrollChart" height="200"></canvas>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card shadow-soft hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">Evaluación 360</div>
                                    <div class="fw-semibold">Última campaña</div>
                                </div>
                                <span class="hn-badge hn-badge-blue">KPI 360</span>
                            </div>

                            @if (Model.LastEval360 == null)
                            {
                                <div class="text-muted small mt-3">Aún no hay resultados 360 disponibles.</div>
                            }
                            else if (!Model.LastEval360.VisibleToEmployee)
                            {
                                <div class="text-muted small mt-3">
                                    La campaña <b>@Model.LastEval360.Title</b> ya existe, pero sus resultados aún no están visibles para empleados.
                                </div>
                            }
                            else
                            {
                                <div class="small text-muted mt-2">
                                    @Model.LastEval360.Title · @Model.LastEval360.Start.ToString("yyyy-MM-dd") a @Model.LastEval360.End.ToString("yyyy-MM-dd")
                                </div>
                                <div class="d-flex justify-content-between mt-3">
                                    <div>
                                        <div class="text-muted small">Autoevaluación</div>
                                        <div class="fs-4 fw-semibold">@Model.LastEval360.AutoPct.ToString("0")%</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small">Equipo</div>
                                        <div class="fs-4 fw-semibold">@Model.LastEval360.OthersPct.ToString("0")%</div>
                                    </div>
                                </div>
                                <div class="text-muted small mt-2">Evaluadores: @Model.LastEval360.OthersCount</div>
                                <div class="mt-2">
                                    <div class="progress" style="height:8px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width:@Model.LastEval360.OthersPct%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card shadow-soft hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">KPI mensual</div>
                                    <div class="fw-semibold">Calificacion y retro</div>
                                </div>
                                @if (Model.HasCurrentMonthReview)
                                {
                                    <span class="hn-badge hn-badge-green">Mes actual</span>
                                }
                                else
                                {
                                    <span class="hn-badge hn-badge-amber">Sin cierre del mes</span>
                                }
                            </div>

                            @if (Model.CurrentPay != null)
                            {
                                <div class="mt-2 small text-muted">Periodo visible: @Model.CurrentReviewPeriodText</div>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <span class="hn-badge hn-badge-blue">Variable: @((Model.CurrentPay.VariablePercent * 100m).ToString("0"))%</span>
                                    <span class="hn-badge hn-badge-green">Promedio KPI: @Model.CurrentKpiAverageScore.ToString("0.0")/5</span>
                                </div>
                            }

                            <div class="mt-3 text-muted small">Calificacion por rubro</div>
                            @if (!Model.CurrentKpiMetrics.Any())
                            {
                                <div class="text-muted small mt-1">Aun no hay calificacion KPI visible.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    @foreach (var m in Model.CurrentKpiMetrics)
                                    {
                                        <span class="hn-badge hn-badge-gray">@m.Name: @m.Score.ToString("0.0")</span>
                                    }
                                </div>
                            }

                            <div class="mt-3 text-muted small">Comentarios de RH</div>
                            @if (string.IsNullOrWhiteSpace(Model.LatestAdminNotes))
                            {
                                <div class="text-muted small mt-1">Aun no hay comentarios visibles.</div>
                            }
                            else
                            {
                                <div class="border rounded-3 p-2 mt-1 small">@Model.LatestAdminNotesPreview</div>
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#kpiRhNotesModal">
                                    Ver comentarios de RH
                                </button>
                            }

                            <div class="mt-3 text-muted small">Tendencia mensual (ultimos 6 meses)</div>
                            <div class="mt-2">
                                <canvas id="kpiHistoryChart" height="120"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card shadow-soft hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">N&oacute;mina</div>
                                    <div class="fw-semibold">Deducciones y bonos</div>
                                </div>
                                <span class="hn-badge @(payrollImpact >= 0 ? "hn-badge-green" : "hn-badge-amber")">Impacto: @payrollImpact.ToString("C")</span>
                            </div>

                            @if (!Model.ActiveDeductions.Any())
                            {
                                <div class="text-muted small mt-3">No tienes ajustes activos.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2 mt-3">
                                    @foreach (var d in Model.ActiveDeductions)
                                    {
                                        var sign = d.Direction == EmployeeDeductionDirection.Bonus ? "+" : "-";
                                        var tagClass = d.Direction == EmployeeDeductionDirection.Bonus ? "hn-badge-green" : "hn-badge-amber";
                                        var hasProgress = d.ProgressPaidPeriods.HasValue && d.ProgressTotalPeriods.HasValue && d.ProgressTotalPeriods.Value > 0;
                                        var progressPct = hasProgress ? Math.Round((d.ProgressPaidPeriods!.Value * 100m) / d.ProgressTotalPeriods!.Value, 0) : 0;

                                        <div class="border rounded-3 p-2">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <div>
                                                    <div class="fw-semibold">@d.Concept</div>
                                                    <div class="small text-muted">@d.Type.GetDisplayName() &middot; @d.Mode.GetDisplayName() &middot; @d.Frequency.GetDisplayName()</div>
                                                </div>
                                                <div class="text-end">
                                                    <span class="hn-badge @tagClass">@d.Direction.GetDisplayName()</span>
                                                    <div class="fw-semibold">@sign@d.PeriodAmount.ToString("C")</div>
                                                </div>
                                            </div>

                                            @if (hasProgress)
                                            {
                                                <div class="mt-2">
                                                    <div class="d-flex justify-content-between small">
                                                        <span>Progreso</span>
                                                        <span>Pago @d.ProgressPaidPeriods de @d.ProgressTotalPeriods</span>
                                                    </div>
                                                    <div class="progress" style="height:6px;">
                                                        <div class="progress-bar" role="progressbar" style="width:@progressPct%"></div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card shadow-soft hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">Vacaciones</div>
                                    <div class="fw-semibold">@Model.VacYear</div>
                                </div>
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Leaves/Index">Abrir</a>
                            </div>
                            <div class="d-flex justify-content-between mt-3">
                                <div><div class="text-muted small">Disponibles</div><div class="fs-4 fw-semibold">@Model.VacationRemaining</div></div>
                                <div class="text-end"><div class="text-muted small">Usadas</div><div class="fs-4 fw-semibold">@Model.VacationUsed</div></div>
                            </div>
                            <div class="text-muted small mt-2">Asignadas: @Model.VacationAllowance &middot; Pendientes: @Model.VacationPending</div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card shadow-soft hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">Ex&aacute;menes</div>
                                    <div class="fw-semibold">Estatus</div>
                                </div>
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Exams/Index">Abrir</a>
                            </div>
                            <div class="mt-3" style="max-width: 300px;">
                                <canvas id="myExamsChart" height="200"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card shadow-soft hn-hover h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small">Tickets</div>
                                    <div class="fw-semibold">Atendidos por mes</div>
                                </div>
                                <span class="hn-badge hn-badge-blue">Ultimos 6 meses</span>
                            </div>
                            <div class="mt-3">
                                <canvas id="ticketsHandledChart" height="120"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card shadow-soft hn-hover">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-muted small">Vi&aacute;ticos</div>
                                    <div class="fw-semibold">Semanas recientes</div>
                                </div>
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Viaticos/Index">Abrir m&oacute;dulo</a>
                            </div>

                            @if (Model.RecentWeeks.Any())
                            {
                                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2 mt-2">
                                    @foreach (var w in Model.RecentWeeks)
                                    {
                                        <div class="col d-flex">
                                            <div class="border rounded-3 p-2 w-100">
                                                <div class="small text-muted">Semana</div>
                                                <div class="fw-semibold">@w.WeekStart.ToString("yyyy-MM-dd")</div>
                                                <div class="small mt-1">@w.Status.GetDisplayName()</div>
                                                <div class="small">Total: <b>@w.Total.ToString("C")</b></div>
                                                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Viaticos/Week" asp-route-id="@w.Id">Abrir</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small mt-2">A&uacute;n no has capturado vi&aacute;ticos.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="kpiRhNotesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Comentarios de RH</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="small text-muted mb-2">Periodo: @Model.CurrentReviewPeriodText</div>
                <div style="white-space: pre-wrap;">@Model.LatestAdminNotes</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const examRawLabels = @Html.Raw(Model.ExamsLabelsJson);
            const examValues = @Html.Raw(Model.ExamsValuesJson);
            const map = { "Assigned": "Asignado", "InProgress": "En progreso", "Submitted": "En revisi&oacute;n", "Graded": "Calificado" };
            const examLabels = (examRawLabels || []).map(x => map[x] ?? x);

            const examsCanvas = document.getElementById('myExamsChart');
            if (examsCanvas) {
                const pairs = examLabels.map((l, i) => ({ l, v: examValues[i] ?? 0 })).filter(x => x.v > 0);
                if (pairs.length > 0) {
                    const cfg = {
                        type: 'doughnut',
                        data: { labels: pairs.map(x => x.l), datasets: [{ label: 'Ex&aacute;menes', data: pairs.map(x => x.v) }] },
                        options: { plugins: { legend: { position: 'bottom' } } }
                    };
                    window.hnCharts?.decorate(cfg);
                    new Chart(examsCanvas, cfg);
                } else {
                    examsCanvas.parentElement.innerHTML = '<div class="text-muted small">Sin datos</div>';
                }
            }

            const payLabels = @Html.Raw(Model.PayrollLabelsJson);
            const payValues = @Html.Raw(Model.PayrollValuesJson);
            const payCanvas = document.getElementById('payrollChart');
            if (payCanvas && Array.isArray(payValues) && payValues.some(v => Number(v) > 0)) {
                const cfg = {
                    type: 'doughnut',
                    data: {
                        labels: payLabels,
                        datasets: [{
                            label: 'N&oacute;mina',
                            data: payValues,
                            backgroundColor: ['#2563eb', '#f59e0b', '#10b981']
                        }]
                    },
                    options: { plugins: { legend: { position: 'bottom' } } }
                };
                new Chart(payCanvas, cfg);
            } else if (payCanvas) {
                payCanvas.parentElement.innerHTML = '<div class="text-muted small">Sin datos de n&oacute;mina</div>';
            }

            const kpiLabels = @Html.Raw(Model.KpiHistoryLabelsJson);
            const kpiValues = @Html.Raw(Model.KpiHistoryValuesJson);
            const kpiCanvas = document.getElementById('kpiHistoryChart');
            if (kpiCanvas && Array.isArray(kpiValues) && kpiValues.length > 0) {
                const cfg = {
                    type: 'line',
                    data: {
                        labels: kpiLabels,
                        datasets: [{
                            label: 'KPI mensual',
                            data: kpiValues,
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37,99,235,.15)',
                            fill: true,
                            tension: 0.35
                        }]
                    },
                    options: {
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                ticks: { callback: (v) => `${v}%` }
                            }
                        }
                    }
                };
                window.hnCharts?.decorate(cfg);
                new Chart(kpiCanvas, cfg);
            } else if (kpiCanvas) {
                kpiCanvas.parentElement.innerHTML = '<div class="text-muted small">Sin historico de KPI aun.</div>';
            }

            const ticketsLabels = @Html.Raw(Model.TicketsLabelsJson);
            const ticketsValues = @Html.Raw(Model.TicketsValuesJson);
            const ticketsCanvas = document.getElementById('ticketsHandledChart');
            if (ticketsCanvas && Array.isArray(ticketsValues) && ticketsValues.some(v => Number(v) > 0)) {
                const cfg = {
                    type: 'bar',
                    data: {
                        labels: ticketsLabels,
                        datasets: [{
                            label: 'Tickets resueltos',
                            data: ticketsValues,
                            backgroundColor: '#2563eb',
                            borderRadius: 8
                        }]
                    },
                    options: {
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                };
                window.hnCharts?.decorate(cfg);
                new Chart(ticketsCanvas, cfg);
            } else if (ticketsCanvas) {
                ticketsCanvas.parentElement.innerHTML = '<div class="text-muted small">Sin tickets resueltos recientes</div>';
            }
        })();
    </script>
}
