@page
@model HNControl.Web.Pages.Employees.OrgChartModel
@using global::System.Text.Json
@{
    ViewData["Title"] = "Organigrama";
    var employeesJson = JsonSerializer.Serialize(Model.Employees, new JsonSerializerOptions(JsonSerializerDefaults.Web));
    var nodesJson = JsonSerializer.Serialize(Model.Nodes, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Organigrama</h1>
        <div class="text-muted small">Vista interna de jerarquía del equipo.</div>
    </div>
</div>

<div class="card shadow-soft">
    <div class="card-body">
        <div id="orgReadOnly" class="org-flow-root"></div>
    </div>
</div>

@section Styles {
    <style>
        .org-flow-root {
            min-height: 420px;
            overflow: auto;
            padding-bottom: 1rem;
            padding-right: .5rem;
        }
        .org-tree {
            margin: 0;
            padding: 0;
            list-style: none;
            display: flex;
            justify-content: center;
        }
        .org-tree li {
            text-align: center;
            list-style-type: none;
            position: relative;
            padding: 20px 8px 0 8px;
        }
        .org-tree li::before,
        .org-tree li::after {
            content: '';
            position: absolute;
            top: 0;
            right: 50%;
            border-top: 2px solid rgba(59,130,246,.35);
            width: 50%;
            height: 20px;
        }
        .org-tree li::after {
            right: auto;
            left: 50%;
            border-left: 2px solid rgba(59,130,246,.35);
        }
        .org-tree li:only-child::after,
        .org-tree li:only-child::before {
            display: none;
        }
        .org-tree li:only-child {
            padding-top: 0;
        }
        .org-tree li:first-child::before,
        .org-tree li:last-child::after {
            border: 0 none;
        }
        .org-tree li:last-child::before {
            border-right: 2px solid rgba(59,130,246,.35);
            border-radius: 0 6px 0 0;
        }
        .org-tree li:first-child::after {
            border-radius: 6px 0 0 0;
        }
        .org-tree ul {
            padding-top: 20px;
            position: relative;
            padding-left: 0;
            display: flex;
            justify-content: center;
        }
        .org-tree ul::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            border-left: 2px solid rgba(59,130,246,.35);
            width: 0;
            height: 20px;
        }
        .org-card {
            background: #fff;
            border: 1px solid rgba(15,23,42,.12);
            border-radius: 14px;
            padding: .5rem .6rem;
            min-width: 170px;
            max-width: 220px;
            box-shadow: 0 8px 16px rgba(15,23,42,.06);
            display: inline-block;
            text-align: left;
        }
        .org-name { font-weight: 700; font-size: .9rem; line-height:1.2; }
        .org-role { font-size:.8rem; color:#64748b; }
    </style>
}

@section Scripts {
<script>
(() => {
    const root = document.getElementById('orgReadOnly');
    const employees = @Html.Raw(employeesJson);
    const nodes = @Html.Raw(nodesJson);

    const getUserId = (x) => x?.userId || x?.UserId || '';
    const getReportsTo = (x) => x?.reportsToUserId || x?.ReportsToUserId || null;
    const getSortOrder = (x) => x?.sortOrder ?? x?.SortOrder ?? 0;
    const getFullName = (x) => x?.fullName || x?.FullName || '-';
    const getPosition = (x) => x?.position || x?.Position || '-';
    const getEmail = (x) => x?.email || x?.Email || '-';

    const byUser = new Map(employees.map(e => [getUserId(e), e]).filter(([k]) => !!k));

    const children = new Map();
    nodes.forEach(n => {
        const parent = getReportsTo(n) || '__ROOT__';
        if (!children.has(parent)) children.set(parent, []);
        children.get(parent).push(n);
    });

    for (const [k, list] of children.entries()) {
        list.sort((a, b) => getSortOrder(a) - getSortOrder(b));
    }

    function renderNode(userId, parentUl) {
        const emp = byUser.get(userId);
        if (!emp) return;
        const li = document.createElement('li');
        const card = document.createElement('div');
        card.className = 'org-card';
        card.innerHTML = `<div class="org-name">${getFullName(emp)}</div><div class="org-role">${getPosition(emp)} · ${getEmail(emp)}</div>`;
        const kids = children.get(userId) || [];
        if (kids.length > 0) {
            const ul = document.createElement('ul');
            ul.className = 'org-tree';
            kids.forEach(k => renderNode(getUserId(k), ul));
            li.appendChild(card);
            li.appendChild(ul);
        } else {
            li.appendChild(card);
        }
        parentUl.appendChild(li);
    }

    const roots = children.get('__ROOT__') || [];
    const rootTree = document.createElement('ul');
    rootTree.className = 'org-tree';
    if (roots.length === 0) {
        employees.forEach(e => {
            renderNode(getUserId(e), rootTree);
        });
        root.appendChild(rootTree);
        return;
    }

    roots.forEach(r => {
        renderNode(getUserId(r), rootTree);
    });
    root.appendChild(rootTree);
})();
</script>
}
