@page
@model HNControl.Web.Pages.Employees.OrgChartModel
@using global::System.Text.Json
@{
    ViewData["Title"] = "Organigrama";
    var employeesJson = JsonSerializer.Serialize(Model.Employees, new JsonSerializerOptions(JsonSerializerDefaults.Web));
    var nodesJson = JsonSerializer.Serialize(Model.Nodes, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Organigrama</h1>
        <div class="text-muted small">Vista interna de jerarquía del equipo.</div>
    </div>
</div>

<div class="card shadow-soft">
    <div class="card-body">
        <div id="orgReadOnly"></div>
    </div>
</div>

@section Styles {
    <style>
        .org-card {
            background: #fff;
            border: 1px solid rgba(15,23,42,.12);
            border-radius: 14px;
            padding: .6rem .75rem;
            margin-bottom: .55rem;
            box-shadow: 0 8px 16px rgba(15,23,42,.06);
        }
        .org-name { font-weight: 700; font-size: .96rem; line-height:1.2; }
        .org-role { font-size:.8rem; color:#64748b; }
        .org-children {
            margin-top: .55rem;
            margin-left: 1rem;
            border-left: 2px solid rgba(59,130,246,.25);
            padding-left: .6rem;
        }
    </style>
}

@section Scripts {
<script>
(() => {
    const root = document.getElementById('orgReadOnly');
    const employees = @Html.Raw(employeesJson);
    const nodes = @Html.Raw(nodesJson);

    const getUserId = (x) => x?.userId || x?.UserId || '';
    const getReportsTo = (x) => x?.reportsToUserId || x?.ReportsToUserId || null;
    const getSortOrder = (x) => x?.sortOrder ?? x?.SortOrder ?? 0;
    const getFullName = (x) => x?.fullName || x?.FullName || '-';
    const getPosition = (x) => x?.position || x?.Position || '-';
    const getEmail = (x) => x?.email || x?.Email || '-';

    const byUser = new Map(employees.map(e => [getUserId(e), e]).filter(([k]) => !!k));

    const children = new Map();
    nodes.forEach(n => {
        const parent = getReportsTo(n) || '__ROOT__';
        if (!children.has(parent)) children.set(parent, []);
        children.get(parent).push(n);
    });

    for (const [k, list] of children.entries()) {
        list.sort((a, b) => getSortOrder(a) - getSortOrder(b));
    }

    function buildCard(userId) {
        const emp = byUser.get(userId);
        if (!emp) return null;
        const card = document.createElement('div');
        card.className = 'org-card';
        card.innerHTML = `<div class="org-name">${getFullName(emp)}</div><div class="org-role">${getPosition(emp)} · ${getEmail(emp)}</div>`;
        const kids = children.get(userId) || [];
        if (kids.length > 0) {
            const zone = document.createElement('div');
            zone.className = 'org-children';
            kids.forEach(k => {
                const child = buildCard(getUserId(k));
                if (child) zone.appendChild(child);
            });
            card.appendChild(zone);
        }
        return card;
    }

    const roots = children.get('__ROOT__') || [];
    if (roots.length === 0) {
        employees.forEach(e => {
            const c = buildCard(getUserId(e));
            if (c) root.appendChild(c);
        });
        return;
    }

    roots.forEach(r => {
        const c = buildCard(getUserId(r));
        if (c) root.appendChild(c);
    });
})();
</script>
}
