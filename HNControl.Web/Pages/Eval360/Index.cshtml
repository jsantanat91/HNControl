@page
@model HNControl.Web.Pages.Eval360.IndexModel
@{
    ViewData["Title"] = "Evaluación 360";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Evaluación 360</h1>
        <div class="text-muted small">Evalúa a tus compañeros (y a ti mismo si aplica).</div>
    </div>
</div>

@if (!Model.Pending.Any())
{
    <div class="alert alert-info">No tienes evaluaciones pendientes. Cuando el admin abra una campaña, aparecerán aquí.</div>
}
else
{
    <div class="card shadow-soft mb-3">
        <div class="card-header fw-semibold">Pendientes</div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Campaña</th>
                        <th>Persona</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Pending)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@p.CampaignTitle</div>
                            <div class="text-muted small">Fin: @(p.PeriodEnd?.ToString("dd/MM/yyyy") ?? "—")</div>
                        </td>
                        <td>
                            @if (p.IsSelf)
                            {
                                <span class="badge bg-light text-dark me-2">Auto</span>
                            }
                            @p.SubjectName
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary" asp-page="/Eval360/Do" asp-route-id="@p.AssignmentId">Calificar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.AvailableResults.Any())
{
    <div class="card shadow-soft">
        <div class="card-header fw-semibold">Resultados disponibles</div>
        <div class="list-group list-group-flush">
        @foreach (var r in Model.AvailableResults)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               asp-page="/Eval360/MyResults" asp-route-id="@r.CampaignId">
                <span>
                    <span class="fw-semibold">@r.CampaignTitle</span>
                    <span class="text-muted small">· Fin: @(r.PeriodEnd?.ToString("dd/MM/yyyy") ?? "—")</span>
                </span>
                <span class="text-muted">Ver</span>
            </a>
        }
        </div>
    </div>
}
