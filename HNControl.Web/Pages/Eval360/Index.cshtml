@page
@model HNControl.Web.Pages.Eval360.IndexModel
@{
    ViewData["Title"] = "Evaluación 360";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Evaluación 360</h1>
        <div class="text-muted">Evalúa a tus compañeros (y a ti mismo si aplica).</div>
    </div>
</div>

@if (!Model.Pending.Any())
{
    <div class="card shadow-soft">
        <div class="card-body text-muted">No tienes evaluaciones pendientes. Cuando el admin abra una campaña, aparecerán aquí.</div>
    </div>
}
else
{
    <div class="row g-3 mb-3">
        @foreach (var p in Model.Pending)
        {
            <div class="col-12 col-lg-6">
                <div class="card shadow-soft h-100 hn-hover">
                    <div class="card-body d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="fw-semibold">@p.CampaignTitle</div>
                                <div class="text-muted small">Fin: @(p.PeriodEnd?.ToString("dd/MM/yyyy") ?? "-")</div>
                            </div>
                            @if (p.IsSelf)
                            {
                                <span class="hn-badge hn-badge-blue">Autoevaluación</span>
                            }
                            else
                            {
                                <span class="hn-badge hn-badge-gray">Compañero</span>
                            }
                        </div>

                        <div class="small"><span class="text-muted">Persona:</span> <b>@p.SubjectName</b></div>

                        <div class="mt-auto d-flex justify-content-end">
                            <a class="btn btn-primary btn-sm" asp-page="/Eval360/Do" asp-route-id="@p.AssignmentId">Calificar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.AvailableResults.Any())
{
    <div class="card shadow-soft">
        <div class="card-header fw-semibold">Resultados disponibles</div>
        <div class="card-body">
            <div class="row g-2">
                @foreach (var r in Model.AvailableResults)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <a class="text-decoration-none" asp-page="/Eval360/MyResults" asp-route-id="@r.CampaignId">
                            <div class="border rounded-3 p-3 h-100 hn-hover">
                                <div class="fw-semibold text-dark">@r.CampaignTitle</div>
                                <div class="text-muted small">Fin: @(r.PeriodEnd?.ToString("dd/MM/yyyy") ?? "-")</div>
                                <div class="mt-2"><span class="hn-badge hn-badge-green">Ver resultados</span></div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}
