@page "{id:guid}"
@model HNControl.Web.Pages.Eval360.MyResultsModel
@{
    ViewData["Title"] = "Mis resultados · 360";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Mis resultados · Evaluación 360</h1>
        <div class="text-muted small">
            <span class="fw-semibold">@Model.Me.FullName</span> · Campaña: <span class="fw-semibold">@Model.Campaign.Title</span>
        </div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Eval360/Index">Volver</a>
</div>

@if (TempData["Msg"] is string msg)
{
    <div class="alert alert-info">@msg</div>
}

@if (!Model.HasOtherResponses)
{
    <div class="alert alert-warning">
        Por ahora solo tienes tu <strong>Esperado</strong>. Cuando tus compañeros completen sus pendientes,
        aparecerá la barra de <strong>Evaluación</strong> (y dejará de verse en 0%).
    </div>
}

@if (!Model.Rows.Any())
{
    <div class="alert alert-warning">Sin datos para graficar todavía.</div>
    return;
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-soft">
            <div class="card-header fw-semibold">Esperado vs Evaluación</div>
            <div class="card-body">
                <canvas id="cmpChart" height="140"></canvas>
                <div class="text-muted small mt-2">
                    Escala 1–5 convertida a porcentaje.
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-soft">
            <div class="card-header fw-semibold">Lectura rápida</div>
            <div class="card-body">
                <div class="small text-muted mb-2">
                    <b>Diferencia</b> = Esperado - Evaluación. <br />
                    <span class="text-muted">Positiva:</span> te estás poniendo más alto que lo que ve el equipo. <br />
                    <span class="text-muted">Negativa:</span> el equipo te ve más alto (bien ahí).
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Competencia</th>
                                <th class="text-end">Esperado</th>
                                <th class="text-end">Evaluación</th>
                                <th class="text-end">Diferencia</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var diff = r.DiffPct;
                            var badge = diff >= 10 ? "text-bg-danger" : (diff <= -10 ? "text-bg-success" : "text-bg-secondary");
                            <tr>
                                <td class="fw-semibold">@r.Competency</td>
                                <td class="text-end">@r.AutoPct%</td>
                                <td class="text-end">@r.OthersPct%</td>
                                <td class="text-end"><span class="badge @badge">@((diff >= 0 ? "+" : ""))@diff%</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <hr />
                <div class="small text-muted mb-0">
                    Tip pro: empieza por las competencias con diferencia positiva grande (ahí se te está “colando” el ego 😄).
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const labels = @Html.Raw(Model.LabelsJson);
        const expectedValues = @Html.Raw(Model.AutoJson);
        const evalValues = @Html.Raw(Model.OthersJson);

        const cfg = {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    { label: 'Esperado', data: expectedValues, backgroundColor: 'rgba(16, 185, 129, 0.6)' },
                    { label: 'Evaluación', data: evalValues, backgroundColor: 'rgba(59, 130, 246, 0.6)' }
                ]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true, max: 100 } }
            }
        };

        window.hnCharts?.decorate(cfg);
        new Chart(document.getElementById('cmpChart'), cfg);
    </script>
}
