@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Carriers.EditModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar carrier";
}

<div class="d-flex align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h4 mb-0">Editar carrier</h1>
    <a class="btn btn-outline-secondary" asp-page="./Index">← Volver</a>
</div>

<form method="post" class="card">
    <div class="card-body">
        <input type="hidden" asp-for="Input.Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input class="form-control" asp-for="Input.Name" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tel soporte</label>
                <input class="form-control" asp-for="Input.SupportPhone" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Email</label>
                <input class="form-control" asp-for="Input.SupportEmail" />
            </div>
            <div class="col-12">
                <label class="form-label">Portal</label>
                <input class="form-control" asp-for="Input.SupportPortalUrl" />
            </div>
            <div class="col-12">
                <label class="form-label">Notas</label>
                <textarea class="form-control" asp-for="Input.Notes" rows="4"></textarea>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.IsActive" />
                    <label class="form-check-label" asp-for="Input.IsActive">Activo</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
