@page
@model HNControl.Web.Pages.Admin.Carriers.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin - Carriers";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Carriers (Internet)</h1>
        <div class="text-muted small">Catálogo de proveedores + datos de soporte.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-page="./Create">+ Nuevo carrier</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Carriers/Services/Index">Servicios por cliente</a>
        <a class="btn btn-outline-secondary" asp-page="/Carriers/Index">Vista (empleados)</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width:86px;">Logo</th>
                        <th>Carrier</th>
                        <th>Ejecutivo</th>
                        <th>Tel soporte</th>
                        <th>Email</th>
                        <th>Portal</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Carriers)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(c.LogoStoragePath))
                            {
                                <img src="@Url.Page("/Carriers/Logo", new { id = c.Id })" alt="logo" style="height:36px; width:72px; object-fit:contain;" class="border rounded bg-white p-1" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="fw-semibold">@c.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(c.ExecutiveName) ? "—" : c.ExecutiveName)</td>
                        <td>@(string.IsNullOrWhiteSpace(c.SupportPhone) ? "—" : c.SupportPhone)</td>
                        <td>@(string.IsNullOrWhiteSpace(c.SupportEmail) ? "—" : c.SupportEmail)</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(c.SupportPortalUrl))
                            {
                                <a class="hn-link" href="@c.SupportPortalUrl" target="_blank" rel="noopener">Abrir</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@c.Id">Editar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Carriers.Count == 0)
        {
            <div class="text-muted">Sin carriers aún.</div>
        }
    </div>
</div>
