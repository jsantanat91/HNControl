@page
@model HNControl.Web.Pages.Admin.Carriers.Services.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin - Servicios Carrier";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Servicios por cliente</h1>
        <div class="text-muted small">Servicios carrier ligados a contratos y datos operativos.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-page="./Create">+ Nuevo servicio</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Carriers/Index">Carriers</a>
    </div>
</div>

<form method="get" class="card mb-3 shadow-soft hn-hover">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small text-muted">Cliente</label>
                <select class="form-select" name="clientId">
                    <option value="">(Todos)</option>
                    @foreach (var c in Model.Clients)
                    {
                        <option value="@c.Id" selected="@(Model.ClientId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small text-muted">Buscar</label>
                <input class="form-control" name="q" value="@Model.Q" placeholder="Servicio, contrato, cuenta, circuito, carrier..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary w-100" type="submit">Filtrar</button>
                <a class="btn btn-outline-secondary" asp-page="./Index">Limpiar</a>
            </div>
        </div>
    </div>
</form>

@if (Model.Services.Count == 0)
{
    <div class="alert alert-light border">Sin resultados.</div>
}
else
{
    <div class="row row-cols-1 row-cols-xl-2 g-3">
        @foreach (var s in Model.Services)
        {
            var contractNumber = s.ClientServiceContract?.ContractNumber;
            var branchBadge = s.ClientServiceContract?.Branch;
            if (string.IsNullOrWhiteSpace(contractNumber))
            {
                contractNumber = s.ContractNumber;
            }
            if (string.IsNullOrWhiteSpace(branchBadge))
            {
                branchBadge = s.ClientServiceContract?.Label;
            }

            <div class="col d-flex">
                <div class="card shadow-soft hn-hover w-100 hn-admin-service-card">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                            <div class="min-w-0">
                                <div class="fw-bold fs-5 lh-sm hn-service-title" title="@s.ServiceLabel">@s.ServiceLabel</div>
                                <div class="text-muted small">@s.Client?.Name</div>
                            </div>
                            <div class="d-flex gap-1 flex-wrap justify-content-end hn-service-badges">
                                <span class="hn-chip hn-chip-neutral">@(s.Carrier?.Name ?? "-")</span>
                                @if (!string.IsNullOrWhiteSpace(s.Plan))
                                {
                                    <span class="hn-chip hn-chip-type">@s.Plan</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(contractNumber))
                                {
                                    <span class="hn-chip hn-chip-ref">#@contractNumber</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(branchBadge))
                                {
                                    <span class="hn-chip hn-chip-type">Sucursal: @branchBadge</span>
                                }
                            </div>
                        </div>

                        <div class="hn-service-grid mt-2">
                            <div><span class="text-muted small">Cuenta</span><div class="fw-semibold">@(string.IsNullOrWhiteSpace(s.AccountNumber) ? "-" : s.AccountNumber)</div></div>
                            <div><span class="text-muted small">Cuenta ID</span><div class="fw-semibold">@(string.IsNullOrWhiteSpace(s.CircuitId) ? "-" : s.CircuitId)</div></div>
                            <div><span class="text-muted small">Contrato ligado</span><div class="fw-semibold">@(s.ClientServiceContract?.Label ?? "-")</div></div>
                            <div><span class="text-muted small">Razon social</span><div class="fw-semibold">@(string.IsNullOrWhiteSpace(s.BusinessName) ? "-" : s.BusinessName)</div></div>
                            <div><span class="text-muted small">Numero serie</span><div class="fw-semibold">@(string.IsNullOrWhiteSpace(s.SerialNumber) ? "-" : s.SerialNumber)</div></div>
                        </div>

                        <div class="mt-auto pt-3 d-flex justify-content-end gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@s.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Carriers/Client" asp-route-id="@s.ClientId">Ver</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-muted small mt-2">Mostrando hasta 500 servicios.</div>
}

@section Styles {
    <style>
        .hn-admin-service-card {
            border-radius: 16px !important;
            background: linear-gradient(150deg, rgba(255,255,255,.98), rgba(248,251,255,.94));
        }

        .hn-service-title {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .hn-service-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .75rem;
        }

        @@media (max-width: 991.98px) {
            .hn-service-grid {
                grid-template-columns: repeat(1, minmax(0, 1fr));
            }

            .hn-service-badges {
                width: 100%;
                justify-content: flex-start !important;
            }
        }
    </style>
}
