@page
@using HNControl.Web.Models
@model HNControl.Web.Pages.Admin.SystemPages.ConfigurationModel
@{
    ViewData["Title"] = "Configuraci\u00F3n del sistema";
}

<style>
    .content-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        align-items: center;
        padding: .45rem;
        margin-bottom: 1rem;
        background: #fff;
        border: 1px solid rgba(37, 99, 235, .12);
        border-radius: .9rem;
        box-shadow: 0 16px 34px rgba(15, 23, 42, .07);
    }

    .content-tabs .nav-item {
        margin: 0;
    }

    .content-tabs .nav-link {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        min-height: 2.3rem;
        padding: .48rem .78rem;
        color: #25324b;
        font-size: .88rem;
        font-weight: 700;
        border: 1px solid transparent;
        border-radius: .65rem;
        background: transparent;
        transition: background-color .16s ease, border-color .16s ease, color .16s ease, box-shadow .16s ease;
    }

    .content-tabs .nav-link:hover,
    .content-tabs .nav-link:focus {
        color: #1d4ed8;
        background: #f5f8ff;
        border-color: #d8e3ff;
    }

    .content-tabs .nav-link.active {
        color: #2746e8;
        background: linear-gradient(180deg, #f6f8ff 0%, #eef3ff 100%);
        border-color: #b8c8ff;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .75);
    }

    .content-tabs .tab-icon {
        color: #64748b;
        font-size: .82rem;
        line-height: 1;
    }

    .content-tabs .nav-link.active .tab-icon {
        color: #2746e8;
    }
</style>

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 m-0">Configuración</h1>
        <div class="text-muted small">General y Fiscal (SAT/PAC/SMTP) para operación central y timbrado.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Admin/System/Backup">Respaldo DB</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Flash))
{
    <div class="alert alert-@(Model.FlashType ?? "info")">@Model.Flash</div>
}
@if (!string.IsNullOrWhiteSpace(Model.FiscalValidation))
{
    <div class="alert alert-@(Model.FiscalValidationType ?? "info")">@Model.FiscalValidation</div>
}

<div class="card shadow-soft hn-hover">
    <div class="card-body">
        <ul class="nav content-tabs" id="cfgTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" type="button" data-bs-toggle="pill" data-bs-target="#tabGeneral">
                    <span class="tab-icon" aria-hidden="true">☰</span>
                    <span>General</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tabFiscal">
                    <span class="tab-icon" aria-hidden="true">◉</span>
                    <span>Fiscal</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tabApi">
                    <span class="tab-icon" aria-hidden="true">⌁</span>
                    <span>Mercado Pago</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tabWa">
                    <span class="tab-icon" aria-hidden="true">✉</span>
                    <span>WA</span>
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tabGeneral">
                <form method="post" asp-page-handler="SaveGeneral" enctype="multipart/form-data" class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Nombre comercial</label>
                        <input class="form-control" asp-for="Input.CompanyName" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Razón social</label>
                        <input class="form-control" asp-for="Input.CompanyLegalName" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Correo de facturación</label>
                        <input class="form-control" asp-for="Input.BillingEmail" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Logo global</label>
                        <input class="form-control" asp-for="Input.CompanyLogo" type="file" accept=".png,.jpg,.jpeg,.webp" />
                        @if (Model.HasLogo)
                        {
                            <div class="small text-success mt-1">Logo cargado: @(string.IsNullOrWhiteSpace(Model.LogoName) ? "archivo actual" : Model.LogoName)</div>
                            <a class="small" asp-page="./Configuration" asp-page-handler="DownloadLogo">Descargar logo actual</a>
                        }
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Guardar datos generales</button>
                    </div>
                </form>

                <hr />

                <form method="post" asp-page-handler="SaveSmtp" class="row g-3">
                    <div class="col-12">
                        <div class="fw-semibold">SMTP editable</div>
                        <div class="text-muted small">Se guarda por separado para no bloquear los datos generales/fiscales.</div>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Servidor SMTP</label>
                        <input class="form-control" asp-for="Input.SmtpHost" />
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Puerto</label>
                        <input class="form-control" asp-for="Input.SmtpPort" type="number" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Usuario SMTP</label>
                        <input class="form-control" asp-for="Input.SmtpUser" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Contrase&ntilde;a SMTP</label>
                        <input class="form-control" asp-for="Input.SmtpPassword" type="password" placeholder="Dejar vacio para conservar" />
                        @if (Model.HasSmtpPassword)
                        {
                            <div class="small text-success">Contrase&ntilde;a guardada.</div>
                        }
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Correo remitente (From)</label>
                        <input class="form-control" asp-for="Input.SmtpFromEmail" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Nombre remitente (From)</label>
                        <input class="form-control" asp-for="Input.SmtpFromName" />
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Seguridad</label>
                        <select class="form-select" asp-for="Input.SmtpSecurity">
                            <option value="StartTls">STARTTLS</option>
                            <option value="SslOnConnect">SSL/TLS directo</option>
                            <option value="StartTlsWhenAvailable">STARTTLS si disponible</option>
                            <option value="None">Sin cifrado</option>
                            <option value="Auto">Auto</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Tiempo de espera (ms)</label>
                        <input class="form-control" asp-for="Input.SmtpTimeoutMs" type="number" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Dominio HELO (opcional)</label>
                        <input class="form-control" asp-for="Input.SmtpHeloDomain" />
                    </div>

                    <div class="col-12 d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" type="submit">Guardar SMTP</button>
                        <button class="btn btn-outline-info" type="submit" formaction="?handler=ValidateSmtp" formmethod="post">Validar conexi&oacute;n SMTP</button>
                    </div>
                </form>
            </div>

            <div class="tab-pane fade" id="tabFiscal">
                <form method="post" asp-page-handler="SaveFiscal" enctype="multipart/form-data" class="row g-3">
                    <div class="col-12">
                        <div class="fw-semibold">Datos fiscales de la empresa</div>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">RFC emisor</label>
                        <input class="form-control" asp-for="Input.CompanyRfc" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">R&eacute;gimen fiscal</label>
                        <select class="form-select" asp-for="Input.CompanyFiscalRegimeCode">
                            @foreach (var it in SatCatalogs.RegimenFiscal)
                            {
                                <option value="@it.Code">@it.Code - @it.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">CP fiscal</label>
                        <input class="form-control" asp-for="Input.CompanyFiscalZipCode" />
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Versi&oacute;n CFDI</label>
                        <input class="form-control" asp-for="Input.CfdiVersion" placeholder="4.0" />
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Serie default</label>
                        <input class="form-control" asp-for="Input.CfdiSerieDefault" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Domicilio fiscal</label>
                        <input class="form-control" asp-for="Input.CompanyFiscalAddress" />
                    </div>

                    <div class="col-12"><hr /></div>
                    <div class="col-12">
                        <div class="fw-semibold">Timbrado oficial (PAC)</div>
                        <div class="text-muted small">Conecta proveedor API y credenciales del CSD SAT.</div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">Proveedor PAC</label>
                        <select class="form-select" asp-for="Input.BillingPacProvider" asp-items="Model.PacProviders"></select>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label">API base URL</label>
                        <input class="form-control" asp-for="Input.BillingPacApiBaseUrl" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">API key</label>
                        <input class="form-control" asp-for="Input.BillingPacApiKey" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">API secret</label>
                        <input class="form-control" asp-for="Input.BillingPacApiSecret" type="password" placeholder="Dejar vacio para conservar" />
                        @if (Model.HasPacSecret)
                        {
                            <div class="small text-success">Secret guardado.</div>
                        }
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Usuario PAC</label>
                        <input class="form-control" asp-for="Input.BillingPacUsername" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Password PAC</label>
                        <input class="form-control" asp-for="Input.BillingPacPassword" type="password" placeholder="Dejar vacio para conservar" />
                        @if (Model.HasPacPassword)
                        {
                            <div class="small text-success">Password guardado.</div>
                        }
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Archivo CSD .cer</label>
                        <input class="form-control" asp-for="Input.CsdCerFile" type="file" accept=".cer" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Archivo CSD .key</label>
                        <input class="form-control" asp-for="Input.CsdKeyFile" type="file" accept=".key" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Password CSD</label>
                        <input class="form-control" asp-for="Input.CsdPassword" type="password" placeholder="Dejar vacio para conservar" />
                        @if (Model.HasCsdPassword)
                        {
                            <div class="small text-success">Password guardado.</div>
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label">Notas t&eacute;cnicas</label>
                        <textarea class="form-control" asp-for="Input.Notes" rows="3"></textarea>
                    </div>

                    <div class="col-12 d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" type="submit">Guardar fiscal / PAC</button>
                        <button class="btn btn-outline-info" type="submit" formaction="?handler=ValidateFiscal" formmethod="post">Validar SAT / PAC</button>
                    </div>
                </form>
            </div>

            <div class="tab-pane fade" id="tabApi">
                <form method="post" asp-page-handler="SaveApi" class="row g-3">
                    <div class="col-12">
                        <div class="fw-semibold">Mercado Pago</div>
                        <div class="text-muted small">Configuracion para pagos y enlaces del portal cliente.</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Base URL publica (opcional)</label>
                        <input class="form-control" asp-for="Input.PublicBaseUrl" placeholder="https://tudominio.com" />
                        <div class="form-text">Se usa para enlaces de retorno del portal cliente (si no esta, toma PublicLinks:BaseUrl).</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Mercado Pago - Public Key (opcional)</label>
                        <input class="form-control" asp-for="Input.MercadoPagoPublicKey" placeholder="APP_USR-..." />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Mercado Pago - Access Token</label>
                        <input class="form-control" asp-for="Input.MercadoPagoAccessToken" type="password" placeholder="Dejar vacio para conservar" />
                        @if (Model.HasMercadoPagoToken)
                        {
                            <div class="small text-success">Access token guardado.</div>
                        }
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Mercado Pago - Webhook Secret (opcional)</label>
                        <input class="form-control" asp-for="Input.MercadoPagoWebhookSecret" type="password" placeholder="Dejar vacio para conservar" />
                        @if (Model.HasMercadoPagoWebhookSecret)
                        {
                            <div class="small text-success">Webhook secret guardado.</div>
                        }
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Guardar Mercado Pago</button>
                        <button class="btn btn-outline-primary" type="submit" asp-page-handler="CheckMercadoPagoConnection">Probar conexión Mercado Pago</button>
                    </div>
                    <div class="col-12">
                        <div class="form-text">"Probar conexión" valida el Access Token contra la API de Mercado Pago (sin generar pagos). Guarda antes de probar.</div>
                    </div>
                </form>
            </div>

            <div class="tab-pane fade" id="tabWa">
                <form method="post" asp-page-handler="SaveWhatsApp" class="row g-3">
                    <div class="col-12">
                        <div class="fw-semibold">WhatsApp Business · Meta Cloud API</div>
                        <div class="text-muted small">Envío oficial vía graph.facebook.com. Los mensajes iniciados por el negocio requieren plantillas aprobadas en Meta.</div>
                    </div>

                    <div class="col-12 col-md-3">
                        <div class="form-check mt-4">
                            <input class="form-check-input" asp-for="Input.WhatsAppEnabled" />
                            <label class="form-check-label" asp-for="Input.WhatsAppEnabled">Habilitar WhatsApp</label>
                        </div>
                    </div>

                    <div class="col-12 col-md-5">
                        <label class="form-label">Phone Number ID</label>
                        <input class="form-control" asp-for="Input.WhatsAppGatewayUrl" placeholder="Ej: 123456789012345" />
                        <div class="form-text">El <code>Phone Number ID</code> del número (WhatsApp → API Setup en Meta).</div>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Access Token permanente</label>
                        <input class="form-control" asp-for="Input.WhatsAppApiKey" type="password" placeholder="Dejar vacio para conservar" />
                        @if (Model.HasWhatsAppApiKey)
                        {
                            <div class="small text-success">Token guardado.</div>
                        }
                        <div class="form-text">Token del Usuario del Sistema de Meta (permiso <code>whatsapp_business_messaging</code>).</div>
                    </div>

                    <div class="col-6 col-md-4">
                        <label class="form-label">WABA ID (opcional)</label>
                        <input class="form-control" asp-for="Input.WhatsAppWabaId" placeholder="ID de la cuenta WhatsApp Business" />
                    </div>

                    <div class="col-6 col-md-4">
                        <label class="form-label">Versión Graph API</label>
                        <input class="form-control" asp-for="Input.WhatsAppGraphApiVersion" placeholder="v21.0" />
                    </div>

                    <div class="col-6 col-md-4">
                        <label class="form-label">Idioma de plantillas</label>
                        <input class="form-control" asp-for="Input.WhatsAppTemplateLanguage" placeholder="es_MX" />
                        <div class="form-text">Debe coincidir con el idioma configurado en la plantilla de Meta.</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Webhook Verify Token (opcional)</label>
                        <input class="form-control" asp-for="Input.WhatsAppWebhookVerifyToken" placeholder="Cadena que eliges tú; debe coincidir en Meta" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Teléfonos internos para alertas</label>
                        <input class="form-control" asp-for="Input.WhatsAppInternalPhonesCsv" placeholder="525655273643, 5255..." />
                        <div class="form-text">Separados por coma. Se usan para tickets y alertas internas.</div>
                    </div>

                    <div class="col-12 col-md-3">
                        <div class="form-check mt-4">
                            <input class="form-check-input" asp-for="Input.WhatsAppNotifyTickets" />
                            <label class="form-check-label" asp-for="Input.WhatsAppNotifyTickets">Notificar tickets</label>
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <div class="form-check mt-4">
                            <input class="form-check-input" asp-for="Input.WhatsAppNotifyCustomers" />
                            <label class="form-check-label" asp-for="Input.WhatsAppNotifyCustomers">Notificar clientes</label>
                        </div>
                    </div>

                    <div class="col-12"><hr /></div>
                    <div class="col-12">
                        <div class="fw-semibold">Plantillas para empleados</div>
                        <div class="text-muted small">
                            OTP: <code>{NombreEmpleado}</code>, <code>{CorreoEmpleado}</code>, <code>{Codigo}</code>, <code>{Fecha}</code>, <code>{Hora}</code>, <code>{MinutosValidez}</code>.
                            Nomina: <code>{NombreEmpleado}</code>, <code>{CorreoEmpleado}</code>, <code>{Periodo}</code>, <code>{FechaPago}</code>, <code>{TotalNeto}</code>, <code>{TotalBruto}</code>, <code>{Deducciones}</code>, <code>{Bonos}</code>, <code>{UrlPortal}</code>.
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="alert alert-info small mb-0">
                            El <b>texto</b> es solo respaldo/preview (se usa dentro de la ventana de 24h). Para mensajes
                            iniciados por el negocio, Meta exige el <b>nombre exacto de una plantilla aprobada</b>.
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label class="form-label">Codigo OTP de inicio de sesion (texto/preview)</label>
                        <textarea class="form-control" asp-for="Input.WhatsAppOtpTemplate" rows="4"></textarea>
                        <label class="form-label mt-2">Nombre de plantilla OTP (Authentication)</label>
                        <input class="form-control" asp-for="Input.WhatsAppOtpTemplateName" placeholder="Ej: hn_otp_login" />
                        <div class="form-text">Plantilla categoría <b>Authentication</b>. Parámetro: {{1}} = código.</div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label class="form-label">Recibo de nomina (texto/preview)</label>
                        <textarea class="form-control" asp-for="Input.WhatsAppPayrollReceiptTemplate" rows="4"></textarea>
                        <label class="form-label mt-2">Nombre de plantilla Nómina (Utility)</label>
                        <input class="form-control" asp-for="Input.WhatsAppPayrollTemplateName" placeholder="Ej: hn_recibo_nomina" />
                        <div class="form-text">Utility. Params: {{1}}Nombre {{2}}Periodo {{3}}TotalNeto {{4}}FechaPago.</div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label class="form-label">Nombre de plantilla Tickets/alertas (Utility)</label>
                        <input class="form-control" asp-for="Input.WhatsAppTicketTemplateName" placeholder="Ej: hn_alerta_ticket" />
                        <div class="form-text">Utility. Parámetro: {{1}} = resumen de la alerta.</div>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Guardar WhatsApp</button>
                        <button class="btn btn-outline-primary" type="submit" asp-page-handler="CheckWhatsAppConnection">Probar conexión</button>
                    </div>
                    <div class="col-12">
                        <div class="form-text">"Probar conexión" valida el token y el Phone Number ID contra Meta (sin enviar mensajes). Guarda antes de probar.</div>
                    </div>
                </form>

                <form method="post" asp-page-handler="TestWhatsApp" class="row g-3 mt-2">
                    <div class="col-12 col-md-5">
                        <label class="form-label">Enviar prueba WhatsApp</label>
                        <input class="form-control" asp-for="Input.WhatsAppTestPhone" placeholder="525655273643" />
                    </div>
                    <div class="col-12 col-md-3 d-flex align-items-end">
                        <button class="btn btn-outline-success w-100" type="submit">Probar WhatsApp</button>
                    </div>
                    <div class="col-12">
                        <div class="form-text">Guarda la configuración WA antes de probar el envío.</div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
