@page "{id:guid}"
@model HNControl.Web.Pages.Admin.ServiceOrderTemplates.EditModel
@{
    Layout = "_Layout";
}

<h1 class="h4 mb-3">Editar plantilla</h1>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

<form method="post" class="card shadow-sm hn-hover hn-hover">
    <div class="card-body">
        <input type="hidden" asp-for="Input.Id" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <input class="form-control" value="@Model.Input.Type" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input class="form-control" asp-for="Input.Name" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="Input.IsActive" />
                    <label class="form-check-label">Activa</label>
                </div>
            </div>
        </div>

        <hr />

        <div class="fw-semibold mb-2">Items</div>

        @for (int i = 0; i < Model.Input.Items.Count; i++)
        {
            <div class="border rounded p-2 mb-2">
                <input type="hidden" name="Input.Items[@i].Id" value="@Model.Input.Items[i].Id" />

                <div class="row g-2">
                    <div class="col-md-2">
                        <label class="form-label small">Orden</label>
                        <input class="form-control form-control-sm" name="Input.Items[@i].SortOrder" value="@Model.Input.Items[i].SortOrder" type="number" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small">Categoría</label>
                        <input class="form-control form-control-sm" name="Input.Items[@i].Category" value="@Model.Input.Items[i].Category" />
                    </div>

                    <div class="col-md-5">
                        <label class="form-label small">Título</label>
                        <input class="form-control form-control-sm" name="Input.Items[@i].Title" value="@Model.Input.Items[i].Title" />
                    </div>

                    <div class="col-md-1 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Input.Items[@i].IsRequired" value="true" @(Model.Input.Items[i].IsRequired ? "checked" : "") />
                            <label class="form-check-label small">Req</label>
                        </div>
                    </div>

                    <div class="col-md-1 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Input.Items[@i].Delete" value="true" />
                            <label class="form-check-label small text-danger">Del</label>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="text-muted small">
            “Req” = requerido para enviar a revisión (si tu config está en RequiredOnly).
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a class="btn btn-outline-secondary" asp-page="/Admin/ServiceOrderTemplates/Index">Volver</a>
    </div>
</form>
