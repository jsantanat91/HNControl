@page
@model HNControl.Web.Pages.Admin.Inventory.Movements.IndexModel
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Movimientos de almacén";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Movimientos de almacén</h1>
        <div class="text-muted small">Log general de entradas/salidas. (Sí, aquí sí vemos “qué pasó”).</div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Items/Index">Items</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Approvals/Index">Aprobaciones</a>
        <a class="btn btn-outline-secondary" asp-page="/Inventory/Index">Vista (empleados)</a>
    </div>
</div>

<form method="get" class="card mb-3">
    <div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-4">
                <label class="form-label small text-muted mb-1">Buscar</label>
                <input class="form-control" name="q" value="@Model.Q" placeholder="Item, SKU, solicitó, responsable, serie, referencia, notas..." />
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label small text-muted mb-1">Item</label>
                <select class="form-select" name="itemId">
                    @foreach (var opt in Model.ItemOptions)
                    {
                        <option value="@opt.Value" selected="@(opt.Value == (Model.ItemId?.ToString() ?? ""))">@opt.Text</option>
                    }
                </select>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label small text-muted mb-1">Tipo</label>
                <select class="form-select" name="type">
                    <option value="all" selected="@(string.Equals(Model.Type, "all", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(Model.Type))">Todos</option>
                    <option value="in" selected="@(string.Equals(Model.Type, "in", StringComparison.OrdinalIgnoreCase))">Entradas</option>
                    <option value="out" selected="@(string.Equals(Model.Type, "out", StringComparison.OrdinalIgnoreCase))">Salidas</option>
                </select>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label small text-muted mb-1">Status</label>
                <select class="form-select" name="status">
                    <option value="all" selected="@(string.Equals(Model.Status, "all", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(Model.Status))">Todos</option>
                    <option value="pending" selected="@(string.Equals(Model.Status, "pending", StringComparison.OrdinalIgnoreCase))">Pendiente</option>
                    <option value="approved" selected="@(string.Equals(Model.Status, "approved", StringComparison.OrdinalIgnoreCase))">Aprobado</option>
                    <option value="rejected" selected="@(string.Equals(Model.Status, "rejected", StringComparison.OrdinalIgnoreCase))">Rechazado</option>
                </select>
            </div>

            <div class="col-6 col-lg-1 d-grid">
                <button class="btn btn-primary" type="submit">Aplicar</button>
            </div>
            <div class="col-6 col-lg-1 d-grid">
                <a class="btn btn-outline-secondary" asp-page="./Index">Limpiar</a>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="text-muted small">Mostrando hasta 1000 movimientos</div>
            <div class="text-muted small">Total cargados: <strong>@Model.Rows.Count</strong></div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Item</th>
                        <th class="text-end">Cantidad</th>
                        <th>Proyecto</th>
                        <th>Solicitó</th>
                        <th>Responsable</th>
                        <th>Status</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Rows)
                {
                    <tr>
                        <td class="text-muted small">@m.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="badge text-bg-light">@(m.Type == InventoryMovementType.In ? "Entrada" : "Salida")</span>
                        </td>
                        <td>
                            <div class="fw-semibold">@m.Item?.Name</div>
                            <div class="text-muted small">SKU: @(string.IsNullOrWhiteSpace(m.Item?.Sku) ? "—" : m.Item?.Sku)</div>
                            @if (m.AssignedClient != null)
                            {
                                <div class="text-muted small">Cliente: @m.AssignedClient.Name</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.SerialNumber))
                            {
                                <div class="text-muted small">Serie: @m.SerialNumber</div>
                            }
                        </td>
                        <td class="text-end fw-semibold">@m.Quantity @m.Item?.Unit</td>
                        <td>@(m.Project?.Title ?? "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(m.RequestedByName) ? "—" : m.RequestedByName)</td>
                        <td>@(string.IsNullOrWhiteSpace(m.ResponsibleName) ? "—" : m.ResponsibleName)</td>
                        <td>
                            @if (m.Status == InventoryMovementStatus.Pending)
                            {
                                <span class="badge text-bg-warning">Pendiente</span>
                            }
                            else if (m.Status == InventoryMovementStatus.Approved)
                            {
                                <span class="badge text-bg-success">Aprobado</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">Rechazado</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Inventory/Approvals/Details" asp-route-id="@m.Id">Ver orden</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Rows.Count == 0)
        {
            <div class="text-muted">Sin movimientos con esos filtros.</div>
        }
    </div>
</div>
