@page
@model HNControl.Web.Pages.Admin.Inventory.Locations.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ubicaciones (Inventario)";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Ubicaciones (Inventario)</h1>
        <div class="text-muted small">Catálogo para usar en los items.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Items/Index">← Volver a items</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-success">@Model.Info</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" asp-page-handler="Add" class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-7">
                <label class="form-label">Nueva ubicación</label>
                <input class="form-control" asp-for="NewName" placeholder="Ej. Caja 3, Almacén Matamoros..." />
                <span class="text-danger small" asp-validation-for="NewName"></span>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary" type="submit">Agregar</button>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Ubicación</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Locations)
                    {
                        <tr>
                            <td class="fw-semibold">@l.Name</td>
                            <td>
                                @if (l.IsActive)
                                {
                                    <span class="badge text-bg-success">Activa</span>
                                }
                                else
                                {

                                    <span class="badge text-bg-secondary">Inactiva</span>
                                }
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Toggle" class="d-inline">
                                    <input type="hidden" name="id" value="@l.Id" />
                                    <button class="btn btn-sm btn-outline-primary" type="submit">
                                        @(l.IsActive ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Locations.Count == 0)
        {
            <div class="text-muted">Sin ubicaciones aún.</div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}