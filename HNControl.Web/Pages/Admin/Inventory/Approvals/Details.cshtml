@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Inventory.Approvals.DetailsModel
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Aprobar orden";
}

<div class="d-flex align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Revisar orden de inventario</h1>
        <div class="text-muted small">Aprueba o rechaza la orden completa. Si apruebas, impacta stock.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="./Index">â† Volver</a>
</div>

@if (Model.Anchor == null)
{
    <div class="alert alert-danger">No encontrado.</div>
}
else
{
    var a = Model.Anchor;
    var lines = Model.Lines;

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Tipo</div>
                    <div class="fw-semibold">@(a.Type == InventoryMovementType.In ? "Entrada" : "Salida")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Orden (fecha/hora)</div>
                    <div class="fw-semibold">@a.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Proyecto</div>
                    <div class="fw-semibold">@(a.Project?.Title ?? "â€”")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Responsable</div>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(a.ResponsibleName) ? "â€”" : a.ResponsibleName)</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">SolicitÃ³</div>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(a.RequestedByName) ? "â€”" : a.RequestedByName)</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">LÃ­neas</div>
                    <div class="fw-semibold">@lines.Count</div>
                </div>

                @if (Model.HasMixedStatuses)
                {
                    <div class="col-12">
                        <div class="alert alert-warning mb-0">
                            Esta orden tiene estatus mezclados (algunas lÃ­neas ya fueron procesadas). Para evitar inconsistencias, el sistema desactiva la aprobaciÃ³n/rechazo por orden.
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Detalle de lÃ­neas</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                    <tr>
                        <th>Item</th>
                        <th class="text-end">Cantidad</th>
                        <th>Cliente (HW)</th>
                        <th>Serie</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var m in lines)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@m.Item?.Name</div>
                                <div class="text-muted small">SKU: @(string.IsNullOrWhiteSpace(m.Item?.Sku) ? "â€”" : m.Item?.Sku)</div>
                                @if (!string.IsNullOrWhiteSpace(m.Notes))
                                {
                                    <div class="text-muted small">Notas: @m.Notes</div>
                                }
                            </td>
                            <td class="text-end fw-semibold">@m.Quantity @m.Item?.Unit</td>
                            <td>@(m.AssignedClient?.Name ?? "â€”")</td>
                            <td>@(string.IsNullOrWhiteSpace(m.SerialNumber) ? "â€”" : m.SerialNumber)</td>
                            <td>
                                @if (m.Status == InventoryMovementStatus.Pending)
                                {
                                    <span class="badge text-bg-warning">Pendiente</span>
                                }
                                else if (m.Status == InventoryMovementStatus.Approved)
                                {
                                    <span class="badge text-bg-success">Aprobado</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Rechazado</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <div class="card">
        <div class="card-body">
            <form method="post" asp-route-id="@a.Id" class="mb-2">
                <label class="form-label">Nota admin (opcional)</label>
                <textarea class="form-control" asp-for="Input.AdminNote" rows="3" placeholder="Comentario de aprobaciÃ³n/rechazo..."></textarea>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-success" type="submit" asp-page-handler="Approve" disabled="@(!Model.CanDecide)">
                        Aprobar orden
                    </button>
                    <button class="btn btn-outline-danger" type="submit" asp-page-handler="Reject" disabled="@(!Model.CanDecide)">
                        Rechazar orden
                    </button>
                    <a class="btn btn-outline-secondary" asp-page="./Index">Cancelar</a>
                </div>
            </form>

            <div class="text-muted small mt-2">Tip: si no hay stock suficiente en salidas, te lo va a decir. La realidad no negocia.</div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

