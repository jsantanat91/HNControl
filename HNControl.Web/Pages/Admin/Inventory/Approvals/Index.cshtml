@page
@model HNControl.Web.Pages.Admin.Inventory.Approvals.IndexModel
@using System
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Aprobaciones pendientes";

    string tabCls(string key) => string.Equals((Model.Filter ?? "pending"), key, StringComparison.OrdinalIgnoreCase)
        ? "btn btn-primary"
        : "btn btn-outline-secondary";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Aprobaciones pendientes</h1>
        <div class="text-muted small">Flujo por orden con vista completa: pendientes, aprobadas, rechazadas y en proceso.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Items/Index">Admin Stock</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Movements/Index">Movimientos</a>
        <a class="btn btn-outline-secondary" asp-page="/Inventory/Index">Vista (empleados)</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Pendientes</div><div class="h3 mb-0">@Model.PendingCount</div></div></div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">En proceso</div><div class="h3 mb-0 text-primary">@Model.InProcessCount</div></div></div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Aprobadas</div><div class="h3 mb-0 text-success">@Model.ApprovedCount</div></div></div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Rechazadas</div><div class="h3 mb-0 text-danger">@Model.RejectedCount</div></div></div>
    </div>
</div>

<div class="card shadow-soft hn-hover mb-3">
    <div class="card-body d-flex flex-wrap gap-2">
        <a class="@tabCls("pending")" asp-page="./Index" asp-route-filter="pending">Pendientes</a>
        <a class="@tabCls("inprocess")" asp-page="./Index" asp-route-filter="inprocess">En proceso</a>
        <a class="@tabCls("approved")" asp-page="./Index" asp-route-filter="approved">Aprobadas</a>
        <a class="@tabCls("rejected")" asp-page="./Index" asp-route-filter="rejected">Rechazadas</a>
        <a class="@tabCls("all")" asp-page="./Index" asp-route-filter="all">Todas</a>
    </div>
</div>

@if (!Model.Orders.Any())
{
    <div class="alert alert-light border">No hay ordenes en este filtro.</div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
        @foreach (var o in Model.Orders)
        {
            var typeClass = o.Type == InventoryMovementType.In ? "hn-badge-green" : "hn-badge-blue";
            <div class="col d-flex">
                <div class="card shadow-soft hn-hover w-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <span class="hn-badge @typeClass">@(o.Type == InventoryMovementType.In ? "Entrada" : "Salida")</span>
                                <span class="hn-badge @o.StatusCss">@o.StatusLabel</span>
                                <span class="hn-badge hn-badge-slate">@o.LinesCount lineas</span>
                            </div>
                            <div class="small text-muted text-end">
                                <div>@o.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                <div>Actualizada: @o.LastUpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</div>
                            </div>
                        </div>

                        <div class="fw-semibold mt-2">@o.ItemsPreview</div>
                        <div class="small text-muted mt-2">Proyecto: @(string.IsNullOrWhiteSpace(o.ProjectTitle) ? "-" : o.ProjectTitle)</div>
                        <div class="small text-muted">Solicito: @o.RequestedByName</div>
                        <div class="small text-muted">Responsable: @o.ResponsibleName</div>

                        <div class="mt-auto pt-3 d-flex justify-content-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="./Details" asp-route-id="@o.AnchorId">Ver orden</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-muted small mt-3">Mostrando hasta @Model.Orders.Count orden(es) en este filtro.</div>
}



