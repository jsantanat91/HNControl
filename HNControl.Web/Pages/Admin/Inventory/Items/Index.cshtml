@page
@model HNControl.Web.Pages.Admin.Inventory.Items.IndexModel
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin - Items";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Items de inventario</h1>
        <div class="text-muted small">Catálogo + stock. Los movimientos se aprueban en Aprobaciones.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-page="./Create">+ Nuevo item</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Approvals/Index">Aprobaciones</a>
        <a class="btn btn-outline-secondary" asp-page="/Inventory/Index">Vista (empleados)</a>
    </div>
</div>

<form method="get" class="d-flex gap-2 mb-3">
    <input class="form-control" name="q" value="@Model.Q" placeholder="Buscar por nombre o SKU..." />
    <button class="btn btn-primary" type="submit">Buscar</button>
    <a class="btn btn-outline-secondary" asp-page="./Index">Limpiar</a>
</form>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>SKU</th>
                        <th>Tipo</th>
                        <th class="text-end">On hand</th>
                        <th class="text-end">Reorder</th>
                        <th>Activo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@i.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(i.Sku) ? "—" : i.Sku)</td>
                        <td>
                            @if (i.IsConsumable)
                            {
                                <span class="badge text-bg-light">Consumible</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light">Hardware</span>
                            }
                        </td>
                        <td class="text-end fw-semibold">@i.QuantityOnHand @i.Unit</td>
                        <td class="text-end">@i.ReorderLevel</td>
                        <td>@(i.IsActive ? "Sí" : "No")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@i.Id">Editar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="text-muted">Sin items.</div>
        }
    </div>
</div>