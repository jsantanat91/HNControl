@page
@model HNControl.Web.Pages.Admin.Inventory.Items.IndexModel
@using System
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Stock";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Items de inventario</h1>
        <div class="text-muted small">Catálogo + stock. Los movimientos se aprueban en Aprobaciones pendientes.</div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-page="./Create">+ Nuevo item</a>

        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Brands/Index">Marcas</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Categories/Index">Categorías</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Locations/Index">Ubicaciones</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Services/Index">Servicios</a>

        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importItemsModal">
            Importar (Excel)
        </button>

        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Approvals/Index">Aprobaciones pendientes</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Movements/Index">Movimientos</a>
        <a class="btn btn-outline-secondary" asp-page="/Inventory/Index">Vista (empleados)</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-success">@Model.Info</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="get" class="card mb-3">
    <div class="card-body p-3">
        <input type="hidden" name="page" value="1" />

        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-4">
                <label class="form-label small text-muted mb-1">Buscar</label>
                <input class="form-control" name="q" value="@Model.Q" placeholder="Buscar por cualquier campo (nombre, SKU, categoría, ubicación, marca, modelo...)" />
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small text-muted mb-1">Categoría</label>
                <select class="form-select" name="cat">
                    <option value="">Todas</option>
                    <option value="__none" selected="@(Model.Cat == "__none")">Sin categoría</option>
                    @foreach (var c in Model.CategoryOptions.Where(x => !string.IsNullOrWhiteSpace(x)))
                    {
                        <option value="@c" selected="@(Model.Cat == c)">@c</option>
                    }
                </select>
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small text-muted mb-1">Ubicación</label>
                <select class="form-select" name="loc">
                    <option value="">Todas</option>
                    <option value="__none" selected="@(Model.Loc == "__none")">Sin ubicación</option>
                    @foreach (var l in Model.LocationOptions.Where(x => !string.IsNullOrWhiteSpace(x)))
                    {
                        <option value="@l" selected="@(Model.Loc == l)">@l</option>
                    }
                </select>
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small text-muted mb-1">Marca</label>
                <select class="form-select" name="brandId">
                    <option value="">Todas</option>
                    <option value="@Guid.Empty" selected="@(Model.BrandId.HasValue && Model.BrandId.Value == Guid.Empty)">Sin marca</option>
                    @foreach (var b in Model.BrandOptions)
                    {
                        <option value="@b.Id" selected="@(Model.BrandId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>

            <div class="col-8 col-sm-4 col-lg-1">
                <label class="form-label small text-muted mb-1">Ordenar</label>
                <select class="form-select" name="sort">
                    <option value="active" selected="@(string.Equals(Model.Sort, "active", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(Model.Sort))">Activo</option>
                    <option value="category" selected="@(string.Equals(Model.Sort, "category", StringComparison.OrdinalIgnoreCase))">Categoría</option>
                    <option value="brand" selected="@(string.Equals(Model.Sort, "brand", StringComparison.OrdinalIgnoreCase))">Marca</option>
                    <option value="location" selected="@(string.Equals(Model.Sort, "location", StringComparison.OrdinalIgnoreCase))">Ubicación</option>
                    <option value="name" selected="@(string.Equals(Model.Sort, "name", StringComparison.OrdinalIgnoreCase))">Item</option>
                    <option value="stock" selected="@(string.Equals(Model.Sort, "stock", StringComparison.OrdinalIgnoreCase))">Existencia</option>
                </select>
            </div>

            <div class="col-4 col-sm-2 col-lg-1">
                <label class="form-label small text-muted mb-1">Dir</label>
                <select class="form-select" name="dir">
                    <option value="desc" selected="@(string.Equals(Model.Dir, "desc", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(Model.Dir))">↓</option>
                    <option value="asc" selected="@(string.Equals(Model.Dir, "asc", StringComparison.OrdinalIgnoreCase))">↑</option>
                </select>
            </div>

            <div class="col-6 col-lg-1 d-grid">
                <button class="btn btn-primary" type="submit">Aplicar</button>
            </div>

            <div class="col-6 col-lg-1 d-grid">
                <a class="btn btn-outline-secondary" asp-page="./Index">Limpiar</a>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="text-muted small">
                @if (Model.TotalCount == 0)
                {
                    <span>Sin resultados.</span>
                }
                else
                {
                    <span>Mostrando <strong>@Model.From</strong>-<strong>@Model.To</strong> de <strong>@Model.TotalCount</strong></span>
                }
            </div>
            <div class="text-muted small">50 por página</div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Categoría</th>
                        <th>Item</th>
                        <th>ID modelo</th>
                        <th>SKU</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Ubicación</th>
                        <th class="text-end">Existencia</th>
                        <th class="text-end">Stock mínimo</th>
                        <th>Activo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        var catLabel = string.IsNullOrWhiteSpace(i.Category) ? "—" : i.Category;
                        var badge = Model.GetCategoryBadgeClass(i.Category);

                        <tr>
                            <td><span class="hn-badge @badge">@catLabel</span></td>
                            <td class="fw-semibold">@i.Name</td>
                            <td><span class="hn-badge hn-badge-cyan">@(string.IsNullOrWhiteSpace(i.ModelCode) ? "—" : i.ModelCode)</span></td>
                            <td>@(string.IsNullOrWhiteSpace(i.Sku) ? "—" : i.Sku)</td>
                            <td>@(i.Brand?.Name ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(i.Model) ? "—" : i.Model)</td>
                            <td>@(string.IsNullOrWhiteSpace(i.Location) ? "—" : i.Location)</td>
                            <td class="text-end fw-semibold">@i.QuantityOnHand @i.Unit</td>
                            <td class="text-end">@i.ReorderLevel</td>
                            <td>
                                @if (i.IsActive)
                                {
                                    <span class="hn-badge hn-badge-green hn-badge-compact">Sí</span>
                                }
                                else
                                {
                                    <span class="hn-badge hn-badge-slate hn-badge-compact">No</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@i.Id">Editar</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Inventory/Movements/Index" asp-route-itemId="@i.Id">Mov.</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="text-muted">Sin items.</div>
        }

        @if (Model.TotalPages > 1)
        {
            var current = Model.Page;
            var total = Model.TotalPages;
            var start = Math.Max(1, current - 3);
            var end = Math.Min(total, current + 3);

            <nav class="mt-3 d-flex justify-content-end">
                <ul class="pagination mb-0">
                    <li class="page-item @(current <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index"
                           asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                           asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                           asp-route-page="@(current - 1)">Anterior</a>
                    </li>

                    @if (start > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-page="./Index"
                               asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                               asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                               asp-route-page="1">1</a>
                        </li>
                        @if (start > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (int p = start; p <= end; p++)
                    {
                        <li class="page-item @(p == current ? "active" : "")">
                            <a class="page-link" asp-page="./Index"
                               asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                               asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                               asp-route-page="@p">@p</a>
                        </li>
                    }

                    @if (end < total)
                    {
                        @if (end < total - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-page="./Index"
                               asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                               asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                               asp-route-page="@total">@total</a>
                        </li>
                    }

                    <li class="page-item @(current >= total ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index"
                           asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                           asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                           asp-route-page="@(current + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<!-- Importar items (Excel) -->
<div class="modal fade" id="importItemsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" enctype="multipart/form-data" asp-page-handler="Import">
                <div class="modal-header">
                    <h5 class="modal-title">Importar items desde Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border small mb-3">
                        1) Descarga la plantilla · 2) Llénala · 3) Sube el archivo y listo.
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <a class="btn btn-sm btn-outline-secondary" asp-page-handler="Template">
                            Descargar plantilla
                        </a>
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Inventory/ExportItems">
                            Exportar items actuales
                        </a>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold">Archivo .xlsx</label>
                        <input class="form-control" type="file" name="file" accept=".xlsx" required />
                        <div class="form-text">
                            Se crea/actualiza por SKU (si viene). Si no hay SKU, intenta por nombre.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Importar</button>
                </div>
            </form>
        </div>
    </div>
</div>


