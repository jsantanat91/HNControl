@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Inventory.Items.EditModel
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar item";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Editar item</h1>
    <a class="btn btn-outline-secondary" asp-page="./Index">← Volver</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="card">
    <input type="hidden" asp-for="Input.Id" />
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input class="form-control" asp-for="Input.Name" />
                <span class="text-danger small" asp-validation-for="Input.Name"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label">SKU (opcional)</label>
                <input class="form-control" asp-for="Input.Sku" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Categoría</label>
                <select class="form-select" asp-for="Input.Category" asp-items="Model.CategoryOptions"></select>
                <div class="form-text">
                    ¿No aparece? <a asp-page="/Admin/Inventory/Categories/Index" target="_blank">Cargar categorías</a>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Marca</label>
                <select class="form-select" asp-for="Input.BrandId" asp-items="Model.BrandOptions"></select>
                <div class="form-text">
                    ¿No aparece? <a asp-page="/Admin/Inventory/Brands/Index" target="_blank">Cargar marcas</a>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Modelo</label>
                <input class="form-control" asp-for="Input.Model" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Ubicación</label>
                <select class="form-select" asp-for="Input.Location" asp-items="Model.LocationOptions"></select>
                <div class="form-text">
                    ¿No aparece? <a asp-page="/Admin/Inventory/Locations/Index" target="_blank">Cargar ubicaciones</a>
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label">Unidad</label>
                <input class="form-control" asp-for="Input.Unit" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Existencia</label>
                <input class="form-control" asp-for="Input.QuantityOnHand" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Stock mínimo</label>
                <input class="form-control" asp-for="Input.ReorderLevel" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.IsConsumable" />
                    <label class="form-check-label" asp-for="Input.IsConsumable">Consumible</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">Notas</label>
                <textarea class="form-control" asp-for="Input.Notes" rows="3"></textarea>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.IsActive" />
                    <label class="form-check-label" asp-for="Input.IsActive">Activo</label>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancelar</a>
        <a class="btn btn-outline-secondary ms-auto" asp-page="/Admin/Inventory/Movements/Index" asp-route-itemId="@Model.Input.Id">Ver movimientos</a>
    </div>
</form>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="fw-semibold">Movimientos recientes</div>
        <div class="text-muted small">Últimos 30</div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th class="text-end">Cantidad</th>
                        <th>Status</th>
                        <th>Solicitó</th>
                        <th>Responsable</th>
                        <th>Aprobó</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.RecentMovements)
                {
                    <tr>
                        <td class="text-muted small">@m.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge text-bg-light">@(m.Type == InventoryMovementType.In ? "Entrada" : "Salida")</span></td>
                        <td class="text-end fw-semibold">@m.Quantity @m.Unit</td>
                        <td>
                            @if (m.Status == InventoryMovementStatus.Pending)
                            {
                                <span class="badge text-bg-warning">Pendiente</span>
                            }
                            else if (m.Status == InventoryMovementStatus.Approved)
                            {
                                <span class="badge text-bg-success">Aprobado</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">Rechazado</span>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(m.RequestedByName) ? "—" : m.RequestedByName)</td>
                        <td>@(string.IsNullOrWhiteSpace(m.ResponsibleName) ? "—" : m.ResponsibleName)</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(m.ApprovedByName))
                            {
                                <div>@m.ApprovedByName</div>
                                @if (m.ApprovedAt != null)
                                {
                                    <div class="text-muted small">@m.ApprovedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Inventory/Approvals/Details" asp-route-id="@m.Id">Ver orden</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.RecentMovements.Count == 0)
        {
            <div class="text-muted">Aún no hay movimientos para este item.</div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
