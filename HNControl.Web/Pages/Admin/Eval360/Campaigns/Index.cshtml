@page
@model HNControl.Web.Pages.Admin.Eval360.Campaigns.IndexModel
@{
    ViewData["Title"] = "Evaluacion 360 · Campanias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Evaluacion 360</h1>
        <div class="text-muted small">Campanias, asignaciones y resultados.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Eval360/Catalog/Index">Editar evaluacion</a>
        <a class="btn btn-primary" asp-page="/Admin/Eval360/Campaigns/Create">+ Nueva campania</a>
    </div>
</div>

@if (!Model.Rows.Any())
{
    <div class="alert alert-info">Aun no hay campanias. Crea una para asignar evaluaciones.</div>
    return;
}

<div class="row row-cols-1 row-cols-xl-2 g-3">
    @foreach (var r in Model.Rows)
    {
        var stateClass = r.Status switch
        {
            HNControl.Web.Models.Eval360CampaignStatus.Open => "hn-chip-status-progress",
            HNControl.Web.Models.Eval360CampaignStatus.Closed => "hn-chip-status-closed",
            _ => "hn-chip-ref"
        };
        var stateText = r.Status switch
        {
            HNControl.Web.Models.Eval360CampaignStatus.Open => "Abierta",
            HNControl.Web.Models.Eval360CampaignStatus.Closed => "Cerrada",
            _ => "Borrador"
        };

        <div class="col d-flex">
            <div class="card shadow-soft hn-hover w-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-bold fs-5">@r.Title</div>
                            <div class="text-muted small">
                                @(r.PeriodStart.HasValue ? r.PeriodStart.Value.ToString("yyyy-MM-dd") : "-")
                                a
                                @(r.PeriodEnd.HasValue ? r.PeriodEnd.Value.ToString("yyyy-MM-dd") : "-")
                            </div>
                        </div>
                        <span class="hn-chip @stateClass">@stateText</span>
                    </div>

                    <div class="row mt-2 small">
                        <div class="col-6"><span class="text-muted">Asignaciones:</span> <b>@r.AssignmentsTotal</b></div>
                        <div class="col-6"><span class="text-muted">Enviadas:</span> <b>@r.AssignmentsSubmitted</b></div>
                    </div>

                    <div class="mt-3 d-flex flex-wrap gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Eval360/Campaigns/Assignments" asp-route-id="@r.Id">Asignaciones</a>
                        <a class="btn btn-sm btn-outline-dark" asp-page="/Admin/Eval360/Results/Index" asp-route-id="@r.Id">Resultados</a>
                        @if (r.Status != HNControl.Web.Models.Eval360CampaignStatus.Open)
                        {
                            <form method="post" asp-page-handler="Open" asp-route-id="@r.Id" class="d-inline">
                                <button class="btn btn-sm btn-outline-success" type="submit">Abrir</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Close" asp-route-id="@r.Id" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Cerrar</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" class="d-inline" onsubmit="return confirm('Eliminar campania y respuestas?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
