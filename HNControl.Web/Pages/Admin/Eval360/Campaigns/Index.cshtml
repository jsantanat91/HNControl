@page
@model HNControl.Web.Pages.Admin.Eval360.Campaigns.IndexModel
@{
    ViewData["Title"] = "Evaluación 360 · Campañas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Evaluación 360</h1>
        <div class="text-muted small">Campañas y resultados.</div>
    </div>

    <a class="btn btn-primary" asp-page="/Admin/Eval360/Campaigns/Create">+ Nueva campaña</a>
</div>

@if (!Model.Rows.Any())
{
    <div class="alert alert-info">
        Aún no hay campañas. Crea una para asignar evaluaciones.
    </div>
    return;
}

<div class="card shadow-soft">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Periodo</th>
                    <th>Estado</th>
                    <th class="text-end">Asignaciones</th>
                    <th class="text-end">Enviadas</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td class="fw-semibold">@r.Title</td>
                    <td class="text-muted small">
                        @(r.PeriodStart.HasValue ? r.PeriodStart.Value.ToString("dd/MM/yyyy") : "—")
                        →
                        @(r.PeriodEnd.HasValue ? r.PeriodEnd.Value.ToString("dd/MM/yyyy") : "—")
                    </td>
                    <td>
                        @if (r.Status == HNControl.Web.Models.Eval360CampaignStatus.Open)
                        {
                            <span class="badge bg-success">Abierta</span>
                        }
                        else if (r.Status == HNControl.Web.Models.Eval360CampaignStatus.Closed)
                        {
                            <span class="badge bg-secondary">Cerrada</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Borrador</span>
                        }
                    </td>
                    <td class="text-end">@r.AssignmentsTotal</td>
                    <td class="text-end">@r.AssignmentsSubmitted</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-page="/Admin/Eval360/Campaigns/Assignments"
                           asp-route-id="@r.Id">Asignaciones</a>

                        <a class="btn btn-sm btn-outline-dark"
                           asp-page="/Admin/Eval360/Results/Index"
                           asp-route-id="@r.Id">Resultados</a>

                        @if (r.Status != HNControl.Web.Models.Eval360CampaignStatus.Open)
                        {
                            <form method="post" asp-page-handler="Open" asp-route-id="@r.Id" class="d-inline">
                                <button class="btn btn-sm btn-outline-success" type="submit">Abrir</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Close" asp-route-id="@r.Id" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Cerrar</button>
                            </form>
                        }

                        <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" class="d-inline"
                              onsubmit="return confirm('¿Eliminar campaña y todas sus respuestas?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
