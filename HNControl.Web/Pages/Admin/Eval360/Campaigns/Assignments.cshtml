@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Eval360.Campaigns.AssignmentsModel
@{
    ViewData["Title"] = "Asignaciones · 360";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Asignaciones · Evaluación 360</h1>
        <div class="text-muted small">
            Campaña: <span class="fw-semibold">@Model.Campaign.Title</span>
        </div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Admin/Eval360/Campaigns/Index">Volver</a>
</div>

@if (TempData["Msg"] is string msg && !string.IsNullOrWhiteSpace(msg))
{
    <div class="alert alert-info">@msg</div>
}

<div class="card shadow-soft mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Participantes</label>
                <div class="text-muted small">
                    Total: <span class="fw-semibold">@Model.Participants.Count</span>
                    · Asignaciones: <span class="fw-semibold">@Model.TotalAssignments</span>
                    · Contestadas: <span class="fw-semibold">@Model.SubmittedAssignments</span>
                </div>
            </div>

            <div class="col-md-6 text-md-end">
                <form method="post" class="d-inline-block">
                    <input type="hidden" name="id" value="@RouteData.Values["id"]" />

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" asp-for="IncludeAdmins" />
                        <label class="form-check-label" asp-for="IncludeAdmins">Incluir admins</label>
                    </div>

                    <button class="btn btn-primary ms-2" type="submit" asp-page-handler="Generate">
                        Generar (todos evalúan a todos)
                    </button>

                    <button class="btn btn-outline-danger ms-2" type="submit" asp-page-handler="Reset"
                            onclick="return confirm('Esto borrará asignaciones y respuestas. ¿Continuar?');">
                        Reset
                    </button>
                </form>
            </div>
        </div>

        <hr />

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach (var p in Model.Participants)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@p.FullName</td>
                            <td class="text-muted">@p.Email</td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
