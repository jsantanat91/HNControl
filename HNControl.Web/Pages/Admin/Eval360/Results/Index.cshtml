@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Eval360.Results.IndexModel
@{
    ViewData["Title"] = "Resultados · 360";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Resultados · Evaluación 360</h1>
        <div class="text-muted small">
            <span class="fw-semibold">@Model.Campaign.Title</span>
            · @(Model.Campaign.PeriodStart?.ToString("dd/MM/yyyy") ?? "—") → @(Model.Campaign.PeriodEnd?.ToString("dd/MM/yyyy") ?? "—")
        </div>
    </div>

    <a class="btn btn-outline-secondary" asp-page="/Admin/Eval360/Campaigns/Index">Volver</a>
</div>

<div class="card shadow-soft mb-3">
    <div class="card-body">
        <form method="get">
            <input type="hidden" name="id" value="@RouteData.Values["id"]" />

            <div class="row g-2 align-items-end">
                <div class="col-12 col-lg-7">
                    <div class="form-floating">
                        <select class="form-select" id="userSelect" name="UserId">
                            @foreach (var e in Model.Employees)
                            {
                                <option value="@e.UserId" selected="@(e.UserId == Model.UserId)">@e.FullName (@e.Email)</option>
                            }
                        </select>
                        <label for="userSelect">Empleado</label>
                    </div>
                    <div class="form-text">Tip: abre el combo y escribe para buscar rápido.</div>
                </div>

                <div class="col-auto">
                    <button class="btn btn-primary px-4">Ver</button>
                </div>

                <div class="col-auto ms-lg-auto">
                    <a class="btn btn-outline-dark"
                       asp-page="/Admin/Eval360/Campaigns/Assignments"
                       asp-route-id="@Model.Campaign.Id">Asignaciones</a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Rows.Any())
{
    <div class="alert alert-info">Aún no hay respuestas para este empleado en esta campaña.</div>
    return;
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-soft">
            <div class="card-header fw-semibold">Comparativo por competencia (Auto vs Evaluadores)</div>
            <div class="card-body">
                <canvas id="cmpChart" height="140"></canvas>
                <div class="text-muted small mt-2">
                    Escala 1–5 convertida a porcentaje.
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-soft">
            <div class="card-header fw-semibold">Detalle</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Competencia</th>
                            <th class="text-end">Auto</th>
                            <th class="text-end">Eval.</th>
                            <th class="text-end">Dif.</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>@r.Competency</td>
                            <td class="text-end">@r.AutoPct% <span class="text-muted small">(@r.LevelAuto)</span></td>
                            <td class="text-end">@r.OthersPct% <span class="text-muted small">(@r.LevelOthers)</span></td>
                            <td class="text-end">@((r.DiffPct >= 0 ? "+" : ""))@r.DiffPct%</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(Model.LabelsJson);
        const autoValues = @Html.Raw(Model.AutoJson);
        const otherValues = @Html.Raw(Model.OthersJson);

        new Chart(document.getElementById('cmpChart'), {
          type: 'bar',
          data: {
            labels,
            datasets: [
              { label: 'Autoevaluación', data: autoValues, backgroundColor: 'rgba(16, 185, 129, 0.6)' },
              { label: 'Evaluadores', data: otherValues, backgroundColor: 'rgba(59, 130, 246, 0.6)' }
            ]
          },
          options: {
            responsive: true,
            scales: {
              y: { beginAtZero: true, max: 100 }
            }
          }
        });
    </script>
}
