@page
@model HNControl.Web.Pages.Admin.Eval360.Catalog.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Catalogo Evaluacion 360";
}

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Catalogo de evaluacion 360</h1>
        <div class="text-muted small">Administra competencias y preguntas.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Eval360/Campaigns/Index">Campanias</a>
    </div>
</div>

<form method="post" asp-page-handler="AddCompetency" class="card shadow-soft hn-hover mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Nueva competencia</label>
                <input class="form-control" name="name" placeholder="Ej. Liderazgo" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Orden</label>
                <input class="form-control" type="number" name="sortOrder" value="0" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Agregar</button>
            </div>
        </div>
    </div>
</form>

<div class="row row-cols-1 row-cols-xl-2 g-3">
    @foreach (var c in Model.Competencies)
    {
        <div class="col d-flex">
            <div class="card shadow-soft hn-hover w-100">
                <div class="card-body">
                    <form method="post" asp-page-handler="UpdateCompetency" class="row g-2 align-items-end mb-2">
                        <input type="hidden" name="id" value="@c.Id" />
                        <div class="col-md-7">
                            <label class="form-label small">Competencia</label>
                            <input class="form-control form-control-sm" name="name" value="@c.Name" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Orden</label>
                            <input class="form-control form-control-sm" type="number" name="sortOrder" value="@c.SortOrder" />
                        </div>
                        <div class="col-md-1">
                            <div class="form-check mt-4">
                                @if (c.IsActive)
                                {
                                    <input class="form-check-input" type="checkbox" name="isActive" value="true" checked />
                                }
                                else
                                {
                                    <input class="form-check-input" type="checkbox" name="isActive" value="true" />
                                }
                            </div>
                        </div>
                        <div class="col-md-2 d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary w-100" type="submit">Guardar</button>
                        </div>
                    </form>

                    <form method="post" asp-page-handler="DeleteCompetency" class="mb-3" onsubmit="return confirm('Eliminar competencia y sus preguntas?');">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar competencia</button>
                    </form>

                    <div class="small fw-semibold mb-2">Preguntas</div>
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var q in c.Questions.OrderBy(x => x.SortOrder))
                        {
                            <div class="border rounded-3 p-2">
                                <form method="post" asp-page-handler="UpdateQuestion" class="row g-2 align-items-end">
                                    <input type="hidden" name="id" value="@q.Id" />
                                    <div class="col-md-8">
                                        <input class="form-control form-control-sm" name="text" value="@q.Text" />
                                    </div>
                                    <div class="col-md-2">
                                        <input class="form-control form-control-sm" type="number" name="sortOrder" value="@q.SortOrder" />
                                    </div>
                                    <div class="col-md-2 d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-primary w-100" type="submit">Guardar</button>
                                    </div>
                                    <div class="col-12">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="form-check">
                                                @if (q.IsActive)
                                                {
                                                    <input class="form-check-input" type="checkbox" name="isActive" value="true" checked />
                                                }
                                                else
                                                {
                                                    <input class="form-check-input" type="checkbox" name="isActive" value="true" />
                                                }
                                                <label class="form-check-label small">Activa</label>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger" type="submit" formaction="?handler=DeleteQuestion" name="id" value="@q.Id">Eliminar</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>

                    <form method="post" asp-page-handler="AddQuestion" class="row g-2 align-items-end">
                        <input type="hidden" name="competencyId" value="@c.Id" />
                        <div class="col-md-8">
                            <label class="form-label small">Nueva pregunta</label>
                            <input class="form-control form-control-sm" name="text" placeholder="Texto de pregunta" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Orden</label>
                            <input class="form-control form-control-sm" type="number" name="sortOrder" value="0" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-sm btn-primary w-100" type="submit">Agregar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
