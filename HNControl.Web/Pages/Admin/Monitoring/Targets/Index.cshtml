@page
@model HNControl.Web.Pages.Admin.Monitoring.Targets.IndexModel
@{
    ViewData["Title"] = "Targets de monitoreo";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Targets de monitoreo</h1>
        <div class="text-muted small">Alta/edicion de servicios a monitorear (ping/tcp/http).</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Monitoring/Index">Ver tablero</a>
        <a class="btn btn-primary" asp-page="Create">Nuevo target</a>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">No hay targets registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
            <tr>
                <th>Cliente</th>
                <th>Target</th>
                <th>Contrato</th>
                <th>Servicio carrier</th>
                <th>Probe</th>
                <th>Destino</th>
                <th>Intervalo</th>
                <th>Status</th>
                <th>Ultimo</th>
                <th class="text-end"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var t in Model.Items)
            {
                <tr>
                    <td>@t.Client</td>
                    <td class="fw-semibold">@t.Name</td>
                    <td class="text-muted small">@t.Contract</td>
                    <td class="text-muted small">@t.CarrierService</td>
                    <td class="text-muted small">@t.Probe</td>
                    <td class="text-muted small">@t.Address</td>
                    <td class="text-muted small">@t.IntervalSeconds s</td>
                    <td><span class="badge @t.BadgeClass">@t.Status</span></td>
                    <td class="text-muted small">@(t.LastCheckedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@t.Id">Editar</a>
                            <form method="post" asp-page-handler="Toggle" class="d-inline m-0">
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(t.IsActive ? "Desactivar" : "Activar")</button>
                            </form>
                        </div>
                    </td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(t.LastError))
                {
                    <tr>
                        <td></td>
                        <td colspan="9" class="small text-danger">@t.LastError</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
}
