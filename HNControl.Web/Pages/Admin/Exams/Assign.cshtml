@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Exams.AssignModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Asignar examen";
}

@if (Model.Exam == null)
{
    <div class="alert alert-warning">No encontrado.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Asignar: @Model.Exam.Title</h1>
        <div class="text-muted small">Selecciona empleados y listo.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Exams/Edit" asp-route-id="@Model.Exam.Id">Volver</a>
    </div>
</div>

<form method="post" class="card shadow-soft hn-hover">
    <div class="card-body">
        <input type="hidden" asp-for="Input.ExamId" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Fecha límite (opcional)</label>
                <input class="form-control" asp-for="Input.DueAt" type="datetime-local" />
            </div>
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:40px"></th>
                                <th>Empleado</th>
                                <th class="text-muted">Puesto</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var e in Model.Employees)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input" type="checkbox" name="Input.SelectedUserIds" value="@e.UserId" />
                                </td>
                                <td class="fw-semibold">@e.FullName</td>
                                <td class="text-muted">@e.Position</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="text-muted small mt-2">Tip: usa Ctrl+F como si fuera 1999.</div>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Asignar</button>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Exams/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
