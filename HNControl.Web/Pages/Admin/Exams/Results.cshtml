@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Exams.ResultsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Resultados";
}

@if (Model.Exam == null)
{
    <div class="alert alert-warning">No encontrado.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Resultados: @Model.Exam.Title</h1>
        <div class="text-muted small">Promedio (calificados): <b>@Model.AvgPct.ToString("0")%</b></div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Admin/Exams/Assign" asp-route-id="@Model.Exam.Id">Asignar</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Exams/Index">Volver</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Estatus</div>
            <div class="card-body">
                <canvas id="statusChart" height="180"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Asignaciones</div>
            <div class="card-body">
                @if (!Model.Assignments.Any())
                {
                    <div class="text-muted">Sin asignaciones.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Empleado</th>
                                    <th>Status</th>
                                    <th class="text-end">Puntaje</th>
                                    <th class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var a in Model.Assignments)
                            {
                                var badge = a.Status switch
                                {
                                    HNControl.Web.Models.ExamAssignmentStatus.Graded => "text-bg-success",
                                    HNControl.Web.Models.ExamAssignmentStatus.Submitted => "text-bg-warning",
                                    HNControl.Web.Models.ExamAssignmentStatus.InProgress => "text-bg-info",
                                    _ => "text-bg-secondary"
                                };
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@(a.EmployeeProfile?.FullName ?? a.UserId)</div>
                                        <div class="text-muted small">@a.AssignedAt.ToLocalTime().ToString("yyyy-MM-dd")</div>
                                    </td>
                                    <td><span class="badge @badge">@a.Status</span></td>
                                    <td class="text-end fw-semibold">@a.Score.ToString("0.##") / @a.MaxScore.ToString("0.##")</td>
                                    <td class="text-end">
                                        @if (a.Status == HNControl.Web.Models.ExamAssignmentStatus.Submitted)
                                        {
                                            <a class="btn btn-sm btn-primary" asp-page="/Admin/Exams/Grade" asp-route-id="@a.Id">Calificar</a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Exams/Take" asp-route-id="@a.Id">Ver</a>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    const labels = @Html.Raw(Model.StatusLabelsJson);
    const values = @Html.Raw(Model.StatusValuesJson);

    const cfg = {
      type: 'doughnut',
      data: { labels, datasets: [{ label: 'Asignaciones', data: values }] },
      options: { plugins: { legend: { position: 'bottom' } } }
    };

    window.hnCharts?.decorate(cfg);
    new Chart(document.getElementById('statusChart'), cfg);
</script>
