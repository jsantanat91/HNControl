@page
@model HNControl.Web.Pages.Admin.Exams.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Exámenes (Admin)";

    string ActiveText(bool active) => active ? "Activo" : "Inactivo";
    string ActiveCss(bool active) => active ? "bg-success text-white" : "bg-secondary text-white";

    string PendingCss(int n) => n > 0 ? "bg-warning text-dark" : "bg-secondary text-white";
    string AvgCss(decimal pct) => pct >= 80m ? "bg-success text-white" : (pct > 0m ? "bg-danger text-white" : "bg-secondary text-white");

    var total = Model.Items.Count;
    var active = Model.Items.Count(x => x.IsActive);
    var pending = Model.Items.Sum(x => x.PendingGrade);
    var view = (Request.Query["view"].ToString() ?? "").Trim().ToLowerInvariant();
    var isCards = string.IsNullOrWhiteSpace(view) || view == "cards";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Exámenes</h1>
        <div class="text-muted small">Crear, asignar y revisar resultados.</div>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm @(isCards ? "active" : "")" asp-page="./Index" asp-route-view="cards">Cards</a>
            <a class="btn btn-outline-secondary btn-sm @(isCards ? "" : "active")" asp-page="./Index" asp-route-view="table">Tabla</a>
        </div>
        <a class="btn btn-primary" asp-page="/Admin/Exams/Create"><i class="bi bi-plus-lg me-1"></i> Crear examen</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Dashboard">Panel</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Total exámenes</div><div class="fs-4 fw-bold">@total</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Activos</div><div class="fs-4 fw-bold">@active</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Pendientes por calificar</div><div class="fs-4 fw-bold">@pending</div></div></div></div>
</div>

<div class="card shadow-soft hn-hover">
    <div class="card-body">
        @if (!Model.Items.Any())
        {
            <div class="text-muted">Sin exámenes aún.</div>
        }
        else if (!isCards)
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Examen</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Preguntas</th>
                            <th class="text-end">Asignados</th>
                            <th class="text-end">En revisi&oacute;n</th>
                            <th class="text-end">Pend. calificar</th>
                            <th class="text-end">Promedio</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@r.Title</div>
                                    <div class="text-muted small">Id: @r.Id</div>
                                </td>

                                <td class="text-center">
                                    <span class="badge rounded-pill @ActiveCss(r.IsActive)">@ActiveText(r.IsActive)</span>
                                </td>

                                <td class="text-end">@r.Questions</td>
                                <td class="text-end">@r.Assigned</td>
                                <td class="text-end">@r.Submitted</td>

                                <td class="text-end">
                                    <span class="badge rounded-pill @PendingCss(r.PendingGrade)">@r.PendingGrade</span>
                                </td>

                                <td class="text-end">
                                    <span class="badge rounded-pill @AvgCss(r.AvgPct)">
                                        @(r.AvgPct > 0 ? $"{r.AvgPct:0}%" : "-")
                                    </span>
                                    <div class="text-muted small">@((r.AvgScore > 0) ? $"{r.AvgScore:0.##} pts" : "")</div>
                                </td>

                                <td class="text-end">
                                    <div class="btn-group">
                                        <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Exams/Edit" asp-route-id="@r.Id">Editar</a>
                                        <a class="btn btn-sm btn-outline-success" asp-page="/Admin/Exams/Assign" asp-route-id="@r.Id">Asignar</a>
                                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Exams/Results" asp-route-id="@r.Id">Resultados</a>
                                        <button type="button" class="btn btn-sm btn-outline-dark js-show-assigned" data-id="@r.Id">Detalles</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-muted small mt-2">
                Pend. calificar = enviados con preguntas abiertas o adjuntos que requieren revision.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-xl-2 row-cols-xxl-3 g-3">
                @foreach (var r in Model.Items)
                {
                    <div class="col d-flex">
                        <div class="card shadow-sm hn-hover w-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-bold">@r.Title</div>
                                        <div class="text-muted small">Preguntas: @r.Questions</div>
                                    </div>
                                    <span class="badge rounded-pill @ActiveCss(r.IsActive)">@ActiveText(r.IsActive)</span>
                                </div>
                                <div class="small mt-2">
                                    <div><span class="text-muted">Asignados:</span> <b>@r.Assigned</b></div>
                                    <div><span class="text-muted">En revisión:</span> <b>@r.Submitted</b></div>
                                    <div><span class="text-muted">Pend. calificar:</span> <span class="badge rounded-pill @PendingCss(r.PendingGrade)">@r.PendingGrade</span></div>
                                    <div class="mt-1"><span class="text-muted">Promedio:</span> <span class="badge rounded-pill @AvgCss(r.AvgPct)">@(r.AvgPct > 0 ? $"{r.AvgPct:0}%" : "-")</span></div>
                                </div>
                                <div class="mt-auto pt-3 d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Exams/Edit" asp-route-id="@r.Id">Editar</a>
                                    <a class="btn btn-sm btn-outline-success" asp-page="/Admin/Exams/Assign" asp-route-id="@r.Id">Asignar</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Exams/Results" asp-route-id="@r.Id">Resultados</a>
                                    <button type="button" class="btn btn-sm btn-outline-dark js-show-assigned" data-id="@r.Id">Detalles</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="modal fade" id="assignedModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignedTitle">Asignaciones</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="assignedBody" class="text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modalEl = document.getElementById('assignedModal');
            if (!modalEl || !window.bootstrap) return;
            const modal = new bootstrap.Modal(modalEl);
            const titleEl = document.getElementById('assignedTitle');
            const bodyEl = document.getElementById('assignedBody');

            async function openDetails(id) {
                bodyEl.innerHTML = '<div class="text-muted">Cargando...</div>';
                modal.show();
                try {
                    const url = new URL('@Url.Page("/Admin/Exams/Index", "Assignments")', window.location.origin);
                    url.searchParams.set('id', id);
                    const res = await fetch(url.toString(), { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) throw new Error('No se pudo cargar el detalle.');
                    const contentType = (res.headers.get('content-type') || '').toLowerCase();
                    if (!contentType.includes('application/json')) {
                        const raw = await res.text();
                        throw new Error(raw?.includes('<!DOCTYPE') ? 'La respuesta no es JSON (revisa sesión/permisos).' : 'Respuesta inválida del servidor.');
                    }
                    const data = await res.json();
                    titleEl.textContent = `Asignaciones · ${data.exam}`;
                    if (!data.rows || data.rows.length === 0) {
                        bodyEl.innerHTML = '<div class="text-muted">Sin asignaciones.</div>';
                        return;
                    }
                    const rows = data.rows.map(r => `
                        <tr>
                            <td><div class="fw-semibold">${r.fullName ?? ''}</div><div class="small text-muted">${r.email ?? ''}</div></td>
                            <td>${r.status ?? '-'}</td>
                            <td>${(r.assignedAt ?? '').replace('T', ' ').substring(0,16)}</td>
                            <td>${r.submittedAt ? r.submittedAt.replace('T',' ').substring(0,16) : '-'}</td>
                            <td>${(r.score ?? 0)} / ${(r.maxScore ?? 0)}</td>
                        </tr>`).join('');
                    bodyEl.innerHTML = `
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Empleado</th>
                                        <th>Estatus</th>
                                        <th>Asignado</th>
                                        <th>Enviado</th>
                                        <th>Score</th>
                                    </tr>
                                </thead>
                                <tbody>${rows}</tbody>
                            </table>
                        </div>`;
                } catch (e) {
                    bodyEl.innerHTML = `<div class="alert alert-danger">${e.message ?? 'Error'}</div>`;
                }
            }

            document.querySelectorAll('.js-show-assigned').forEach(btn => {
                btn.addEventListener('click', () => openDetails(btn.dataset.id));
            });
        })();
    </script>
}
