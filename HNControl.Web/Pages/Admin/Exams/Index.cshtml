@page
@model HNControl.Web.Pages.Admin.Exams.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Exámenes (Admin)";

    string ActiveBadge(bool active) => active ? "text-bg-success" : "text-bg-secondary";
    string ActiveText(bool active) => active ? "Activo" : "Inactivo";

    string PendingBadge(int pending) => pending > 0 ? "text-bg-warning" : "text-bg-secondary";
    string AvgBadge(decimal pct) => pct >= 80m ? "text-bg-success" : (pct > 0m ? "text-bg-danger" : "text-bg-secondary");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Exámenes</h1>
        <div class="text-muted small">Crear · asignar · revisar resultados</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-page="/Admin/Exams/Create">
            <i class="bi bi-plus-lg me-1"></i> Crear examen
        </a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Dashboard">Panel</a>
    </div>
</div>

<div class="card shadow-soft hn-hover">
    <div class="card-body">
        @if (!Model.Items.Any())
        {
            <div class="text-muted">Sin exámenes aún.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Examen</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Preguntas</th>
                            <th class="text-end">Asignados</th>
                            <th class="text-end">En revisión</th>
                            <th class="text-end">Pend. calificar</th>
                            <th class="text-end">Promedio</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@r.Title</div>
                                    <div class="text-muted small">Id: @r.Id</div>
                                </td>

                                <td class="text-center">
                                    <span class="badge rounded-pill @ActiveBadge(r.IsActive)">@ActiveText(r.IsActive)</span>
                                </td>

                                <td class="text-end">@r.Questions</td>
                                <td class="text-end">@r.Assigned</td>
                                <td class="text-end">@r.Submitted</td>

                                <td class="text-end">
                                    <span class="badge rounded-pill @PendingBadge(r.PendingGrade)">@r.PendingGrade</span>
                                </td>

                                <td class="text-end">
                                    <span class="badge rounded-pill @AvgBadge(r.AvgPct)">
                                        @(r.AvgPct > 0 ? $"{r.AvgPct:0}%" : "—")
                                    </span>
                                    <div class="text-muted small">@((r.AvgScore > 0) ? $"{r.AvgScore:0.##} pts" : "")</div>
                                </td>

                                <td class="text-end">
                                    <div class="btn-group">
                                        <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Exams/Edit" asp-route-id="@r.Id">
                                            Editar
                                        </a>
                                        <a class="btn btn-sm btn-outline-success" asp-page="/Admin/Exams/Assign" asp-route-id="@r.Id">
                                            Asignar
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Exams/Results" asp-route-id="@r.Id">
                                            Resultados
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-muted small mt-2">
                * “Pend. calificar” = enviados con preguntas abiertas/adjuntos que requieren revisión.
                * “Promedio” se calcula sobre intentos “Calificados”.
            </div>
        }
    </div>
</div>