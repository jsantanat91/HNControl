@page
@model HNControl.Web.Pages.Admin.Exams.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Exámenes (Admin)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Exámenes</h1>
        <div class="text-muted small">Crear · asignar · calificar</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-page="/Admin/Exams/Create"><i class="bi bi-plus-lg me-1"></i> Crear examen</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Dashboard">Panel</a>
    </div>
</div>

<div class="card shadow-soft hn-hover">
    <div class="card-body">
        @if (!Model.Items.Any())
        {
            <div class="text-muted">Sin exámenes aún.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Examen</th>
                            <th class="text-center">Activo</th>
                            <th class="text-end">Preguntas</th>
                            <th class="text-end">Asignados</th>
                            <th class="text-end">Pend. calificar</th>
                            <th class="text-end">Promedio</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@e.Title</div>
                                <div class="text-muted small">@e.Id</div>
                            </td>
                            <td class="text-center">
                                @if (e.IsActive)
                                {
                                    <span class="badge text-bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end">@e.Questions</td>
                            <td class="text-end">@e.Assigned</td>
                            <td class="text-end">@e.PendingGrade</td>
                            <td class="text-end">@e.AvgPct.ToString("0")%</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Exams/Edit" asp-route-id="@e.Id">Editar</a>
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Exams/Assign" asp-route-id="@e.Id">Asignar</a>
                                <a class="btn btn-sm btn-outline-success" asp-page="/Admin/Exams/Results" asp-route-id="@e.Id">Resultados</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
