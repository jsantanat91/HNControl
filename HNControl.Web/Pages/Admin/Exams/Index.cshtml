@page
@model HNControl.Web.Pages.Admin.Exams.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ex&aacute;menes (Admin)";

    string ActiveText(bool active) => active ? "Activo" : "Inactivo";
    string ActiveCss(bool active) => active ? "bg-success text-white" : "bg-secondary text-white";

    string PendingCss(int n) => n > 0 ? "bg-warning text-dark" : "bg-secondary text-white";
    string AvgCss(decimal pct) => pct >= 80m ? "bg-success text-white" : (pct > 0m ? "bg-danger text-white" : "bg-secondary text-white");

    var total = Model.Items.Count;
    var active = Model.Items.Count(x => x.IsActive);
    var pending = Model.Items.Sum(x => x.PendingGrade);
    var view = (Request.Query["view"].ToString() ?? "").Trim().ToLowerInvariant();
    var isCards = view == "cards";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Ex&aacute;menes</h1>
        <div class="text-muted small">Crear, asignar y revisar resultados.</div>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm @(isCards ? "active" : "")" asp-page="./Index" asp-route-view="cards">Cards</a>
            <a class="btn btn-outline-secondary btn-sm @(isCards ? "" : "active")" asp-page="./Index" asp-route-view="table">Tabla</a>
        </div>
        <a class="btn btn-primary" asp-page="/Admin/Exams/Create"><i class="bi bi-plus-lg me-1"></i> Crear examen</a>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Dashboard">Panel</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Total ex&aacute;menes</div><div class="fs-4 fw-bold">@total</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Activos</div><div class="fs-4 fw-bold">@active</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-soft hn-hover"><div class="card-body"><div class="text-muted small">Pendientes por calificar</div><div class="fs-4 fw-bold">@pending</div></div></div></div>
</div>

<div class="card shadow-soft hn-hover">
    <div class="card-body">
        @if (!Model.Items.Any())
        {
            <div class="text-muted">Sin ex&aacute;menes a&uacute;n.</div>
        }
        else if (!isCards)
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Examen</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Preguntas</th>
                            <th class="text-end">Asignados</th>
                            <th class="text-end">En revisi&oacute;n</th>
                            <th class="text-end">Pend. calificar</th>
                            <th class="text-end">Promedio</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@r.Title</div>
                                    <div class="text-muted small">Id: @r.Id</div>
                                </td>

                                <td class="text-center">
                                    <span class="badge rounded-pill @ActiveCss(r.IsActive)">@ActiveText(r.IsActive)</span>
                                </td>

                                <td class="text-end">@r.Questions</td>
                                <td class="text-end">@r.Assigned</td>
                                <td class="text-end">@r.Submitted</td>

                                <td class="text-end">
                                    <span class="badge rounded-pill @PendingCss(r.PendingGrade)">@r.PendingGrade</span>
                                </td>

                                <td class="text-end">
                                    <span class="badge rounded-pill @AvgCss(r.AvgPct)">
                                        @(r.AvgPct > 0 ? $"{r.AvgPct:0}%" : "-")
                                    </span>
                                    <div class="text-muted small">@((r.AvgScore > 0) ? $"{r.AvgScore:0.##} pts" : "")</div>
                                </td>

                                <td class="text-end">
                                    <div class="btn-group">
                                        <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Exams/Edit" asp-route-id="@r.Id">Editar</a>
                                        <a class="btn btn-sm btn-outline-success" asp-page="/Admin/Exams/Assign" asp-route-id="@r.Id">Asignar</a>
                                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Exams/Results" asp-route-id="@r.Id">Resultados</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-muted small mt-2">
                Pend. calificar = enviados con preguntas abiertas o adjuntos que requieren revision.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-xl-2 row-cols-xxl-3 g-3">
                @foreach (var r in Model.Items)
                {
                    <div class="col d-flex">
                        <div class="card shadow-sm hn-hover w-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-bold">@r.Title</div>
                                        <div class="text-muted small">Preguntas: @r.Questions</div>
                                    </div>
                                    <span class="badge rounded-pill @ActiveCss(r.IsActive)">@ActiveText(r.IsActive)</span>
                                </div>
                                <div class="small mt-2">
                                    <div><span class="text-muted">Asignados:</span> <b>@r.Assigned</b></div>
                                    <div><span class="text-muted">En revisión:</span> <b>@r.Submitted</b></div>
                                    <div><span class="text-muted">Pend. calificar:</span> <span class="badge rounded-pill @PendingCss(r.PendingGrade)">@r.PendingGrade</span></div>
                                    <div class="mt-1"><span class="text-muted">Promedio:</span> <span class="badge rounded-pill @AvgCss(r.AvgPct)">@(r.AvgPct > 0 ? $"{r.AvgPct:0}%" : "-")</span></div>
                                </div>
                                <div class="mt-auto pt-3 d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Exams/Edit" asp-route-id="@r.Id">Editar</a>
                                    <a class="btn btn-sm btn-outline-success" asp-page="/Admin/Exams/Assign" asp-route-id="@r.Id">Asignar</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Exams/Results" asp-route-id="@r.Id">Resultados</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
