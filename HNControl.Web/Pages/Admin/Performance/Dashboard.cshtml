@page
@model HNControl.Web.Pages.Admin.Performance.DashboardModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "KPI / 80-20";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-0">KPI / 80-20</h3>
        <div class="text-muted small">Quincena: @Model.PeriodStart.ToString("yyyy-MM-dd") → @Model.PeriodEnd.ToString("yyyy-MM-dd")</div>
    </div>

    <div class="d-flex gap-2 align-items-center">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Dashboard/Index">Dashboard</a>
        <a class="btn btn-outline-primary" asp-page="/Admin/Performance/ExportPayroll"
           asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-half="@Model.Half">
            Exportar nómina (CSV)
        </a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-2">
                <label class="form-label">Año</label>
                <input class="form-control" name="year" value="@Model.Year" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">Mes</label>
                <input class="form-control" name="month" value="@Model.Month" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Periodo</label>
                <select class="form-select" name="half">
                    <option value="1" selected="@(Model.Half == 1)">1ª quincena (1–15)</option>
                    <option value="2" selected="@(Model.Half == 2)">2ª quincena (16–fin)</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <button class="btn btn-primary w-100">Aplicar</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-lg-3">
        <div class="card shadow-soft">
            <div class="card-body">
                <div class="text-muted small">Empleados</div>
                <div class="fs-4 fw-bold">@Model.EmployeesTotal</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-3">
        <div class="card shadow-soft">
            <div class="card-body">
                <div class="text-muted small">Evaluados</div>
                <div class="fs-4 fw-bold">@Model.EmployeesRated</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-3">
        <div class="card shadow-soft">
            <div class="card-body">
                <div class="text-muted small">Promedio general</div>
                <div class="fs-4 fw-bold">@((Model.AvgScoreAll ?? 0).ToString("0.0"))</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-3">
        <div class="card shadow-soft">
            <div class="card-body">
                <div class="text-muted small">Total a pagar</div>
                <div class="fs-4 fw-bold">@Model.TotalPayrollPay.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <h6 class="mb-2">Total a pagar por empleado</h6>
                <canvas id="payChart" height="180"></canvas>
            </div>
            <div class="col-12 col-lg-6">
                <h6 class="mb-2">% variable por empleado</h6>
                <canvas id="varChart" height="180"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-soft">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Empleado</th>
                        <th class="text-end">Sueldo base</th>
                        <th class="text-center">Evaluado</th>
                        <th class="text-end">Prom</th>
                        <th class="text-end">% Var</th>
                        <th class="text-end">Var $</th>
                        <th class="text-end">Total a pagar</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@r.FullName</div>
                                <div class="text-muted small">@r.UserId</div>
                            </td>
                            <td class="text-end">@r.SalaryBase.ToString("C")</td>
                            <td class="text-center">
                                @if (r.HasReview)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end">@((r.AvgScore ?? 0).ToString("0.0"))</td>
                            <td class="text-end">@((r.VariablePercent * 100m).ToString("0.##"))%</td>
                            <td class="text-end">@r.VariableAmount.ToString("C")</td>
                            <td class="text-end fw-bold">@r.TotalPay.ToString("C")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-page="/Admin/Performance/Rate"
                                   asp-route-employeeId="@r.UserId"
                                   asp-route-ym="@($"{Model.Year:D4}-{Model.Month:D2}")"
                                   asp-route-half="@Model.Half">
                                    Calificar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const labels = @Html.Raw(Model.LabelsJson);
        const totalPay = @Html.Raw(Model.TotalPayJson);
        const varPct = @Html.Raw(Model.VarPercentJson);
        const chartColors = ['#2563eb', '#14b8a6', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6', '#0ea5e9', '#84cc16'];

        const payCfg = {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Total a pagar',
                    data: totalPay,
                    backgroundColor: totalPay.map((_, i) => chartColors[i % chartColors.length]),
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true } },
                plugins: { legend: { position: 'bottom' } }
            }
        };
        window.hnCharts?.decorate(payCfg);
        new Chart(document.getElementById('payChart'), payCfg);

        const varCfg = {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Variable (%)',
                    data: varPct,
                    backgroundColor: varPct.map((_, i) => chartColors[i % chartColors.length]),
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true, max: 100 } },
                plugins: { legend: { position: 'bottom' } }
            }
        };
        window.hnCharts?.decorate(varCfg);
        new Chart(document.getElementById('varChart'), varCfg);
    </script>
}
