@page
@model HNControl.Web.Pages.Admin.Performance.DashboardModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "KPI 80/20";
    var pending = Model.EmployeesTotal - Model.EmployeesRated;
    var progress = Model.EmployeesTotal == 0 ? 0 : (int)Math.Round(100m * Model.EmployeesRated / Model.EmployeesTotal);
    var firstPending = Model.Rows.FirstOrDefault(r => !r.HasReview && r.IsActive) ?? Model.Rows.FirstOrDefault(r => !r.HasReview);
    var ym = $"{Model.Year:D4}-{Model.Month:D2}";
}
<link rel="stylesheet" href="~/css/hn-kpi.css" asp-append-version="true" />
<div class="hn-kpi">
    <div class="hn-kpi-heading"><div><div class="hn-eyebrow">Personas · Desempeño</div><h1>KPI <span>80/20</span></h1><p>Evalúa a tu equipo y revisa el componente variable de cada quincena.</p></div><a class="btn btn-outline-secondary" asp-page="/Performance/ExportPayroll" asp-route-start="@Model.PeriodStart.ToString("yyyy-MM-dd")" asp-route-end="@Model.PeriodEnd.ToString("yyyy-MM-dd")"><i class="bi bi-download me-2" aria-hidden="true"></i>Exportar nómina · Excel</a></div>
    <form method="get" class="hn-kpi-filter">
        <div><label for="kpiYear">Año</label><input id="kpiYear" type="number" min="1900" max="9998" class="form-control" name="year" value="@Model.Year" required /></div>
        <div><label for="kpiMonth">Mes</label><select id="kpiMonth" class="form-select" name="month">@for(var m = 1; m <= 12; m++) { <option value="@m" selected="@(Model.Month == m)">@(global::System.Globalization.CultureInfo.GetCultureInfo("es-MX").DateTimeFormat.GetMonthName(m))</option> }</select></div>
        <div><label for="kpiHalf">Quincena</label><select id="kpiHalf" class="form-select" name="half"><option value="1" selected="@(Model.Half == 1)">Primera · 1 al 15</option><option value="2" selected="@(Model.Half == 2)">Segunda · 16 al cierre</option></select></div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i>Consultar periodo</button>
    </form>
    <section class="hn-kpi-banner">
        <div><div class="hn-eyebrow">@Model.PeriodStart.ToString("dd/MM/yyyy") — @Model.PeriodEnd.ToString("dd/MM/yyyy")</div><h2>@(pending == 0 && Model.EmployeesTotal > 0 ? "Tu equipo está evaluado." : "Cada evaluación cuenta.")</h2><p>@Model.EmployeesRated de @Model.EmployeesTotal empleados evaluados en esta quincena.</p>
            @if (firstPending != null) { <a class="btn btn-primary" asp-page="./Rate" asp-route-employeeId="@firstPending.UserId" asp-route-ym="@ym" asp-route-half="@Model.Half" data-module-panel="Calificar rendimiento">Continuar evaluaciones<i class="bi bi-arrow-right ms-2" aria-hidden="true"></i></a> }
        </div>
        <div class="hn-kpi-progress"><strong>@progress<small>%</small></strong><span>Avance de evaluación</span><progress value="@Model.EmployeesRated" max="@Math.Max(1, Model.EmployeesTotal)" aria-label="Avance de evaluaciones"></progress></div>
    </section>
    <div class="hn-kpi-stats">
        <article><span><i class="bi bi-check2-circle" aria-hidden="true"></i>Evaluados</span><strong>@Model.EmployeesRated<small> / @Model.EmployeesTotal</small></strong><p>Con calificación guardada</p></article>
        <article><span><i class="bi bi-hourglass" aria-hidden="true"></i>Pendientes</span><strong>@pending</strong><p>Sin evaluación en el periodo</p></article>
        <article><span><i class="bi bi-star" aria-hidden="true"></i>Promedio del equipo</span><strong>@(Model.AvgScoreAll?.ToString("0.0") ?? "—")<small> / 5</small></strong><p>Solo empleados evaluados</p></article>
        <article><span><i class="bi bi-wallet2" aria-hidden="true"></i>Estimación 80/20</span><strong>@Model.TotalPayrollPay.ToString("C2")</strong><p>Antes de bonos y deducciones</p></article>
    </div>
    <section class="hn-kpi-panel">
        <div class="hn-kpi-panel-heading"><div><h2>Evaluaciones por empleado</h2><p>Consulta, califica o actualiza la evaluación del periodo seleccionado.</p></div><span id="kpiVisibleCount" class="hn-kpi-count">@Model.Rows.Count empleados</span></div>
        <div class="hn-kpi-searchbar"><div><label for="kpiSearch">Buscar empleado</label><input id="kpiSearch" type="search" class="form-control" placeholder="Nombre, puesto o número de empleado" /></div><div><label for="kpiStatus">Evaluación</label><select id="kpiStatus" class="form-select"><option value="all">Todos</option><option value="pending">Pendientes</option><option value="rated">Evaluados</option></select></div></div>
        <div class="table-responsive"><table class="table hn-kpi-table align-middle"><thead><tr><th>Empleado</th><th>Estado</th><th class="text-end">Promedio</th><th class="text-end">Variable ganada</th><th class="text-end">Fijo 80%</th><th class="text-end">Variable $</th><th class="text-end">Estimación 80/20</th><th><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>
            @foreach (var r in Model.Rows) {
                <tr data-kpi-row data-search="@($"{r.FullName} {r.Position} {r.EmployeeNumber}")" data-rated="@(r.HasReview ? "rated" : "pending")" data-employee-status="@(r.IsActive ? "active" : "inactive")">
                    <td><a class="hn-kpi-person" asp-page="/Admin/Employees/Details" asp-route-userId="@r.UserId" data-module-panel="Ficha · @r.FullName">@r.FullName</a><div class="hn-kpi-person-meta">@r.Position @(!string.IsNullOrWhiteSpace(r.EmployeeNumber) ? "· " + r.EmployeeNumber : "") @(!r.IsActive ? "· Baja" : "")</div></td>
                    <td><span class="hn-kpi-badge @(r.HasReview ? "is-rated" : "is-pending")">@(r.HasReview ? "Evaluado" : "Pendiente")</span></td>
                    <td class="text-end">@(r.AvgScore?.ToString("0.0") ?? "—")</td><td class="text-end">@(r.HasReview ? (r.VariablePercent * 100m).ToString("0.##") + "%" : "—")</td>
                    <td class="text-end">@((r.SalaryBase / 2m * .8m).ToString("C2"))</td><td class="text-end">@r.VariableAmount.ToString("C2")</td><td class="text-end fw-semibold">@r.TotalPay.ToString("C2")</td>
                    <td class="text-end"><a class="btn btn-sm @(r.HasReview ? "btn-outline-secondary" : "btn-outline-primary")" asp-page="./Rate" asp-route-employeeId="@r.UserId" asp-route-ym="@ym" asp-route-half="@Model.Half" data-module-panel="Evaluación · @r.FullName">@(r.HasReview ? "Revisar" : "Calificar")<i class="bi bi-chevron-right ms-2" aria-hidden="true"></i></a></td>
                </tr>
            }
        </tbody></table></div>
        <p class="hn-kpi-empty" id="kpiNoResults" hidden="@(Model.Rows.Count > 0)">No hay empleados que coincidan con esta selección.</p>
        <div class="hn-kpi-footnote"><i class="bi bi-info-circle" aria-hidden="true"></i>Sin evaluación, la estimación considera únicamente el 80% fijo. El Excel de nómina incluye los ajustes registrados. Solo empleados activos. Los indicadores superiores corresponden al periodo completo.</div>
    </section>
    <details class="hn-kpi-panel hn-kpi-chart-panel"><summary>Comparativa del periodo <span>Estimación y porcentaje variable</span></summary><div class="hn-kpi-charts"><div><h3>Estimación 80/20 por empleado</h3><div class="hn-kpi-chart"><canvas id="payChart" aria-label="Estimación por empleado" role="img"></canvas></div></div><div><h3>Variable ganada</h3><div class="hn-kpi-chart"><canvas id="varChart" aria-label="Porcentaje variable por empleado" role="img"></canvas></div></div></div></details>
    <details class="hn-kpi-panel hn-kpi-explainer"><summary>¿Cómo se calcula el 80/20?</summary><div><p>La base quincenal es el sueldo mensual dividido entre dos. El 80% es fijo y el 20% restante depende de la evaluación.</p><p><strong>Variable ganada = suma de las siete calificaciones ÷ 35.</strong> Una evaluación con todos los indicadores en 3 obtiene el 60% del componente variable.</p><p>Estimación del periodo = fijo del 80% + máximo variable del 20% × variable ganada. Los bonos y las deducciones se aplican por separado en nómina.</p></div></details>
</div>
@section Scripts {
<script>
(() => {
    const rows = [...document.querySelectorAll('[data-kpi-row]')];
    const search = document.getElementById('kpiSearch'), status = document.getElementById('kpiStatus');
    const normalize = value => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    function filter() { let count=0; rows.forEach(row => { const show = normalize(row.dataset.search).includes(normalize(search.value.trim())) && (status.value==='all'||row.dataset.rated===status.value); row.hidden=!show; if(show) count++; }); document.getElementById('kpiVisibleCount').textContent = count+' empleados'; document.getElementById('kpiNoResults').hidden=count>0; }
    search.addEventListener('input',filter); status.addEventListener('change',filter);
    const panel=document.querySelector('.hn-kpi-chart-panel'); let rendered=false;
    panel.addEventListener('toggle',()=>{ if(!panel.open||rendered) return; if(typeof Chart==='undefined') return; rendered=true;
        const labels=@Html.Raw(Model.LabelsJson), payments=@Html.Raw(Model.TotalPayJson), variable=@Html.Raw(Model.VarPercentJson);
        [['payChart',payments,'Estimación 80/20'],['varChart',variable,'Variable (%)']].forEach(([id,data,label])=>{const cfg={type:'bar',data:{labels,datasets:[{label,data,backgroundColor:'#80a8e9',borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,scales:{y:{beginAtZero:true,...(id==='varChart'?{max:100}:{})}}}};window.hnCharts?.decorate(cfg);new Chart(document.getElementById(id),cfg);});
    });
})();
</script>
}
