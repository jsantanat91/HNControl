@page
@model HNControl.Web.Pages.Admin.Performance.RateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Evaluar rendimiento";
}
<link rel="stylesheet" href="~/css/hn-kpi.css" asp-append-version="true" />
<div class="hn-kpi">
    <div class="hn-kpi-heading"><div><div class="hn-eyebrow">KPI · Modelo 80/20</div><h1>Evaluar rendimiento</h1><p>Selecciona una calificación por indicador y registra tus observaciones.</p></div><a class="btn btn-outline-secondary" asp-page="./Dashboard" asp-route-year="@Model.PeriodStart.Year" asp-route-month="@Model.PeriodStart.Month" asp-route-half="@Model.Input.Half" data-module-panel-close>Volver al resumen</a></div>
    @if(!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
    @if(!string.IsNullOrWhiteSpace(Model.Info)) { <div class="alert alert-success" role="status">@Model.Info</div> }
    <form method="get" class="hn-kpi-filter hn-kpi-picker" id="kpiContextForm">
        @if(Request.Query["panel"] == "1") { <input type="hidden" name="panel" value="1" /> }
        <div><label for="employeePicker">Empleado</label><select class="form-select" name="employeeId" id="employeePicker">@foreach(var item in Model.EmployeeItems) { <option value="@item.Value" selected="@(item.Value == Model.Input.EmployeeId)">@item.Text</option> }</select></div>
        <div><label for="ymPicker">Mes</label><select class="form-select" name="ym" id="ymPicker" asp-items="Model.MonthItems"></select></div>
        <div><label for="halfPicker">Quincena</label><select class="form-select" name="half" id="halfPicker" asp-items="Model.HalfItems"></select></div>
        <button type="submit" class="btn btn-outline-primary">Cargar evaluación</button>
    </form>
    <form method="post" id="kpiRatingForm" data-salary="@Model.SalaryBase.ToString(global::System.Globalization.CultureInfo.InvariantCulture)">
        <input type="hidden" asp-for="Input.EmployeeId" /><input type="hidden" asp-for="Input.Ym" /><input type="hidden" asp-for="Input.Half" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="hn-kpi-evaluation-heading"><div><h2>@Model.EmployeeName</h2><p>@Model.PeriodStart.ToString("dd/MM/yyyy") — @Model.PeriodEnd.ToString("dd/MM/yyyy")</p></div><span class="hn-kpi-badge @(Model.HasReview ? "is-rated" : "is-pending")">@(Model.HasReview ? "Evaluación registrada" : "Nueva evaluación")</span></div>
        <div class="hn-kpi-rating-layout"><div class="hn-kpi-metrics">
            <fieldset class="hn-kpi-metric"><legend><span>01</span>Rendimiento personal</legend><p>Calidad, cumplimiento y responsabilidad en el trabajo.</p><div class="hn-kpi-choices">
                @for(var score=1; score<=5; score++) { <div><input asp-for="Input.PersonalPerformance" type="radio" value="@score" id="PersonalPerformance-@score" /><label for="PersonalPerformance-@score">@score</label></div> }
            </div><div class="hn-kpi-scale"><span>1 · Por mejorar</span><span>5 · Sobresaliente</span></div><span asp-validation-for="Input.PersonalPerformance" class="text-danger"></span></fieldset>
            <fieldset class="hn-kpi-metric"><legend><span>02</span>Trabajo en equipo</legend><p>Colaboración y apoyo a los compañeros.</p><div class="hn-kpi-choices">
                @for(var score=1; score<=5; score++) { <div><input asp-for="Input.Teamwork" type="radio" value="@score" id="Teamwork-@score" /><label for="Teamwork-@score">@score</label></div> }
            </div><div class="hn-kpi-scale"><span>1 · Por mejorar</span><span>5 · Sobresaliente</span></div><span asp-validation-for="Input.Teamwork" class="text-danger"></span></fieldset>
            <fieldset class="hn-kpi-metric"><legend><span>03</span>Participación en equipo</legend><p>Iniciativa y aportaciones a las actividades del equipo.</p><div class="hn-kpi-choices">
                @for(var score=1; score<=5; score++) { <div><input asp-for="Input.ParticipationInTeam" type="radio" value="@score" id="ParticipationInTeam-@score" /><label for="ParticipationInTeam-@score">@score</label></div> }
            </div><div class="hn-kpi-scale"><span>1 · Por mejorar</span><span>5 · Sobresaliente</span></div><span asp-validation-for="Input.ParticipationInTeam" class="text-danger"></span></fieldset>
            <fieldset class="hn-kpi-metric"><legend><span>04</span>Puntualidad y asistencia</legend><p>Cumplimiento de horarios y asistencia.</p><div class="hn-kpi-choices">
                @for(var score=1; score<=5; score++) { <div><input asp-for="Input.PunctualityAttendance" type="radio" value="@score" id="PunctualityAttendance-@score" /><label for="PunctualityAttendance-@score">@score</label></div> }
            </div><div class="hn-kpi-scale"><span>1 · Por mejorar</span><span>5 · Sobresaliente</span></div><span asp-validation-for="Input.PunctualityAttendance" class="text-danger"></span></fieldset>
            <fieldset class="hn-kpi-metric"><legend><span>05</span>Ejecución de proyectos</legend><p>Avance, entregables y cumplimiento de compromisos.</p><div class="hn-kpi-choices">
                @for(var score=1; score<=5; score++) { <div><input asp-for="Input.ProjectExecution" type="radio" value="@score" id="ProjectExecution-@score" /><label for="ProjectExecution-@score">@score</label></div> }
            </div><div class="hn-kpi-scale"><span>1 · Por mejorar</span><span>5 · Sobresaliente</span></div><span asp-validation-for="Input.ProjectExecution" class="text-danger"></span></fieldset>
            <fieldset class="hn-kpi-metric"><legend><span>06</span>Orden y limpieza</legend><p>Cuidado del espacio, herramientas y materiales.</p><div class="hn-kpi-choices">
                @for(var score=1; score<=5; score++) { <div><input asp-for="Input.OrderCleanliness" type="radio" value="@score" id="OrderCleanliness-@score" /><label for="OrderCleanliness-@score">@score</label></div> }
            </div><div class="hn-kpi-scale"><span>1 · Por mejorar</span><span>5 · Sobresaliente</span></div><span asp-validation-for="Input.OrderCleanliness" class="text-danger"></span></fieldset>
            <fieldset class="hn-kpi-metric"><legend><span>07</span>Habilidades técnicas</legend><p>Conocimientos y aplicación técnica en el servicio.</p><div class="hn-kpi-choices">
                @for(var score=1; score<=5; score++) { <div><input asp-for="Input.TechnicalSkills" type="radio" value="@score" id="TechnicalSkills-@score" /><label for="TechnicalSkills-@score">@score</label></div> }
            </div><div class="hn-kpi-scale"><span>1 · Por mejorar</span><span>5 · Sobresaliente</span></div><span asp-validation-for="Input.TechnicalSkills" class="text-danger"></span></fieldset>
            <div class="hn-kpi-panel hn-kpi-notes"><label for="Input_Notes">Observaciones y acuerdos</label><p>Describe fortalezas, oportunidades de mejora y compromisos para la siguiente quincena.</p><textarea asp-for="Input.Notes" class="form-control" rows="4" maxlength="3600" placeholder="Ejemplo: completó las instalaciones a tiempo; acordamos mejorar el registro de evidencias."></textarea><span asp-validation-for="Input.Notes" class="text-danger"></span></div>
        </div><aside class="hn-kpi-live"><div class="hn-eyebrow">Resumen de la evaluación</div><h3>Promedio</h3><div class="hn-kpi-live-score"><strong id="kpiLiveScore">—</strong><span> / 5</span></div><progress id="kpiLiveProgress" max="100" value="0" aria-label="Porcentaje variable de la evaluación"></progress>
            <dl><div><dt>Variable ganada</dt><dd id="kpiLivePercent">—</dd></div><div><dt>Base quincenal</dt><dd id="kpiLiveBase">—</dd></div><div><dt>Fijo del 80%</dt><dd id="kpiLiveFixed">—</dd></div><div><dt>Importe variable</dt><dd id="kpiLiveVariable">—</dd></div><div class="hn-kpi-live-total"><dt>Estimación 80/20</dt><dd id="kpiLiveTotal">—</dd></div></dl><p>Antes de bonos y deducciones. La evaluación determina qué proporción del 20% variable corresponde al empleado.</p><span id="kpiDirty" role="status" hidden>Cambios sin guardar</span>
        </aside></div>
        <div class="hn-kpi-savebar"><span>Se guardará para <strong>@Model.EmployeeName</strong> en esta quincena.</span><button type="submit" class="btn btn-primary" id="kpiSave"><i class="bi bi-check2 me-2" aria-hidden="true"></i>Guardar evaluación</button></div>
    </form>
</div>
@section Scripts { <script src="~/js/hn-kpi-rating.js" asp-append-version="true"></script> }
