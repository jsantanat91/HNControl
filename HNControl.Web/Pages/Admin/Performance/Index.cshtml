@page
@model HNControl.Web.Pages.Admin.Performance.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Evaluaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Evaluaciones y Nómina (80/20)</h1>
        <div class="text-muted small">Periodo: @Model.PeriodStart:yyyy-MM-dd → @Model.PeriodEnd:yyyy-MM-dd</div>
    </div>
</div>

<div class="card shadow-sm hn-hover mb-3">
    <div class="card-body">
        <canvas id="chartVar" height="80"></canvas>
        <div class="text-muted small mt-2">Variable % por empleado (0–100%).</div>
    </div>
</div>

<div class="card shadow-sm hn-hover hn-hover">
    <div class="card-header fw-semibold">Resumen por empleado</div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Empleado</th>
                    <th class="text-end">Base quincenal</th>
                    <th class="text-end">80% fijo</th>
                    <th class="text-end">20% máx</th>
                    <th class="text-end">Variable %</th>
                    <th class="text-end">Variable $</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Name</td>
                        <td class="text-end">@r.BaseQuincenal.ToString("0.00")</td>
                        <td class="text-end">@r.Fixed80.ToString("0.00")</td>
                        <td class="text-end">@r.Variable20Max.ToString("0.00")</td>
                        <td class="text-end">@((r.VariablePercent * 100m).ToString("0.##"))%</td>
                        <td class="text-end">@r.VariableMoney.ToString("0.00")</td>
                        <td class="text-end fw-semibold">@r.TotalQuincena.ToString("0.00")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-page="/Admin/Performance/Edit"
                               asp-route-userId="@r.UserId"
                               asp-route-start="@Model.PeriodStart.ToString("yyyy-MM-dd")">
                                Calificar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(Model.LabelsJson);
        const values = @Html.Raw(Model.ValuesJson);
        new Chart(document.getElementById('chartVar'), {
          type: 'bar',
          data: { labels, datasets: [{ label: 'Variable %', data: values }] },
          options: { scales: { y: { beginAtZero: true, max: 100 } } }
        });
    </script>
}
