    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo item del catalogo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="small text-muted">Captura rapida en modal. Este formulario usa el mismo guardado del catalogo.</div>
                <form method="post" asp-page-handler="Create" class="row g-3 mt-1">
                    <div class="col-md-3">
                        <label class="form-label">Segmento</label>
                        <select asp-for="Input.Segment" class="form-select" id="modalSegment">
                            <option value="Residential">Residencial</option>
                            <option value="Business">Empresarial</option>
                            <option value="Events">Eventos</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Nivel</label>
                        <select asp-for="Input.NodeType" class="form-select" id="modalNodeType">
                            <option value="Category">Categoria</option>
                            <option value="Service">Servicio</option>
                            <option value="Subproduct">Subproducto</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Padre (si aplica)</label>
                        <select asp-for="Input.ParentId" class="form-select" id="modalParentSelect">
                            <option value="">Sin padre</option>
                            @foreach (var p in Model.ParentOptions)
                            {
                                <option value="@p.Id" data-segment="@p.Segment" data-type="@p.NodeType">@p.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre</label>
                        <input asp-for="Input.Name" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Descripcion</label>
                        <input asp-for="Input.Description" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Costo unitario (opcional)</label>
                        <input asp-for="Input.UnitPrice" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tipo comercial</label>
                        <select asp-for="Input.OfferType" class="form-select">
                            <option value="Sale">Venta</option>
                            <option value="MonthlyRent">Renta mensual</option>
                            <option value="Lease">Arrendamiento</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Atributo variante (opcional)</label>
                        <input asp-for="Input.VariantGroup" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Opcion variante (opcional)</label>
                        <input asp-for="Input.VariantValue" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Imagen (URL opcional)</label>
                        <input asp-for="Input.ImageUrl" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Referencia (URL opcional)</label>
                        <input asp-for="Input.ReferenceUrl" class="form-control" />
                    </div>
                    <div class="col-12 d-flex gap-3">
                        <div class="form-check">
                            <input asp-for="Input.UnitPriceIncludesVat" class="form-check-input" />
                            <label asp-for="Input.UnitPriceIncludesVat" class="form-check-label">Costo con IVA</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="Input.IsManualPrice" class="form-check-input" />
                            <label asp-for="Input.IsManualPrice" class="form-check-label">Costo manual</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">Guardar item</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    const seg = document.querySelector('[name="Input.Segment"]');
    const node = document.getElementById('nodeTypeSelect');
    const parent = document.getElementById('parentSelect');
    const modalSeg = document.getElementById('modalSegment');
    const modalNode = document.getElementById('modalNodeType');
    const modalParent = document.getElementById('modalParentSelect');

    function neededParentType(nodeType){
        if(nodeType === 'Service') return 'Category';
        if(nodeType === 'Subproduct') return 'Service';
        return '';
    }

    function refreshParents(){
        const currentSeg = seg.value;
        const typeNeeded = neededParentType(node.value);

        [...parent.options].forEach((opt, idx) => {
            if(idx === 0){
                opt.hidden = !!typeNeeded;
                if(!typeNeeded) opt.selected = true;
                return;
            }
            const okSeg = opt.dataset.segment === currentSeg;
            const okType = !typeNeeded || opt.dataset.type === typeNeeded;
            opt.hidden = !(okSeg && okType);
            if(opt.hidden && opt.selected) parent.value = '';
        });
    }

    if (seg && node && parent) {
        seg.addEventListener('change', refreshParents);
        node.addEventListener('change', refreshParents);
        refreshParents();
    }

    function refreshModalParents(){
        if (!modalSeg || !modalNode || !modalParent) return;
        const currentSeg = modalSeg.value;
        const typeNeeded = neededParentType(modalNode.value);
        [...modalParent.options].forEach((opt, idx) => {
            if(idx === 0){
                opt.hidden = !!typeNeeded;
                if(!typeNeeded) opt.selected = true;
                return;
            }
            const okSeg = opt.dataset.segment === currentSeg;
            const okType = !typeNeeded || opt.dataset.type === typeNeeded;
            opt.hidden = !(okSeg && okType);
            if(opt.hidden && opt.selected) modalParent.value = '';
        });
    }
    if (modalSeg && modalNode && modalParent) {
        modalSeg.addEventListener('change', refreshModalParents);
        modalNode.addEventListener('change', refreshModalParents);
        refreshModalParents();
    }
})();

(function(){
    const catalog = @Html.Raw(catalogJson);
    const detailModalEl = document.getElementById('catalogDetailModal');
    const detailBody = document.getElementById('catalogDetailBody');
    const detailTitle = document.getElementById('catalogDetailTitle');
    const detailNewBtn = document.getElementById('catalogDetailNewItem');
    const createModalEl = document.getElementById('nuevoItemCatalogoModal');
    const createParent = document.getElementById('modalParentSelect');
    const createNode = document.getElementById('modalNodeType');

    if (!detailModalEl || !detailBody || !detailTitle || typeof bootstrap === 'undefined') return;
    const detailModal = new bootstrap.Modal(detailModalEl);
    const createModal = createModalEl ? new bootstrap.Modal(createModalEl) : null;

    function openCreate(parentId){
        if (!createModal || !createParent) return;
        if (createNode) createNode.value = 'Service';
        if (parentId) createParent.value = parentId;
        detailModal.hide();
        createModal.show();
    }

    function renderCategory(categoryId, categoryName, categorySegment){
        const services = catalog.filter(x => x.nodeType === 'Service' && x.segment === categorySegment && x.parentId === categoryId);
        const serviceIds = new Set(services.map(s => s.id));
        const subs = catalog.filter(x => x.nodeType === 'Subproduct' && x.segment === categorySegment && x.parentId && serviceIds.has(x.parentId));

        let html = `<div class="mb-3"><div class="fw-semibold">${categoryName}</div><div class="small text-muted">Servicios: ${services.length} · Subservicios: ${subs.length}</div></div>`;

        if (services.length === 0 && subs.length === 0) {
            html += `<div class="text-muted">Sin servicios registrados en esta categoria.</div>`;
        } else {
            html += `<div class="row g-3">`;
            services.forEach(s => {
                const price = s.isManualPrice ? 'Manual' : (s.unitPrice == null ? '-' : `$${Number(s.unitPrice).toFixed(2)} ${(s.unitPriceIncludesVat ? '(IVA incl.)' : '+ IVA')}`);
                html += `<div class="col-12 col-md-6"><div class="border rounded p-2 h-100"><div class="fw-semibold">${s.name}</div><div class="small text-muted">${s.description || 'Sin descripcion'}</div><div class="small mt-1">Tipo: ${s.offerType} · Costo: ${price}</div></div></div>`;
            });
            html += `</div>`;

            if (subs.length > 0) {
                html += `<hr /><div class="fw-semibold mb-2">Subservicios</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Nombre</th><th>Padre</th><th>Costo</th><th>Estado</th></tr></thead><tbody>`;
                subs.forEach(s => {
                    const price = s.isManualPrice ? 'Manual' : (s.unitPrice == null ? '-' : `$${Number(s.unitPrice).toFixed(2)}`);
                    html += `<tr><td>${s.name}</td><td>${s.parentName || '-'}</td><td>${price}</td><td>${s.isActive ? 'Activo' : 'Inactivo'}</td></tr>`;
                });
                html += `</tbody></table></div>`;
            }
        }

        detailBody.innerHTML = html;
        detailTitle.textContent = `Detalle: ${categoryName}`;
        if (detailNewBtn) detailNewBtn.setAttribute('data-parent-id', categoryId);
    }

    document.querySelectorAll('[data-category-open="true"]').forEach(btn => {
        btn.addEventListener('click', function(){
            const categoryId = this.getAttribute('data-category-id') || '';
            const categoryName = this.getAttribute('data-category-name') || 'Categoria';
            const categorySegment = this.getAttribute('data-category-segment') || 'Residential';
            renderCategory(categoryId, categoryName, categorySegment);
            detailModal.show();
        });
    });

    if (detailNewBtn) {
        detailNewBtn.addEventListener('click', function(){
            openCreate(this.getAttribute('data-parent-id') || '');
        });
    }

    document.querySelectorAll('[data-parent-prefill]').forEach(btn => {
        btn.addEventListener('click', function(){
            openCreate(this.getAttribute('data-parent-prefill') || '');
            const seg = this.getAttribute('data-segment-prefill') || '';
            const modalSegment = document.getElementById('modalSegment');
            if (modalSegment && seg) modalSegment.value = seg;
        });
    });

    const newParentCategoryBtn = document.getElementById('newParentCategoryBtn');
    if (newParentCategoryBtn) {
        newParentCategoryBtn.addEventListener('click', function(){
            const modalNodeType = document.getElementById('modalNodeType');
            const modalParent = document.getElementById('modalParentSelect');
            if (modalNodeType) modalNodeType.value = 'Category';
            if (modalParent) modalParent.value = '';
            if (createModal) createModal.show();
        });
    }
})();
</script>
}
