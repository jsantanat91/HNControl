@page
@model HNControl.Web.Pages.Admin.Quotes.CatalogModel
@using global::System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin - Cotizaciones";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Cotizacion a la medida</h1>
        <div class="text-muted small">Configura segmento, categorias, servicios y subproductos para cotizacion interna.</div>
    </div>
    <div class="d-flex gap-2">
            <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoItemCatalogoModal">
                + Nuevo item
            </button>
            <button class="btn btn-outline-primary" type="button" id="newParentCategoryBtn">
                + Nueva categoria padre
            </button>
        <a class="btn btn-outline-primary" asp-page="./Requests">Cotizaciones</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@{
    var categories = Model.Items
        .Where(x => x.NodeType == HNControl.Web.Models.QuoteNodeType.Category)
        .OrderBy(x => x.Segment)
        .ThenBy(x => x.Name)
        .ToList();
    var categoryIds = categories.Select(x => x.Id).ToHashSet();
    var services = Model.Items.Where(x => x.NodeType == HNControl.Web.Models.QuoteNodeType.Service).ToList();
    var serviceIds = services.Select(x => x.Id).ToHashSet();

    var catalogJson = JsonSerializer.Serialize(Model.Items.Select(x => new
    {
        id = x.Id,
        parentId = x.ParentId,
        segment = x.Segment.ToString(),
        nodeType = x.NodeType.ToString(),
        name = x.Name,
        description = x.Description,
        parentName = x.ParentName,
        offerType = x.OfferType.ToString(),
        unitPrice = x.UnitPrice,
        unitPriceIncludesVat = x.UnitPriceIncludesVat,
        isManualPrice = x.IsManualPrice,
        isActive = x.IsActive
    }));
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h6 mb-3">Categorias padre (dashboard)</h2>
        @if (categories.Count == 0)
        {
            <div class="text-muted">Aun no hay categorias padre en el catalogo.</div>
        }
        else
        {
            @foreach (var segment in new[] { HNControl.Web.Models.QuoteSegment.Residential, HNControl.Web.Models.QuoteSegment.Business, HNControl.Web.Models.QuoteSegment.Events })
            {
                var segmentCategories = categories.Where(c => c.Segment == segment).ToList();
                <div class="mb-3">
                    <div class="fw-semibold mb-2">@Model.LabelSegment(segment)</div>
                    @if (!segmentCategories.Any())
                    {
                        <div class="small text-muted border rounded p-2">Sin categorias en este segmento.</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var cat in segmentCategories)
                            {
                                var serviceRows = services.Where(s => s.ParentId == cat.Id).ToList();
                                var subCount = Model.Items.Count(s => s.NodeType == HNControl.Web.Models.QuoteNodeType.Subproduct && s.ParentId.HasValue && serviceIds.Contains(s.ParentId.Value) && serviceRows.Any(sr => sr.Id == s.ParentId.Value));
                                <div class="col-12 col-md-6 col-xl-4">
                                    <div class="border rounded-3 p-3 h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge text-bg-light border">@Model.LabelSegment(cat.Segment)</span>
                                            <span class="hn-chip @(cat.IsActive ? "hn-chip-status-up" : "hn-chip-neutral")">@(cat.IsActive ? "Activo" : "Inactivo")</span>
                                        </div>
                                        <div class="fw-semibold">@cat.Name</div>
                                        <div class="small text-muted">@(!string.IsNullOrWhiteSpace(cat.Description) ? cat.Description : "Sin descripcion")</div>
                                        <div class="small text-muted mt-2">Servicios/Subservicios: @serviceRows.Count / @subCount</div>
                                        <div class="mt-3 d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    type="button"
                                                    data-category-open="true"
                                                    data-category-id="@cat.Id"
                                                    data-category-name="@cat.Name"
                                                    data-category-segment="@cat.Segment">Abrir</button>
                                            <button class="btn btn-sm btn-primary"
                                                    type="button"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#nuevoItemCatalogoModal"
                                                    data-parent-prefill="@cat.Id"
                                                    data-segment-prefill="@cat.Segment">Nuevo item</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<div class="card shadow-sm mb-3 d-none">
    <div class="card-body">
        <h2 class="h6 mb-3">Nuevo item del catalogo</h2>
        <form method="post" asp-page-handler="Create" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Segmento</label>
                <select asp-for="Input.Segment" class="form-select">
                    <option value="Residential">Residencial</option>
                    <option value="Business">Empresarial</option>
                    <option value="Events">Eventos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Nivel</label>
                <select asp-for="Input.NodeType" class="form-select" id="nodeTypeSelect">
                    <option value="Category">Categoria</option>
                    <option value="Service">Servicio</option>
                    <option value="Subproduct">Subproducto</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Padre (si aplica)</label>
                <select asp-for="Input.ParentId" class="form-select" id="parentSelect">
                    <option value="">Sin padre</option>
                    @foreach (var p in Model.ParentOptions)
                    {
                        <option value="@p.Id" data-segment="@p.Segment" data-type="@p.NodeType">@p.Label</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Nombre</label>
                <input asp-for="Input.Name" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Imagen (URL opcional)</label>
                <input asp-for="Input.ImageUrl" class="form-control" placeholder="https://..." />
            </div>
            <div class="col-md-4">
                <label class="form-label">Costo unitario (opcional)</label>
                <input asp-for="Input.UnitPrice" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo comercial</label>
                <select asp-for="Input.OfferType" class="form-select">
                    <option value="Sale">Venta</option>
                    <option value="MonthlyRent">Renta mensual</option>
                    <option value="Lease">Arrendamiento</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Atributo variante (opcional)</label>
                <input asp-for="Input.VariantGroup" class="form-control" placeholder="Color, Tecnologia, Plan..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Opcion variante (opcional)</label>
                <input asp-for="Input.VariantValue" class="form-control" placeholder="Negro, PIR, 8 canales..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check mb-2 me-3">
                    <input asp-for="Input.UnitPriceIncludesVat" class="form-check-input" />
                    <label asp-for="Input.UnitPriceIncludesVat" class="form-check-label">Costo con IVA</label>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="Input.IsManualPrice" class="form-check-input" />
                    <label asp-for="Input.IsManualPrice" class="form-check-label">Costo manual</label>
                </div>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="small text-muted">
                    Orden automatico: el sistema coloca el nuevo item despues del ultimo en su mismo nivel.
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Link de referencia (opcional)</label>
                <input asp-for="Input.ReferenceUrl" class="form-control" placeholder="https://..." />
            </div>
            <div class="col-md-6">
                <label class="form-label">Descripcion</label>
                <input asp-for="Input.Description" class="form-control" />
            </div>
            <div class="col-12">
                <div class="small text-muted">
                    Variantes: para crear mas de una opcion del mismo producto, repite el alta con mismo Segmento + Padre + Nombre y cambia solo Atributo/Opcion variante.
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Guardar item</button>
                <button class="btn btn-outline-secondary" type="submit" formaction="?handler=SeedDemo">Cargar demo base</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm d-none">
    <div class="card-body">
        <h2 class="h6 mb-3">Catalogo actual</h2>

        @if (Model.Items.Count == 0)
        {
            <div class="text-muted">Aun no hay elementos en el catalogo.</div>
        }
        else
        {
            var grouped = Model.Items
                .GroupBy(x => new { x.Segment, Parent = Model.ParentCategoryGroup(x) })
                .OrderBy(g => g.Key.Segment)
                .ThenBy(g => g.Key.Parent)
                .ToList();
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Segmento</th>
                            <th>Nivel</th>
                            <th>Nombre</th>
                            <th>Padre</th>
                            <th>Tipo</th>
                            <th>Costo</th>
                            <th>Imagen</th>
                            <th>Referencia</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var group in grouped)
                    {
                        <tr class="table-light">
                            <td colspan="10" class="fw-semibold">
                                @Model.LabelSegment(group.Key.Segment) · Categoria padre: @group.Key.Parent
                            </td>
                        </tr>
                        @foreach (var i in group)
                        {
                            <tr>
                                <td><span class="badge text-bg-light border">@Model.LabelSegment(i.Segment)</span></td>
                                <td>@Model.LabelType(i.NodeType)</td>
                                <td>
                                    <div class="fw-semibold">@i.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(i.Description))
                                    {
                                        <div class="small text-muted">@i.Description</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(i.VariantGroup) || !string.IsNullOrWhiteSpace(i.VariantValue))
                                    {
                                        <div class="small mt-1">
                                            <span class="badge text-bg-light border">@((i.VariantGroup ?? "Variante") + ": " + (i.VariantValue ?? "-"))</span>
                                        </div>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(i.ParentName) ? "-" : i.ParentName)</td>
                                <td>
                                    <span class="badge text-bg-light border">@Model.LabelOfferType(i.OfferType)</span>
                                </td>
                                <td>
                                    @if (i.IsManualPrice)
                                    {
                                        <span class="badge text-bg-warning">Manual</span>
                                    }
                                    else if (i.UnitPrice.HasValue)
                                    {
                                        @i.UnitPrice.Value.ToString("C2")
                                        <div class="small text-muted">@(i.UnitPriceIncludesVat ? "Incluye IVA" : "+ IVA 16%")</div>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(i.ImageUrl))
                                    {
                                        <img src="@i.ImageUrl" alt="img" style="width:56px;height:56px;object-fit:cover;border-radius:10px;border:1px solid #dbe3f4;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(i.ReferenceUrl))
                                    {
                                        <a href="@i.ReferenceUrl" target="_blank" rel="noopener">Abrir</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    <span class="hn-chip @(i.IsActive ? "hn-chip-status-up" : "hn-chip-neutral")">@(i.IsActive ? "Activo" : "Inactivo")</span>
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                                        <input type="hidden" name="id" value="@i.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(i.IsActive ? "Desactivar" : "Activar")</button>
                                    </form>
                                    <a class="btn btn-sm btn-outline-primary" asp-page="./EditItem" asp-route-id="@i.Id">Editar</a>
                                    <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Eliminar este item y sus variantes/hijos?');">
                                        <input type="hidden" name="id" value="@i.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <h2 class="h6 mb-3">Reglas condicionales (Fase 2)</h2>
        <div class="text-muted small mb-3">Muestra un item solo cuando otro item ya fue seleccionado en la cotizacion.</div>
        <form method="post" asp-page-handler="CreateRule" class="row g-2 mb-3">
            <div class="col-md-5">
                <label class="form-label">Item objetivo (se mostrara)</label>
                <select asp-for="Rule.TargetItemId" class="form-select">
                    <option value="">Seleccionar</option>
                    @foreach (var p in Model.ParentOptions)
                    {
                        <option value="@p.Id">@p.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Item requerido</label>
                <select asp-for="Rule.RequiredItemId" class="form-select">
                    <option value="">Seleccionar</option>
                    @foreach (var p in Model.ParentOptions)
                    {
                        <option value="@p.Id">@p.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid align-items-end">
                <button class="btn btn-primary mt-4" type="submit">Agregar regla</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Segmento</th>
                        <th>Mostrar</th>
                        <th>Cuando exista</th>
                        <th class="text-end">Accion</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Rules.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">Sin reglas por ahora.</td></tr>
                }
                else
                {
                    @foreach (var r in Model.Rules)
                    {
                        <tr>
                            <td>@Model.LabelSegment(r.Segment)</td>
                            <td>@r.TargetName</td>
                            <td>@r.RequiredName</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="DeleteRule" class="d-inline">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="catalogDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="catalogDetailTitle">Detalle de categoria</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="catalogDetailBody">
                <div class="text-muted">Sin datos.</div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cerrar</button>
                <button class="btn btn-primary" type="button" id="catalogDetailNewItem">+ Nuevo item</button>
            </div>
        </div>
    </div>
</div>

