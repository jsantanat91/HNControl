@page
@model HNControl.Web.Pages.Admin.Quotes.RequestsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin - Solicitudes de cotizacion";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Solicitudes de cotizacion</h1>
        <div class="text-muted small">Leads del kiosk y PDF generado.</div>
    </div>
    <a class="btn btn-outline-primary" asp-page="./Catalog">Catalogo</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<form method="get" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Buscar</label>
            <input class="form-control" name="q" value="@Model.Q" placeholder="Folio, nombre o correo" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Segmento</label>
            <select class="form-select" name="segment">
                <option value="">Todos</option>
                <option value="Residential" selected="@(Model.Segment == "Residential")">Residencial</option>
                <option value="Business" selected="@(Model.Segment == "Business")">Empresarial</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Estado</label>
            <select class="form-select" name="status">
                <option value="">Todos</option>
                <option value="New" selected="@(Model.Status == "New")">Nueva</option>
                <option value="Emailed" selected="@(Model.Status == "Emailed")">Enviada</option>
                <option value="EmailError" selected="@(Model.Status == "EmailError")">Error envio</option>
                <option value="Accepted" selected="@(Model.Status == "Accepted")">Aceptada</option>
                <option value="Rejected" selected="@(Model.Status == "Rejected")">Rechazada</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Desde</label>
            <input class="form-control" type="date" name="from" value="@Model.From" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Hasta</label>
            <input class="form-control" type="date" name="to" value="@Model.To" />
        </div>
        <div class="col-md-1 d-grid">
            <button class="btn btn-primary" type="submit">Filtrar</button>
        </div>
    </div>
</form>

<div class="vstack gap-3">
@foreach (var r in Model.Rows)
{
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                <div>
                    <div class="fw-bold">@r.Folio · @r.CustomerName</div>
                    <div class="text-muted small">@r.CustomerEmail · @r.CustomerPhone · @r.CustomerLocation</div>
                    <div class="small d-flex gap-1 flex-wrap">
                        <span>@r.CreatedAtLocal</span>
                        <span class="badge text-bg-light border">@r.SegmentLabel</span>
                        <span class="hn-chip @(r.Status == "Accepted" ? "hn-chip-status-up" : r.Status == "Rejected" ? "hn-chip-priority-critical" : "hn-chip-type")">@r.StatusLabel</span>
                        <span class="hn-chip @r.ValidityCss">@r.ValidityLabel</span>
                        @if (!string.IsNullOrWhiteSpace(r.AcceptedAtLocal) && r.Status == "Accepted")
                        {
                            <span class="text-muted">Aceptada: @r.AcceptedAtLocal</span>
                        }
                        @if (r.Status == "Rejected")
                        {
                            @if (r.IsRejectedAuto)
                            {
                                <span class="hn-chip hn-chip-neutral">Rechazo automático</span>
                                @if (!string.IsNullOrWhiteSpace(r.AcceptedAtLocal))
                                {
                                    <span class="text-muted">Vencida: @r.AcceptedAtLocal</span>
                                }
                            }
                            else if (r.IsRejectedManual)
                            {
                                <span class="hn-chip hn-chip-priority-critical">Rechazo manual</span>
                                @if (!string.IsNullOrWhiteSpace(r.AcceptedAtLocal))
                                {
                                    <span class="text-muted">Rechazada: @r.AcceptedAtLocal</span>
                                }
                            }
                        }
                    </div>
                </div>
                <div class="text-end">
                    <div><strong>Total estimado:</strong> @r.EstimatedTotal.ToString("C2")</div>
                    <div><span class="badge @(r.ManualItemsCount > 0 ? "text-bg-warning" : "text-bg-success")">Manual: @r.ManualItemsCount</span></div>
                    <a class="btn btn-sm btn-outline-dark mt-2" asp-page="/Projects/Sales/Index" asp-route-quoteId="@r.Id">Ventas</a>
                    @if (r.Status == "Accepted")
                    {
                        <a class="btn btn-sm btn-outline-success mt-2" asp-page="/Projects/Billing/Index" asp-route-quoteId="@r.Id">Facturacion</a>
                    }
                    @if (r.HasPdf)
                    {
                        <a class="btn btn-sm btn-outline-primary mt-2" asp-page="./Requests" asp-page-handler="DownloadPdf" asp-route-id="@r.Id">PDF</a>
                    }
                    @if (r.Status != "Accepted" && r.Status != "Rejected")
                    {
                        <div class="d-flex gap-2 justify-content-end mt-2">
                            <form method="post" asp-page-handler="Accept">
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="q" value="@Model.Q" />
                                <input type="hidden" name="segment" value="@Model.Segment" />
                                <input type="hidden" name="status" value="@Model.Status" />
                                <input type="hidden" name="from" value="@Model.From" />
                                <input type="hidden" name="to" value="@Model.To" />
                                <button type="submit" class="btn btn-sm btn-success">Aceptar</button>
                            </form>
                            <form method="post" asp-page-handler="Reject">
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="q" value="@Model.Q" />
                                <input type="hidden" name="segment" value="@Model.Segment" />
                                <input type="hidden" name="status" value="@Model.Status" />
                                <input type="hidden" name="from" value="@Model.From" />
                                <input type="hidden" name="to" value="@Model.To" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Rechazar</button>
                            </form>
                        </div>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Categoria</th>
                            <th>Servicio</th>
                            <th>Subproducto</th>
                            <th class="text-center">Cant</th>
                            <th class="text-center">Modalidad</th>
                            <th class="text-end">Costo</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var l in r.Lines)
                    {
                        <tr>
                            <td>@l.CategoryName</td>
                            <td>@l.ServiceName</td>
                            <td>@(string.IsNullOrWhiteSpace(l.SubproductName) ? "-" : l.SubproductName)</td>
                            <td class="text-center">@l.Quantity</td>
                            <td class="text-center">
                                <span class="badge text-bg-light border">
                                    @(l.OfferType == "MonthlyRent" ? "Renta mensual" : l.OfferType == "Lease" ? "Arrendamiento" : "Venta")
                                </span>
                            </td>
                            <td class="text-end">@(l.IsManualPrice ? "Manual" : $"{l.UnitPrice?.ToString("C2")} {(l.PriceIncludesVat ? "(IVA incl.)" : "+ IVA")}")</td>
                            <td class="text-end">@(l.IsManualPrice ? "Por validar" : l.LineTotal?.ToString("C2"))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="card"><div class="card-body text-muted">Sin solicitudes en este filtro.</div></div>
}
</div>
