@page
@model HNControl.Web.Pages.Admin.Quotes.RequestsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin - Cotizaciones";
    var canManage = Model.CanManage;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">@(canManage ? "Cotizaciones" : "Mis cotizaciones")</h1>
        <div class="text-muted small">Cotizaciones internas de ventas y PDF generado.</div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanCreate)
        {
            <button class="btn btn-primary" type="button" data-quote-modal-open="true" data-quote-modal-size="xl" onclick="return false;">+ Nueva cotización</button>
        }
        @if (User.IsInRole(HNControl.Web.Models.AppRoles.SuperAdmin) || canManage)
        {
            <a class="btn btn-outline-primary" asp-page="./Catalog">Catálogo</a>
        }
    </div>
</div>

@{
    var activeSelected = string.IsNullOrWhiteSpace(Model.Status) && string.Equals(Model.ViewMode, "active", StringComparison.OrdinalIgnoreCase);
    var acceptedSelected = string.IsNullOrWhiteSpace(Model.Status) && string.Equals(Model.ViewMode, "accepted", StringComparison.OrdinalIgnoreCase);
    var rejectedSelected = string.IsNullOrWhiteSpace(Model.Status) && string.Equals(Model.ViewMode, "rejected", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex gap-2 flex-wrap mb-3">
    <a class="btn btn-sm @(activeSelected ? "btn-primary" : "btn-outline-primary")"
       asp-page="./Requests"
       asp-route-view="active"
       asp-route-month="@Model.Month"
       asp-route-q="@Model.Q"
       asp-route-segment="@Model.Segment">Activas</a>
    <a class="btn btn-sm @(acceptedSelected ? "btn-success" : "btn-outline-success")"
       asp-page="./Requests"
       asp-route-view="accepted"
       asp-route-month="@Model.Month"
       asp-route-q="@Model.Q"
       asp-route-segment="@Model.Segment">Aceptadas</a>
    <a class="btn btn-sm @(rejectedSelected ? "btn-danger" : "btn-outline-danger")"
       asp-page="./Requests"
       asp-route-view="rejected"
       asp-route-month="@Model.Month"
       asp-route-q="@Model.Q"
       asp-route-segment="@Model.Segment">Rechazadas</a>
    <span class="text-muted small align-self-center ms-2">Mostrando @Model.TotalCount cotizaciones del mes.</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<form method="get" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <input type="hidden" name="view" value="@Model.ViewMode" />
        <div class="col-md-4"><label class="form-label">Buscar</label><input class="form-control" name="q" value="@Model.Q" placeholder="Folio, nombre o correo" /></div>
        <div class="col-md-3">
            <label class="form-label">Segmento</label>
            <select class="form-select" name="segment">
                <option value="">Todos</option>
                <option value="Residential" selected="@(Model.Segment == "Residential")">Residencial</option>
                <option value="Business" selected="@(Model.Segment == "Business")">Empresarial</option>
                <option value="Events" selected="@(Model.Segment == "Events")">Eventos</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Mes</label>
            <input class="form-control" type="month" name="month" value="@Model.Month" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-primary" type="submit">Filtrar</button>
        </div>
    </div>
</form>

<div class="row g-2">
@foreach (var r in Model.Rows)
{
    <div class="col-12 col-xl-6">
        <div class="card shadow-soft hn-hover h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">@r.Folio · @r.CustomerName</div>
                        <div class="small text-muted">@r.CustomerEmail · @r.CreatedAtLocal</div>
                        <div class="small d-flex gap-1 flex-wrap mt-1">
                            <span class="badge text-bg-light border">@r.SegmentLabel</span>
                            <span class="hn-chip @(r.Status == "Accepted" ? "hn-chip-status-up" : r.Status == "Rejected" ? "hn-chip-priority-critical" : "hn-chip-type")">@r.StatusLabel</span>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-semibold">@r.EstimatedTotal.ToString("C2")</div>
                        <div class="small text-muted">Items: @r.Lines.Count</div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="modal" data-bs-target="#quoteDetailModal-@r.Id">Ver detalle</button>
                    @if (canManage && r.Status != "Accepted" && r.Status != "Rejected")
                    {
                        <a class="btn btn-sm btn-outline-secondary"
                           href="/cotizar?editId=@r.Id"
                           data-quote-modal-open="true"
                           data-quote-modal-size="xl">
                            Editar
                        </a>
                    }
                    @if (r.HasPdf)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-page="./Requests" asp-page-handler="DownloadPdf" asp-route-id="@r.Id">PDF</a>
                    }
                    @if (canManage && r.Status != "Accepted" && r.Status != "Rejected")
                    {
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('¿Eliminar esta cotización?');">
                            <input type="hidden" name="id" value="@r.Id" />
                            <input type="hidden" name="page" value="@Model.PageNumber" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    }
                    else if (canManage && (r.Status == "Accepted" || r.Status == "Rejected"))
                    {
                        <form method="post" asp-page-handler="Reopen">
                            <input type="hidden" name="id" value="@r.Id" />
                            <input type="hidden" name="page" value="@Model.PageNumber" />
                            <button type="submit" class="btn btn-sm btn-outline-warning">Reabrir</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="quoteDetailModal-@r.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                <h5 class="modal-title">@r.Folio · @r.CustomerName</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="small text-muted mb-2">@r.CustomerEmail · @r.CustomerPhone · @r.CustomerLocation</div>
                    <div class="d-flex justify-content-end gap-2 mb-2">
                        @if (canManage && r.Status != "Accepted" && r.Status != "Rejected")
                        {
                            <a class="btn btn-sm btn-outline-secondary"
                               href="/cotizar?editId=@r.Id"
                               data-quote-modal-open="true"
                               data-quote-modal-size="xl">
                                Editar
                            </a>
                        }
                        @if (r.HasPdf)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-page="./Requests" asp-page-handler="DownloadPdf" asp-route-id="@r.Id">Descargar PDF</a>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr><th>Categoría</th><th>Servicio</th><th>Subproducto</th><th class="text-center">Cant</th><th class="text-center">Modalidad</th><th class="text-end">Costo unit. (sin IVA)</th><th class="text-end">Subtotal (sin IVA)</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var l in r.Lines)
                            {
                                <tr>
                                    <td>@l.CategoryName</td>
                                    <td>@l.ServiceName</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.SubproductName) ? "-" : l.SubproductName)</td>
                                    <td class="text-center">@l.Quantity</td>
                                    <td class="text-center"><span class="badge text-bg-light border">@(l.OfferType == "MonthlyRent" ? "Renta mensual" : l.OfferType == "Lease" ? "Arrendamiento" : "Venta")</span></td>
                                    @{
                                        var qty = l.Quantity <= 0 ? 1 : l.Quantity;
                                        var unit = l.UnitPrice ?? 0m;
                                        var lineTotal = l.LineTotal ?? (unit * qty);
                                        var unitNoVat = l.PriceIncludesVat ? (unit / 1.16m) : unit;
                                        var subtotalNoVat = l.PriceIncludesVat ? (lineTotal / 1.16m) : (unit * qty);
                                    }
                                    <td class="text-end">
                                        @(l.IsManualPrice
                                            ? "Manual"
                                            : l.PriceIncludesVat
                                                ? unitNoVat.ToString("C2")
                                                : unit.ToString("C2"))
                                    </td>
                                    <td class="text-end">@(l.IsManualPrice ? "Por validar" : subtotalNoVat.ToString("C2"))</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
</div>

@if (!Model.Rows.Any())
{
    <div class="card mt-3"><div class="card-body text-muted">Sin cotizaciones en este filtro.</div></div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm">
        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link"
                   asp-page="./Requests"
                   asp-route-page="@i"
                   asp-route-q="@Model.Q"
                   asp-route-segment="@Model.Segment"
                   asp-route-view="@Model.ViewMode"
                   asp-route-month="@Model.Month"
                   asp-route-status="@Model.Status">@i</a>
            </li>
        }
    </ul></nav>
}

