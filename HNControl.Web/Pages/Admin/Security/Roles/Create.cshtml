@page
@model HNControl.Web.Pages.Admin.Security.Roles.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nuevo rol de permisos";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Nuevo rol de permisos</h1>
    <a class="btn btn-outline-secondary" asp-page="./Index">Volver</a>
</div>

<form method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input class="form-control" asp-for="Input.Name" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Descripción</label>
                <input class="form-control" asp-for="Input.Description" />
            </div>

            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input class="form-check-input" asp-for="Input.IsDefault" />
                    <label class="form-check-label">Marcar como Default</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input class="form-check-input" asp-for="Input.IsActive" />
                    <label class="form-check-label">Activo</label>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <h2 class="h6 mb-2">Módulos permitidos</h2>
        <div class="text-muted small mb-3">Selecciona las pestañas a las que el Employee puede entrar (la navegación se ajusta sola).</div>

        <div class="row row-cols-1 row-cols-lg-2 g-2">
        @foreach (var m in Model.Modules)
        {
            var id = $"m_{m.Key}";
            <div class="col">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Input.SelectedModules" id="@id" value="@m.Key"
                           @(Model.Input.SelectedModules.Contains(m.Key, StringComparer.OrdinalIgnoreCase) ? "checked" : "") />
                    <label class="form-check-label" for="@id">@m.Label</label>
                </div>
            </div>
        }
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
