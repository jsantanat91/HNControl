@page
@model HNControl.Web.Pages.Admin.Security.Roles.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Seguridad · Roles de permisos";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h4 mb-1">Roles de permisos por módulo</h1>
        <div class="text-muted">Controla el acceso de empleados por módulo con diseño de roles reutilizables.</div>
    </div>
    <a class="btn btn-primary" asp-page="./Create">Nuevo rol</a>
</div>

<div class="row g-3">
    @foreach (var r in Model.Roles)
    {
        <div class="col-12 col-lg-6">
            <div class="card shadow-soft h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                        <div>
                            <div class="fw-semibold fs-5">@r.Name</div>
                            <div class="text-muted small">@r.Description</div>
                        </div>
                        <span class="hn-chip hn-chip-info">@r.ModulesCount módulo(s)</span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="hn-chip @(r.IsDefault ? "hn-chip-ok" : "hn-chip-neutral")">
                            @(r.IsDefault ? "Default" : "No default")
                        </span>
                        <span class="hn-chip @(r.IsActive ? "hn-chip-ok" : "hn-chip-danger")">
                            @(r.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@r.Id">Editar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card shadow-soft mt-3">
    <div class="card-body small text-muted">
        Tip rápido: el rol global Admin/SuperAdmin ignora estos permisos. Aplican para usuarios en rol <strong>Employee</strong>.
    </div>
</div>

