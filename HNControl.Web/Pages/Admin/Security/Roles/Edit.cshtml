@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Security.Roles.EditModel
@{
    ViewData["Title"] = "Editar rol de permisos";
}

<div class="container-xxl py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">@ViewData["Title"]</h2>
            <div class="text-muted">Ajusta modulos, acciones y estado del rol.</div>
        </div>
        <a class="btn btn-outline-secondary" asp-page="./Index">Volver</a>
    </div>

    @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-danger">@err</div>
    }
    @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="alert alert-success">@ok</div>
    }

    <form method="post" class="card shadow-soft border-0">
        <div class="card-body p-4">
            <input type="hidden" asp-for="Input.Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" asp-for="Input.Name" maxlength="80" />
                    <span class="text-danger small" asp-validation-for="Input.Name"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Activo</label>
                    <select class="form-select" asp-for="Input.IsActive">
                        <option value="true">Si</option>
                        <option value="false">No</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Descripcion</label>
                    <textarea class="form-control" asp-for="Input.Description" rows="2" maxlength="400"></textarea>
                    <span class="text-danger small" asp-validation-for="Input.Description"></span>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="Input.IsDefault" />
                        <label class="form-check-label" asp-for="Input.IsDefault">Rol por defecto (empleados nuevos)</label>
                    </div>
                    <div class="text-muted small">Si lo marcas como default, se desmarca automaticamente en los demas.</div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="mb-0">Modulos permitidos</h5>
                <div class="text-muted small">Marca lo que el empleado podra ver/usar.</div>
            </div>

            @foreach (var group in Model.ModuleGroups)
            {
                <div class="border rounded-3 p-2 mb-2">
                    <div class="fw-semibold mb-2">@group.Name</div>
                    <div class="row g-2">
                        @foreach (var opt in group.Items)
                        {
                            var key = opt.Value ?? "";
                            var isChecked = Model.Input.SelectedModules?.Any(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase)) == true;

                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="d-flex align-items-center gap-2 border rounded-3 p-2 role-module-item" style="cursor:pointer;">
                                    <input class="form-check-input m-0"
                                           type="checkbox"
                                           name="Input.SelectedModules"
                                           value="@key"
                                           @(isChecked ? "checked" : "") />
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@opt.Text</span>
                                        <span class="text-muted small">@key</span>
                                    </div>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }

            <hr class="my-4" />
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="mb-0">Matriz CRUD por submodulo</h5>
                <div class="text-muted small">Ver, Crear, Editar y Aprobar por submodulo. Si marcas Editar/Crear/Aprobar, se marca Ver en automático.</div>
            </div>

            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Area</th>
                            <th>Submodulo</th>
                            <th class="text-center">Ver</th>
                            <th class="text-center">Crear</th>
                            <th class="text-center">Editar</th>
                            <th class="text-center">Aprobar</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.CrudMatrix)
                    {
                        <tr>
                            <td class="text-muted small">@row.Area</td>
                            <td>@row.Label</td>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(row.ViewKey))
                                {
                                    var key = row.ViewKey!;
                                    var chk = Model.Input.SelectedActions?.Any(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase)) == true;
                                    <input class="form-check-input perm-action-check" type="checkbox" name="Input.SelectedActions" value="@key" @(chk ? "checked" : "") />
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(row.CreateKey))
                                {
                                    var key = row.CreateKey!;
                                    var chk = Model.Input.SelectedActions?.Any(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase)) == true;
                                    <input class="form-check-input perm-action-check" type="checkbox" name="Input.SelectedActions" value="@key" @(chk ? "checked" : "") />
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(row.EditKey))
                                {
                                    var key = row.EditKey!;
                                    var chk = Model.Input.SelectedActions?.Any(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase)) == true;
                                    <input class="form-check-input perm-action-check" type="checkbox" name="Input.SelectedActions" value="@key" @(chk ? "checked" : "") />
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(row.ApproveKey))
                                {
                                    var key = row.ApproveKey!;
                                    var chk = Model.Input.SelectedActions?.Any(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase)) == true;
                                    <input class="form-check-input perm-action-check" type="checkbox" name="Input.SelectedActions" value="@key" @(chk ? "checked" : "") />
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <details class="mb-3">
                <summary class="fw-semibold">Permisos avanzados por accion</summary>
                <div class="text-muted small mb-2">Opcional para ajustes especiales fuera de la matriz.</div>

            @foreach (var group in Model.ActionGroups)
            {
                <div class="border rounded-3 p-2 mb-2">
                    <div class="fw-semibold mb-2">@group.Name</div>
                    <div class="row g-2">
                        @foreach (var opt in group.Items)
                        {
                            var key = opt.Value ?? "";
                            var isChecked = Model.Input.SelectedActions?.Any(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase)) == true;

                            <div class="col-12 col-md-6">
                                <label class="d-flex align-items-center gap-2 border rounded-3 p-2 role-action-item" style="cursor:pointer;">
                                    <input class="form-check-input m-0 perm-action-check"
                                           type="checkbox"
                                           name="Input.SelectedActions"
                                           value="@key"
                                           @(isChecked ? "checked" : "") />
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@opt.Text</span>
                                        <span class="text-muted small">@key</span>
                                    </div>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }
            </details>

            <hr class="my-4" />
            <h5 class="mb-2">Simular menu (antes de guardar)</h5>
            <div class="text-muted small mb-2">Vista rapida del menu que veria el empleado con los checks actuales.</div>
            <div class="border rounded-3 p-3 bg-light-subtle">
                <ul id="menuPreview" class="mb-0 small"></ul>
            </div>
        </div>

        <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2 p-3">
            <a class="btn btn-outline-secondary" asp-page="./Index">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const preview = document.getElementById('menuPreview');
            const allActionChecks = () => Array.from(document.querySelectorAll('input[name="Input.SelectedActions"]'));
            const checks = () => allActionChecks().filter(x => x.checked).map(x => x.value);
            const has = (arr, key) => arr.includes(key);
            const deps = {
                'Clients.Edit': ['Clients.View'],
                'Projects.Edit': ['Projects.View'],
                'Projects.Investments.Edit': ['Projects.Investments.View'],
                'Projects.Resellers.Edit': ['Projects.Resellers.View'],
                'Projects.Delivery.Edit': ['Projects.Delivery.View'],
                'Sales.Manage': ['Sales.ViewAll'],
                'Sales.Workflow.Move': ['Sales.ViewOwn'],
                'Sales.Workflow.Assign': ['Sales.Workflow.Move', 'Sales.ViewOwn'],
                'Sales.Quotes.Manage': ['Sales.Quotes.View'],
                'Sales.Catalog.Manage': ['Sales.Catalog.View'],
                'Sales.Prospects.Create': ['Sales.Prospects.View'],
                'Sales.Prospects.Edit': ['Sales.Prospects.View'],
                'Sales.Prospects.Convert': ['Sales.Prospects.Edit', 'Sales.Prospects.View'],
                'Employees.OrgChart.Edit': ['Employees.OrgChart.View'],
                'Employees.OrgChart.Export': ['Employees.OrgChart.View'],
                'Billing.Manage': ['Billing.ViewOwn'],
                'Billing.Send': ['Billing.Manage', 'Billing.ViewOwn'],
                'Inventory.Manage': ['Inventory.View'],
                'Inventory.Approve': ['Inventory.Manage', 'Inventory.View'],
                'Carriers.Manage': ['Carriers.View'],
                'Monitoring.Manage': ['Monitoring.View'],
                'Tickets.Manage': ['Tickets.View'],
                'Tickets.Close': ['Tickets.Manage', 'Tickets.View']
            };
            function enforceDependencies(source) {
                if (!source.checked) return;
                const queue = [source.value];
                while (queue.length) {
                    const key = queue.shift();
                    const req = deps[key] || [];
                    req.forEach(need => {
                        const checkbox = allActionChecks().find(x => x.value === need);
                        if (checkbox && !checkbox.checked) {
                            checkbox.checked = true;
                            queue.push(need);
                        }
                    });
                }
            }
            function render() {
                const a = checks();
                const out = [];
                if (has(a, 'Clients.View')) out.push('Clientes');
                if (has(a, 'Projects.View')) out.push('Proyectos > Base');
                if (has(a, 'Projects.Investments.View')) out.push('Proyectos > Inversiones');
                if (has(a, 'Projects.Resellers.View')) out.push('Proyectos > Reseller');
                if (has(a, 'Projects.Delivery.View')) out.push('Proyectos > Formato de entrega');
                if (has(a, 'Sales.ViewOwn') || has(a, 'Sales.ViewAll')) out.push('Ventas > Dashboard');
                if (has(a, 'Sales.Workflow.Move') || has(a, 'Sales.Workflow.Assign')) out.push('Ventas > Workflow');
                if (has(a, 'Sales.Manage') || has(a, 'Sales.ViewAll')) out.push('Ventas > Gestion');
                if (has(a, 'Sales.Quotes.View')) out.push('Ventas > Cotizaciones');
                if (has(a, 'Sales.Catalog.View')) out.push('Ventas > Catálogo');
                if (has(a, 'Sales.Prospects.View')) out.push('Ventas > Prospectos');
                if (has(a, 'Billing.ViewOwn') || has(a, 'Billing.ViewAll')) out.push('Facturacion');
                if (has(a, 'Employees.OrgChart.View')) out.push('Empleados > Organigrama');
                if (has(a, 'Inventory.View')) out.push('Inventario');
                if (has(a, 'Tickets.View')) out.push('Tickets');
                if (has(a, 'Carriers.View')) out.push('Carriers');
                if (has(a, 'Monitoring.View')) out.push('Carriers > Monitoreo');
                preview.innerHTML = out.length ? out.map(x => `<li>${x}</li>`).join('') : '<li class="text-muted">Sin accesos visibles con la configuracion actual.</li>';
            }
            allActionChecks().forEach(c => c.addEventListener('change', () => { enforceDependencies(c); render(); }));
            allActionChecks().forEach(c => { if (c.checked) enforceDependencies(c); });
            render();
        })();
    </script>
}

<style>
    .role-module-item:hover, .role-action-item:hover {
        box-shadow: 0 .25rem .75rem rgba(0,0,0,.08);
        transition: box-shadow .15s ease-in-out;
    }
</style>
