@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Viaticos.WeekModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Viáticos · Revisión";
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-success">@Model.Info</div>
}

@if (Model.Week == null)
{
    <div class="alert alert-info">No se encontró la semana.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Revisión de viáticos</h1>
        <div class="text-muted small">
            Empleado: <strong>@(Model.Week.EmployeeProfile?.FullName ?? Model.Week.UserId)</strong>
            · Semana: <strong>@Model.Week.WeekStartDate.ToString("yyyy-MM-dd")</strong>
            · Estado: <strong>@Model.Week.Status</strong>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Viaticos/Index">Volver</a>
        <a class="btn btn-outline-primary" asp-page="/Admin/Viaticos/ExportWeek" asp-route-id="@Model.Week.Id">Exportar CSV</a>

        @if (Model.Week.Status == HNControl.Web.Models.ViaticWeekStatus.Submitted)
        {
            <form method="post" asp-page-handler="Approve" class="d-inline">
                <input type="hidden" name="id" value="@Model.Week.Id" />
                <button class="btn btn-success" type="submit" onclick="return confirm('¿Aprobar esta semana?');">Aprobar</button>
            </form>

            <form method="post" asp-page-handler="Reject" class="d-inline">
                <input type="hidden" name="id" value="@Model.Week.Id" />
                <input class="form-control form-control-sm d-inline" style="width: 260px" name="reason" placeholder="Motivo del rechazo" required />
                <button class="btn btn-outline-danger" type="submit" onclick="return confirm('¿Rechazar esta semana?');">Rechazar</button>
            </form>
        }
    </div>
</div>

@{ var nonBillable = Math.Max(0m, Model.Week.TotalAmount - Model.Week.BillableAmount); }

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">Total semana</div>
                <div class="fs-4 fw-semibold">@Model.Week.TotalAmount.ToString("0.00")</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">Facturable</div>
                <div class="fs-4 fw-semibold">@Model.Week.BillableAmount.ToString("0.00")</div>
                <div class="text-muted small">Reembolso esperado</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">No facturable</div>
                <div class="fs-4 fw-semibold">@nonBillable.ToString("0.00")</div>
                <div class="text-muted small">Gasto absorbido / no deducible</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">Flujo</div>
                <div class="small">
                    Enviado: <strong>@(Model.Week.SubmittedAt.HasValue ? Model.Week.SubmittedAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")</strong><br />
                    Aprobado: <strong>@(Model.Week.ApprovedAt.HasValue ? Model.Week.ApprovedAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm hn-hover hn-hover hn-hover">
    <div class="card-header fw-semibold">Gastos (desglose por día)</div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Día</th>
                    <th>Categoría</th>
                    <th>Descripción</th>
                    <th class="text-end">Monto</th>
                    <th class="text-center">Facturable</th>
                    <th>Comprobante</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Week.Entries.OrderBy(x => x.DayDate).ThenBy(x => x.Category))
                {
                    <tr>
                        <td>@e.DayDate.ToString("yyyy-MM-dd")</td>
                        <td>@e.Category</td>
                        <td>@e.Description</td>
                        <td class="text-end">@e.Amount.ToString("0.00")</td>
                        <td class="text-center">@(e.IsBillable ? "Sí" : "No")</td>
                        <td>
                            @if (e.Attachment != null)
                            {
                                <a asp-page="/Viaticos/Download" asp-route-attachmentId="@e.Attachment.Id">@e.Attachment.OriginalFileName</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Week.AdminNotes))
    {
        <div class="card-footer">
            <div class="text-muted small">Nota admin (rechazo):</div>
            <div>@Model.Week.AdminNotes</div>
        </div>
    }
</div>
