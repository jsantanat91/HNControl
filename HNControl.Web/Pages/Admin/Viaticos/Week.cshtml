@page "{id:guid}"
@model HNControl.Web.Pages.Admin.Viaticos.WeekModel
@{
    Layout = "_Layout";
}

@if (Model.Week == null)
{
    <div class="alert alert-danger">Semana no encontrada.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Admin · @Model.EmployeeName</h1>
        <div class="text-muted small">
            Semana (lunes): @Model.Week.WeekStartDate.ToString("yyyy-MM-dd")
            · Status: <span class="fw-semibold">@Model.Week.Status</span>
            @if (Model.Week.ApprovedAt != null)
            {
                <span class="text-muted">· Aprobado: @Model.Week.ApprovedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Viaticos/Index">Volver</a>

        <a class="btn btn-outline-primary"
           asp-page="/Admin/Viaticos/ExportWeek"
           asp-route-id="@Model.Week.Id">
            Exportar Excel
        </a>

        <form method="post" asp-page-handler="Approve" class="d-inline">
            <input type="hidden" name="id" value="@Model.Week.Id" />
            <button class="btn btn-success" type="submit" @(Model.CanApprove ? "" : "disabled")>
                Aprobar
            </button>
        </form>

        <form method="post" asp-page-handler="Reject" class="d-inline">
            <input type="hidden" name="id" value="@Model.Week.Id" />
            <button class="btn btn-outline-danger" type="submit" @(Model.CanReject ? "" : "disabled")>
                Rechazar
            </button>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

@foreach (var day in Model.Days)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold">@day.Date.ToString("dddd dd MMM yyyy")</div>
        <div class="card-body table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Categoría</th>
                        <th>Descripción</th>
                        <th class="text-end">Monto</th>
                        <th>Facturable</th>
                        <th>PDF</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!day.Entries.Any())
                    {
                        <tr><td colspan="5" class="text-muted">Sin gastos</td></tr>
                    }
                    else
                    {
                        foreach (var e in day.Entries)
                        {
                            <tr>
                                <td>@e.Category</td>
                                <td>@e.Description</td>
                                <td class="text-end">@e.Amount.ToString("C")</td>
                                <td>@(e.IsBillable ? "Sí" : "No")</td>
                                <td>
                                    @if (e.AttachmentId != null)
                                    {
                                        <a asp-page="/Viaticos/Download" asp-route-attachmentId="@e.AttachmentId">Descargar</a>
                                    }
                                    else
                                    {

                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" class="text-end fw-semibold">Total día</td>
                        <td class="text-end fw-semibold">@day.Total.ToString("C")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body d-flex justify-content-between">
        <div class="text-muted">Total semana</div>
        <div class="fw-bold">@Model.WeekTotal.ToString("C")</div>
    </div>
</div>
