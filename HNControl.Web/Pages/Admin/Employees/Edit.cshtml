@page "{userId}"
@model HNControl.Web.Pages.Admin.Employees.EditModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar empleado";
}

@if (Model.Employee == null)
{
    <div class="alert alert-warning">Empleado no encontrado.</div>
    return;
}

<h1 class="h4 mb-3">Editar empleado</h1>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

<form method="post" class="card shadow-sm hn-hover">
    <div class="card-body">
        <input type="hidden" asp-for="Input.UserId" />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input class="form-control" asp-for="Input.FullName" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Puesto</label>
                <input class="form-control" asp-for="Input.Position" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Sexo</label>
                <select class="form-select" asp-for="Input.Sex">
                    <option value="">—</option>
                    <option value="Hombre">Hombre</option>
                    <option value="Mujer">Mujer</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Teléfono</label>
                <input class="form-control" asp-for="Input.Phone" />
            </div>

            <div class="col-md-4">
                <label class="form-label">NSS</label>
                <input class="form-control" asp-for="Input.Nss" />
            </div>

            <div class="col-md-4">
                <label class="form-label">CURP</label>
                <input class="form-control text-uppercase" asp-for="Input.Curp" maxlength="18" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Fecha de nacimiento</label>
                <input class="form-control" asp-for="Input.BirthDate" type="date" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Fecha de ingreso (antigüedad)</label>
                <input class="form-control" asp-for="Input.HireDate" type="date" />
            </div>

            <div class="col-12">
                <label class="form-label">Dirección</label>
                <input class="form-control" asp-for="Input.Address" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Correo (login)</label>
                <input class="form-control" asp-for="Input.Email" type="email" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Sueldo base mensual</label>
                <input class="form-control" asp-for="Input.SalaryBase" type="number" step="0.01" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Rol (acceso global)</label>
                <select class="form-select" asp-for="Input.AppRole">
                    <option value="Employee">Employee</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Rol de permisos por módulo</label>
                <select class="form-select" asp-for="Input.PermissionRoleId" asp-items="Model.PermissionRoleOptions">
                    <option value="">(sin asignar)</option>
                </select>
                <div class="form-text">Solo aplica a Employee. Se gestiona en <a asp-page="/Admin/Security/Roles/Index">Seguridad</a>.</div>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Employees/Details" asp-route-userId="@Model.Employee.UserId">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
