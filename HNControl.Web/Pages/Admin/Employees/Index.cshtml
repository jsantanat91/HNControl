@page
@model HNControl.Web.Pages.Admin.Employees.IndexModel
@{
    ViewData["Title"] = "Empleados";

    var total = Model.Rows.Count;
    var avgSalary = total > 0 ? Model.Rows.Average(x => x.SalaryBase) : 0m;
    var view = (Request.Query["view"].ToString() ?? "").Trim().ToLowerInvariant();
    var isTable = view == "table";
    var includeInactive = string.Equals(Request.Query["includeInactive"], "true", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Empleados</h1>
        <div class="text-muted small">Alta, edici&oacute;n y ficha.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="./OrgChart">Organigrama</a>
        <a class="btn btn-outline-secondary btn-sm @(includeInactive ? "active" : "")" asp-page="./Index" asp-route-view="@(isTable ? "table" : "cards")" asp-route-includeInactive="true">Ver bajas</a>
        <a class="btn btn-outline-secondary btn-sm @(!includeInactive ? "active" : "")" asp-page="./Index" asp-route-view="@(isTable ? "table" : "cards")" asp-route-includeInactive="false">Solo activos</a>
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm @(isTable ? "" : "active")" asp-page="./Index" asp-route-view="cards" asp-route-includeInactive="@includeInactive">Cards</a>
            <a class="btn btn-outline-secondary btn-sm @(isTable ? "active" : "")" asp-page="./Index" asp-route-view="table" asp-route-includeInactive="@includeInactive">Tabla</a>
        </div>
        <a class="btn btn-primary" href="/Admin/Employees/Create">+ Nuevo</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.FlashOk))
{
    <div class="alert alert-success">@Model.FlashOk</div>
}
@if (!string.IsNullOrWhiteSpace(Model.FlashError))
{
    <div class="alert alert-danger">@Model.FlashError</div>
}

<div class="row g-3 mb-3">
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Total empleados</div><div class="fs-4 fw-bold">@total</div></div></div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Sueldo promedio</div><div class="fs-4 fw-bold">@avgSalary.ToString("C")</div></div></div>
    </div>
</div>

@if (!Model.Rows.Any())
{
    <div class="alert alert-light border">No hay empleados registrados.</div>
}
else if (!isTable)
{
    <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
        @foreach (var r in Model.Rows)
        {
            var initials = string.Join("", (r.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x.Substring(0, 1))).ToUpperInvariant();
            var photoUrl = Url.Page("/Admin/Employees/Details", "Photo", new { userId = r.UserId });
            <div class="col d-flex">
                <div class="card shadow-soft hn-hover w-100 hn-emp-card">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-start gap-3">
                            @if (r.HasPhoto)
                            {
                                <img class="hn-emp-avatar-img" src="@photoUrl" alt="Foto @r.FullName" />
                            }
                            else
                            {
                                <div class="hn-emp-avatar">@(string.IsNullOrWhiteSpace(initials) ? "EM" : initials)</div>
                            }
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-bold fs-5 lh-sm">@r.FullName</div>
                                <div class="text-muted small text-truncate">@r.Email</div>
                            </div>
                        </div>

                        <div class="mt-3 small">
                            <div><span class="text-muted">Puesto:</span> <span class="fw-semibold">@r.Position</span></div>
                            <div class="mt-1"><span class="text-muted">Sueldo:</span> <span class="fw-bold">@r.SalaryBase.ToString("C")</span></div>
                            @if (r.IsInventoryManager)
                            {
                                <div class="mt-2"><span class="hn-badge hn-badge-blue">Encargado de inventario</span></div>
                            }
                            <div class="mt-2">
                                @if (r.IsActive)
                                {
                                    <span class="hn-badge hn-badge-green">Activo</span>
                                }
                                else
                                {
                                    <span class="hn-badge hn-badge-red">Baja</span>
                                }
                            </div>
                        </div>

                        <div class="mt-auto pt-3 d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="./Details" asp-route-userId="@r.UserId">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-userId="@r.UserId">Editar</a>
                            @if (r.IsActive)
                            {
                                <form method="post" asp-page-handler="Deactivate" class="d-inline">
                                    <input type="hidden" name="userId" value="@r.UserId" />
                                    <input type="hidden" name="includeInactive" value="true" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('¿Dar de baja a este empleado?');">Baja</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Activate" class="d-inline">
                                    <input type="hidden" name="userId" value="@r.UserId" />
                                    <input type="hidden" name="includeInactive" value="true" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Reactivar</button>
                                </form>

                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                    <input type="hidden" name="userId" value="@r.UserId" />
                                    <input type="hidden" name="includeInactive" value="true" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Eliminar definitivamente. Solo aplica si no tiene historial. ¿Continuar?');">Eliminar</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card shadow-soft hn-hover">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Puesto</th>
                            <th>Inventario</th>
                            <th>Estatus</th>
                            <th class="text-end">Sueldo</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td class="fw-semibold">@r.FullName</td>
                                <td>@r.Email</td>
                                <td>@r.Position</td>
                                <td>
                                    @if (r.IsInventoryManager)
                                    {
                                        <span class="hn-badge hn-badge-blue">Encargado</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (r.IsActive)
                                    {
                                        <span class="hn-badge hn-badge-green">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="hn-badge hn-badge-red">Baja</span>
                                    }
                                </td>
                                <td class="text-end">@r.SalaryBase.ToString("C")</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="./Details" asp-route-userId="@r.UserId">Ver</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-userId="@r.UserId">Editar</a>
                                    @if (r.IsActive)
                                    {
                                        <form method="post" asp-page-handler="Deactivate" class="d-inline">
                                            <input type="hidden" name="userId" value="@r.UserId" />
                                            <input type="hidden" name="includeInactive" value="true" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('¿Dar de baja a este empleado?');">Baja</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Activate" class="d-inline">
                                            <input type="hidden" name="userId" value="@r.UserId" />
                                            <input type="hidden" name="includeInactive" value="true" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Reactivar</button>
                                        </form>

                                        <form method="post" asp-page-handler="Delete" class="d-inline">
                                            <input type="hidden" name="userId" value="@r.UserId" />
                                            <input type="hidden" name="includeInactive" value="true" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Eliminar definitivamente. Solo aplica si no tiene historial. ¿Continuar?');">Eliminar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Styles {
    <style>
        .hn-emp-card {
            border-radius: 18px !important;
            background: linear-gradient(150deg, rgba(255,255,255,.96), rgba(248,251,255,.90));
            min-height: 210px;
        }

        .hn-emp-avatar {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            color: #1e40af;
            background: rgba(37,99,235,.12);
            border: 1px solid rgba(37,99,235,.25);
            flex: 0 0 auto;
        }

        .hn-emp-avatar-img {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            object-fit: cover;
            border: 1px solid rgba(37,99,235,.25);
            flex: 0 0 auto;
        }
    </style>
}
