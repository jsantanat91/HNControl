@page
@model HNControl.Web.Pages.Admin.Employees.Deductions.IndexModel
@using HNControl.Web.Models
@{
    ViewData["Title"] = "Ajustes";
    var activeCount = Model.Items.Count(x => x.IsActive);
    var inactiveCount = Model.Items.Count(x => !x.IsActive);
    var netImpact = Model.BonusTotal - Model.DeductTotal;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Ajustes de n&oacute;mina</h1>
        <div class="text-muted small">@Model.Employee?.FullName</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Employees/Details" asp-route-id="@Model.UserId">Volver</a>
        <a class="btn btn-outline-primary" asp-page="/Admin/Employees/PayrollReceipt" asp-route-userId="@Model.UserId">Recibo PDF (quincena)</a>
        <a class="btn btn-primary" asp-page="Create" asp-route-userId="@Model.UserId">Nuevo ajuste</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Activos</div><div class="h4 mb-0">@activeCount</div></div></div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Inactivos</div><div class="h4 mb-0">@inactiveCount</div></div></div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Deducci&oacute;n por periodo</div><div class="h4 mb-0">@Model.DeductTotal.ToString("C")</div></div></div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card shadow-soft hn-hover h-100"><div class="card-body"><div class="text-muted small">Impacto neto</div><div class="h4 mb-0 @(netImpact >= 0 ? "text-success" : "text-warning-emphasis")">@netImpact.ToString("C")</div></div></div>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-light border">Sin ajustes todav&iacute;a.</div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-3">
        @foreach (var d in Model.Items)
        {
            var directionClass = d.Direction == EmployeeDeductionDirection.Bonus ? "hn-badge-green" : "hn-badge-amber";
            var statusClass = d.IsActive ? "hn-badge-blue" : "hn-badge-slate";
            var hasProgress = d.PaidPeriodsView.HasValue && d.TotalPeriodsView.HasValue && d.TotalPeriodsView.Value > 0;
            var progressPct = hasProgress ? Math.Round((d.PaidPeriodsView!.Value * 100m) / d.TotalPeriodsView!.Value, 0) : 0;

            <div class="col d-flex">
                <div class="card shadow-soft hn-hover w-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="fw-semibold fs-5">@d.Concept</div>
                                <div class="small text-muted">@d.Type.GetDisplayName() &middot; @d.Mode.GetDisplayName()</div>
                            </div>
                            <div class="text-end">
                                <span class="hn-badge @statusClass">@(d.IsActive ? "Activo" : "Inactivo")</span>
                                <span class="hn-badge @directionClass">@d.Direction.GetDisplayName()</span>
                            </div>
                        </div>

                        <div class="small mt-2">Frecuencia: <b>@d.Frequency.GetDisplayName()</b></div>
                        @if (d.Frequency == EmployeeDeductionFrequency.Monthly)
                        {
                            <div class="small text-muted">Aplica en: @((d.ApplyOnHalf ?? EmployeeDeductionApplyOnHalf.First).GetDisplayName())</div>
                        }

                        <div class="small mt-1">Importe: <b>@d.AmountLabel</b></div>
                        <div class="small text-muted">Inicio: @(d.StartDate?.ToString("dd/MM/yyyy") ?? "-") &middot; Fin: @(d.EndDate?.ToString("dd/MM/yyyy") ?? "-")</div>

                        @if (d.TotalAmount.HasValue || d.RemainingAmount.HasValue)
                        {
                            <div class="small mt-1">Monto total: <b>@(d.TotalAmount?.ToString("C") ?? "-")</b> &middot; Saldo: <b>@(d.RemainingAmountView?.ToString("C") ?? "-")</b></div>
                        }

                        @if (hasProgress)
                        {
                            <div class="mt-2">
                                <div class="d-flex justify-content-between small">
                                    <span>Progreso de pago</span>
                                    <span>Pago @d.PaidPeriodsView de @d.TotalPeriodsView</span>
                                </div>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar" role="progressbar" style="width:@progressPct%"></div>
                                </div>
                            </div>
                        }

                        <div class="mt-auto pt-3 d-flex gap-2 justify-content-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@d.Id" asp-route-userId="@Model.UserId">Editar</a>
                            @if (d.IsActive)
                            {
                                <form method="post" asp-page-handler="Stop" class="d-inline m-0">
                                    <input type="hidden" name="UserId" value="@Model.UserId" />
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Detener</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
