@page
@model HNControl.Web.Pages.Admin.Employees.Deductions.CreateModel
@{
    ViewData["Title"] = "Nueva deducción";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Nueva deducción</h1>
        <div class="text-muted small">@Model.Employee?.FullName</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="Index" asp-route-userId="@Model.UserId">Volver</a>
</div>

<form method="post" class="row g-3">
    <input type="hidden" asp-for="UserId" />

    <div class="col-12 col-lg-6">
        <div class="card shadow-soft">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Concepto</label>
                        <input class="form-control" asp-for="Input.Concept" />
                        <span class="text-danger small" asp-validation-for="Input.Concept"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" asp-for="Input.Type" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.EmployeeDeductionType>()"></select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Modo</label>
                        <select class="form-select" asp-for="Input.Mode" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.EmployeeDeductionMode>()"></select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Monto fijo (si aplica)</label>
                        <input class="form-control" asp-for="Input.Amount" type="number" step="0.01" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Porcentaje (%, si aplica)</label>
                        <input class="form-control" asp-for="Input.RatePercent" type="number" step="0.01" placeholder="15 = 15%" />
                        <span class="text-danger small" asp-validation-for="Input.RatePercent"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Inicio</label>
                        <input class="form-control" asp-for="Input.StartDate" type="date" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Fin (opcional)</label>
                        <input class="form-control" asp-for="Input.EndDate" type="date" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Total (préstamo, opcional)</label>
                        <input class="form-control" asp-for="Input.TotalAmount" type="number" step="0.01" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Saldo (préstamo, opcional)</label>
                        <input class="form-control" asp-for="Input.RemainingAmount" type="number" step="0.01" />
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="Input.IsActive" />
                            <label class="form-check-label" asp-for="Input.IsActive">Activo</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 d-flex justify-content-end gap-2">
        <button class="btn btn-primary" type="submit">Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
