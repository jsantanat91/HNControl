@page
@model HNControl.Web.Pages.Admin.Employees.Deductions.CreateModel
@{
    ViewData["Title"] = "Nuevo ajuste";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Nuevo ajuste</h1>
        <div class="text-muted small">@Model.Employee?.FullName</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="Index" asp-route-userId="@Model.UserId">Volver</a>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <form method="post" class="card shadow-soft hn-hover">
            <input type="hidden" asp-for="UserId" />
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Concepto</label>
                        <input class="form-control" asp-for="Input.Concept" placeholder="Ej. Pensi&oacute;n alimenticia" />
                        <span class="text-danger small" asp-validation-for="Input.Concept"></span>
                    </div>

                    <div class="col-12"><hr class="my-1" /></div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Movimiento</label>
                        <select class="form-select" asp-for="Input.Direction" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.EmployeeDeductionDirection>()"></select>
                        <div class="form-text">Deducci&oacute;n resta. Bono suma.</div>
                    </div>
                    <div class="col-12 col-md-4" id="wrapType">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" asp-for="Input.Type" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.EmployeeDeductionType>()"></select>
                    </div>
                    <div class="col-12 col-md-4" id="wrapMode">
                        <label class="form-label">C&aacute;lculo</label>
                        <select class="form-select" asp-for="Input.Mode" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.EmployeeDeductionMode>()"></select>
                    </div>

                    <div class="col-12 col-md-6" id="wrapAmount">
                        <label class="form-label">Monto por periodo</label>
                        <input class="form-control" asp-for="Input.Amount" type="number" step="0.01" placeholder="1200.00" />
                    </div>

                    <div class="col-12 col-md-6" id="wrapRate">
                        <label class="form-label">Porcentaje (%)</label>
                        <input class="form-control" asp-for="Input.RatePercent" type="number" step="0.01" placeholder="15" />
                        <div class="form-text">Ej. 15 = 15%.</div>
                        <span class="text-danger small" asp-validation-for="Input.RatePercent"></span>
                    </div>

                    <div class="col-12"><hr class="my-1" /></div>

                    <div class="col-12 col-md-4" id="wrapFrequency">
                        <label class="form-label">Frecuencia</label>
                        <select class="form-select" asp-for="Input.Frequency" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.EmployeeDeductionFrequency>()"></select>
                        <div class="form-text">Quincenal: cada n&oacute;mina. Mensual: 1 vez al mes.</div>
                    </div>

                    <div class="col-12 col-md-4" id="wrapApplyOnHalf">
                        <label class="form-label">Aplicar en</label>
                        <select class="form-select" asp-for="Input.ApplyOnHalf" asp-items="Html.GetEnumSelectList<HNControl.Web.Models.EmployeeDeductionApplyOnHalf>()">
                            <option value="">(Por defecto: 1a quincena)</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4" id="wrapStartDate">
                        <label class="form-label">Inicio</label>
                        <input class="form-control" asp-for="Input.StartDate" type="date" />
                    </div>

                    <div class="col-12 col-md-6" id="wrapTerm">
                        <label class="form-label">Plazo (periodos)</label>
                        <input class="form-control" asp-for="Input.TermCount" type="number" min="1" step="1" placeholder="Ej. 6" />
                        <div class="form-text">Para pr&eacute;stamo: cu&aacute;ntos pagos se aplicar&aacute;n.</div>
                        <div class="text-muted small mt-1" id="endPreview" style="display:none;"></div>
                    </div>

                    <div class="col-12 col-md-6" id="wrapEndDate">
                        <label class="form-label">Fin (opcional)</label>
                        <input class="form-control" asp-for="Input.EndDate" type="date" />
                        <div class="form-text">Si usas plazo, el fin se calcula solo.</div>
                    </div>

                    <div class="col-12" id="wrapLoan">
                        <div class="rounded-3 border p-3">
                            <div class="fw-semibold mb-2">Pr&eacute;stamo (opcional)</div>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Monto total</label>
                                    <input class="form-control" asp-for="Input.TotalAmount" type="number" step="0.01" placeholder="Ej. 10000" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Saldo</label>
                                    <input class="form-control" asp-for="Input.RemainingAmount" type="number" step="0.01" placeholder="Opcional" />
                                    <div class="form-text">Si lo dejas vac&iacute;o y capturas monto total, inicia con saldo = total.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="Input.IsActive" />
                            <label class="form-check-label" asp-for="Input.IsActive">Activo</label>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2">
                        <button class="btn btn-primary" type="submit">Guardar ajuste</button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="fw-semibold mb-2">Gu&iacute;a r&aacute;pida</div>
                <div class="small text-muted">1. Define concepto y movimiento.</div>
                <div class="small text-muted">2. Elige c&aacute;lculo (monto o porcentaje).</div>
                <div class="small text-muted">3. Si es pr&eacute;stamo, usa plazo/monto total para seguimiento de pagos.</div>
                <div class="small text-muted">4. Si quieres cortar por fecha, agrega fin.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const modeEl = document.getElementById('Input_Mode');
            const typeEl = document.getElementById('Input_Type');
            const directionEl = document.getElementById('Input_Direction');
            const freqEl = document.getElementById('Input_Frequency');
            const applyEl = document.getElementById('Input_ApplyOnHalf');
            const termEl = document.getElementById('Input_TermCount');
            const startEl = document.getElementById('Input_StartDate');
            const endEl = document.getElementById('Input_EndDate');

            const wrapAmount = document.getElementById('wrapAmount');
            const wrapRate = document.getElementById('wrapRate');
            const wrapMode = document.getElementById('wrapMode');
            const wrapFrequency = document.getElementById('wrapFrequency');
            const wrapApplyOnHalf = document.getElementById('wrapApplyOnHalf');
            const wrapType = document.getElementById('wrapType');
            const wrapLoan = document.getElementById('wrapLoan');
            const wrapTerm = document.getElementById('wrapTerm');
            const wrapEndDate = document.getElementById('wrapEndDate');
            const wrapStartDate = document.getElementById('wrapStartDate');
            const endPreview = document.getElementById('endPreview');

            function setSection(el, show) {
                if (!el) return;
                el.classList.toggle('d-none', !show);
                el.querySelectorAll('input, select, textarea').forEach(i => i.disabled = !show);
            }

            function fmtDate(d) {
                const dd = String(d.getDate()).padStart(2, '0');
                const mm = String(d.getMonth() + 1).padStart(2, '0');
                const yy = d.getFullYear();
                return `${dd}/${mm}/${yy}`;
            }

            function calcEndPreview() {
                if (!endPreview) return;
                endPreview.style.display = 'none';
                endPreview.textContent = '';

                const term = termEl ? parseInt(termEl.value || '0', 10) : 0;
                if (!term || term <= 0) return;

                const startVal = startEl ? startEl.value : '';
                if (!startVal) return;
                const start = new Date(startVal + 'T00:00:00');
                if (isNaN(start.getTime())) return;

                const freq = freqEl ? parseInt(freqEl.value || '1', 10) : 1;
                const applyHalf = applyEl ? parseInt(applyEl.value || '1', 10) : 1;

                let y = start.getFullYear();
                let m = start.getMonth();
                let half = (start.getDate() <= 15) ? 1 : 2;
                let end;

                if (freq === 2) {
                    half = (applyHalf === 2) ? 2 : 1;
                    for (let i = 1; i <= term; i++) {
                        end = (half === 1) ? new Date(y, m, 15) : new Date(y, m + 1, 0);
                        if (i === term) break;
                        m += 1;
                        if (m > 11) { m = 0; y += 1; }
                    }
                } else {
                    for (let i = 1; i <= term; i++) {
                        end = (half === 1) ? new Date(y, m, 15) : new Date(y, m + 1, 0);
                        if (i === term) break;
                        if (half === 1) half = 2;
                        else {
                            half = 1;
                            m += 1;
                            if (m > 11) { m = 0; y += 1; }
                        }
                    }
                }

                if (!end) return;
                endPreview.style.display = '';
                endPreview.textContent = `Fin estimado: ${fmtDate(end)}`;
            }

            function refresh() {
                const mode = modeEl ? parseInt(modeEl.value || '1', 10) : 1;
                const freq = freqEl ? parseInt(freqEl.value || '1', 10) : 1;
                const type = typeEl ? parseInt(typeEl.value || '99', 10) : 99;
                const direction = directionEl ? parseInt(directionEl.value || '1', 10) : 1;
                const isBonus = direction === 2;

                if (isBonus) {
                    if (modeEl) modeEl.value = '1';
                    if (typeEl) typeEl.value = '99';
                    if (freqEl) freqEl.value = '1';
                    if (applyEl) applyEl.value = '';
                    if (termEl) termEl.value = '';

                    const now = new Date();
                    const yyyy = now.getFullYear();
                    const mm = String(now.getMonth() + 1).padStart(2, '0');
                    const dd = now.getDate();
                    const start = dd <= 15 ? `${yyyy}-${mm}-01` : `${yyyy}-${mm}-16`;
                    const end = dd <= 15 ? `${yyyy}-${mm}-15` : `${yyyy}-${mm}-${String(new Date(yyyy, now.getMonth() + 1, 0).getDate()).padStart(2, '0')}`;
                    if (startEl) startEl.value = start;
                    if (endEl) endEl.value = end;
                }

                const isPercent = mode !== 1;
                setSection(wrapAmount, !isPercent);
                setSection(wrapRate, isPercent);

                const isMonthly = !isBonus && freq === 2;
                setSection(wrapApplyOnHalf, isMonthly);
                setSection(wrapFrequency, !isBonus);
                setSection(wrapMode, !isBonus);

                const isLoan = !isBonus && type === 2;
                setSection(wrapLoan, isLoan);
                setSection(wrapTerm, isLoan);
                setSection(wrapType, !isBonus);
                setSection(wrapStartDate, !isBonus);

                const hasTerm = isLoan && termEl && termEl.value && parseInt(termEl.value || '0', 10) > 0;
                setSection(wrapEndDate, !hasTerm && !isBonus);
                calcEndPreview();
            }

            [modeEl, typeEl, directionEl, freqEl, applyEl, termEl, startEl].forEach(el => {
                if (!el) return;
                el.addEventListener('change', refresh);
                el.addEventListener('input', refresh);
            });

            refresh();
        })();
    </script>
}
