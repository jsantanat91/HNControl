@page
@model HNControl.Web.Pages.Admin.Employees.OrgChartModel
@using global::System.Text.Json
@{
    ViewData["Title"] = "Organigrama";
    var employeesJson = JsonSerializer.Serialize(Model.Employees, new JsonSerializerOptions(JsonSerializerDefaults.Web));
    var nodesJson = JsonSerializer.Serialize(Model.Nodes, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Organigrama</h1>
        <div class="text-muted small">Arrastra tarjetas para definir jerarquía, guarda y exporta.</div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanExport)
        {
            <a class="btn btn-outline-success" asp-page-handler="Export">Exportar Excel</a>
        }
        @if (Model.CanEdit)
        {
            <button class="btn btn-primary" type="button" id="saveOrgBtn">Guardar organigrama</button>
        }
    </div>
</div>

<div id="orgAlert" class="alert d-none"></div>

<div class="row g-3">
    <div class="col-12 col-xl-4">
        <div class="card shadow-soft h-100">
            <div class="card-header fw-semibold">Sin jefe (nivel raíz)</div>
            <div class="card-body">
                <div id="orgRoot" class="org-dropzone"></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-8">
        <div class="card shadow-soft h-100">
            <div class="card-header fw-semibold">Vista del organigrama</div>
            <div class="card-body">
                <div id="orgCanvas" class="org-dropzone">
                    <div id="orgTreeRoot" class="org-tree-root"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.CanEdit)
{
    <div class="mt-2 text-muted small">Modo solo lectura. Puedes visualizar, pero no editar.</div>
}

@section Styles {
    <style>
        #orgRoot, #orgCanvas { min-height: 420px; }
        .org-dropzone {
            border: 1px dashed rgba(59,130,246,.45);
            border-radius: 16px;
            padding: .75rem;
            background: rgba(241,245,249,.55);
        }
        .org-tree-root { min-height: 360px; }
        .org-card {
            background: #fff;
            border: 1px solid rgba(15,23,42,.12);
            border-radius: 14px;
            padding: .6rem .75rem;
            margin-bottom: .55rem;
            box-shadow: 0 8px 16px rgba(15,23,42,.06);
        }
        .org-card.dragging { opacity: .55; }
        .org-card.is-selected { outline: 2px solid rgba(37,99,235,.5); }
        .org-card-head { display:flex; justify-content:space-between; align-items:center; gap:.5rem; }
        .org-name { font-weight: 700; font-size: .96rem; line-height:1.2; }
        .org-role { font-size:.8rem; color:#64748b; }
        .org-children {
            margin-top: .55rem;
            margin-left: 1rem;
            border-left: 2px solid rgba(59,130,246,.25);
            padding-left: .6rem;
            min-height: .75rem;
        }
        .org-children.drop-target, #orgRoot.drop-target {
            background: rgba(147,197,253,.25);
            border-radius: 12px;
        }
        .org-link-help {
            font-size: .8rem;
            color: #64748b;
            margin-bottom: .55rem;
        }
    </style>
}

@section Scripts {
<script>
(() => {
    const canEdit = @Model.CanEdit.ToString().ToLowerInvariant();
    const employees = @Html.Raw(employeesJson);
    const links = @Html.Raw(nodesJson);
    const root = document.getElementById('orgRoot');
    const canvas = document.getElementById('orgCanvas');
    const orgTreeRoot = document.getElementById('orgTreeRoot');
    const alertBox = document.getElementById('orgAlert');

    const getUserId = (x) => x?.userId || x?.UserId || '';
    const getReportsTo = (x) => x?.reportsToUserId || x?.ReportsToUserId || null;
    const getSortOrder = (x) => x?.sortOrder ?? x?.SortOrder ?? 0;
    const getFullName = (x) => x?.fullName || x?.FullName || '-';
    const getPosition = (x) => x?.position || x?.Position || '-';
    const getEmail = (x) => x?.email || x?.Email || '-';

    const byUser = new Map(employees.map(e => [getUserId(e), e]).filter(([k]) => !!k));
    const cardByUser = new Map();
    let draggingUserId = null;
    let selectedParentId = null;

    function showAlert(msg, ok) {
        alertBox.className = `alert ${ok ? 'alert-success' : 'alert-danger'}`;
        alertBox.textContent = msg;
    }

    function createCard(emp) {
        const userId = getUserId(emp);
        const card = document.createElement('div');
        card.className = 'org-card';
        card.dataset.userId = userId;
        if (canEdit) card.draggable = true;
        card.innerHTML = `
            <div class="org-card-head">
                <div>
                    <div class="org-name">${getFullName(emp)}</div>
                    <div class="org-role">${getPosition(emp)}</div>
                </div>
                <span class="badge text-bg-light">${getEmail(emp)}</span>
            </div>
            <div class="org-children" data-parent-id="${userId}"></div>
        `;
        card.addEventListener('click', () => {
            if (!canEdit) return;
            if (selectedParentId === userId) {
                selectedParentId = null;
            } else {
                selectedParentId = userId;
            }
            cardByUser.forEach(c => c.classList.toggle('is-selected', c.dataset.userId === selectedParentId));
        });
        cardByUser.set(userId, card);
        return card;
    }

    function buildBase() {
        root.innerHTML = '';
        orgTreeRoot.innerHTML = '';

        employees.forEach(emp => {
            const card = createCard(emp);
            orgTreeRoot.appendChild(card);
        });

        const linkMap = new Map(links.map(x => [getUserId(x), x]).filter(([k]) => !!k));
        const sorted = [...employees].sort((a, b) => {
            const sa = getSortOrder(linkMap.get(getUserId(a))) || 9999;
            const sb = getSortOrder(linkMap.get(getUserId(b))) || 9999;
            if (sa !== sb) return sa - sb;
            return (getFullName(a) || '').localeCompare(getFullName(b) || '');
        });

        sorted.forEach(emp => {
            const userId = getUserId(emp);
            const card = cardByUser.get(userId);
            const parentId = getReportsTo(linkMap.get(userId));
            if (!parentId) {
                orgTreeRoot.appendChild(card);
                return;
            }
            const parent = cardByUser.get(parentId);
            const zone = parent?.querySelector('.org-children');
            (zone || orgTreeRoot).appendChild(card);
        });

        const help = document.createElement('div');
        help.className = 'org-link-help';
        help.textContent = 'Tip: arrastra tarjetas al panel derecho. Para enlazar por jerarquía, suelta una tarjeta sobre otra.';
        canvas.prepend(help);
    }

    function isDropInsideSelf(targetZone, draggedCard) {
        const targetCard = targetZone.closest('.org-card');
        return targetCard ? draggedCard.contains(targetCard) : false;
    }

    function enableDnD() {
        if (!canEdit) return;

        const zones = () => [root, orgTreeRoot, ...document.querySelectorAll('.org-children')];
        zones().forEach(zone => {
            zone.addEventListener('dragover', e => {
                e.preventDefault();
                zone.classList.add('drop-target');
            });
            zone.addEventListener('dragleave', () => zone.classList.remove('drop-target'));
            zone.addEventListener('drop', e => {
                e.preventDefault();
                zone.classList.remove('drop-target');
                if (!draggingUserId) return;
                const card = cardByUser.get(draggingUserId);
                if (!card) return;
                if (isDropInsideSelf(zone, card)) return;
                zone.appendChild(card);
            });
        });

        cardByUser.forEach(card => {
            card.addEventListener('dragstart', () => {
                draggingUserId = card.dataset.userId;
                card.classList.add('dragging');
            });
            card.addEventListener('dragend', () => {
                draggingUserId = null;
                card.classList.remove('dragging');
            });
        });
    }

    function collectLayout() {
        const out = [];
        let order = 0;
        const baseRect = orgTreeRoot.getBoundingClientRect();
        function walk(zone, parentId) {
            const cards = [...zone.children].filter(x => x.classList.contains('org-card'));
            cards.forEach(card => {
                const userId = card.dataset.userId;
                const r = card.getBoundingClientRect();
                order += 1;
                out.push({
                    userId,
                    reportsToUserId: parentId,
                    sortOrder: order,
                    positionX: Math.max(0, Math.round(r.left - baseRect.left)),
                    positionY: Math.max(0, Math.round(r.top - baseRect.top))
                });
                const childZone = card.querySelector(':scope > .org-children');
                if (childZone) walk(childZone, userId);
            });
        }
        walk(orgTreeRoot, null);
        walk(root, null);
        return out;
    }

    async function saveLayout() {
        const payload = collectLayout();
        const fd = new FormData();
        fd.append('layoutJson', JSON.stringify(payload));
        const res = await fetch('?handler=Save', { method: 'POST', body: fd });
        const json = await res.json();
        showAlert(json.message || 'Sin respuesta', !!json.ok);
    }

    const saveBtn = document.getElementById('saveOrgBtn');
    if (saveBtn) saveBtn.addEventListener('click', saveLayout);

    buildBase();
    enableDnD();
})();
</script>
}
