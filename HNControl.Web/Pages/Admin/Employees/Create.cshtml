@page
@model HNControl.Web.Pages.Admin.Employees.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nuevo empleado";
}

<h1 class="h4 mb-3">Nuevo empleado</h1>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="card shadow-soft hn-hover">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input class="form-control" asp-for="Input.FullName" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Correo (login)</label>
                <input class="form-control" asp-for="Input.Email" type="email" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Sexo</label>
                <select class="form-select" asp-for="Input.Gender">
                    <option value="Hombre">Hombre</option>
                    <option value="Mujer">Mujer</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Teléfono</label>
                <input class="form-control" asp-for="Input.Phone" />
            </div>
            <div class="col-md-4">
                <label class="form-label">NSS</label>
                <input class="form-control" asp-for="Input.Nss" />
            </div>

            <div class="col-md-4">
                <label class="form-label">CURP</label>
                <input class="form-control text-uppercase" asp-for="Input.Curp" maxlength="18" />
                <div class="form-text">18 caracteres. Se guarda en mayúsculas.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Fecha de nacimiento</label>
                <input class="form-control" asp-for="Input.BirthDate" type="date" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fecha de ingreso (antigüedad)</label>
                <input class="form-control" asp-for="Input.HireDate" type="date" />
            </div>

            <div class="col-12">
                <label class="form-label">Dirección</label>
                <input class="form-control" asp-for="Input.Address" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Puesto</label>
                <input class="form-control" asp-for="Input.Position" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Sueldo base mensual</label>
                <input class="form-control" asp-for="Input.SalaryBase" type="number" step="0.01" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Vacaciones (días por año)</label>
                <input class="form-control" asp-for="Input.VacationAllowanceDays" type="number" min="0" max="60" />
                <div class="form-text">Se calcula "usado" desde vacaciones aprobadas.</div>
            </div>

            <div class="col-md-3">
                <label class="form-label">Rol (acceso global)</label>
                <select class="form-select" asp-for="Input.AppRole" id="appRoleSelect">
                    <option value="Employee">Employee</option>
                    <option value="Admin">SuperAdmin (Master)</option>
                </select>
                <div class="form-text">SuperAdmin tiene acceso total global. Employee depende de permisos por módulo.</div>
            </div>
            <div class="col-md-3" id="permissionRoleWrap">
                <label class="form-label">Rol de permisos por módulo</label>
                <select class="form-select" asp-for="Input.PermissionRoleId" asp-items="Model.PermissionRoleOptions" id="permissionRoleSelect">
                    <option value="">(sin asignar)</option>
                </select>
                <div class="form-text">Solo aplica a Employee. Se gestiona en <a asp-page="/Admin/Security/Roles/Index">Seguridad</a>.</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Contraseña inicial</label>
                <input class="form-control" asp-for="Input.Password" type="password" />
                <div class="text-muted small">El empleado podrá cambiarla después.</div>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Crear</button>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Employees/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const role = document.getElementById('appRoleSelect');
            const wrap = document.getElementById('permissionRoleWrap');
            const select = document.getElementById('permissionRoleSelect');
            if (!role || !wrap || !select) return;
            const sync = () => {
                const isGlobal = role.value === 'Admin' || role.value === 'SuperAdmin';
                wrap.style.display = isGlobal ? 'none' : '';
                if (isGlobal) select.value = '';
            };
            role.addEventListener('change', sync);
            sync();
        })();
    </script>
}
