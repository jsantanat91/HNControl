@page
@model HNControl.Web.Pages.Admin.Employees.DetailsModel
@inject HNControl.Web.Services.ModuleAvailability Modules
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ficha del empleado";
    var employee = Model.Employee;
    var now = DateTime.Today;
    var initials = string.Join("", (employee.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x.Substring(0, 1))).ToUpperInvariant();
    var photoUrl = Url.Page("/Admin/Employees/Details", "Photo", new { userId = employee.UserId });
    var selectedTab = Request.Query["tab"].ToString();
    var activeTab = new[] { "datos", "desempeno", "viaticos" }.Contains(selectedTab) ? selectedTab : "resumen";
    string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Sin registrar" : value;
    string TabClass(string name) => activeTab == name ? "active" : "";
    string PaneClass(string name) => activeTab == name ? "show active" : "";
}
<link rel="stylesheet" href="~/css/hn-people.css" asp-append-version="true" />
<div class="hn-profile">
    <div class="hn-profile-toolbar">
        <a class="hn-profile-back" asp-page="./Index" data-module-panel-close><i class="bi bi-arrow-left" aria-hidden="true"></i>Empleados</a>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" asp-page="/Admin/Viaticos/Index" asp-route-UserId="@employee.UserId"><i class="bi bi-wallet2 me-2" aria-hidden="true"></i>Viáticos</a>
            <a class="btn btn-outline-secondary" asp-page="/Admin/Employees/Deductions/Index" asp-route-userId="@employee.UserId">Ajustes de nómina</a>
            <a class="btn btn-outline-primary" asp-page="/Admin/Performance/Rate" asp-route-employeeId="@employee.UserId" asp-route-ym="@now.ToString("yyyy-MM")" asp-route-half="@(now.Day <= 15 ? 1 : 2)">Calificar KPI</a>
            <a class="btn btn-primary" asp-page="./Edit" asp-route-userId="@employee.UserId"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Editar ficha</a>
        </div>
    </div>
    <header class="hn-profile-hero">
        <div class="hn-profile-identity">
            @if (!string.IsNullOrWhiteSpace(employee.ProfilePhotoStoragePath))
            {
                <img class="hn-profile-avatar" src="@photoUrl" alt="Foto @employee.FullName" />
            }
            else
            {
                <div class="hn-profile-avatar" aria-hidden="true">@(string.IsNullOrEmpty(initials) ? "EM" : initials)</div>
            }
            <div>
                <div class="hn-profile-eyebrow">Ficha del empleado · @Display(employee.EmployeeNumber)</div>
                <h1>@employee.FullName</h1>
                <p>@Display(employee.Position)</p>
                <div class="hn-profile-contact">
                    <span><i class="bi bi-envelope" aria-hidden="true"></i>@Display(employee.Email)</span>
                    <span><i class="bi bi-telephone" aria-hidden="true"></i>@Display(employee.Phone)</span>
                </div>
            </div>
        </div>
        <div class="hn-profile-hero-meta">
            <span class="hn-person-status @(employee.IsActive ? "is-active" : "is-inactive")"><span aria-hidden="true"></span>@(employee.IsActive ? "Activo" : "Baja")</span>
            <span>Fecha de ingreso<strong>@(employee.HireDate?.ToString("dd/MM/yyyy") ?? "Sin registrar")</strong></span>
        </div>
    </header>

    <nav class="nav hn-profile-tabs" role="tablist" aria-label="Secciones de la ficha">
        <button class="btn @TabClass("resumen")" id="resumen-tab" data-bs-toggle="tab" data-bs-target="#resumen" type="button" role="tab" aria-controls="resumen" aria-selected="@(activeTab == "resumen" ? "true" : "false")"><i class="bi bi-grid" aria-hidden="true"></i>Resumen</button>
        <button class="btn @TabClass("datos")" id="datos-tab" data-bs-toggle="tab" data-bs-target="#datos" type="button" role="tab" aria-controls="datos" aria-selected="@(activeTab == "datos" ? "true" : "false")"><i class="bi bi-person-vcard" aria-hidden="true"></i>Datos del empleado</button>
        <button class="btn @TabClass("desempeno")" id="desempeno-tab" data-bs-toggle="tab" data-bs-target="#desempeno" type="button" role="tab" aria-controls="desempeno" aria-selected="@(activeTab == "desempeno" ? "true" : "false")"><i class="bi bi-bar-chart" aria-hidden="true"></i>Desempeño</button>
        <button class="btn @TabClass("viaticos")" id="viaticos-tab" data-bs-toggle="tab" data-bs-target="#viaticos" type="button" role="tab" aria-controls="viaticos" aria-selected="@(activeTab == "viaticos" ? "true" : "false")"><i class="bi bi-wallet2" aria-hidden="true"></i>Viáticos</button>
    </nav>
    <div class="tab-content">
        <section class="tab-pane fade @PaneClass("resumen")" id="resumen" role="tabpanel" aria-labelledby="resumen-tab" tabindex="0">
            <div class="hn-profile-section-heading"><div><h2>Tu equipo, en detalle</h2><p>Resumen de la quincena actual.</p></div><span class="hn-profile-period"><i class="bi bi-calendar3" aria-hidden="true"></i>@Model.CurrentPayrollPeriod</span></div>
            <div class="hn-profile-overview">
                <article class="hn-profile-net">
                    <span class="hn-profile-eyebrow">Nómina · Quincena actual</span>
                    <h3>Neto quincenal estimado</h3><strong>@Model.CurrentNetQuincenal.ToString("C2")</strong>
                    <p>Considera la variable, los bonos y las deducciones del periodo.</p>
                    <a asp-page="/Admin/Employees/Deductions/Index" asp-route-userId="@employee.UserId">Consultar ajustes<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </article>
                <div class="hn-profile-summary-grid">
                    <article class="hn-profile-stat"><span><i class="bi bi-pie-chart" aria-hidden="true"></i>Variable 80/20 actual</span><strong>@((Model.CurrentVariablePercent * 100m).ToString("0.##"))<small>%</small></strong><p>Aplicada a la estimación</p></article>
                    <article class="hn-profile-stat"><span><i class="bi bi-plus-circle" aria-hidden="true"></i>Bonos del periodo</span><strong>@Model.CurrentBonusesTotal.ToString("C2")</strong><p>Incluye las comisiones registradas</p></article>
                    <article class="hn-profile-stat"><span><i class="bi bi-dash-circle" aria-hidden="true"></i>Deducciones</span><strong>@Model.CurrentDeductionsTotal.ToString("C2")</strong><p>Descuentos de la quincena</p></article>
                    <article class="hn-profile-stat"><span><i class="bi bi-calendar2-check" aria-hidden="true"></i>Vacaciones disponibles</span><strong>@Model.VacationRemaining<small> días</small></strong><p>Saldo del año en curso</p></article>
                </div>
            </div>
            <div class="hn-profile-bottom-grid">
                <article class="hn-profile-panel"><h3><i class="bi bi-wallet2" aria-hidden="true"></i>Condiciones de compensación</h3>
                    <dl class="hn-profile-facts">
                        <div><dt>Sueldo base mensual</dt><dd>@employee.SalaryBase.ToString("C2")</dd></div>
                        <div><dt>Comisión por orden finalizada</dt><dd>@(employee.ServiceOrderCommissionEnabled ? employee.ServiceOrderCommissionAmount.ToString("C2") : "Desactivada")</dd></div>
                    </dl>
                    <p class="hn-profile-note">La comisión es el importe configurado por orden; los bonos de la quincena muestran lo ya registrado.</p>
                </article>
                <article class="hn-profile-panel"><h3><i class="bi bi-activity" aria-hidden="true"></i>Seguimiento</h3>
                    <dl class="hn-profile-facts">
                        <div><dt>KPI promedio · últimos 90 días</dt><dd>@Model.KPIAvgScore.ToString("0.0") <small>/ 5</small></dd></div>
                        <div><dt>Variable promedio · últimos 12 periodos</dt><dd>@((Model.VariableAvgPercent * 100m).ToString("0.##"))%</dd></div>
                        @if (Modules.ExamsEnabled) { <div><dt>Exámenes pendientes</dt><dd>@Model.ExamsPendingCount</dd></div> }
                    </dl>
                </article>
            </div>
        </section>
        <section class="tab-pane fade @PaneClass("datos")" id="datos" role="tabpanel" aria-labelledby="datos-tab" tabindex="0">
            <div class="hn-profile-section-heading"><div><h2>Datos del empleado</h2><p>Información registrada en su ficha.</p></div></div>
            <div class="hn-profile-bottom-grid">
                <article class="hn-profile-panel"><h3><i class="bi bi-person" aria-hidden="true"></i>Información personal</h3><dl class="hn-profile-data">
                    <div><dt>Nombre completo</dt><dd>@Display(employee.FullName)</dd></div><div><dt>Fecha de nacimiento</dt><dd>@(employee.BirthDate?.ToString("dd/MM/yyyy") ?? "Sin registrar")</dd></div>
                    <div><dt>Sexo</dt><dd>@Display(employee.Sex)</dd></div><div><dt>Nivel de estudios</dt><dd>@Display(employee.EducationLevel)</dd></div>
                    <div><dt>CURP</dt><dd>@Display(employee.Curp)</dd></div><div><dt>RFC</dt><dd>@Display(employee.Rfc)</dd></div><div><dt>NSS</dt><dd>@Display(employee.Nss)</dd></div>
                </dl></article>
                <article class="hn-profile-panel"><h3><i class="bi bi-geo-alt" aria-hidden="true"></i>Contacto y domicilio</h3><dl class="hn-profile-data">
                    <div><dt>Correo electrónico</dt><dd>@Display(employee.Email)</dd></div><div><dt>Teléfono</dt><dd>@Display(employee.Phone)</dd></div>
                    <div class="hn-profile-span"><dt>Domicilio</dt><dd>@Display(employee.Address)</dd></div><div><dt>Código postal</dt><dd>@Display(employee.PostalCode)</dd></div>
                </dl></article>
                <article class="hn-profile-panel"><h3><i class="bi bi-briefcase" aria-hidden="true"></i>Información laboral</h3><dl class="hn-profile-data">
                    <div><dt>Número de empleado</dt><dd>@Display(employee.EmployeeNumber)</dd></div><div><dt>Puesto</dt><dd>@Display(employee.Position)</dd></div>
                    <div><dt>Fecha de ingreso</dt><dd>@(employee.HireDate?.ToString("dd/MM/yyyy") ?? "Sin registrar")</dd></div><div><dt>Estado</dt><dd>@(employee.IsActive ? "Activo" : "Baja")</dd></div>
                </dl></article>
                <article class="hn-profile-panel"><h3><i class="bi bi-bank" aria-hidden="true"></i>Datos para nómina</h3><dl class="hn-profile-data">
                    <div><dt>Banco</dt><dd>@Display(employee.BankName)</dd></div><div><dt>Cuenta</dt><dd>@Display(employee.BankAccount)</dd></div><div class="hn-profile-span"><dt>CLABE</dt><dd>@Display(employee.BankClabe)</dd></div>
                    <div><dt>Tipo de contrato SAT</dt><dd>@Display(employee.SatContractTypeCode)</dd></div><div><dt>Tipo de jornada SAT</dt><dd>@Display(employee.SatWorkdayTypeCode)</dd></div><div><dt>Riesgo de puesto SAT</dt><dd>@Display(employee.SatJobRiskCode)</dd></div>
                </dl></article>
            </div>
        </section>
        <section class="tab-pane fade @PaneClass("desempeno")" id="desempeno" role="tabpanel" aria-labelledby="desempeno-tab" tabindex="0">
            <div class="hn-profile-section-heading"><div><h2>Desempeño y evolución</h2><p>Calificaciones y variable de los periodos evaluados.</p></div>
                <form method="get" class="hn-profile-month"><input type="hidden" name="userId" value="@employee.UserId" /><input type="hidden" name="tab" value="desempeno" /><label for="profileMonth">Mes de KPI</label><select class="form-select form-select-sm" name="ym" id="profileMonth" onchange="this.form.submit()">@foreach (var it in Model.MonthItems) { <option value="@it.Value" selected="@it.Selected">@it.Text</option> }</select></form>
            </div>
            <div class="hn-profile-bottom-grid">
                <article class="hn-profile-panel"><h3>Evaluaciones del mes</h3><p class="hn-profile-note">Promedio de los indicadores por evaluación · @Model.SelectedYm</p><div class="hn-profile-chart"><canvas id="kpiMonthChart" role="img" aria-label="Promedio KPI por evaluación del mes"></canvas></div><p class="hn-profile-empty" id="kpiEmpty" hidden>No hay evaluaciones registradas en este mes.</p></article>
                <article class="hn-profile-panel"><h3>Historial de variable</h3><p class="hn-profile-note">Últimos 12 periodos evaluados</p><div class="hn-profile-chart"><canvas id="varHistChart" role="img" aria-label="Historial del porcentaje variable"></canvas></div><p class="hn-profile-empty" id="variableEmpty" hidden>Aún no hay periodos evaluados.</p></article>
            </div>
        </section>
        <section class="tab-pane fade @PaneClass("viaticos")" id="viaticos" role="tabpanel" aria-labelledby="viaticos-tab" tabindex="0">
            <div class="hn-profile-section-heading"><div><h2>Viáticos por semana</h2><p>Semanas registradas para @Model.SelectedYm.</p></div><span class="hn-profile-period">Total del mes <strong>@Model.CurrentMonthViaticTotal.ToString("C2")</strong></span></div>
            @if (Model.CurrentMonthWeeks.Count == 0)
            {
                <div class="hn-profile-panel hn-profile-empty"><i class="bi bi-wallet2" aria-hidden="true"></i><h3>Sin viáticos en este mes</h3><p>Las semanas registradas aparecerán aquí.</p><a class="btn btn-outline-primary" asp-page="/Admin/Viaticos/Index" asp-route-UserId="@employee.UserId">Consultar viáticos</a></div>
            }
            else
            {
                <div class="hn-profile-weeks">@foreach (var w in Model.CurrentMonthWeeks) { <article class="hn-profile-panel"><div class="hn-profile-week-title"><h3>@w.WeekLabel</h3><a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Viaticos/Week" asp-route-id="@w.WeekId">Abrir<i class="bi bi-arrow-up-right ms-2" aria-hidden="true"></i></a></div><p class="hn-profile-note">@w.WeekStart.ToString("dd/MM/yyyy") — @w.WeekEnd.ToString("dd/MM/yyyy")</p><strong class="hn-profile-week-total">@w.Total.ToString("C2")</strong><dl class="hn-profile-facts"><div><dt>Facturable</dt><dd>@w.Billable.ToString("C2")</dd></div><div><dt>No facturable</dt><dd>@w.NonBillable.ToString("C2")</dd></div></dl></article> }</div>
            }
        </section>
    </div>
</div>
@section Scripts {
    <script>
    (() => {
        const kpiLabels = @Html.Raw(Model.KpiMonthLabelsJson);
        const kpiValues = @Html.Raw(Model.KpiMonthValuesJson);
        const varLabels = @Html.Raw(Model.VarHistLabelsJson);
        const varValues = @Html.Raw(Model.VarHistValuesJson);
        const charts = [];
        function renderChart(id, labels, values, type, emptyId) {
            const canvas = document.getElementById(id);
            if (!values.length) { canvas.parentElement.hidden = true; document.getElementById(emptyId).hidden = false; return; }
            if (typeof Chart === 'undefined') { canvas.parentElement.hidden = true; const message = document.getElementById(emptyId); message.textContent = 'No fue posible cargar la gráfica. Actualiza la página para reintentar.'; message.hidden = false; return; }
            const cfg = { type, data: { labels, datasets: [{ label: type === 'bar' ? 'KPI' : 'Variable (%)', data: values, backgroundColor: type === 'bar' ? '#75a3eb' : 'rgba(37,99,235,.08)', borderColor:'#2563eb', borderRadius:6, fill:type === 'line', tension:.3, pointRadius:4, pointBackgroundColor:'#2563eb' }] }, options:{ responsive:true, maintainAspectRatio:false, scales:{ y:{beginAtZero:true, suggestedMax:type === 'bar' ? 5 : 100} } } };
            window.hnCharts?.decorate(cfg);
            charts.push(new Chart(canvas, cfg));
        }
        renderChart('kpiMonthChart', kpiLabels, kpiValues, 'bar', 'kpiEmpty');
        renderChart('varHistChart', varLabels, varValues.map(v => Number(v) * 100), 'line', 'variableEmpty');
        const tabs = [...document.querySelectorAll('.hn-profile-tabs [role="tab"]')];
        tabs.forEach((tab, index) => {
            tab.tabIndex = tab.classList.contains('active') ? 0 : -1;
            tab.addEventListener('keydown', event => {
                if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
                event.preventDefault();
                const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
                tabs[next].focus(); bootstrap.Tab.getOrCreateInstance(tabs[next]).show();
            });
            tab.addEventListener('shown.bs.tab', () => tabs.forEach(item => item.tabIndex = item === tab ? 0 : -1));
        });
        document.querySelectorAll('.hn-profile-tabs [data-bs-toggle="tab"]').forEach(button => button.addEventListener('shown.bs.tab', () => { charts.forEach(chart => chart.resize()); const url = new URL(location.href); url.searchParams.set('tab', button.getAttribute('aria-controls')); history.replaceState(null, '', url); }));
    })();
    </script>
}
