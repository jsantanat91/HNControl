@page
@model HNControl.Web.Pages.Admin.Employees.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Detalle empleado";
}
@{
    var __now = DateTime.Today; var __ym = __now.ToString("yyyy-MM"); var __half = __now.Day <= 15 ? 1 : 2;
}

<div class="card shadow-soft hn-hover mb-3">
    <div class="card-body d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div class="d-flex align-items-start gap-3">
            @{
                var hasPhoto = !string.IsNullOrWhiteSpace(Model.Employee.ProfilePhotoStoragePath);
                var photoUrl = Url.Page("/Admin/Employees/Details", "Photo", new { userId = Model.Employee.UserId });
                var initials = string.Join("", (Model.Employee.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x.Substring(0, 1))).ToUpperInvariant();
            }
            @if (hasPhoto)
            {
                <img class="hn-emp-detail-avatar" src="@photoUrl" alt="Foto @Model.Employee.FullName" />
            }
            else
            {
                <div class="hn-emp-detail-avatar-fallback">@((string.IsNullOrWhiteSpace(initials) ? "EM" : initials))</div>
            }
            <div>
                <h3 class="mb-0">@Model.Employee.FullName</h3>
                <div class="text-muted small">
                    @Model.Employee.Position &middot; @Model.Employee.Email &middot; @Model.Employee.Phone
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Employee.EmployeeNumber))
                {
                    <div class="mt-1"><span class="hn-badge hn-badge-blue">@Model.Employee.EmployeeNumber</span></div>
                }
                <div class="text-muted small">
                    RFC: @(string.IsNullOrWhiteSpace(Model.Employee.Rfc) ? "-" : Model.Employee.Rfc)
                    &middot; Estudios: @(string.IsNullOrWhiteSpace(Model.Employee.EducationLevel) ? "-" : Model.Employee.EducationLevel)
                    &middot; Nacimiento: @(Model.Employee.BirthDate?.ToString("yyyy-MM-dd") ?? "-")
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" asp-page="/Admin/Employees/Index">Volver</a>

            <a class="btn btn-outline-primary"
               asp-page="/Admin/Viaticos/Index"
               asp-route-UserId="@Model.Employee.UserId">
                Vi&aacute;ticos
            </a>

            <a class="btn btn-outline-warning"
               asp-page="/Admin/Employees/Deductions/Index"
               asp-route-userId="@Model.Employee.UserId">
                Ajustes
            </a>

            <a class="btn btn-primary"
               asp-page="/Admin/Performance/Rate"
               asp-route-employeeId="@Model.Employee.UserId"
               asp-route-ym="@__ym"
               asp-route-half="@__half">
                Calificar KPI
            </a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-3">
        <div class="card shadow-soft emp-kpi-card kpi-tone-1">
            <div class="card-body">
                <div class="text-muted small">Neto quincenal estimado</div>
                <div class="fs-3 fw-bold">@Model.CurrentNetQuincenal.ToString("C")</div>
                <div class="text-muted small">Periodo: @Model.CurrentPayrollPeriod</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-3">
        <div class="card shadow-soft emp-kpi-card kpi-tone-2">
            <div class="card-body">
                <div class="text-muted small">Variable 80/20 actual</div>
                <div class="fs-3 fw-bold">@((Model.CurrentVariablePercent * 100m).ToString("0.##"))%</div>
                <div class="text-muted small">Deducciones: @Model.CurrentDeductionsTotal.ToString("C")</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-3">
        <div class="card shadow-soft emp-kpi-card kpi-tone-3">
            <div class="card-body">
                <div class="text-muted small">Bonos del periodo</div>
                <div class="fs-3 fw-bold">@Model.CurrentBonusesTotal.ToString("C")</div>
                <div class="text-muted small">Vacaciones disponibles: @Model.VacationRemaining</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-3">
        <div class="card shadow-soft emp-kpi-card kpi-tone-8">
            <div class="card-body">
                <div class="text-muted small">Comisiones de venta</div>
                <div class="fs-3 fw-bold">@Model.CurrentSalesCommissionsTotal.ToString("C")</div>
                <div class="text-muted small">Se suma como bono en la nomina.</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-3">
        <div class="card shadow-soft emp-kpi-card kpi-tone-4">
            <div class="card-body">
                <div class="text-muted small">Ex&aacute;menes pendientes</div>
                <div class="fs-3 fw-bold">@Model.ExamsPendingCount</div>
                <div class="text-muted small">Vista informativa tipo empleado</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-soft emp-kpi-card kpi-tone-5">
            <div class="card-body">
                <div class="text-muted small">KPI promedio (90 d&iacute;as)</div>
                <div class="fs-3 fw-bold">@Model.KPIAvgScore.ToString("0.0")</div>
                <div class="text-muted small">Escala 1-5</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-soft emp-kpi-card kpi-tone-6">
            <div class="card-body">
                <div class="text-muted small">Variable promedio (6 meses)</div>
                <div class="fs-3 fw-bold">@((Model.VariableAvgPercent * 100m).ToString("0.##"))%</div>
                <div class="text-muted small">Promedio de periodos</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-soft emp-kpi-card kpi-tone-7">
            <div class="card-body">
                <div class="text-muted small">Vi&aacute;ticos mes actual</div>
                <div class="fs-3 fw-bold">@Model.CurrentMonthViaticTotal.ToString("C")</div>
                <div class="text-muted small">Suma de semanas del mes</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-soft emp-chart-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">KPIs del mes</div>
                    <form method="get" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="userId" value="@Model.Employee.UserId" />
                        <select class="form-select form-select-sm" name="ym" onchange="this.form.submit()">
                            @foreach (var it in Model.MonthItems)
                            {
                                <option value="@it.Value" selected="@it.Selected">@it.Text</option>
                            }
                        </select>
                    </form>
                </div>
                <canvas id="kpiMonthChart" height="160"></canvas>
                <div class="text-muted small mt-2">Promedio por categor&iacute;a del mes seleccionado (@Model.SelectedYm).</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-soft emp-chart-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">Variable (historial)</div>
                    <div class="text-muted small">&Uacute;ltimos 12 periodos</div>
                </div>
                <canvas id="varHistChart" height="160"></canvas>
                <div class="text-muted small mt-2">L&iacute;nea en porcentaje por periodo evaluado.</div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-soft emp-chart-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="fw-semibold">Vi&aacute;ticos del mes (semanas)</div>
                    <div class="text-muted small">4-5 semanas (seg&uacute;n el mes)</div>
                </div>

                <div class="row g-3">
                    @foreach (var w in Model.CurrentMonthWeeks)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="border rounded-4 p-3 h-100 viatic-week-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">@w.WeekLabel</div>
                                        <div class="text-muted small">
                                            @w.WeekStart.ToString("yyyy-MM-dd") &rarr; @w.WeekEnd.ToString("yyyy-MM-dd")
                                        </div>
                                        <div class="text-muted small">
                                            Facturable: @w.Billable.ToString("C") &middot; No facturable: @w.NonBillable.ToString("C")
                                        </div>
                                    </div>
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-page="/Admin/Viaticos/Week"
                                       asp-route-id="@w.WeekId">
                                        Abrir
                                    </a>
                                </div>
                                <div class="mt-2 fw-bold">Total: @w.Total.ToString("C")</div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const kpiLabels = @Html.Raw(Model.KpiMonthLabelsJson);
        const kpiValues = @Html.Raw(Model.KpiMonthValuesJson);
        const chartColors = ['#2563eb', '#14b8a6', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6', '#0ea5e9', '#84cc16'];

        const kpiCfg = {
            type: 'bar',
            data: {
                labels: kpiLabels,
                datasets: [{
                    label: 'KPI',
                    data: kpiValues,
                    backgroundColor: kpiValues.map((_, i) => chartColors[i % chartColors.length]),
                    borderRadius: 10
                }]
            },
            options: { responsive: true, scales: { y: { beginAtZero: true } } }
        };
        window.hnCharts?.decorate(kpiCfg);
        new Chart(document.getElementById('kpiMonthChart'), kpiCfg);

        const varLabels = @Html.Raw(Model.VarHistLabelsJson);
        const varValues = @Html.Raw(Model.VarHistValuesJson);

        const varCfg = {
            type: 'line',
            data: {
                labels: varLabels,
                datasets: [{
                    label: 'Variable (%)',
                    data: varValues,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37,99,235,.18)',
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: varValues.map((_, i) => chartColors[i % chartColors.length]),
                    pointBorderColor: '#fff',
                    pointRadius: 4
                }]
            },
            options: { responsive: true, scales: { y: { beginAtZero: true } } }
        };
        window.hnCharts?.decorate(varCfg);
        new Chart(document.getElementById('varHistChart'), varCfg);
    </script>
}

@section Styles {
    <style>
        .emp-kpi-card .card-body { min-height: 128px; }
        .emp-chart-card .card-body { min-height: 320px; }

        .hn-emp-detail-avatar {
            width: 74px;
            height: 74px;
            border-radius: 16px;
            object-fit: cover;
            border: 1px solid rgba(37,99,235,.25);
            box-shadow: 0 8px 20px rgba(15,23,42,.12);
            flex: 0 0 auto;
        }

        .hn-emp-detail-avatar-fallback {
            width: 74px;
            height: 74px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            color: #1e40af;
            background: rgba(37,99,235,.12);
            border: 1px solid rgba(37,99,235,.25);
            box-shadow: 0 8px 20px rgba(15,23,42,.08);
            flex: 0 0 auto;
            font-size: 1.2rem;
        }

        .emp-kpi-card {
            border: 1px solid rgba(148, 163, 184, .30);
            overflow: hidden;
        }

        .emp-kpi-card .card-body {
            position: relative;
            background: linear-gradient(160deg, rgba(255,255,255,.93), rgba(248,250,255,.84));
        }

        .emp-kpi-card .card-body::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: .92;
        }

        .emp-kpi-card .card-body > * {
            position: relative;
            z-index: 1;
        }

        .emp-kpi-card.kpi-tone-1 .card-body::after { background: linear-gradient(135deg, rgba(37,99,235,.12), rgba(14,165,233,.02)); }
        .emp-kpi-card.kpi-tone-2 .card-body::after { background: linear-gradient(135deg, rgba(14,165,233,.12), rgba(56,189,248,.02)); }
        .emp-kpi-card.kpi-tone-3 .card-body::after { background: linear-gradient(135deg, rgba(22,163,74,.12), rgba(74,222,128,.02)); }
        .emp-kpi-card.kpi-tone-4 .card-body::after { background: linear-gradient(135deg, rgba(245,158,11,.12), rgba(251,191,36,.02)); }
        .emp-kpi-card.kpi-tone-5 .card-body::after { background: linear-gradient(135deg, rgba(99,102,241,.12), rgba(129,140,248,.02)); }
        .emp-kpi-card.kpi-tone-6 .card-body::after { background: linear-gradient(135deg, rgba(168,85,247,.12), rgba(196,181,253,.02)); }
        .emp-kpi-card.kpi-tone-7 .card-body::after { background: linear-gradient(135deg, rgba(20,184,166,.12), rgba(45,212,191,.02)); }
        .emp-kpi-card.kpi-tone-8 .card-body::after { background: linear-gradient(135deg, rgba(14,116,144,.14), rgba(59,130,246,.05)); }

        .emp-chart-card {
            border: 1px solid rgba(148, 163, 184, .30);
            background: linear-gradient(145deg, rgba(255,255,255,.95), rgba(244,248,255,.88));
        }

        .viatic-week-card {
            border-color: rgba(148,163,184,.34) !important;
            background: linear-gradient(145deg, rgba(255,255,255,.95), rgba(240,249,255,.80));
            box-shadow: 0 8px 22px rgba(15,23,42,.05);
        }
    </style>
}
