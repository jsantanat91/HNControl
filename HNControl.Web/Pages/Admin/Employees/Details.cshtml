@page
@model HNControl.Web.Pages.Admin.Employees.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Detalle empleado";
}
@{
    var __now = DateTime.Today; var __ym = __now.ToString("yyyy-MM"); var __half = __now.Day <= 15 ? 1 : 2;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-0">@Model.Employee.FullName</h3>
        <div class="text-muted small">
            @Model.Employee.Position · @Model.Employee.Email · @Model.Employee.Phone
        </div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Employees/Index">Volver</a>

        <a class="btn btn-outline-primary"
           asp-page="/Admin/Viaticos/Index"
           asp-route-UserId="@Model.Employee.UserId">
            Viáticos
        </a>

        <a class="btn btn-outline-warning"
           asp-page="/Admin/Employees/Deductions/Index"
           asp-route-userId="@Model.Employee.UserId">
            Deducciones
        </a>

        <a class="btn btn-primary"
           asp-page="/Admin/Performance/Rate"
           asp-route-employeeId="@Model.Employee.UserId"
           asp-route-ym="@__ym"
           asp-route-half="@__half">
            Calificar KPI
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">KPI promedio (90 días)</div>
                <div class="fs-3 fw-bold">@Model.KPIAvgScore.ToString("0.0")</div>
                <div class="text-muted small">Escala 1–5</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Variable promedio (6 meses)</div>
                <div class="fs-3 fw-bold">@((Model.VariableAvgPercent * 100m).ToString("0.##"))%</div>
                <div class="text-muted small">Promedio de periodos</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Viáticos mes actual</div>
                <div class="fs-3 fw-bold">@Model.CurrentMonthViaticTotal.ToString("C")</div>
                <div class="text-muted small">Suma de semanas del mes</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">KPIs del mes</div>
                    <form method="get" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="userId" value="@Model.Employee.UserId" />
                        <select class="form-select form-select-sm" name="ym" onchange="this.form.submit()">
                            @foreach (var it in Model.MonthItems)
                            {
                                <option value="@it.Value" selected="@it.Selected">@it.Text</option>
                            }
                        </select>
                    </form>
                </div>
                <canvas id="kpiMonthChart" height="160"></canvas>
                <div class="text-muted small mt-2">Promedio por categoría del mes seleccionado (@Model.SelectedYm).</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">Variable (historial)</div>
                    <div class="text-muted small">Últimos 12 periodos</div>
                </div>
                <canvas id="varHistChart" height="160"></canvas>
                <div class="text-muted small mt-2">Línea en porcentaje por periodo evaluado.</div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="fw-semibold">Viáticos del mes (semanas)</div>
                    <div class="text-muted small">4–5 semanas (según el mes)</div>
                </div>

                <div class="row g-3">
                    @foreach (var w in Model.CurrentMonthWeeks)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="border rounded-4 p-3 h-100">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">@w.WeekLabel</div>
                                        <div class="text-muted small">
                                            @w.WeekStart.ToString("yyyy-MM-dd") → @w.WeekEnd.ToString("yyyy-MM-dd")
                                        </div>
                                        <div class="text-muted small">
                                            Facturable: @w.Billable.ToString("C") · No facturable: @w.NonBillable.ToString("C")
                                        </div>
                                    </div>
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-page="/Admin/Viaticos/Week"
                                       asp-route-weekId="@w.WeekId">
                                        Abrir
                                    </a>
                                </div>
                                <div class="mt-2 fw-bold">Total: @w.Total.ToString("C")</div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const kpiLabels = @Html.Raw(Model.KpiMonthLabelsJson);
        const kpiValues = @Html.Raw(Model.KpiMonthValuesJson);

        new Chart(document.getElementById('kpiMonthChart'), {
            type: 'bar',
            data: { labels: kpiLabels, datasets: [{ label: 'KPI', data: kpiValues }] },
            options: { responsive: true }
        });

        const varLabels = @Html.Raw(Model.VarHistLabelsJson);
        const varValues = @Html.Raw(Model.VarHistValuesJson);

        new Chart(document.getElementById('varHistChart'), {
            type: 'line',
            data: { labels: varLabels, datasets: [{ label: '% Variable', data: varValues }] },
            options: { responsive: true }
        });
    </script>
}