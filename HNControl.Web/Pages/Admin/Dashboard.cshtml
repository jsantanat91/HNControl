@page
@model HNControl.Web.Pages.Admin.DashboardModel
@{
    Layout = "_Layout";

    ViewData["Title"] = "Panel";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Panel</h1>
        <div class="text-muted small">KPIs · evaluaciones · operación</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Performance/Rate">Calificar</a>
        <a class="btn btn-outline-secondary" asp-page="/Performance/ExportPayroll">Exportar nómina</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">Empleados</div>
                <div class="fs-4 fw-semibold">@Model.Kpi.Employees</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">Órdenes en revisión</div>
                <div class="fs-4 fw-semibold">@Model.Kpi.OrdersInReview</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">SLA vencidos (proyectos)</div>
                <div class="fs-4 fw-semibold">@Model.Kpi.OverdueProjects</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">Viáticos pendientes</div>
                <div class="fs-4 fw-semibold">@Model.Kpi.PendingViaticWeeks</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">Vacaciones pendientes</div>
                <div class="fs-4 fw-semibold">@Model.Kpi.PendingLeaveRequests</div>
                <div class="mt-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Leaves/Index">Ver</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover">
            <div class="card-body">
                <div class="text-muted small">Exámenes por calificar</div>
                <div class="fs-4 fw-semibold">@Model.Kpi.ExamsToGrade</div>
                <div class="mt-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Exams/Index">Ver</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-7">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Órdenes completadas (últimos 30 días)</div>
            <div class="card-body">
                <canvas id="ordersChart" height="110"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Top variable % (última evaluación)</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Empleado</th><th class="text-end">Variable %</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Top)
                            {
                                <tr>
                                    <td>@r.Name</td>
                                    <td class="text-end">@((r.Variable * 100m).ToString("0.#"))%</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Employees/Details" asp-route-userId="@r.UserId">Ficha</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-muted small mt-2">Si aquí sale “0%”, es porque nadie ha sido calificado aún.</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-lg-5">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Exámenes (estatus)</div>
            <div class="card-body">
                <canvas id="examAdminChart" height="160"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Acciones rápidas</div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Leaves/Index"><i class="bi bi-calendar2-week me-1"></i> Vacaciones</a>
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Exams/Index"><i class="bi bi-ui-checks me-1"></i> Exámenes</a>
                </div>
                <div class="text-muted small mt-2">Porque el mouse también merece propósito.</div>
            </div>
        </div>
    </div>
</div>

<script>
    const labels = @Html.Raw(Model.OrdersLabelsJson);
    const values = @Html.Raw(Model.OrdersValuesJson);

    const cfg = {
      type: 'line',
      data: { labels, datasets: [{ label: 'Completadas', data: values, tension: 0.25 }] },
      options: { scales: { y: { beginAtZero: true } } }
    };

    window.hnCharts?.decorate(cfg);
    new Chart(document.getElementById('ordersChart'), cfg);

    const examLabels = @Html.Raw(Model.ExamStatusLabelsJson);
    const examValues = @Html.Raw(Model.ExamStatusValuesJson);

    const exCfg = {
      type: 'doughnut',
      data: { labels: examLabels, datasets: [{ label: 'Exámenes', data: examValues }] },
      options: { plugins: { legend: { position: 'bottom' } } }
    };

    window.hnCharts?.decorate(exCfg);
    new Chart(document.getElementById('examAdminChart'), exCfg);
</script>
