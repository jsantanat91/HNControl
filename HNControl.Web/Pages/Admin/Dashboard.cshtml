@page
@model HNControl.Web.Pages.Admin.DashboardModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Panel";
}

<div class="hn-dashboard-hero mb-3">
    <div>
        <h1 class="h4 m-0">Panel ejecutivo</h1>
        <div class="text-muted small">Operacion, KPI y seguimiento diario</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Performance/Rate">Calificar</a>
        <a class="btn btn-outline-secondary" asp-page="/Performance/ExportPayroll">Exportar nomina</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card"><div class="card-body"><div class="text-muted small">Empleados</div><div class="fs-3 fw-bold">@Model.Kpi.Employees</div></div></div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card"><div class="card-body"><div class="text-muted small">Ordenes en revision</div><div class="fs-3 fw-bold">@Model.Kpi.OrdersInReview</div></div></div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card"><div class="card-body"><div class="text-muted small">SLA vencidos (proyectos)</div><div class="fs-3 fw-bold">@Model.Kpi.OverdueProjects</div></div></div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card"><div class="card-body"><div class="text-muted small">Viaticos pendientes</div><div class="fs-3 fw-bold">@Model.Kpi.PendingViaticWeeks</div></div></div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card">
            <div class="card-body">
                <div class="text-muted small">Vacaciones pendientes</div>
                <div class="fs-3 fw-bold">@Model.Kpi.PendingLeaveRequests</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Leaves/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card">
            <div class="card-body">
                <div class="text-muted small">Examenes por calificar</div>
                <div class="fs-3 fw-bold">@Model.Kpi.ExamsToGrade</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Exams/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card">
            <div class="card-body">
                <div class="text-muted small">Inventario · ordenes pendientes</div>
                <div class="fs-3 fw-bold">@Model.Kpi.PendingInventoryOrders</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Inventory/Approvals/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card">
            <div class="card-body">
                <div class="text-muted small">Inventario · bajo stock</div>
                <div class="fs-3 fw-bold">@Model.Kpi.LowStockItems</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Inventory/Items/Index">Ver</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-7">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Ordenes completadas (ultimos 30 dias)</div>
            <div class="card-body">
                <canvas id="ordersChart" height="110"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Top variable % (ultima evaluacion)</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Empleado</th><th class="text-end">Variable %</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Top)
                            {
                                <tr>
                                    <td>@r.Name</td>
                                    <td class="text-end">@((r.Variable * 100m).ToString("0.#"))%</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Employees/Details" asp-route-userId="@r.UserId">Ficha</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-muted small mt-2">Si aqui sale "0%" es porque aun no hay evaluaciones publicadas.</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-lg-7">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Inventario · movimientos aprobados (ultimos 30 dias)</div>
            <div class="card-body">
                <canvas id="invChart" height="130"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Examenes (estatus)</div>
            <div class="card-body">
                <canvas id="examAdminChart" height="160"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-lg-12">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Acciones rapidas</div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Leaves/Index"><i class="bi bi-calendar2-week me-1"></i> Vacaciones</a>
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Exams/Index"><i class="bi bi-ui-checks me-1"></i> Examenes</a>
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Approvals/Index"><i class="bi bi-box-seam me-1"></i> Inventario</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hn-dashboard-hero {
            border: 1px solid rgba(37, 99, 235, .18);
            border-radius: 18px;
            padding: 1rem 1.1rem;
            background: linear-gradient(120deg, rgba(37,99,235,.10), rgba(6,182,212,.09));
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .hn-kpi-card .card-body {
            background: linear-gradient(160deg, rgba(255,255,255,.9), rgba(250,252,255,.8));
        }
    </style>
}

<script>
    const labels = @Html.Raw(Model.OrdersLabelsJson);
    const values = @Html.Raw(Model.OrdersValuesJson);

    const cfg = {
      type: 'line',
      data: { labels, datasets: [{ label: 'Completadas', data: values, tension: 0.25 }] },
      options: { scales: { y: { beginAtZero: true } } }
    };

    window.hnCharts?.decorate(cfg);
    new Chart(document.getElementById('ordersChart'), cfg);

    const examLabels = @Html.Raw(Model.ExamStatusLabelsJson);
    const examValues = @Html.Raw(Model.ExamStatusValuesJson);

    const exCfg = {
      type: 'doughnut',
      data: { labels: examLabels, datasets: [{ label: 'Examenes', data: examValues }] },
      options: { plugins: { legend: { position: 'bottom' } } }
    };

    window.hnCharts?.decorate(exCfg);
    new Chart(document.getElementById('examAdminChart'), exCfg);

    const invLabels = @Html.Raw(Model.InvLabelsJson);
    const invIn = @Html.Raw(Model.InvInValuesJson);
    const invOut = @Html.Raw(Model.InvOutValuesJson);

    const invCfg = {
      type: 'bar',
      data: {
        labels: invLabels,
        datasets: [
          { label: 'Entradas', data: invIn },
          { label: 'Salidas', data: invOut }
        ]
      },
      options: {
        scales: { y: { beginAtZero: true } },
        plugins: { legend: { position: 'bottom' } }
      }
    };

    window.hnCharts?.decorate(invCfg);
    new Chart(document.getElementById('invChart'), invCfg);
</script>
