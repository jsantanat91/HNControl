@page
@model HNControl.Web.Pages.Admin.DashboardModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Panel";
}

<div class="hn-dashboard-hero mb-3">
    <div>
        <h1 class="h4 m-0">Panel ejecutivo</h1>
        <div class="text-muted small">Operacion, KPI y seguimiento diario</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Performance/Rate">Calificar</a>
        <a class="btn btn-outline-secondary" asp-page="/Performance/ExportPayroll">Exportar nomina</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.FlashSuccess))
{
    <div class="alert alert-success py-2">@Model.FlashSuccess</div>
}
@if (!string.IsNullOrWhiteSpace(Model.FlashError))
{
    <div class="alert alert-warning py-2">@Model.FlashError</div>
}

<div class="row g-3">
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-1">
            <div class="card-body">
                <div class="text-muted small">Empleados</div>
                <div class="fs-3 fw-bold">@Model.Kpi.Employees</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Employees/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-2">
            <div class="card-body">
                <div class="text-muted small">Ordenes en revision</div>
                <div class="fs-3 fw-bold">@Model.Kpi.OrdersInReview</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/ServiceOrders/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-3">
            <div class="card-body">
                <div class="text-muted small">SLA vencidos (proyectos)</div>
                <div class="fs-3 fw-bold">@Model.Kpi.OverdueProjects</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Projects/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-4">
            <div class="card-body">
                <div class="text-muted small">Viaticos pendientes</div>
                <div class="fs-3 fw-bold">@Model.Kpi.PendingViaticWeeks</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Viaticos/Index">Ver</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-5">
            <div class="card-body">
                <div class="text-muted small">Vacaciones pendientes</div>
                <div class="fs-3 fw-bold">@Model.Kpi.PendingLeaveRequests</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Leaves/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-6">
            <div class="card-body">
                <div class="text-muted small">Examenes por calificar</div>
                <div class="fs-3 fw-bold">@Model.Kpi.ExamsToGrade</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Exams/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-7">
            <div class="card-body">
                <div class="text-muted small">Inventario · ordenes pendientes</div>
                <div class="fs-3 fw-bold">@Model.Kpi.PendingInventoryOrders</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Inventory/Approvals/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-8">
            <div class="card-body">
                <div class="text-muted small">Inventario · bajo stock</div>
                <div class="fs-3 fw-bold">@Model.Kpi.LowStockItems</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Inventory/Items/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-9">
            <div class="card-body">
                <div class="text-muted small">Tickets abiertos</div>
                <div class="fs-3 fw-bold">@Model.Kpi.OpenTickets</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Tickets/Index">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-10">
            <div class="card-body">
                <div class="text-muted small">Tickets SLA vencido</div>
                <div class="fs-3 fw-bold text-danger">@Model.Kpi.TicketSlaBreached</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Tickets/Index" asp-route-status="open">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-11">
            <div class="card-body">
                <div class="text-muted small">Cotizaciones aceptadas (mes)</div>
                <div class="fs-3 fw-bold text-success">@Model.Kpi.QuotesAcceptedMonth</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Quotes/Requests" asp-route-status="Accepted">Ver</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-soft hn-hover hn-kpi-card kpi-tone-12">
            <div class="card-body">
                <div class="text-muted small">Ventas cotizadas (mes)</div>
                <div class="fs-4 fw-bold text-success">@Model.Kpi.QuotesRevenueMonth.ToString("C0")</div>
                <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Quotes/Requests" asp-route-status="Accepted">Detalle</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>Resumen n&oacute;mina</span>
                <span class="text-muted small">@Model.PayrollPeriodLabel</span>
            </div>
            <div class="card-body">
                <form method="get" class="row g-2 align-items-end mb-3">
                    <div class="col-12 col-md-2">
                        <label class="form-label small text-muted mb-1">A&ntilde;o</label>
                        <input class="form-control form-control-sm" type="number" name="payrollYear" min="2020" max="2100" value="@Model.PayrollYear" />
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label small text-muted mb-1">Mes</label>
                        <input class="form-control form-control-sm" type="number" name="payrollMonth" min="1" max="12" value="@Model.PayrollMonth" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small text-muted mb-1">Quincena</label>
                        <select class="form-select form-select-sm" name="payrollHalf">
                            <option value="1" selected="@(Model.PayrollHalf == 1)">1&ordf; quincena (1-15)</option>
                            <option value="2" selected="@(Model.PayrollHalf == 2)">2&ordf; quincena (16-fin)</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <button class="btn btn-sm btn-primary w-100">Consultar</button>
                    </div>
                </form>

                <div class="row g-3">
                    @foreach (var r in Model.PayrollRows)
                    {
                        var photoUrl = Url.Page("/Admin/Dashboard", "PayrollPhoto", new { userId = r.UserId });
                        var initials = string.Join("", (r.Name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x.Substring(0, 1))).ToUpperInvariant();
                        <div class="col-12 col-lg-6">
                            <div class="payroll-card">
                                <div class="payroll-card-head">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (r.HasPhoto)
                                        {
                                            <img class="payroll-avatar" src="@photoUrl" alt="Foto @r.Name" />
                                        }
                                        else
                                        {
                                            <div class="payroll-avatar-fallback">@((string.IsNullOrWhiteSpace(initials) ? "EM" : initials))</div>
                                        }
                                        <div class="fw-semibold">@r.Name</div>
                                    </div>
                                    @if (r.IsPaid)
                                    {
                                        <span class="badge bg-success">Pagado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                </div>
                                <div class="small text-muted mb-2">Periodo: @Model.PayrollPeriodLabel</div>

                                <div class="payroll-metrics">
                                    <div><span class="text-muted">Sueldo mensual</span><strong>@r.SalaryBase.ToString("C")</strong></div>
                                    <div><span class="text-muted">Variable 80/20</span><strong>@((r.VariablePct * 100m).ToString("0.#"))%</strong></div>
                                    <div><span class="text-muted">Deducciones</span><strong class="text-danger">@r.Deductions.ToString("C")</strong></div>
                                    <div><span class="text-muted">Bonos</span><strong class="text-success">@r.Bonuses.ToString("C")</strong></div>
                                    <div><span class="text-muted">Neto estimado</span><strong>@r.NetEstimated.ToString("C")</strong></div>
                                </div>

                                @if (r.PaidAt.HasValue)
                                {
                                    <div class="small text-muted mt-2">Confirmado: @r.PaidAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                }

                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    @if (!r.IsPaid)
                                    {
                                        <form method="post" asp-page-handler="MarkPaid" asp-route-userId="@r.UserId" class="d-inline">
                                            <input type="hidden" name="payrollYear" value="@Model.PayrollYear" />
                                            <input type="hidden" name="payrollMonth" value="@Model.PayrollMonth" />
                                            <input type="hidden" name="payrollHalf" value="@Model.PayrollHalf" />
                                            <button type="submit" class="btn btn-sm btn-success">Pagado</button>
                                        </form>
                                    }
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Employees/Details" asp-route-userId="@r.UserId">Ficha</a>
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-page="/Admin/Employees/PayrollReceipt"
                                       asp-route-userId="@r.UserId"
                                       asp-route-start="@Model.PayrollPeriodStart.ToString("yyyy-MM-dd")"
                                       asp-route-end="@Model.PayrollPeriodEnd.ToString("yyyy-MM-dd")">Recibo PDF</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-7">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Ordenes completadas (ultimos 30 dias)</div>
            <div class="card-body">
                <canvas id="ordersChart" height="110"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Top variable % (ultima evaluacion)</div>
            <div class="card-body">
                <canvas id="topVarChart" height="185"></canvas>
                <div class="text-muted small mt-2">Si aqui sale "0%" es porque aun no hay evaluaciones publicadas.</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-12">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Tickets atendidos/cerrados (ultimos 30 dias)</div>
            <div class="card-body">
                <canvas id="ticketsClosedChart" height="95"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-lg-4">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Ventas de cotizaciones aceptadas (6 meses)</div>
            <div class="card-body">
                <canvas id="quoteSalesChart" height="130"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Inventario · movimientos aprobados (ultimos 30 dias)</div>
            <div class="card-body">
                <canvas id="invChart" height="130"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Examenes (estatus)</div>
            <div class="card-body">
                <canvas id="examAdminChart" height="160"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-lg-12">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Acciones rapidas</div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Leaves/Index"><i class="bi bi-calendar2-week me-1"></i> Vacaciones</a>
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Exams/Index"><i class="bi bi-ui-checks me-1"></i> Examenes</a>
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Approvals/Index"><i class="bi bi-box-seam me-1"></i> Inventario</a>
                    <a class="btn btn-outline-secondary" asp-page="/Tickets/Index"><i class="bi bi-life-preserver me-1"></i> Tickets</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hn-dashboard-hero {
            border: 1px solid rgba(37, 99, 235, .18);
            border-radius: 18px;
            padding: 1rem 1.1rem;
            background: linear-gradient(120deg, rgba(37,99,235,.10), rgba(6,182,212,.09));
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .hn-kpi-card {
            border: 1px solid rgba(148, 163, 184, .28);
            overflow: hidden;
        }

        .hn-kpi-card .card-body {
            background: linear-gradient(160deg, rgba(255,255,255,.92), rgba(250,252,255,.82));
            position: relative;
        }

        .hn-kpi-card .card-body::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: .9;
        }

        .hn-kpi-card.kpi-tone-1 .card-body::after { background: linear-gradient(135deg, rgba(59,130,246,.10), rgba(14,165,233,.02)); }
        .hn-kpi-card.kpi-tone-2 .card-body::after { background: linear-gradient(135deg, rgba(37,99,235,.09), rgba(2,132,199,.02)); }
        .hn-kpi-card.kpi-tone-3 .card-body::after { background: linear-gradient(135deg, rgba(99,102,241,.10), rgba(56,189,248,.02)); }
        .hn-kpi-card.kpi-tone-4 .card-body::after { background: linear-gradient(135deg, rgba(14,116,144,.10), rgba(6,182,212,.02)); }
        .hn-kpi-card.kpi-tone-5 .card-body::after { background: linear-gradient(135deg, rgba(20,184,166,.10), rgba(34,197,94,.02)); }
        .hn-kpi-card.kpi-tone-6 .card-body::after { background: linear-gradient(135deg, rgba(16,185,129,.09), rgba(45,212,191,.02)); }
        .hn-kpi-card.kpi-tone-7 .card-body::after { background: linear-gradient(135deg, rgba(59,130,246,.08), rgba(16,185,129,.02)); }
        .hn-kpi-card.kpi-tone-8 .card-body::after { background: linear-gradient(135deg, rgba(139,92,246,.09), rgba(59,130,246,.02)); }
        .hn-kpi-card.kpi-tone-9 .card-body::after { background: linear-gradient(135deg, rgba(34,197,94,.10), rgba(20,184,166,.02)); }
        .hn-kpi-card.kpi-tone-10 .card-body::after { background: linear-gradient(135deg, rgba(239,68,68,.08), rgba(251,113,133,.02)); }
        .hn-kpi-card.kpi-tone-11 .card-body::after { background: linear-gradient(135deg, rgba(16,185,129,.10), rgba(74,222,128,.02)); }
        .hn-kpi-card.kpi-tone-12 .card-body::after { background: linear-gradient(135deg, rgba(245,158,11,.10), rgba(250,204,21,.02)); }

        .hn-kpi-card .card-body > * {
            position: relative;
            z-index: 1;
        }

        .payroll-card {
            border: 1px solid rgba(148, 163, 184, .34);
            border-radius: 14px;
            padding: .9rem;
            background: linear-gradient(145deg, rgba(255,255,255,.94), rgba(243,247,255,.88));
            height: 100%;
        }

        .payroll-card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: .5rem;
        }

        .payroll-avatar {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            object-fit: cover;
            border: 1px solid rgba(37,99,235,.26);
            box-shadow: 0 8px 18px rgba(15,23,42,.12);
        }

        .payroll-avatar-fallback {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .9rem;
            font-weight: 700;
            color: #1d4ed8;
            border: 1px solid rgba(37,99,235,.26);
            background: linear-gradient(140deg, rgba(219,234,254,.95), rgba(191,219,254,.75));
            box-shadow: 0 8px 18px rgba(15,23,42,.1);
        }

        .payroll-metrics {
            display: grid;
            gap: .45rem;
        }

        .payroll-metrics > div {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: .75rem;
            border-bottom: 1px dashed rgba(148, 163, 184, .32);
            padding-bottom: .2rem;
        }
    </style>
}

<script>
    const labels = @Html.Raw(Model.OrdersLabelsJson);
    const values = @Html.Raw(Model.OrdersValuesJson);

    const cfg = {
      type: 'line',
      data: { labels, datasets: [{ label: 'Completadas', data: values, tension: 0.25 }] },
      options: { scales: { y: { beginAtZero: true } } }
    };

    window.hnCharts?.decorate(cfg);
    new Chart(document.getElementById('ordersChart'), cfg);

    const examLabels = @Html.Raw(Model.ExamStatusLabelsJson);
    const examValues = @Html.Raw(Model.ExamStatusValuesJson);

    const exCfg = {
      type: 'doughnut',
      data: { labels: examLabels, datasets: [{ label: 'Examenes', data: examValues }] },
      options: { plugins: { legend: { position: 'bottom' } } }
    };

    window.hnCharts?.decorate(exCfg);
    new Chart(document.getElementById('examAdminChart'), exCfg);

    const invLabels = @Html.Raw(Model.InvLabelsJson);
    const invIn = @Html.Raw(Model.InvInValuesJson);
    const invOut = @Html.Raw(Model.InvOutValuesJson);

    const invCfg = {
      type: 'bar',
      data: {
        labels: invLabels,
        datasets: [
          { label: 'Entradas', data: invIn },
          { label: 'Salidas', data: invOut }
        ]
      },
      options: {
        scales: { y: { beginAtZero: true } },
        plugins: { legend: { position: 'bottom' } }
      }
    };

    window.hnCharts?.decorate(invCfg);
    new Chart(document.getElementById('invChart'), invCfg);

    const quoteLabels = @Html.Raw(Model.QuoteSalesLabelsJson);
    const quoteValues = @Html.Raw(Model.QuoteSalesValuesJson);
    const qSalesCfg = {
      type: 'bar',
      data: {
        labels: quoteLabels,
        datasets: [{ label: 'Ventas aceptadas', data: quoteValues }]
      },
      options: { scales: { y: { beginAtZero: true } }, plugins: { legend: { position: 'bottom' } } }
    };
    window.hnCharts?.decorate(qSalesCfg);
    new Chart(document.getElementById('quoteSalesChart'), qSalesCfg);

    const tkLabels = @Html.Raw(Model.TicketsClosedLabelsJson);
    const tkValues = @Html.Raw(Model.TicketsClosedValuesJson);
    const tkCfg = {
      type: 'line',
      data: { labels: tkLabels, datasets: [{ label: 'Tickets cerrados', data: tkValues, tension: 0.25 }] },
      options: { scales: { y: { beginAtZero: true } } }
    };
    window.hnCharts?.decorate(tkCfg);
    new Chart(document.getElementById('ticketsClosedChart'), tkCfg);

    const topLabels = @Html.Raw(Model.TopVarLabelsJson);
    const topValues = @Html.Raw(Model.TopVarValuesJson);
    const topColors = ['#2563eb', '#14b8a6', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6', '#0ea5e9', '#84cc16'];
    const topCfg = {
      type: 'bar',
      data: {
        labels: topLabels,
        datasets: [{
          label: 'Variable %',
          data: topValues,
          backgroundColor: topValues.map((_, i) => topColors[i % topColors.length]),
          borderRadius: 8
        }]
      },
      options: {
        indexAxis: 'y',
        scales: { x: { beginAtZero: true, max: 100 } },
        plugins: {
          legend: { display: false },
          tooltip: { enabled: false }
        }
      }
    };
    window.hnCharts?.decorate(topCfg);
    new Chart(document.getElementById('topVarChart'), topCfg);
</script>
