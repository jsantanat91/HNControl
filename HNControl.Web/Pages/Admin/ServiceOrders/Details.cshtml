@page "{id:guid}"
@model HNControl.Web.Pages.Admin.ServiceOrders.DetailsModel
@{
    ViewData["Title"] = "Orden de Servicio";
}

@if (Model.Order == null)
{
    <div class="alert alert-danger">Orden no encontrada.</div>
    return;
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h2 class="mb-1">Orden de Servicio</h2>
        <div class="text-muted">
            Cliente: <strong>@(Model.Order.Client?.Name ?? "-")</strong>
            · Tipo: <strong>@Model.Order.Type</strong>
            · Status: <strong>@Model.Order.Status</strong>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/ServiceOrders/Index">Volver</a>
        <a class="btn btn-outline-primary" asp-page="/Admin/ServiceOrders/Edit" asp-route-id="@Model.Order.Id">Editar</a>
        <a class="btn btn-primary" target="_blank" href="@Model.PublicUrl">Link cliente</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 fw-semibold">Acciones</div>
            <div class="card-body d-flex flex-wrap gap-2">
                <form method="post">
                    <input type="hidden" name="id" value="@Model.Order.Id" />
                    <button class="btn btn-outline-primary" type="submit" formaction="?handler=GeneratePdf">Generar PDF</button>
                </form>

                @if (Model.Order.Checklist == null || Model.Order.Checklist.Count == 0)
                {
                    <form method="post">
                        <input type="hidden" name="id" value="@Model.Order.Id" />
                        <button class="btn btn-outline-secondary" type="submit" formaction="?handler=ApplyChecklistTemplate">Cargar checklist base</button>
                    </form>
                }

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Order.Id" />
                    <button class="btn btn-outline-secondary" type="submit" formaction="?handler=DownloadPdf">Descargar PDF</button>
                </form>

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Order.Id" />
                    <button class="btn btn-outline-success" type="submit" formaction="?handler=SendEmail">Enviar PDF por correo</button>
                </form>
            </div>

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-header bg-white border-0 fw-semibold d-flex justify-content-between align-items-center">
                <span>Vista previa PDF</span>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary" target="_blank"
                       href="@Url.Page("/Admin/ServiceOrders/DownloadPdf", null, new { id = Model.Order.Id, inline = true }, null)">Abrir</a>
                    <a class="btn btn-sm btn-outline-secondary"
                       href="@Url.Page("/Admin/ServiceOrders/Details", null, new { id = Model.Order.Id, pdfRefresh = 1 }, null)">Actualizar</a>
                </div>
            </div>

            <div class="card-body p-0">
                @if (string.IsNullOrWhiteSpace(Model.Order.PdfStoragePath))
                {
                    <div class="p-3 text-muted">
                        Aún no hay PDF generado. Usa <strong>Generar PDF</strong> (o “Actualizar” para forzar regeneración en esta vista).
                    </div>
                }
                else
                {
                    var refresh = HttpContext.Request.Query.ContainsKey("pdfRefresh");
                    var pdfUrl = Url.Page("/Admin/ServiceOrders/DownloadPdf", null,
                        new { id = Model.Order.Id, inline = true, refresh = refresh }, null);

                    // Cache-buster: cuando refrescamos, forzamos recarga del visor.
                    pdfUrl += refresh ? $"&v={DateTime.UtcNow.Ticks}" : $"&v={(Model.Order.PdfGeneratedAt?.Ticks ?? 0)}";

                    <object data="@pdfUrl" type="application/pdf" style="width:100%; height:650px;">
                        <div class="p-3 text-muted">
                            Tu navegador no pudo mostrar el PDF aquí.
                            <a target="_blank" href="@pdfUrl">Abrir PDF</a>
                        </div>
                    </object>
                }
            </div>

            <div class="card-footer bg-white border-0 text-muted small">
                Si hiciste cambios (checklist/notas/firmas), usa “Actualizar”.
            </div>
        </div>
        </div>

        @if (Model.Order.Status == HNControl.Web.Models.ServiceOrderStatus.InReview)
        {
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-header bg-white border-0 fw-semibold">Validación (Admin)</div>
                <div class="card-body">
                    <form method="post" class="d-grid gap-2">
                        <input type="hidden" name="id" value="@Model.Order.Id" />

                        <label class="form-label text-muted small">Notas (opcional)</label>
                        <textarea class="form-control" rows="3" name="ReviewNotes"
                              placeholder="Ej: faltó evidencia de pruebas, se corrigió canalización, etc.">@Model.Order.AdminReviewNotes</textarea>

                        <div class="d-flex gap-2 mt-2">
                            <button class="btn btn-success" type="submit" formaction="?handler=Approve">Aprobar y finalizar</button>
                            <button class="btn btn-danger" type="submit" formaction="?handler=Reject">Rechazar</button>
                        </div>

                        <div class="text-muted small">
                            Aprobar: marca Finalizado y (si no existe) genera el PDF.
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 fw-semibold">Firma / Evidencias</div>
            <div class="card-body">
                <div class="mb-2">
                    <div class="text-muted small">Firmas registradas:</div>
                    <div>
                        Técnico: <strong>@(Model.Order.Signatures.Any(s => s.Role == HNControl.Web.Models.SignatureRole.Technician) ? "OK" : "Pendiente")</strong>
                        · Cliente: <strong>@(Model.Order.Signatures.Any(s => s.Role == HNControl.Web.Models.SignatureRole.Client) ? "OK" : "Pendiente")</strong>
                    </div>
                </div>

                <div class="text-muted small">Evidencias: <strong>@Model.Order.Evidences.Count</strong></div>
            </div>
        </div>
    </div>
</div>
