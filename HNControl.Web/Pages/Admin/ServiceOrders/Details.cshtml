@page "{id:guid}"
@model HNControl.Web.Pages.Admin.ServiceOrders.DetailsModel
@{
    Layout = "_Layout";
}

@if (Model.Order == null)
{
    <div class="alert alert-warning">Orden no encontrada.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">@Model.Order.Title</h1>
        <div class="text-muted small">
            Cliente: <b>@Model.ClientName</b> · Tipo: <b>@Model.Order.Type</b> · Status: <b>@Model.Order.Status</b>
            @if (Model.Order.EstimatedEndDate != null)
            {
                <span>· SLA: @Model.Order.EstimatedEndDate.Value.ToString("yyyy-MM-dd")</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="../Index">Volver</a>
        <a class="btn btn-outline-primary" href="@Model.PublicUrl" target="_blank" rel="noopener">Link público</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">Checklist</div>
            <div class="card-body table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>#</th><th>Item</th><th>Hecho</th><th>Notas</th></tr></thead>
                    <tbody>
                        @foreach (var i in Model.Checklist)
                        {
                            <tr>
                                <td class="text-muted">@i.Sort</td>
                                <td>@i.Title</td>
                                <td>@(i.Done ? "Sí" : "No")</td>
                                <td class="text-muted">@i.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Evidencias</div>
            <div class="card-body table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Archivo</th><th>Fecha</th><th></th></tr></thead>
                    <tbody>
                        @if (!Model.Evidences.Any())
                        {
                            <tr><td colspan="3" class="text-muted">Sin evidencias</td></tr>
                        }
                        else
                        {
                            foreach (var e in Model.Evidences)
                            {
                                <tr>
                                    <td>@e.Name</td>
                                    <td class="text-muted">@e.Date</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="../DownloadEvidence?evidenceId=@e.Id">Descargar</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">Firmas</div>
            <div class="card-body">
                <div class="mb-2"><b>Técnico:</b> @Model.TechSignature</div>
                <div class="mb-2"><b>Cliente:</b> @Model.ClientSignature</div>
                <div class="text-muted small">Se capturan desde el link público.</div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Acciones</div>
            <div class="card-body d-flex flex-column gap-2">
                <form method="post" asp-page-handler="GeneratePdf">
                    <input type="hidden" name="id" value="@Model.Order.Id" />
                    <button class="btn btn-outline-primary w-100" type="submit">Generar PDF</button>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.Order.PdfStoragePath))
                {
                    <!-- ✅ RELATIVO + handler: no se rompe con /interno -->
                    <a class="btn btn-outline-secondary w-100" href="?handler=DownloadPdf">
                        Descargar PDF
                    </a>
                }

                <form method="post" asp-page-handler="SendEmail">
                    <input type="hidden" name="id" value="@Model.Order.Id" />
                    <button class="btn btn-success w-100" type="submit">Enviar PDF por correo</button>
                </form>
            </div>
        </div>
    </div>
</div>
