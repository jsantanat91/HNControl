@page "{id:guid}"
@using HNControl.Web.Helpers
@using HNControl.Web.Models
@model HNControl.Web.Pages.Admin.ServiceOrders.DetailsModel
@{ ViewData["Title"] = "Orden de servicio"; }
@if (Model.Order == null) { <div class="alert alert-danger">Orden no encontrada.</div> return; }
@{ var order = Model.Order; var state = UiBadges.ServiceOrderStatusBadge(order.Status); var type = UiBadges.ServiceOrderTypeBadge(order.Type); }
<link rel="stylesheet" href="~/css/hn-operations.css" asp-append-version="true" />
<div class="hn-ops hn-order-profile" data-ops-key="order-@order.Id">
    <div class="hn-ops-toolbar"><a class="hn-ops-back" asp-page="/Admin/ServiceOrders/Index" data-module-panel-close><i class="bi bi-arrow-left" aria-hidden="true"></i>Órdenes de servicio</a><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-secondary" asp-page="/Admin/ServiceOrders/Edit" asp-route-id="@order.Id"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Editar orden</a>@if(!string.IsNullOrWhiteSpace(Model.PublicUrl)){<a class="btn btn-primary" target="_blank" rel="noopener" href="@Model.PublicUrl"><i class="bi bi-box-arrow-up-right me-2" aria-hidden="true"></i>Enlace del cliente</a>}</div></div>
    <header class="hn-ops-hero"><div><div class="hn-eyebrow">Orden de servicio · OS-@order.Id.ToString("N")[..8].ToUpperInvariant()</div><h1>@order.Title</h1><p>@(order.Client?.Name ?? "Sin cliente")</p><div class="hn-ops-hero-meta"><span>@type.text</span><span>Creada el @order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></div></div><span class="hn-ops-state" data-status="@order.Status">@state.text</span></header>
    @if (!string.IsNullOrWhiteSpace(Model.Info)) { <div class="alert alert-info mt-3" role="status">@Model.Info</div> }
    <nav class="nav hn-ops-tabs" role="tablist" aria-label="Secciones de la orden"><button type="button" class="btn active" id="order-summary-tab" data-bs-toggle="tab" data-bs-target="#order-summary" role="tab" aria-controls="order-summary" aria-selected="true">Resumen</button><button type="button" class="btn" id="order-delivery-tab" data-bs-toggle="tab" data-bs-target="#order-delivery" role="tab" aria-controls="order-delivery" aria-selected="false">Entrega y firmas</button><button type="button" class="btn" id="order-documents-tab" data-bs-toggle="tab" data-bs-target="#order-documents" role="tab" aria-controls="order-documents" aria-selected="false">PDF y correo</button></nav>
    <div class="tab-content">
        <section class="tab-pane fade show active" id="order-summary" role="tabpanel" aria-labelledby="order-summary-tab" tabindex="0">
            <div class="hn-ops-facts"><div><span>Servicio contratado</span><strong>@(order.ClientServiceContract?.Label ?? "Sin contrato vinculado")</strong></div><div><span>Proyecto</span><strong>@(order.Project?.Title ?? "Sin proyecto vinculado")</strong></div><div><span>Asignado a</span><strong>@(order.AssignedEmployee?.FullName ?? "Sin asignar")</strong></div><div><span>Tomada por</span><strong>@(order.ClaimedByEmployee?.FullName ?? "Por tomar")</strong></div></div>
            <article class="card mb-3"><div class="card-header"><i class="bi bi-card-text me-2" aria-hidden="true"></i>Trabajo a realizar</div><div class="card-body"><div class="hn-ops-description">@(string.IsNullOrWhiteSpace(order.Description) ? "Sin descripción capturada." : order.Description)</div></div></article>
<partial name="_ServiceOrderNotificationNotice" />
@if (Model.CreationNotifications.Exists)
{
    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="fw-semibold mb-1">Avisos de creación de la orden</div>
                <div class="small text-muted">
                    Ingeniería: @(Model.CreationNotifications.EngineeringSent ? "Enviado" : Model.CreationNotifications.EngineeringConfigured ? "Pendiente" : "Sin destinatarios configurados")
                    · Cliente: @(Model.CreationNotifications.ClientSent ? "Enviado" : "Pendiente")
                </div>
            </div>
            @if (Model.CreationNotifications.HasPending)
            {
                <form method="post" asp-page-handler="RetryCreationNotifications" asp-route-id="@Model.Order.Id">
                    <button class="btn btn-outline-primary" type="submit">Reintentar avisos pendientes</button>
                </form>
            }
        </div>
    </div>
}

        @if (Model.Order.Status == HNControl.Web.Models.ServiceOrderStatus.InReview)
        {
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-header bg-white border-0 fw-semibold">Validación (Admin)</div>
                <div class="card-body">
                    <form method="post" asp-page="./Details" asp-route-id="@Model.Order.Id" class="d-grid gap-2">
                        @Html.AntiForgeryToken()

                        <label class="form-label text-muted small">Notas (opcional)</label>
                        <textarea class="form-control" rows="3" name="ReviewNotes"
                              placeholder="Ej: faltó evidencia de pruebas, se corrigió canalización, etc.">@Model.Order.AdminReviewNotes</textarea>

                        <div class="d-flex gap-2 mt-2">
                            <button class="btn btn-success" type="submit" formaction="?handler=Approve">Aprobar y finalizar</button>
                            <button class="btn btn-danger" type="submit" formaction="?handler=Reject">Rechazar</button>
                        </div>

                        <div class="text-muted small">
                            Aprobar: marca Finalizado y (si no existe) genera el PDF.
                        </div>
                    </form>
                </div>
            </div>
        }
<div class="my-3">                @if (!string.IsNullOrWhiteSpace(Model.Order.ClaimedByUserId))
                {
                    <form method="post" asp-page-handler="UnassignTechnician" asp-route-id="@Model.Order.Id"
                          onsubmit="return confirm('¿Desasignar técnico tomado para que otro la pueda tomar?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-warning" type="submit">Desasignar técnico</button>
                    </form>
                }
</div>        </section>
        <section class="tab-pane fade" id="order-delivery" role="tabpanel" aria-labelledby="order-delivery-tab" tabindex="0">
            <article class="card mb-3"><div class="card-body hn-ops-callout"><div><span class="hn-ops-tag">@HNControl.Shared.OrderDeliveryData.Read(order.DeliveryJson).KindLabel</span><h2>Entrega y equipos</h2><p>Router, series, accesorios y modalidad de entrega en esta orden.</p></div><a class="btn btn-primary" asp-page="/ServiceOrders/Delivery" asp-route-id="@order.Id">Ver / capturar entrega<i class="bi bi-arrow-right ms-2" aria-hidden="true"></i></a></div></article>
            <div class="row g-3 mb-3">@foreach(var role in new[]{SignatureRole.Technician, SignatureRole.Client}) { var signature=order.Signatures.FirstOrDefault(s=>s.Role==role); <div class="col-md-6"><article class="card h-100"><div class="card-body"><div class="hn-ops-card-top"><span class="hn-ops-icon"><i class="bi bi-pen" aria-hidden="true"></i></span><span class="hn-ops-state" data-status="@(signature==null?"Created":"Finalized")">@(signature==null?"Pendiente":"Firma registrada")</span></div><h2 class="h6">@(role==SignatureRole.Technician?"Firma del técnico":"Firma del cliente")</h2>@if(signature!=null){<p class="mb-1">@signature.SignedByName</p><small class="text-muted">@signature.SignedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>}else{<p class="text-muted small mb-0">Aún no se ha registrado esta firma.</p>}</div></article></div> }</div>
            <article class="card"><div class="card-header">Evidencias <span class="hn-ops-tag">@order.Evidences.Count</span></div><div class="card-body">@if(!order.Evidences.Any()){<div class="hn-ops-empty"><i class="bi bi-images" aria-hidden="true"></i><p>Aún no hay evidencias adjuntas.</p></div>}else{<div class="hn-ops-files">@foreach(var evidence in order.Evidences){<a asp-page="./DownloadEvidence" asp-route-evidenceId="@evidence.Id"><i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i><span>@evidence.OriginalFileName<small>@evidence.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></span><i class="bi bi-download" aria-hidden="true"></i></a>}</div>}</div></article>
        </section>
        <section class="tab-pane fade" id="order-documents" role="tabpanel" aria-labelledby="order-documents-tab" tabindex="0"><article class="card"><div class="card-header">Documento y envío al cliente</div><div class="card-body d-flex flex-wrap gap-2">
                <form method="post" asp-page-handler="GeneratePdf" asp-route-id="@Model.Order.Id">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-primary" type="submit">Generar PDF</button>
                </form>

                @if (Model.Order.Checklist == null || Model.Order.Checklist.Count == 0)
                {
                    <form method="post" asp-page-handler="ApplyChecklistTemplate" asp-route-id="@Model.Order.Id">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-secondary" type="submit">Cargar checklist base</button>
                    </form>
                }

                <form method="post" asp-page-handler="DownloadPdf" asp-route-id="@Model.Order.Id">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-secondary" type="submit">Descargar PDF</button>
                </form>

                <form method="post" asp-page-handler="SendEmail" asp-route-id="@Model.Order.Id">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-success" type="submit">Enviar PDF por correo</button>
                </form>

                <div class="w-100 rounded border p-3 bg-light small">
                    <div class="fw-semibold mb-1">Destinatarios del PDF</div>
                    <div>Cliente: <strong>@(string.IsNullOrWhiteSpace(Model.PdfEmailRecipient) ? "Sin correo registrado" : Model.PdfEmailRecipient)</strong></div>
                    <div>Copia (CC): @(Model.PdfEmailCopies.Count > 0 ? string.Join(", ", Model.PdfEmailCopies) : "Sin copias configuradas")</div>
                    <div class="text-muted mt-1">Las copias se administran en Configuración → Ingeniería. Se adjunta el PDF actualizado con las firmas registradas.</div>
                    @if (Model.PdfEmailConfigurationError != null)
                    {
                        <div class="text-danger">@Model.PdfEmailConfigurationError</div>
                    }
                </div>

</div></article>        <div class="card shadow-sm border-0 mt-3">
            <div class="card-header bg-white border-0 fw-semibold d-flex justify-content-between align-items-center">
                <span>Vista previa PDF</span>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary" target="_blank"
                       href="@Url.Page("/Admin/ServiceOrders/DownloadPdf", null, new { id = Model.Order.Id, inline = true }, null)">Abrir</a>
                    <a class="btn btn-sm btn-outline-secondary"
                       href="@Url.Page("/Admin/ServiceOrders/Details", null, new { id = Model.Order.Id, pdfRefresh = 1 }, null)">Actualizar</a>
                </div>
            </div>

            <div class="card-body p-0">
                @if (string.IsNullOrWhiteSpace(Model.Order.PdfStoragePath))
                {
                    <div class="p-3 text-muted">
                        Aún no hay PDF generado. Usa <strong>Generar PDF</strong> (o “Actualizar” para forzar regeneración en esta vista).
                    </div>
                }
                else
                {
                    var refresh = HttpContext.Request.Query.ContainsKey("pdfRefresh");
                    var pdfUrl = Url.Page("/Admin/ServiceOrders/DownloadPdf", null,
                        new { id = Model.Order.Id, inline = true, refresh = refresh }, null);

                    // Cache-buster: cuando refrescamos, forzamos recarga del visor.
                    pdfUrl += refresh ? $"&v={DateTime.UtcNow.Ticks}" : $"&v={(Model.Order.PdfGeneratedAt?.Ticks ?? 0)}";

                    <object data="@pdfUrl" type="application/pdf" style="width:100%; height:650px;">
                        <div class="p-3 text-muted">
                            Tu navegador no pudo mostrar el PDF aquí.
                            <a target="_blank" href="@pdfUrl">Abrir PDF</a>
                        </div>
                    </object>
                }
            </div>

            <div class="card-footer bg-white border-0 text-muted small">
                Si hiciste cambios (checklist/notas/firmas), usa “Actualizar”.
            </div>
        </div>

</section></div></div>
@section Scripts { <script src="~/js/hn-operations.js" asp-append-version="true"></script> }
