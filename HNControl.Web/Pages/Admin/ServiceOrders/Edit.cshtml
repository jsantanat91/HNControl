@page "{id:guid}"
@model HNControl.Web.Pages.Admin.ServiceOrders.EditModel
@{
    Layout = "_Layout";
}

@if (Model.Input == null)
{
    <div class="alert alert-warning">Orden no encontrada.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Editar orden</h1>
        <div class="text-muted small">Ajusta lo necesario (cliente, contrato, fechas, técnico, etc.) sin romper trazabilidad.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/ServiceOrders/Details" asp-route-id="@Model.Input.Id">Volver</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="card shadow-sm hn-hover">
    <div class="card-body">
        <input type="hidden" asp-for="Input.Id" />

        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Título</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select class="form-select" asp-for="Input.Status" asp-items="Model.StatusItems"></select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <select class="form-select" asp-for="Input.Type" asp-items="Model.TypeItems"></select>
            </div>

            <div class="col-md-8">
                <label class="form-label">Técnico / Responsable</label>
                <select class="form-select" asp-for="Input.AssignedUserId" asp-items="Model.EmployeeItems"></select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Cliente</label>
                <select class="form-select" asp-for="Input.ClientId" asp-items="Model.ClientItems" id="clientSelect"></select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Proyecto (opcional)</label>
                <select class="form-select" asp-for="Input.ProjectId" asp-items="Model.ProjectItems" id="projectSelect" data-selected="@Model.Input.ProjectId">
                    <option value="">— Sin proyecto —</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Servicio contratado (opcional)</label>
                <select class="form-select" asp-for="Input.ClientServiceContractId" asp-items="Model.ContractItems" id="contractSelect" data-selected="@Model.Input.ClientServiceContractId">
                    <option value="">— Sin contrato ligado —</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Inicio</label>
                <input class="form-control" type="date" asp-for="Input.StartDate" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Fecha esperada fin</label>
                <input class="form-control" type="date" asp-for="Input.ExpectedEndDate" />
            </div>

            <div class="col-12">
                <label class="form-label">Descripción</label>
                <textarea class="form-control" rows="3" asp-for="Input.Description"></textarea>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a class="btn btn-outline-secondary" asp-page="/Admin/ServiceOrders/Details" asp-route-id="@Model.Input.Id">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        async function refreshProjectsAndContracts() {
            const clientId = document.getElementById('clientSelect')?.value;
            const projectSelect = document.getElementById('projectSelect');
            const contractSelect = document.getElementById('contractSelect');
            if (!clientId) return;

            // Projects
            try {
                const r = await fetch(`?handler=Projects&clientId=${clientId}`);
                const items = await r.json();

                // Si el servidor ya tenía valor (por ejemplo al recargar la página), lo guardamos en data-selected.
                const desired = projectSelect.value || projectSelect.dataset.selected;
                projectSelect.querySelectorAll('option[value]:not([value=""])').forEach(o => o.remove());
                items.forEach(x => {
                    const opt = document.createElement('option');
                    opt.value = x.id;
                    opt.textContent = x.text;
                    projectSelect.appendChild(opt);
                });
                if (desired) projectSelect.value = desired;
                projectSelect.dataset.selected = projectSelect.value;
            } catch { }

            await refreshContracts();
        }

        async function refreshContracts() {
            const clientId = document.getElementById('clientSelect')?.value;
            const projectId = document.getElementById('projectSelect')?.value;
            const contractSelect = document.getElementById('contractSelect');
            if (!clientId) return;

            const url = projectId
                ? `?handler=Contracts&clientId=${clientId}&projectId=${projectId}`
                : `?handler=Contracts&clientId=${clientId}`;

            try {
                const r = await fetch(url);
                const items = await r.json();

                const desired = contractSelect.value || contractSelect.dataset.selected;
                contractSelect.querySelectorAll('option[value]:not([value=""])').forEach(o => o.remove());
                items.forEach(x => {
                    const opt = document.createElement('option');
                    opt.value = x.id;
                    opt.textContent = x.text;
                    contractSelect.appendChild(opt);
                });
                if (desired) contractSelect.value = desired;
                contractSelect.dataset.selected = contractSelect.value;
            } catch { }
        }

        document.getElementById('clientSelect')?.addEventListener('change', () => {
            // Cambió cliente: la selección previa puede dejar de ser válida.
            const projectSelect = document.getElementById('projectSelect');
            const contractSelect = document.getElementById('contractSelect');
            if (projectSelect) projectSelect.dataset.selected = '';
            if (contractSelect) contractSelect.dataset.selected = '';
            refreshProjectsAndContracts();
        });
        document.getElementById('projectSelect')?.addEventListener('change', () => {
            const projectSelect = document.getElementById('projectSelect');
            const contractSelect = document.getElementById('contractSelect');
            if (projectSelect) projectSelect.dataset.selected = projectSelect.value;
            if (contractSelect) contractSelect.dataset.selected = '';
            refreshContracts();
        });

        document.getElementById('contractSelect')?.addEventListener('change', () => {
            const contractSelect = document.getElementById('contractSelect');
            if (contractSelect) contractSelect.dataset.selected = contractSelect.value;
        });

        refreshProjectsAndContracts();
    </script>
}
