@page "{id:guid}"
@using HNControl.Web.Services
@model HNControl.Web.Pages.Admin.ServiceOrders.EditModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar orden";
}

@if (Model.Input == null)
{
    <div class="alert alert-warning">Orden no encontrada.</div>
    return;
}

<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Editar orden</h1>
        <div class="text-muted small">Ajusta datos generales; cualquier tecnico podra tomar la orden para trabajarla.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/ServiceOrders/Details" asp-route-id="@Model.Input.Id">Volver</a>
    </div>
            </div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" asp-page="./Edit" asp-route-id="@Model.Input.Id" class="card shadow-soft hn-workflow-form">
    @Html.AntiForgeryToken()
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>
        <input type="hidden" asp-for="Input.Id" />

        <section class="hn-form-section">
            <header class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">01</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Cliente y servicio</span>
                    <span class="hn-form-section-hint">Conserva la relación de la orden con el cliente, proyecto y contrato.</span>
                </span>
            </header>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-md-6">
                <label class="form-label" for="clientSelect">Cliente</label>
                <select class="form-select" asp-for="Input.ClientId" asp-items="Model.ClientItems" id="clientSelect"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="projectSelect">Proyecto (opcional)</label>
                <select class="form-select" asp-for="Input.ProjectId" asp-items="Model.ProjectItems" id="projectSelect" data-selected="@Model.Input.ProjectId">
                    <option value="">-- Sin proyecto --</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label" for="contractSelect">Servicio contratado (opcional)</label>
                <select class="form-select" asp-for="Input.ClientServiceContractId" asp-items="Model.ContractItems" id="contractSelect" data-selected="@Model.Input.ClientServiceContractId">
                    <option value="">-- Sin contrato ligado --</option>
                </select>
                <div class="hn-related-context mt-2" id="relatedDataStatus" role="status" aria-live="polite"></div>
                <button type="button" id="relatedDataRetry" class="hn-field-action" hidden>Reintentar consulta</button>
                <div class="hn-related-context mt-2" id="contractContext"></div>
                <div class="d-flex flex-wrap gap-3">
                    <button type="button" class="hn-field-action" id="useContractProject" hidden>Vincular también el proyecto del contrato</button>
                    <button type="button" class="hn-field-action" id="useContractTitle" hidden>Usar nombre del servicio en el título</button>
                </div>
            </div>
            </div>
        </section>
        <section class="hn-form-section">
            <header class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">02</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Trabajo a realizar</span>
                    <span class="hn-form-section-hint">Información de la intervención y su estado actual.</span>
                </span>
            </header>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-md-12">
                <label class="form-label" asp-for="Input.Title">Título</label>
                <input class="form-control" asp-for="Input.Title" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.Status">Estado</label>
                <select class="form-select" asp-for="Input.Status" asp-items="Model.StatusItems"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="orderTypeSelect">Tipo</label>
                @if (Model.WorkItems.Count > 0 || Model.Input.Type == HNControl.Web.Models.ServiceOrderType.Global)
                {
                    <select id="orderTypeSelect" class="form-select" asp-for="Input.Type" asp-items="Model.TypeItems" disabled></select>
                    <input type="hidden" asp-for="Input.Type" />
                    <div class="text-muted small mt-1">Esta orden es <strong>Global</strong>. El tipo real se maneja por actividad.</div>
                }
                else
                {
                    <select id="orderTypeSelect" class="form-select" asp-for="Input.Type" asp-items="Model.TypeItems"></select>
                }
            </div>
            <div class="col-12">
                <label class="form-label" asp-for="Input.Description">Descripción</label>
                <textarea class="form-control" rows="3" asp-for="Input.Description"></textarea>
            </div>
            </div>
        </section>
        <section class="hn-form-section">
            <header class="hn-form-section-heading">
                <span class="hn-form-step" aria-hidden="true">03</span>
                <span>
                    <span class="hn-form-section-title" role="heading" aria-level="2">Programación</span>
                    <span class="hn-form-section-hint">Fechas de atención y término esperado.</span>
                </span>
            </header>
            <div class="row g-3 hn-form-section-fields">
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.AssignedUserId">Responsable inicial (opcional)</label>
                <select class="form-select" asp-for="Input.AssignedUserId" asp-items="Model.EmployeeItems">
                    <option value="">-- Sin responsable inicial --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Input.StartDate">Inicio</label>
                <input class="form-control" type="date" asp-for="Input.StartDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Input.ExpectedEndDate">Término esperado</label>
                <input class="form-control" type="date" asp-for="Input.ExpectedEndDate" />
            </div>
            </div>
        </section>
    </div>

    <div class="card-footer d-flex flex-wrap gap-2 hn-form-actions">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a class="btn btn-outline-secondary" asp-page="/Admin/ServiceOrders/Details" asp-route-id="@Model.Input.Id">Cancelar</a>
    </div>
</form>

<div class="card shadow-soft hn-hover mt-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="fw-semibold">Orden global (actividades)</div>
                <div class="text-muted small">
                    Para un solo ticket del cliente con varios trabajos (ej: preventivo + camara nueva), agrega <strong>actividades</strong>.
                    Cada actividad tiene su checklist y campos abiertos del tecnico.
                </div>
            </div>

            @if (Model.WorkItems.Count == 0 && Model.Input.Type != HNControl.Web.Models.ServiceOrderType.Global)
            {
                <form method="post" asp-page-handler="ConvertToGlobal" asp-route-id="@Model.Input.Id">
                    <button class="btn btn-outline-primary" type="submit">Convertir a Global</button>
                </form>
            }
        </div>

        @if (Model.WorkItems.Count > 0 || Model.Input.Type == HNControl.Web.Models.ServiceOrderType.Global)
        {
            <hr />

            <form method="post" asp-page-handler="AddWorkItem" asp-route-id="@Model.Input.Id" class="row g-2 align-items-end" novalidate>
                <div class="col-12">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Tipo</label>
                    <select class="form-select" asp-for="NewWorkItem.Type" asp-items="Model.WorkTypeItems"></select>
                    <span asp-validation-for="NewWorkItem.Type" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Titulo de la actividad</label>
                    <input class="form-control" asp-for="NewWorkItem.Title" placeholder="Ej: Mantenimiento preventivo" />
                    <span asp-validation-for="NewWorkItem.Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Descripción</label>
                    <input class="form-control" asp-for="NewWorkItem.Description" placeholder="Ej: revision, limpieza, pruebas" />
                    <span asp-validation-for="NewWorkItem.Description" class="text-danger small"></span>
                </div>

                <div class="col-md-1 d-grid">
                    <button class="btn btn-primary" type="submit">Agregar</button>
                </div>
            </form>

            @if (Model.WorkItems.Count > 0)
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle">
                        <thead>
                        <tr>
                            <th style="width:50px">#</th>
                            <th style="width:240px">Tipo</th>
                            <th>Titulo</th>
                            <th style="width:110px"></th>
                        </tr>
                        </thead>
                        <tbody>
                        @for (var i = 0; i < Model.WorkItems.Count; i++)
                        {
                            var w = Model.WorkItems[i];
                            <tr>
                                <td>@(w.SortOrder + 1)</td>
                                <td>@w.Type.GetDisplayName()</td>
                                <td>
                                    <div class="fw-semibold">@w.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(w.Description))
                                    {
                                        <div class="text-muted small">@w.Description</div>
                                    }
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="DeleteWorkItem" asp-route-id="@Model.Input.Id" class="d-inline">
                                        <input type="hidden" name="workItemId" value="@w.Id" />
                                        <button class="btn btn-outline-danger btn-sm" type="submit"
                                                onclick="return confirm('Borrar actividad? Se eliminara su checklist.');">
                                            Borrar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-muted small mt-2">Aun no hay actividades. Agrega la primera arriba.</div>
            }
        }
    </div>
            </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="application/json" id="contractOptions">@Html.Raw(global::System.Text.Json.JsonSerializer.Serialize(Model.ContractOptions, new global::System.Text.Json.JsonSerializerOptions(global::System.Text.Json.JsonSerializerDefaults.Web)))</script>
    <script src="~/js/hn-related-records.js" asp-append-version="true"></script>
}



