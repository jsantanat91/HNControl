@page
@model HNControl.Web.Pages.Admin.ServiceOrders.IndexModel
@{
    Layout = "_Layout";

    ViewData["Title"] = "Órdenes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Órdenes de Servicio</h1>
        <div class="text-muted small">Admin crea · técnico/cliente llenan por link público</div>
    </div>
    <a class="btn btn-primary" asp-page="/Admin/ServiceOrders/Create">+ Nueva orden</a>
</div>

<div class="card shadow-soft hn-hover">
    <div class="card-body table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Proyecto</th>
                    <th>Servicio</th>
                    <th>Título</th>
                    <th>Tipo</th>
                    <th>Status</th>
                    <th>Asignado</th>
                    <th>Link público</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Rows)
                {
                    <tr>
                        <td>@o.ClientName</td>
                        <td class="text-muted">@o.ProjectTitle</td>
                        <td class="text-muted">@o.ContractLabel</td>
                        <td>@o.Title</td>
                        <td>@o.Type</td>
                        <td><span class="fw-semibold">@o.Status</span></td>
                        <td class="text-muted">@o.Assigned</td>
                        <td>
                            <a href="@o.PublicUrl" target="_blank">Abrir</a>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/ServiceOrders/Details" asp-route-id="@o.Id">Admin</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
