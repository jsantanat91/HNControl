@page
@using HNControl.Web.Helpers
@model HNControl.Web.Pages.Admin.ServiceOrders.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Órdenes";
}

<link rel="stylesheet" href="~/css/hn-operations.css" asp-append-version="true" />
<div class="hn-ops">
<div class="hn-ops-heading">
    <div>
        <h1 class="h4 m-0">Órdenes de Servicio</h1>
        <div class="text-muted small">Vista operativa con tipo, estado y responsable actual.</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" href="/Ventas/Factibilidad" data-module-panel="Factibilidad en sitio">Factibilidad</a>
        <a class="btn btn-outline-secondary" asp-page="/Projects/Delivery/Index">Entregas anteriores</a>
        <a class="btn btn-primary" asp-page="/Admin/ServiceOrders/Create">+ Nueva orden</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Flash))
{
    var alertClass = Model.Flash.Contains("No se pudo", StringComparison.OrdinalIgnoreCase)
        || Model.Flash.Contains("No se encontr", StringComparison.OrdinalIgnoreCase)
            ? "alert-warning"
            : "alert-success";
    <div class="alert @alertClass mb-3">@Model.Flash</div>
}

<form method="get" class="card hn-ops-filter mb-4">
    <div class="card-body row g-2 align-items-end mx-0">
        <div class="col-6 col-xl-2"><label class="form-label">Desde</label><input class="form-control" type="date" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-6 col-xl-2"><label class="form-label">Hasta</label><input class="form-control" type="date" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-6 col-xl-2">
            <label class="form-label">Tipo</label>
            <select class="form-select" name="Type">
                <option value="">Todos</option>
                @foreach (var t in Model.TypeOptions)
                {
                    var lbl = UiBadges.ServiceOrderTypeBadge(t).text;
                    <option value="@t" selected="@(Model.Type == t)">@lbl</option>
                }
            </select>
        </div>
        <div class="col-6 col-xl-2">
            <label class="form-label">Estatus</label>
            <select class="form-select" name="Status">
                <option value="">Todos</option>
                @foreach (var st in Model.StatusOptions)
                {
                    var lbl = UiBadges.ServiceOrderStatusBadge(st).text;
                    <option value="@st" selected="@(Model.Status == st)">@lbl</option>
                }
            </select>
        </div>
        <div class="col-6 col-xl-1"><label class="form-label">Por p&aacute;gina</label><select class="form-select" name="PageSize">@foreach (var s in new[] { 10,20,50,100 }) {<option value="@s" selected="@(Model.PageSize==s)">@s</option>}</select></div>
        <div class="col-12 col-xl-2 d-flex gap-2 justify-content-start flex-wrap">
            <button class="btn btn-primary" type="submit">Filtrar</button>
            <a class="btn btn-outline-secondary" asp-page="/Admin/ServiceOrders/Index">Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Rows.Any())
{
    <div class="alert alert-light border">No hay &oacute;rdenes para los filtros seleccionados.</div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
        @foreach (var o in Model.Rows)
        {
            var type = UiBadges.ServiceOrderTypeBadge(o.Type);
            var status = UiBadges.ServiceOrderStatusBadge(o.Status);
            <div class="col d-flex">
                <article class="card hn-order-card w-100" data-status="@o.Status">
                    <div class="card-body d-flex flex-column">
                        <div class="hn-ops-card-top"><span class="hn-ops-reference">OS-@o.Id.ToString("N")[..8].ToUpperInvariant()</span><span class="hn-ops-state" data-status="@o.Status">@status.text</span></div>
                        <div class="hn-order-identity"><span class="hn-ops-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span><div><h2>@o.Title</h2><p>@o.ClientName</p></div></div>
                        <div class="hn-order-type"><i class="bi bi-tag" aria-hidden="true"></i>@type.text</div>
                        @if (!string.IsNullOrWhiteSpace(o.ContractLabel) && o.ContractLabel != "-" && o.ContractLabel != o.Title) { <div class="hn-order-reference"><span>Servicio contratado</span><strong>@o.ContractLabel</strong></div> }
                        @if (!string.IsNullOrWhiteSpace(o.ProjectTitle) && o.ProjectTitle != "-") { <div class="hn-order-reference"><span>Proyecto</span><strong>@o.ProjectTitle</strong></div> }
                        <div class="hn-order-team"><div><span>Asignado a</span><strong>@(o.Assigned == "-" ? "Sin asignar" : o.Assigned)</strong></div><div><span>Tomada por</span><strong>@(o.ClaimedBy == "-" ? "Por tomar" : o.ClaimedBy)</strong>@if(o.ClaimedAt.HasValue){<small>@o.ClaimedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>}</div></div>
                        <div class="hn-ops-date"><i class="bi bi-calendar3" aria-hidden="true"></i>Creada el @o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                        <div class="hn-ops-card-actions mt-auto">
                            <a class="btn btn-sm hn-ops-open" asp-page="/Admin/ServiceOrders/Details" asp-route-id="@o.Id" data-module-panel="Orden · @o.Title">Ver orden<i class="bi bi-window ms-2" aria-hidden="true"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/ServiceOrders/DownloadPdf" asp-route-id="@o.Id" asp-route-inline="false"><i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>PDF</a>
                            @if(Model.IsSuperAdmin) {
                            <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('¿Eliminar esta orden de servicio? Esta acción no se puede deshacer.');">
                                <input type="hidden" name="id" value="@o.Id" />
                                <input type="hidden" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="Type" value="@Model.Type?.ToString()" />
                                <input type="hidden" name="Status" value="@Model.Status?.ToString()" />
                                <input type="hidden" name="Page" value="@Model.Page" />
                                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar orden" aria-label="Eliminar orden @o.Title"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </form>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Total: @Model.TotalCount · P&aacute;gina @Model.Page de @Model.TotalPages</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-page="/Admin/ServiceOrders/Index" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-Type="@(Model.Type?.ToString())" asp-route-Status="@(Model.Status?.ToString())" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page-1)">Anterior</a>
        <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-page="/Admin/ServiceOrders/Index" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-Type="@(Model.Type?.ToString())" asp-route-Status="@(Model.Status?.ToString())" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page+1)">Siguiente</a>
    </div>
</div>

</div>
