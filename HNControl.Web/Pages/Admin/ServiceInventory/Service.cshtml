@page "{id:guid?}"
@model HNControl.Web.Pages.Admin.ServiceInventory.ServiceModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Administrar servicio" : "Nuevo servicio";
    var starlinkPlanTypes = ServiceInventoryDisplay.GetPlanTypes("starlink");
    var otherPlanTypes = ServiceInventoryDisplay.GetPlanTypes("telmex");
    var sharedPlanTypes = starlinkPlanTypes.Intersect(otherPlanTypes).ToArray();
    var planTypes = starlinkPlanTypes.Except(sharedPlanTypes).Concat(otherPlanTypes.Except(sharedPlanTypes)).Concat(sharedPlanTypes);
}
<link rel="stylesheet" href="~/css/service-inventory.css" asp-append-version="true" />
<div class="service-inventory inv-editor">
    <header class="inv-header"><div><div class="inv-eyebrow">INVENTARIO SERVICIOS · CONEXIONES</div><h1>@ViewData["Title"]<span>.</span></h1><p>Registra la conexión, su equipo y el cliente que la utiliza.</p></div><a class="btn btn-light" asp-page="Index">Volver al inventario</a></header>
    <form method="post" class="inv-form">
        <input type="hidden" asp-for="Input.RecordId" /><input type="hidden" asp-for="Input.Version" />
        <div asp-validation-summary="All" class="text-danger inv-validation" role="alert"></div>
        <section class="inv-section"><div class="inv-section-heading"><span>01</span><div><h2>Proveedor y asignación</h2><p>Selecciona el proveedor, el tipo de servicio y su cliente.</p></div></div>
            <div class="inv-provider-picker" role="group" aria-label="Seleccionar proveedor">
                @foreach (var provider in ServiceInventoryCatalog.Carriers) {
                    <button type="button" class="inv-provider-choice @(Model.Input.CarrierKey == provider.Id ? "is-selected" : "")" data-provider-choice="@provider.Id" aria-pressed="@(Model.Input.CarrierKey == provider.Id ? "true" : "false")">
                        <span class="inv-provider-logo inv-logo-@provider.Id">@if (!string.IsNullOrEmpty(provider.LogoPath)) { <img src="@provider.LogoPath" alt="" /> } else { <span aria-hidden="true">＋</span> }</span>
                        <span>@(provider.Id == "otro" ? "Otro proveedor" : provider.Name)</span>
                    </button>
                }
            </div>
            <div class="inv-fields inv-fields-3 inv-provider-fields">
                <div><label asp-for="Input.CarrierKey">Proveedor</label><select asp-for="Input.CarrierKey" class="form-select" data-carrier-selector>@foreach (var carrier in ServiceInventoryCatalog.Carriers) { <option value="@carrier.Id">@(carrier.Id == "otro" ? "Otro proveedor" : carrier.Name)</option> }</select><span asp-validation-for="Input.CarrierKey" class="text-danger"></span></div>
                <div><label asp-for="Input.PlanType">Tipo de plan</label><select asp-for="Input.PlanType" class="form-select" data-plan-selector><option value="">Seleccionar tipo de plan</option>@foreach (var plan in planTypes) { <option value="@plan" data-provider-kind="@(sharedPlanTypes.Contains(plan) ? "shared" : starlinkPlanTypes.Contains(plan) ? "starlink" : "other")">@plan</option> }@if (!string.IsNullOrEmpty(Model.LegacyPlanType)) { <option value="@Model.LegacyPlanType" data-provider-kind="legacy" data-original-provider="@Model.LegacyCarrierKey">@Model.LegacyPlanType · valor anterior</option> }</select><span asp-validation-for="Input.PlanType" class="text-danger"></span>@if (!string.IsNullOrEmpty(Model.SuggestedPlanType)) { <button type="button" class="inv-text-button" data-suggest-plan="@Model.SuggestedPlanType">Usar @Model.SuggestedPlanType como tipo de plan</button> }</div>
                <div><label asp-for="Input.DeliveryType">Tipo de conexión</label><select asp-for="Input.DeliveryType" class="form-select" data-connection-selector><option value="">Seleccionar conexión</option>@foreach (var connection in ServiceInventoryDisplay.GetDeliveryTypes("starlink")) { <option value="@connection" data-provider-kind="starlink">@connection</option> }@foreach (var connection in ServiceInventoryDisplay.GetDeliveryTypes("telmex")) { <option value="@connection" data-provider-kind="other">@connection</option> }@if (!string.IsNullOrEmpty(Model.LegacyDeliveryType) && Model.Input.CarrierKey != "starlink") { <option value="@Model.LegacyDeliveryType" data-provider-kind="legacy" data-original-provider="@Model.LegacyCarrierKey">@Model.LegacyDeliveryType · valor anterior</option> }</select><span asp-validation-for="Input.DeliveryType" class="text-danger"></span><small data-starlink-help>Starlink utiliza conexión satelital.</small></div>
            </div>
            <div class="inv-fields inv-assignment-fields">
            <div data-other-carrier><label asp-for="Input.OtherCarrierName">Nombre del proveedor</label><input asp-for="Input.OtherCarrierName" class="form-control" maxlength="120" /><span asp-validation-for="Input.OtherCarrierName" class="text-danger"></span></div>
            <div><label asp-for="Input.Name">Nombre del servicio</label><input asp-for="Input.Name" class="form-control" maxlength="180" placeholder="Ej. Starlink Mini · Unidad de eventos" /><span asp-validation-for="Input.Name" class="text-danger"></span></div>
            <div><label asp-for="Input.AccountId">Cuenta del proveedor</label><select asp-for="Input.AccountId" class="form-select" data-inventory-account data-accounts-url="?handler=Accounts"><option value="">Sin cuenta vinculada</option>@foreach (var account in Model.Accounts) { <option value="@account.Id" data-carrier="@account.CarrierKey" data-account-number="@account.AccountNumber" data-other-name="@account.OtherCarrierName">@account.Label · @account.Email@(account.IsActive ? "" : " (inactiva)")</option> }</select><span asp-validation-for="Input.AccountId" class="text-danger"></span><small id="inventory-account-hint">Registra una cuenta del proveedor para poder vincularla.</small><div class="inv-account-tools"><a asp-page="Account" asp-route-carrier="@Model.Input.CarrierKey" target="_blank" rel="noopener noreferrer" data-new-account-link>+ Nueva cuenta ↗</a><button type="button" data-refresh-accounts>Actualizar cuentas</button></div><small id="inventory-account-feedback" role="status" aria-live="polite"></small></div>
            <div><label asp-for="Input.ClientId">Cliente asignado</label><select asp-for="Input.ClientId" asp-items="Model.Clients" class="form-select"><option value="">Sin asignar · Disponible</option></select><span asp-validation-for="Input.ClientId" class="text-danger"></span></div>
            <div class="inv-span-2"><label asp-for="Input.PhysicalLocation">Ubicación física</label><input asp-for="Input.PhysicalLocation" class="form-control" maxlength="500" placeholder="Sucursal, dirección, almacén o unidad donde está instalado" /></div>
        </div></section>
        <section class="inv-section"><div class="inv-section-heading"><span>02</span><div><h2>Plan y equipo</h2><p>Características contratadas y datos para identificar el dispositivo.</p></div></div><div class="inv-fields inv-fields-3">
            <div><label asp-for="Input.PlanName">Nombre del plan</label><select asp-for="Input.PlanName" class="form-select" data-plan-name-selector><option value="">Seleccionar plan</option>@foreach (var planName in ServiceInventoryDisplay.GetPlanNames("starlink")) { <option value="@planName" data-provider-kind="starlink">@planName</option> }@foreach (var planName in ServiceInventoryDisplay.GetPlanNames("telmex")) { <option value="@planName" data-provider-kind="other">@planName</option> }@if (!string.IsNullOrEmpty(Model.LegacyPlanName)) { <option value="@Model.LegacyPlanName" data-provider-kind="legacy" data-original-provider="@Model.LegacyCarrierKey">@Model.LegacyPlanName · valor anterior</option> }</select><span asp-validation-for="Input.PlanName" class="text-danger"></span></div>
            <div><label asp-for="Input.SpeedMbps">Velocidad (Mbps)</label><input asp-for="Input.SpeedMbps" class="form-control" type="number" min="0.01" max="1000000" step="0.01" /><span asp-validation-for="Input.SpeedMbps" class="text-danger"></span></div>
            <div><label asp-for="Input.MonthlyCost">Costo mensual (MXN)</label><div class="input-group"><span class="input-group-text">$</span><input asp-for="Input.MonthlyCost" class="form-control" type="number" min="0" max="999999999.99" step="0.01" /></div><span asp-validation-for="Input.MonthlyCost" class="text-danger"></span><small>Importe final facturado por el proveedor.</small></div>
            <div><label asp-for="Input.AccountNumber">Número de servicio / línea</label><input asp-for="Input.AccountNumber" class="form-control" maxlength="120" /><small>Solo si es distinto al número de la cuenta vinculada.</small></div>
            <div><label asp-for="Input.DeviceModel">Modelo de antena / equipo</label><input asp-for="Input.DeviceModel" class="form-control" maxlength="120" list="starlink-models" /><datalist id="starlink-models">@foreach (var antenna in ServiceInventoryCatalog.StarlinkModels) { <option value="@antenna.Value" label="@antenna.Label"></option> }</datalist><small data-starlink-help>Modelos oficiales sugeridos. También puedes escribir tu modelo o referencia interna (V1–V4).</small></div>
            <div><label asp-for="Input.SerialNumber">Número de serie</label><input asp-for="Input.SerialNumber" class="form-control" maxlength="120" /></div>
            <div data-starlink-kit hidden="@(Model.Input.CarrierKey != "starlink")"><label asp-for="Input.KitNumber">Número de kit</label><input asp-for="Input.KitNumber" class="form-control" maxlength="120" placeholder="Ej. KIT…" disabled="@(Model.Input.CarrierKey != "starlink")" /></div>
        </div></section>
        <section class="inv-section"><div class="inv-section-heading"><span>03</span><div><h2>Soporte y datos de red</h2><p>El contacto de soporte siempre queda a la mano.</p></div></div>
            <div class="inv-support-row"><div><label asp-for="Input.SupportPhone">Soporte del proveedor</label><input asp-for="Input.SupportPhone" class="form-control" maxlength="60" data-support-input placeholder="Teléfono o canal de atención" readonly="@(Model.Input.CarrierKey == "starlink" ? "readonly" : null)" /><small data-starlink-help>Online · desde la aplicación o el portal de Starlink.</small></div><a href="https://www.starlink.com/support" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary" data-starlink-help>Ir a soporte Starlink ↗</a></div>
            <div class="inv-network-toggle"><input asp-for="Input.HasNetworkDetails" class="form-check-input" data-network-toggle aria-controls="inventory-network-fields" aria-expanded="@(Model.Input.HasNetworkDetails ? "true" : "false")" /><label asp-for="Input.HasNetworkDetails"><strong>Configurar datos de red</strong><span>IP, máscara, gateway, DNS, LAN y DDNS. Al cerrar esta sección se conservan los datos guardados.</span></label><span class="inv-optional-badge">Opcional</span></div>
            <div id="inventory-network-fields" class="inv-fields inv-fields-3 inv-network-fields" data-network-fields hidden="@(!Model.Input.HasNetworkDetails)">
            <div><label asp-for="Input.FixedIp">IP fija / pública</label><input asp-for="Input.FixedIp" class="form-control" maxlength="64" placeholder="Ej. 203.0.113.10" /><span asp-validation-for="Input.FixedIp" class="text-danger"></span></div>
            <div><label asp-for="Input.SubnetMask">Máscara de red</label><input asp-for="Input.SubnetMask" class="form-control" maxlength="64" placeholder="Ej. 255.255.255.248" /><span asp-validation-for="Input.SubnetMask" class="text-danger"></span></div>
            <div><label asp-for="Input.Gateway">Gateway</label><input asp-for="Input.Gateway" class="form-control" maxlength="64" /><span asp-validation-for="Input.Gateway" class="text-danger"></span></div>
            <div><label asp-for="Input.Dns">DNS</label><input asp-for="Input.Dns" class="form-control" maxlength="200" placeholder="Ej. 1.1.1.1, 8.8.8.8" /><span asp-validation-for="Input.Dns" class="text-danger"></span></div>
            <div><label asp-for="Input.Lan">Red LAN</label><input asp-for="Input.Lan" class="form-control" maxlength="80" placeholder="Ej. 192.168.1.0/24" /></div>
            <div><label asp-for="Input.Ddns">DDNS / nombre de host</label><input asp-for="Input.Ddns" class="form-control" maxlength="253" placeholder="Ej. sucursal.ejemplo.net" /></div>
        </div></section>
        <section class="inv-section"><div class="inv-section-heading"><span>04</span><div><h2>Plazo y control</h2><p>Consulta vencimientos y conserva el historial de tus servicios.</p></div></div><div class="inv-fields inv-fields-3">
            <div><label asp-for="Input.ContractStartsOn">Inicio del contrato</label><input asp-for="Input.ContractStartsOn" class="form-control" type="date" /></div>
            <div><label asp-for="Input.ContractMonths">Plazo contratado (meses)</label><input asp-for="Input.ContractMonths" class="form-control" type="number" min="1" max="240" /><span asp-validation-for="Input.ContractMonths" class="text-danger"></span><small>Déjalo vacío si no existe plazo forzoso.</small></div>
            <div class="inv-term-summary"><label for="inventory-contract-end">Fin del contrato</label><output id="inventory-contract-end" class="inv-term-result" data-contract-end data-stored-end="@(Model.HasLegacyContractEnd && Model.Input.ContractEndsOn.HasValue ? Model.StoredContractEnd?.ToString("yyyy-MM-dd") : null)" data-original-start="@Model.Input.ContractStartsOn?.ToString("yyyy-MM-dd")" data-original-months="@Model.Input.ContractMonths" aria-live="polite">@(Model.Input.ContractEndsOn?.ToString("dd/MM/yyyy") ?? "Sin plazo definido")</output><small data-contract-end-hint>@(Model.HasLegacyContractEnd && Model.Input.ContractEndsOn.HasValue ? "Fecha registrada anteriormente. Completa inicio y plazo para recalcularla." : "Se calcula automáticamente con el inicio y el plazo.")</small><span asp-validation-for="Input.ContractEndsOn" class="text-danger"></span></div>
            <div class="inv-span-all"><label asp-for="Input.Notes">Notas internas</label><textarea asp-for="Input.Notes" class="form-control" rows="3" maxlength="3000" placeholder="Referencias, condiciones o indicaciones operativas. No agregues contraseñas aquí."></textarea></div>
        </div><div class="form-check form-switch inv-state-switch"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Servicio activo</label></div><p class="inv-help">Un servicio inactivo conserva su información y asignación. Puedes reactivarlo en cualquier momento.</p></section>
        <footer class="inv-form-footer"><a class="btn btn-light" asp-page="Index">Cancelar</a><button type="submit" class="btn btn-primary">@(Model.Id.HasValue ? "Guardar cambios" : "Guardar servicio")</button></footer>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/service-inventory.js" asp-append-version="true"></script> }
