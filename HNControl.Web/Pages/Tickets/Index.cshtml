@page
@model HNControl.Web.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Tickets ITIL</h1>
        <div class="text-muted small">Flujo operativo con SLA de 8 horas. Todos ven tickets, cualquier empleado puede cerrarlos.</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" href="/ticket-publico" target="_blank" rel="noopener">Portal público</a>
        @if (Model.IsAdmin)
        {
            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#reportModal">Reporte PDF</button>
            <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#newTicketModal">Nuevo ticket</button>
        }
        <a class="btn @(Model.StatusFilter == "open" ? "btn-primary" : "btn-outline-secondary")" href="?status=open&q=@Model.Search">Abiertos</a>
        <a class="btn @(Model.StatusFilter == "mine" ? "btn-primary" : "btn-outline-secondary")" href="?status=mine&q=@Model.Search">Míos</a>
        <a class="btn @(Model.StatusFilter == "closed" ? "btn-primary" : "btn-outline-secondary")" href="?status=closed&q=@Model.Search">Cerrados</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.UiMessage))
{
    <div class="alert alert-@(Model.UiMessageType ?? "info")">@Model.UiMessage</div>
}

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card shadow-soft"><div class="card-body"><div class="text-muted small">Abiertos</div><div class="fs-3 fw-bold">@Model.OpenCount</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-soft"><div class="card-body"><div class="text-muted small">Asignados a mí</div><div class="fs-3 fw-bold">@Model.MineCount</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-soft"><div class="card-body"><div class="text-muted small">SLA vencido</div><div class="fs-3 fw-bold text-danger">@Model.BreachCount</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-soft"><div class="card-body"><div class="text-muted small">Auto-monitoreo</div><div class="fs-3 fw-bold text-warning">@Model.AutoCount</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-soft"><div class="card-body"><div class="text-muted small">Respuesta promedio (30d)</div><div class="fs-4 fw-bold">@Model.AvgFirstResponseMinutes min</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-soft"><div class="card-body"><div class="text-muted small">Resolución promedio (30d)</div><div class="fs-4 fw-bold">@Model.AvgResolutionHours h</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-soft"><div class="card-body"><div class="text-muted small">Cumplimiento SLA (30d)</div><div class="fs-4 fw-bold text-success">@Model.SlaCompliancePercent%</div></div></div></div>
</div>

<form method="get" class="card shadow-soft mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label">Filtro</label>
                <select class="form-select" name="status">
                    <option value="open" selected="@(Model.StatusFilter=="open")">Abiertos</option>
                    <option value="mine" selected="@(Model.StatusFilter=="mine")">Míos</option>
                    <option value="closed" selected="@(Model.StatusFilter=="closed")">Cerrados</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Buscar</label>
                <input class="form-control" name="q" value="@Model.Search" placeholder="Ticket, cliente o título" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary w-100">Filtrar</button>
            </div>
        </div>
    </div>
</form>

<div class="row g-3">
@if (!Model.Groups.Any())
{
    <div class="col-12"><div class="alert alert-light border">Sin tickets para este filtro.</div></div>
}
else
{
    @foreach (var g in Model.Groups)
    {
        <div class="col-12">
            <div class="card shadow-soft">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">@g.Client</div>
                    <div class="d-flex gap-2">
                        <span class="hn-chip hn-chip-neutral">Abiertos: @g.OpenCount</span>
                        @if (g.BreachCount > 0)
                        {
                            <span class="hn-chip hn-chip-priority-critical">SLA vencido: @g.BreachCount</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var t in g.Tickets)
                        {
                            var statusClass = t.Status switch
                            {
                                HNControl.Web.Models.TicketStatus.New => "hn-chip-type",
                                HNControl.Web.Models.TicketStatus.Assigned => "hn-chip-type",
                                HNControl.Web.Models.TicketStatus.InProgress => "hn-chip-status-progress",
                                HNControl.Web.Models.TicketStatus.Resolved => "hn-chip-status-up",
                                HNControl.Web.Models.TicketStatus.Closed => "hn-chip-status-closed",
                                _ => "hn-chip-neutral"
                            };
                            var priorityClass = t.Priority switch
                            {
                                HNControl.Web.Models.TicketPriority.Critical => "hn-chip-priority-critical",
                                HNControl.Web.Models.TicketPriority.High => "hn-chip-priority-high",
                                HNControl.Web.Models.TicketPriority.Medium => "hn-chip-priority-medium",
                                _ => "hn-chip-priority-low"
                            };

                            <div class="col-xxl-4 col-lg-6">
                                <div class="card border h-100">
                                    <div class="card-body">
                                        <div class="small text-muted">@t.TicketNumber</div>
                                        <div class="fw-semibold mb-1">@t.Title</div>
                                        <div class="text-muted small mb-2">Sucursal: @t.Branch</div>

                                        <div class="d-flex gap-1 flex-wrap mb-2">
                                            <span class="hn-chip @statusClass">@t.StatusLabel</span>
                                            <span class="hn-chip @priorityClass">@t.PriorityLabel</span>
                                            @if (t.Source == HNControl.Web.Models.TicketSource.MonitoringAuto)
                                            {
                                                <span class="hn-chip hn-chip-ref">Auto monitoreo</span>
                                            }
                                        </div>

                                        <div class="small">
                                            <div>Asignado: <b>@t.AssignedTo</b></div>
                                            <div>Creado: @t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                            <div>SLA: @t.DueResolutionAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                        </div>

                                        <div class="d-flex gap-2 mt-3">
                                            @if (t.CanTake)
                                            {
                                                <form method="post" asp-page-handler="Take">
                                                    <input type="hidden" name="id" value="@t.Id" />
                                                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                    <input type="hidden" name="q" value="@Model.Search" />
                                                    <button class="btn btn-sm btn-outline-primary">Tomar</button>
                                                </form>
                                            }
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#ticketDetailModal"
                                                data-id="@t.Id"
                                                data-num="@t.TicketNumber"
                                                data-title="@t.Title"
                                                data-branch="@t.Branch"
                                                data-status="@t.StatusLabel"
                                                data-priority="@t.PriorityLabel"
                                                data-client="@t.Client"
                                                data-assigned="@t.AssignedTo"
                                                data-created="@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")"
                                                data-sla="@t.DueResolutionAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")"
                                                data-carrier="@t.CarrierName"
                                                data-service="@t.CarrierServiceLabel"
                                                data-account="@t.CarrierAccount"
                                                data-circuit="@t.CarrierCircuit"
                                                data-ip="@t.CarrierIp"
                                                data-lastnote="@t.LastNote">
                                                Detalle
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
</div>

@if (Model.IsAdmin)
{
    <div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="ExportClientMonthPdf">
                    <div class="modal-header">
                        <h5 class="modal-title">Reporte PDF por cliente y mes</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-2">
                            <div class="col-md-7">
                                <label class="form-label">Cliente</label>
                                <select class="form-select" name="clientId" required>
                                    @foreach (var c in Model.ClientOptions)
                                    {
                                        <option value="@c.Id" selected="@(Model.ReportClientId == c.Id)">@c.Name (@c.Code)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Mes</label>
                                <select class="form-select" name="month" required>
                                    @foreach (var m in Model.ReportMonthOptions)
                                    {
                                        <option value="@m" selected="@(Model.ReportMonth == m)">@m</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Exportar PDF</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="newTicketModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form method="post" asp-page-handler="CreateManual">
                    <div class="modal-header">
                        <h5 class="modal-title">Nuevo ticket manual (admin)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Cliente</label>
                                <select id="manualClientSelect" asp-for="CreateInput.ClientId" class="form-select" required onchange="filterContractsByClient()">
                                    <option value="">Selecciona cliente</option>
                                    @foreach (var c in Model.ClientOptions)
                                    {
                                        <option value="@c.Id">@c.Name (@c.Code)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Sucursal (opcional)</label>
                                <select id="manualContractSelect" asp-for="CreateInput.ContractId" class="form-select">
                                    <option value="">Sin sucursal</option>
                                    @foreach (var c in Model.ContractOptions)
                                    {
                                        <option value="@c.Id" data-client-id="@c.ClientId" data-address="@c.Address" data-carrier="@c.CarrierSummary">@c.Label</option>
                                    }
                                </select>
                                <div id="manualCarrierInfo" class="form-text">Selecciona una sucursal para ver datos carrier.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Asignar a (opcional)</label>
                                <select asp-for="CreateInput.AssignedToUserId" class="form-select" onchange="document.getElementById('assignedName').value = this.options[this.selectedIndex].dataset.name || ''">
                                    <option value="">Sin asignar</option>
                                    @foreach (var e in Model.EmployeeOptions)
                                    {
                                        <option value="@e.UserId" data-name="@e.Name">@e.Name</option>
                                    }
                                </select>
                                <input id="assignedName" asp-for="CreateInput.AssignedToName" type="hidden" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Contacto cliente (opcional)</label>
                                <select id="manualContactSelect" asp-for="CreateInput.ClientContactId" class="form-select">
                                    <option value="">Captura manual</option>
                                    @foreach (var c in Model.ContactOptions)
                                    {
                                        var contactLabel = c.Name + (string.IsNullOrWhiteSpace(c.Role) ? "" : $" ({c.Role})");
                                        if (c.IsPrimary)
                                        {
                                            contactLabel += " · Principal";
                                        }
                                        <option value="@c.Id"
                                                data-client-id="@c.ClientId"
                                                data-name="@c.Name"
                                                data-email="@c.Email"
                                                data-phone="@c.Phone">@contactLabel</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Prioridad</label>
                                <select asp-for="CreateInput.Priority" class="form-select">
                                    <option value="@HNControl.Web.Models.TicketPriority.Low">Baja</option>
                                    <option value="@HNControl.Web.Models.TicketPriority.Medium">Intermedia</option>
                                    <option value="@HNControl.Web.Models.TicketPriority.High">Alta</option>
                                    <option value="@HNControl.Web.Models.TicketPriority.Critical">Urge</option>
                                </select>
                            </div>
                            <div class="col-md-9">
                                <label class="form-label">Asunto</label>
                                <input asp-for="CreateInput.Title" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Contacto</label>
                                <input id="manualRequesterName" asp-for="CreateInput.RequesterName" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Correo</label>
                                <input id="manualRequesterEmail" asp-for="CreateInput.RequesterEmail" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Teléfono</label>
                                <input id="manualRequesterPhone" asp-for="CreateInput.RequesterPhone" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Ubicación</label>
                                <input id="manualLocationInput" asp-for="CreateInput.RequesterLocation" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Descripción</label>
                                <textarea asp-for="CreateInput.Description" class="form-control" rows="3" required></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button class="btn btn-primary" type="submit">Crear ticket</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="ticketDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle de ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="card shadow-soft mb-3">
                    <div class="card-body">
                        <div class="small text-muted" id="mNum">-</div>
                        <div class="h5 mb-1" id="mTitle">-</div>
                        <div class="small text-muted mb-2" id="mClient">-</div>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <span class="hn-chip hn-chip-type" id="mBranch">-</span>
                            <span class="hn-chip hn-chip-status-progress" id="mStatus">-</span>
                            <span class="hn-chip hn-chip-priority-medium" id="mPriority">-</span>
                        </div>
                        <div class="small">
                            <div>Asignado: <b id="mAssigned">-</b></div>
                            <div>Creado: <span id="mCreated">-</span></div>
                            <div>SLA: <span id="mSla">-</span></div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-soft mb-3">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">Datos carrier de la sucursal</div>
                        <div class="small">
                            <div>Carrier: <b id="mCarrier">-</b></div>
                            <div>Servicio: <b id="mService">-</b></div>
                            <div>Cuenta: <b id="mAccount">-</b></div>
                            <div>Circuito: <b id="mCircuit">-</b></div>
                            <div>IP: <b id="mIp">-</b></div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-soft mb-3">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">Ultima nota ITIL</div>
                        <div id="mLastNote" class="small text-muted">Sin notas todavia.</div>
                    </div>
                </div>

                <div class="card shadow-soft mb-3">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">Bitacora completa</div>
                        <div id="mTimeline" class="small text-muted">Cargando...</div>
                    </div>
                </div>

                <div class="card shadow-soft mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <form method="post" asp-page-handler="Start" class="d-inline">
                                <input type="hidden" name="id" id="startId" />
                                <input type="hidden" name="status" value="@Model.StatusFilter" />
                                <input type="hidden" name="q" value="@Model.Search" />
                                <button class="btn btn-outline-secondary">Iniciar</button>
                            </form>
                            <form method="post" asp-page-handler="Close" class="d-inline">
                                <input type="hidden" name="id" id="closeId" />
                                <input type="hidden" name="status" value="@Model.StatusFilter" />
                                <input type="hidden" name="q" value="@Model.Search" />
                                <button class="btn btn-dark">Cerrar ticket</button>
                            </form>
                        </div>

                        <form method="post" asp-page-handler="Resolve" class="row g-2 mb-3">
                            <input type="hidden" name="id" id="resolveId" />
                            <input type="hidden" name="status" value="@Model.StatusFilter" />
                            <input type="hidden" name="q" value="@Model.Search" />
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="summary" placeholder="Resumen de solución" />
                            </div>
                            <div class="col-md-3 d-grid">
                                <button class="btn btn-success">Resolver</button>
                            </div>
                        </form>

                        <form method="post" asp-page-handler="Note" enctype="multipart/form-data" class="row g-2">
                            <input type="hidden" name="id" id="noteId" />
                            <input type="hidden" name="status" value="@Model.StatusFilter" />
                            <input type="hidden" name="q" value="@Model.Search" />
                            <div class="col-12">
                                <input type="text" class="form-control" name="noteText" placeholder="Bitácora ITIL: nota técnica (sin adjunto también guarda)" />
                            </div>
                            <div class="col-md-8">
                                <input type="file" class="form-control" name="noteFile" accept=".pdf,.jpg,.jpeg,.png,.webp,.heic" />
                            </div>
                            <div class="col-md-4 d-grid">
                                <button class="btn btn-outline-primary">Guardar nota/evidencia</button>
                            </div>
                            <div class="small text-muted">Permite evidencia fotográfica o PDF (max 25MB).</div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar ventana</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterContractsByClient() {
            const clientSelect = document.getElementById('manualClientSelect');
            const contractSelect = document.getElementById('manualContractSelect');
            const contactSelect = document.getElementById('manualContactSelect');
            const locationInput = document.getElementById('manualLocationInput');
            if (!clientSelect || !contractSelect) return;
            const clientId = (clientSelect.value || '').toLowerCase();
            const options = Array.from(contractSelect.options);
            options.forEach((opt, idx) => {
                if (idx === 0) {
                    opt.hidden = false;
                    opt.disabled = false;
                    return;
                }
                const owner = (opt.getAttribute('data-client-id') || '').toLowerCase();
                const visible = !!clientId && owner === clientId;
                opt.hidden = !visible;
                opt.disabled = !visible;
            });
            if (contractSelect.options[contractSelect.selectedIndex]?.hidden) {
                contractSelect.value = '';
            }
            if (contactSelect) {
                const contactOptions = Array.from(contactSelect.options);
                contactOptions.forEach((opt, idx) => {
                    if (idx === 0) {
                        opt.hidden = false;
                        opt.disabled = false;
                        return;
                    }
                    const owner = (opt.getAttribute('data-client-id') || '').toLowerCase();
                    const visible = !!clientId && owner === clientId;
                    opt.hidden = !visible;
                    opt.disabled = !visible;
                });
                if (contactSelect.options[contactSelect.selectedIndex]?.hidden) {
                    contactSelect.value = '';
                }
            }
            applyManualContact();
            applyBranchLocation();
        }

        function applyManualContact() {
            const contactSelect = document.getElementById('manualContactSelect');
            const nameInput = document.getElementById('manualRequesterName');
            const emailInput = document.getElementById('manualRequesterEmail');
            const phoneInput = document.getElementById('manualRequesterPhone');
            if (!contactSelect || !nameInput || !emailInput || !phoneInput) return;
            const opt = contactSelect.options[contactSelect.selectedIndex];
            if (!opt || !opt.value) return;
            nameInput.value = opt.getAttribute('data-name') || '';
            emailInput.value = opt.getAttribute('data-email') || '';
            phoneInput.value = opt.getAttribute('data-phone') || '';
        }

        function applyBranchLocation() {
            const contractSelect = document.getElementById('manualContractSelect');
            const locationInput = document.getElementById('manualLocationInput');
            const carrierInfo = document.getElementById('manualCarrierInfo');
            if (!contractSelect || !locationInput) return;
            const opt = contractSelect.options[contractSelect.selectedIndex];
            const address = opt?.getAttribute('data-address') || '';
            const carrier = opt?.getAttribute('data-carrier') || '';
            if (address.trim().length > 0) {
                locationInput.value = address;
            }
            if (carrierInfo) {
                carrierInfo.textContent = carrier.trim().length > 0
                    ? ("Datos carrier: " + carrier)
                    : "Selecciona una sucursal para ver datos carrier.";
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            filterContractsByClient();
            const contractSelect = document.getElementById('manualContractSelect');
            const contactSelect = document.getElementById('manualContactSelect');
            if (contractSelect) {
                contractSelect.addEventListener('change', applyBranchLocation);
            }
            if (contactSelect) {
                contactSelect.addEventListener('change', applyManualContact);
            }

            const detailModal = document.getElementById('ticketDetailModal');
            if (detailModal) {
                detailModal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;
                    const id = btn.getAttribute('data-id') || '';
                    document.getElementById('mNum').textContent = btn.getAttribute('data-num') || '-';
                    document.getElementById('mTitle').textContent = btn.getAttribute('data-title') || '-';
                    document.getElementById('mClient').textContent = (btn.getAttribute('data-client') || '-') + ' · Sucursal: ' + (btn.getAttribute('data-branch') || '-');
                    document.getElementById('mBranch').textContent = btn.getAttribute('data-branch') || '-';
                    document.getElementById('mStatus').textContent = btn.getAttribute('data-status') || '-';
                    document.getElementById('mPriority').textContent = btn.getAttribute('data-priority') || '-';
                    document.getElementById('mAssigned').textContent = btn.getAttribute('data-assigned') || '-';
                    document.getElementById('mCreated').textContent = btn.getAttribute('data-created') || '-';
                    document.getElementById('mSla').textContent = btn.getAttribute('data-sla') || '-';
                    document.getElementById('mCarrier').textContent = btn.getAttribute('data-carrier') || '-';
                    document.getElementById('mService').textContent = btn.getAttribute('data-service') || '-';
                    document.getElementById('mAccount').textContent = btn.getAttribute('data-account') || '-';
                    document.getElementById('mCircuit').textContent = btn.getAttribute('data-circuit') || '-';
                    document.getElementById('mIp').textContent = btn.getAttribute('data-ip') || '-';
                    const lastNote = btn.getAttribute('data-lastnote') || '';
                    document.getElementById('mLastNote').textContent = (lastNote && lastNote.trim().length > 0) ? lastNote : 'Sin notas todavia.';
                    document.getElementById('startId').value = id;
                    document.getElementById('resolveId').value = id;
                    document.getElementById('closeId').value = id;
                    document.getElementById('noteId').value = id;

                    const timeline = document.getElementById('mTimeline');
                    if (timeline) timeline.innerHTML = 'Cargando...';
                    const url = '@Url.Page("/Tickets/Index", "Timeline")' + '&id=' + encodeURIComponent(id);
                    fetch(url, { credentials: 'same-origin' })
                        .then(r => r.ok ? r.json() : Promise.reject())
                        .then(rows => {
                            if (!timeline) return;
                            if (!rows || rows.length === 0) {
                                timeline.innerHTML = '<span class="text-muted">Sin eventos todavia.</span>';
                                return;
                            }
                            timeline.innerHTML = rows.map(x =>
                                `<div class="border rounded p-2 mb-2">
                                    <div class="text-muted">${x.at} · ${x.eventType} · ${x.user}</div>
                                    <div>${x.message}</div>
                                </div>`
                            ).join('');
                        })
                        .catch(() => {
                            if (timeline) timeline.innerHTML = '<span class="text-danger">No se pudo cargar la bitacora.</span>';
                        });
                });
            }
        });
    </script>
}
