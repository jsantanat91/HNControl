@page
@model HNControl.Web.Pages.Inventory.IndexModel
@using System
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inventarios";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Inventarios</h1>
        <div class="text-muted small">Consulta existencias + solicita entradas/salidas (aprobaci&oacute;n admin).</div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-success" asp-page="./RequestIn">+ Solicitar entrada</a>
        <a class="btn btn-warning" asp-page="./RequestOut">- Solicitar salida</a>
        <a class="btn btn-outline-primary" asp-page="./MyRequests">Solicitudes</a>
        <a class="btn btn-outline-secondary" asp-page="./ExportItems">Exportar items (Excel)</a>
        @if (User.IsInRole(AppRoles.Admin))
        {
            <a class="btn btn-outline-secondary" asp-page="/Admin/Employees/Index" asp-route-view="table">Encargado inventario</a>
        }
        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InventoryManager))
        {
            <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Items/Index">Admin Stock</a>
            <a class="btn btn-outline-secondary" asp-page="/Admin/Inventory/Approvals/Index">Aprobaciones pendientes</a>
        }
    </div>
</div>

<form method="get" class="card mb-3 shadow-soft hn-hover">
    <div class="card-body p-3">
        <input type="hidden" name="page" value="1" />

        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-4">
                <label class="form-label small text-muted mb-1">Buscar</label>
                <input class="form-control" name="q" value="@Model.Q" placeholder="Buscar por cualquier campo (nombre, SKU, categor&iacute;a, ubicaci&oacute;n, marca, modelo...)" />
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small text-muted mb-1">Categor&iacute;a</label>
                <select class="form-select" name="cat">
                    <option value="">Todas</option>
                    <option value="__none" selected="@(Model.Cat == "__none")">Sin categor&iacute;a</option>
                    @foreach (var c in Model.CategoryOptions.Where(x => !string.IsNullOrWhiteSpace(x)))
                    {
                        <option value="@c" selected="@(Model.Cat == c)">@c</option>
                    }
                </select>
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small text-muted mb-1">Ubicaci&oacute;n</label>
                <select class="form-select" name="loc">
                    <option value="">Todas</option>
                    <option value="__none" selected="@(Model.Loc == "__none")">Sin ubicaci&oacute;n</option>
                    @foreach (var l in Model.LocationOptions.Where(x => !string.IsNullOrWhiteSpace(x)))
                    {
                        <option value="@l" selected="@(Model.Loc == l)">@l</option>
                    }
                </select>
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small text-muted mb-1">Marca</label>
                <select class="form-select" name="brandId">
                    <option value="">Todas</option>
                    <option value="@Guid.Empty" selected="@(Model.BrandId.HasValue && Model.BrandId.Value == Guid.Empty)">Sin marca</option>
                    @foreach (var b in Model.BrandOptions)
                    {
                        <option value="@b.Id" selected="@(Model.BrandId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>

            <div class="col-8 col-sm-4 col-lg-1">
                <label class="form-label small text-muted mb-1">Ordenar</label>
                <select class="form-select" name="sort">
                    <option value="name" selected="@(string.Equals(Model.Sort, "name", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(Model.Sort))">Item</option>
                    <option value="category" selected="@(string.Equals(Model.Sort, "category", StringComparison.OrdinalIgnoreCase))">Categor&iacute;a</option>
                    <option value="brand" selected="@(string.Equals(Model.Sort, "brand", StringComparison.OrdinalIgnoreCase))">Marca</option>
                    <option value="location" selected="@(string.Equals(Model.Sort, "location", StringComparison.OrdinalIgnoreCase))">Ubicaci&oacute;n</option>
                    <option value="stock" selected="@(string.Equals(Model.Sort, "stock", StringComparison.OrdinalIgnoreCase))">Existencia</option>
                </select>
            </div>

            <div class="col-4 col-sm-2 col-lg-1">
                <label class="form-label small text-muted mb-1">Dir</label>
                <select class="form-select" name="dir">
                    <option value="asc" selected="@(string.Equals(Model.Dir, "asc", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(Model.Dir))">&uarr;</option>
                    <option value="desc" selected="@(string.Equals(Model.Dir, "desc", StringComparison.OrdinalIgnoreCase))">&darr;</option>
                </select>
            </div>

            <div class="col-6 col-lg-1 d-grid">
                <button class="btn btn-primary" type="submit">Aplicar</button>
            </div>

            <div class="col-6 col-lg-1 d-grid">
                <a class="btn btn-outline-secondary" asp-page="./Index">Limpiar</a>
            </div>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <div class="card shadow-soft hn-hover h-100">
            <div class="card-body">
                <div class="text-muted small">Items filtrados</div>
                <div class="h3 mb-0">@Model.TotalCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-soft hn-hover h-100 border-warning-subtle">
            <div class="card-body">
                <div class="text-muted small">Bajo stock</div>
                <div class="h3 mb-0">@Model.LowStockCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-soft hn-hover h-100 border-danger-subtle">
            <div class="card-body">
                <div class="text-muted small">Sin stock</div>
                <div class="h3 mb-0">@Model.ZeroStockCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-soft hn-hover">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="text-muted small">
                @if (Model.TotalCount == 0)
                {
                    <span>Sin resultados.</span>
                }
                else
                {
                    <span>Mostrando <strong>@Model.From</strong>-<strong>@Model.To</strong> de <strong>@Model.TotalCount</strong></span>
                }
            </div>
            <div class="text-muted small">50 por p&aacute;gina</div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Categor&iacute;a</th>
                        <th>Item</th>
                        <th>SKU</th>
                        <th>Marca / Modelo</th>
                        <th>Ubicaci&oacute;n</th>
                        <th class="text-end">Existencia</th>
                        <th class="text-end">Stock m&iacute;nimo</th>
                        <th class="text-end">Estado</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var i in Model.Items)
                {
                    var low = i.ReorderLevel > 0 && i.QuantityOnHand <= i.ReorderLevel;
                    <tr>
                        <td>
                            @{
                                var catLabel = string.IsNullOrWhiteSpace(i.Category) ? "Sin categor&iacute;a" : i.Category;
                                var badge = Model.GetCategoryBadgeClass(i.Category);
                            }
                            <span class="hn-badge @badge">@catLabel</span>
                        </td>
                        <td class="fw-semibold">@i.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(i.Sku) ? "-" : i.Sku)</td>
                        <td>
                            <div class="fw-semibold">@(i.Brand?.Name ?? "-")</div>
                            <div class="text-muted small">@(string.IsNullOrWhiteSpace(i.Model) ? "-" : i.Model)</div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(i.Location) ? "-" : i.Location)</td>
                        <td class="text-end fw-semibold">@i.QuantityOnHand @i.Unit</td>
                        <td class="text-end">@i.ReorderLevel</td>
                        <td class="text-end">
                            @if (low)
                            {
                                <span class="hn-badge hn-badge-amber hn-badge-compact">Bajo stock</span>
                            }
                            else
                            {
                                <span class="hn-badge hn-badge-green hn-badge-compact">OK</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="text-muted">No hay items.</div>
        }

        @if (Model.TotalPages > 1)
        {
            var current = Model.Page;
            var total = Model.TotalPages;
            var start = Math.Max(1, current - 3);
            var end = Math.Min(total, current + 3);

            <nav class="mt-3 d-flex justify-content-end">
                <ul class="pagination mb-0">
                    <li class="page-item @(current <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index"
                           asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                           asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                           asp-route-page="@(current - 1)">Anterior</a>
                    </li>

                    @if (start > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-page="./Index"
                               asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                               asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                               asp-route-page="1">1</a>
                        </li>
                        @if (start > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @for (int p = start; p <= end; p++)
                    {
                        <li class="page-item @(p == current ? "active" : "")">
                            <a class="page-link" asp-page="./Index"
                               asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                               asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                               asp-route-page="@p">@p</a>
                        </li>
                    }

                    @if (end < total)
                    {
                        @if (end < total - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-page="./Index"
                               asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                               asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                               asp-route-page="@total">@total</a>
                        </li>
                    }

                    <li class="page-item @(current >= total ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index"
                           asp-route-q="@Model.Q" asp-route-cat="@Model.Cat" asp-route-loc="@Model.Loc" asp-route-brandId="@Model.BrandId"
                           asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
                           asp-route-page="@(current + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
