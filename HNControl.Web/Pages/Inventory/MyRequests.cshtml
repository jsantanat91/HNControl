@page
@model HNControl.Web.Pages.Inventory.MyRequestsModel
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis solicitudes";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Mis solicitudes</h1>
        <div class="text-muted small">Tus solicitudes, agrupadas por orden (ya no por pieza suelta).</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="./Index">← Inventario</a>
        <a class="btn btn-outline-secondary" asp-page="./ExportMyRequests">Exportar (Excel)</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Resumen</th>
                    <th>Proyecto</th>
                    <th>Responsable</th>
                    <th>Status</th>
                    <th class="text-end">Acciones</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var o in Model.Orders)
                {
                    <tr>
                        <td class="text-muted small">@o.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="badge text-bg-light">@(o.Type == InventoryMovementType.In ? "Entrada" : "Salida")</span>
                            <span class="badge text-bg-secondary">@o.LinesCount líneas</span>
                        </td>
                        <td>
                            <div class="fw-semibold">@o.ItemsPreview</div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(o.ProjectTitle) ? "—" : o.ProjectTitle)</td>
                        <td>@o.ResponsibleName</td>
                        <td>
                            <span class="badge @o.StatusCss">@o.StatusLabel</span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="./RequestDetails" asp-route-id="@o.AnchorId">Ver</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Orders.Count == 0)
        {
            <div class="text-muted">Sin solicitudes.</div>
        }
        else
        {
            <div class="text-muted small mt-2">Mostrando hasta 300 órdenes.</div>
        }
    </div>
</div>
