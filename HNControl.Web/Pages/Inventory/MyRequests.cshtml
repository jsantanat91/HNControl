@page
@model HNControl.Web.Pages.Inventory.MyRequestsModel
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis solicitudes";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Mis solicitudes</h1>
        <div class="text-muted small">Solicitudes donde eres quien pidió o el responsable.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="./Index">← Inventario</a>
        <a class="btn btn-outline-secondary" asp-page="./ExportMyRequests">Exportar (Excel)</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Item</th>
                    <th class="text-end">Cantidad</th>
                    <th>Proyecto</th>
                    <th>Responsable</th>
                    <th>Status</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Rows)
                {
                    <tr>
                        <td class="text-muted small">@m.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (m.Type == InventoryMovementType.In)
                            {
                                <span class="badge text-bg-light">Entrada</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light">Salida</span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@m.Item?.Name</div>
                            <div class="text-muted small">@(string.IsNullOrWhiteSpace(m.SerialNumber) ? "" : ("Serie: " + m.SerialNumber))</div>
                            @if (m.AssignedClient != null)
                            {
                                <div class="text-muted small">Cliente: @m.AssignedClient.Name</div>
                            }
                        </td>
                        <td class="text-end fw-semibold">@m.Quantity @m.Item?.Unit</td>
                        <td>@(m.Project?.Title ?? "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(m.ResponsibleName) ? "—" : m.ResponsibleName)</td>
                        <td>
                            @if (m.Status == InventoryMovementStatus.Pending)
                            {
                                <span class="badge text-bg-warning">Pendiente</span>
                            }
                            else if (m.Status == InventoryMovementStatus.Approved)
                            {
                                <span class="badge text-bg-success">Aprobado</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">Rechazado</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Rows.Count == 0)
        {
            <div class="text-muted">Sin solicitudes.</div>
        }
        else
        {
            <div class="text-muted small mt-2">Mostrando hasta 300 movimientos.</div>
        }
    </div>
</div>