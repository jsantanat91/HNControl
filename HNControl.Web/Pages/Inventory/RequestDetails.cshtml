@page "{id:guid}"
@model HNControl.Web.Pages.Inventory.RequestDetailsModel
@using HNControl.Web.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Detalle de solicitud";
}

<div class="d-flex align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Detalle de solicitud</h1>
        <div class="text-muted small">Tu orden, con todas sus líneas y estatus.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="./MyRequests">← Volver</a>
</div>

@if (Model.Anchor == null)
{
    <div class="alert alert-danger">No encontrado.</div>
}
else
{
    var a = Model.Anchor;

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Tipo</div>
                    <div class="fw-semibold">@(a.Type == InventoryMovementType.In ? "Entrada" : "Salida")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Estatus</div>
                    <div class="fw-semibold"><span class="badge @Model.StatusCss">@Model.StatusLabel</span></div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Proyecto</div>
                    <div class="fw-semibold">@(a.Project?.Title ?? "—")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Responsable</div>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(a.ResponsibleName) ? "—" : a.ResponsibleName)</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Solicitó</div>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(a.RequestedByName) ? "—" : a.RequestedByName)</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Fecha</div>
                    <div class="fw-semibold">@a.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">Líneas</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                    <tr>
                        <th>Item</th>
                        <th class="text-end">Cantidad</th>
                        <th>Cliente (HW)</th>
                        <th>Serie</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var m in Model.Lines)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@m.Item?.Name</div>
                                <div class="text-muted small">SKU: @(string.IsNullOrWhiteSpace(m.Item?.Sku) ? "—" : m.Item?.Sku)</div>
                                @if (!string.IsNullOrWhiteSpace(m.Notes))
                                {
                                    <div class="text-muted small">Notas: @m.Notes</div>
                                }
                            </td>
                            <td class="text-end fw-semibold">@m.Quantity @m.Item?.Unit</td>
                            <td>@(m.AssignedClient?.Name ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(m.SerialNumber) ? "—" : m.SerialNumber)</td>
                            <td>
                                @if (m.Status == InventoryMovementStatus.Pending)
                                {
                                    <span class="badge text-bg-warning">Pendiente</span>
                                }
                                else if (m.Status == InventoryMovementStatus.Approved)
                                {
                                    <span class="badge text-bg-success">Aprobado</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Rechazado</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.Lines.Count == 0)
            {
                <div class="text-muted">Sin líneas.</div>
            }
        </div>
    </div>
}
