@page
@model HNControl.Web.Pages.Inventory.RequestInModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Solicitar entrada";
}

<div class="d-flex align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h4 mb-0">Solicitar entrada</h1>
    <a class="btn btn-outline-secondary" asp-page="./Index">← Volver</a>
</div>

<form method="post" class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Item</label>
                <select class="form-select" asp-for="Input.ItemId" asp-items="Model.ItemOptions"></select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Cantidad</label>
                <input class="form-control" asp-for="Input.Quantity" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Referencia (OC / factura)</label>
                <input class="form-control" asp-for="Input.Reference" />
            </div>
            <div class="col-12">
                <label class="form-label">Notas</label>
                <textarea class="form-control" asp-for="Input.Notes" rows="4" placeholder="Proveedor, condiciones, observaciones..."></textarea>
            </div>
        </div>

        <div class="alert alert-light border mt-3 mb-0">
            Se crea como <strong>Pendiente</strong>. Un admin la aprueba para que impacte existencias.
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit">Enviar solicitud</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
