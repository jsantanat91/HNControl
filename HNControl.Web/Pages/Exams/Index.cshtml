@page
@model HNControl.Web.Pages.Exams.IndexModel
@{
    ViewData["Title"] = "Exámenes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Exámenes</h1>
        <div class="text-muted small">Asignados, en progreso y calificados</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Estatus</div>
            <div class="card-body">
                <canvas id="examStatusChart" height="160"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-soft hn-hover">
            <div class="card-header fw-semibold">Mis exámenes</div>
            <div class="card-body">
                @if (!Model.Items.Any())
                {
                    <div class="text-muted">No tienes exámenes asignados (todavía).</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Examen</th>
                                    <th>Status</th>
                                    <th class="text-end">Puntaje</th>
                                    <th class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var a in Model.Items)
                            {
                                var badge = a.Status switch
                                {
                                    HNControl.Web.Models.ExamAssignmentStatus.Graded => "text-bg-success",
                                    HNControl.Web.Models.ExamAssignmentStatus.Submitted => "text-bg-warning",
                                    HNControl.Web.Models.ExamAssignmentStatus.InProgress => "text-bg-info",
                                    _ => "text-bg-secondary"
                                };
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@a.Exam?.Title</div>
                                        <div class="text-muted small">Asignado: @a.AssignedAt.ToLocalTime().ToString("yyyy-MM-dd")</div>
                                    </td>
                                    <td><span class="badge @badge">@a.Status</span></td>
                                    <td class="text-end fw-semibold">@a.Score.ToString("0.##") / @a.MaxScore.ToString("0.##")</td>
                                    <td class="text-end">
                                        @if (a.Status == HNControl.Web.Models.ExamAssignmentStatus.Assigned || a.Status == HNControl.Web.Models.ExamAssignmentStatus.InProgress)
                                        {
                                            <a class="btn btn-sm btn-primary" asp-page="/Exams/Take" asp-route-id="@a.Id">Resolver</a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Exams/Take" asp-route-id="@a.Id">Ver</a>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    const labels = @Html.Raw(Model.StatusLabelsJson);
    const values = @Html.Raw(Model.StatusValuesJson);

    const cfg = {
      type: 'doughnut',
      data: { labels, datasets: [{ label: 'Exámenes', data: values }] },
      options: { plugins: { legend: { position: 'bottom' } } }
    };

    window.hnCharts?.decorate(cfg);
    new Chart(document.getElementById('examStatusChart'), cfg);
</script>
