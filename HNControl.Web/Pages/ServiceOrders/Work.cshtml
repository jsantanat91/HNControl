@page "{id:guid}"
@using HNControl.Web.Models
@model HNControl.Web.Pages.ServiceOrders.WorkModel
@{
    ViewData["Title"] = "Orden de Servicio";
    var isFinalArea = Model.Order?.CurrentArea == ServiceOrderWorkflowArea.CierreTecnico;
}

@if (Model.Order == null)
{
    <div class="alert alert-danger">Orden no encontrada.</div>
    return;
}

<div class="d-flex align-items-start justify-content-between gap-3 mb-3">
    <div>
        <h2 class="mb-1">Orden de Servicio</h2>
        <div class="text-muted">
            Cliente: <strong>@(Model.Order.Client?.Name ?? "-")</strong>
            - Titulo: <strong>@Model.Order.Title</strong>
            - Tipo: <strong>@(Model.WorkItems != null && Model.WorkItems.Count > 0 ? "Global" : Model.Order.Type.GetDisplayName())</strong>
            - Status: <strong>@Model.Order.Status.GetDisplayName()</strong>
            - Area actual: <strong>@Model.Order.CurrentArea.GetDisplayName()</strong>
            - Progreso del area: <strong id="hnChecklistPctTextTop">@Model.ChecklistCompletionPercent</strong>
            - Progreso total: <strong>@Model.TotalChecklistCompletionPercent</strong>
        </div>
        <div class="small text-muted mt-1">
            Tomada por: <strong>@(Model.Order.ClaimedByEmployee?.FullName ?? "Sin tomar")</strong>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/ServiceOrders/Index">Volver</a>
        @if (!string.IsNullOrWhiteSpace(Model.Order.PdfStoragePath))
        {
            <a class="btn btn-outline-primary" asp-page="/ServiceOrders/DownloadPdf" asp-route-id="@Model.Order.Id" target="_blank">Ver PDF</a>
        }

        @if (Model.CanTakeOwnership && !Model.IsClaimedByCurrentUser)
        {
            <form method="post" asp-page-handler="Take" asp-route-id="@Model.Order.Id" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Tomar orden</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

@if (Model.IsReadOnly)
{
    <div class="alert alert-secondary">Modo consulta: solo quien toma la orden puede editar o enviar.</div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div class="d-flex flex-wrap gap-2">
            @foreach (var area in Model.WorkflowAreas)
            {
                var cls = area == Model.Order.CurrentArea ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";
                <span class="@cls" style="pointer-events:none;">@area.GetDisplayName()</span>
            }
        </div>

        @if (!Model.IsReadOnly)
        {
            <div class="d-flex gap-2">
                <form method="post" asp-page-handler="PreviousArea" asp-route-id="@Model.Order.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Area anterior</button>
                </form>
                <form method="post" asp-page-handler="NextArea" asp-route-id="@Model.Order.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Siguiente area</button>
                </form>
            </div>
        }
    </div>
</div>

<div class="row g-3">
    @if (Model.Order.CurrentArea == ServiceOrderWorkflowArea.Levantamiento || Model.Order.CurrentArea == ServiceOrderWorkflowArea.Materiales)
    {
        <div class="col-12">
            <form method="post" asp-page-handler="SaveAreaNotes" asp-route-id="@Model.Order.Id" class="card shadow-sm border-0">
                @Html.AntiForgeryToken()
                <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-semibold">
                            @(Model.Order.CurrentArea == ServiceOrderWorkflowArea.Levantamiento ? "Levantamiento tecnico" : "Materiales requeridos")
                        </div>
                        <div class="text-muted small">Captura observaciones de esta etapa.</div>
                    </div>
                    @if (!Model.IsReadOnly)
                    {
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                    }
                </div>
                <div class="card-body">
                    <textarea class="form-control" rows="12" name="AreaNotes" readonly="@Model.IsReadOnly"
                              placeholder="Escribe aqui las observaciones de esta etapa...">@Model.AreaNotes</textarea>
                </div>
            </form>
        </div>
    }

    @if (Model.Order.CurrentArea == ServiceOrderWorkflowArea.Ejecucion)
    {
        <div class="col-12">
            <form method="post" asp-page-handler="SaveChecklist" asp-route-id="@Model.Order.Id" class="card shadow-sm border-0">
                @Html.AntiForgeryToken()

                <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-semibold">Checklist y avances tecnicos</div>
                        <div class="text-muted small">Progreso del area: <strong id="hnChecklistPctText">@Model.ChecklistCompletionPercent</strong></div>
                    </div>
                    @if (!Model.IsReadOnly)
                    {
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="hnChecklistMarkAll(true)">Marcar todo</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="hnChecklistMarkAll(false)">Limpiar</button>
                            <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        </div>
                    }
                </div>

                <div class="card-body">
                    <div class="progress mb-3" style="height:10px;">
                        <div id="hnChecklistPctBar" class="progress-bar" role="progressbar" style="width:@Model.ChecklistCompletionPercent"></div>
                    </div>

                    @if (Model.ChecklistGroups == null || Model.ChecklistGroups.Count == 0)
                    {
                        <div class="text-muted">Esta area no tiene checklist asignado.</div>
                    }
                    else
                    {
                        var gIndex = 0;
                        <div class="accordion" id="hnChecklistAcc">
                            @foreach (var g in Model.ChecklistGroups)
                            {
                                var headId = $"h_{gIndex}";
                                var collapseId = $"c_{gIndex}";
                                var doneCount = g.ItemIndices.Count(ix => Model.ItemsPost[ix].IsDone);
                                var totalCount = g.ItemIndices.Count;
                                var pct = totalCount == 0 ? 0 : (int)Math.Round(doneCount * 100.0 / totalCount);

                                <div class="accordion-item mb-2 border rounded-4 overflow-hidden">
                                    <h2 class="accordion-header" id="@headId">
                                        <button class="accordion-button @(gIndex == 0 ? "" : "collapsed")" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                                aria-expanded="@(gIndex == 0 ? "true" : "false")" aria-controls="@collapseId">
                                            <div class="w-100 d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge bg-secondary">@g.TypeLabel</span>
                                                <strong class="me-auto">@g.Title</strong>
                                                <span class="text-muted small">Progreso: <strong>@pct%</strong></span>
                                            </div>
                                        </button>
                                    </h2>

                                    <div id="@collapseId" class="accordion-collapse collapse @(gIndex == 0 ? "show" : "")"
                                         aria-labelledby="@headId" data-bs-parent="#hnChecklistAcc">
                                        <div class="accordion-body">
                                            @if (g.WorkItemPostIndex.HasValue)
                                            {
                                                <input type="hidden" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].Id" />
                                                <div class="row g-3 mb-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label small text-muted mb-1">Trabajo realizado</label>
                                                        <textarea class="form-control" rows="3" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].WorkPerformed" readonly="@Model.IsReadOnly"></textarea>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label small text-muted mb-1">Material usado</label>
                                                        <textarea class="form-control" rows="3" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].MaterialsUsed" readonly="@Model.IsReadOnly"></textarea>
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="form-label small text-muted mb-1">Observaciones del tecnico</label>
                                                        <textarea class="form-control" rows="2" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].TechnicianNotes" readonly="@Model.IsReadOnly"></textarea>
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].IsCompleted" disabled="@Model.IsReadOnly" />
                                                            <label class="form-check-label">Actividad completada</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            <div class="row g-3">
                                                @foreach (var ix in g.ItemIndices)
                                                {
                                                    <div class="col-md-6">
                                                        <div class="border rounded-4 p-2 h-100 bg-white">
                                                            <input type="hidden" asp-for="ItemsPost[ix].Id" />
                                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                                <div class="pe-2">
                                                                    <div class="fw-semibold small">@Model.ItemsPost[ix].Title</div>
                                                                    @if (!string.IsNullOrWhiteSpace(Model.ItemsPost[ix].Category))
                                                                    {
                                                                        <div class="mt-1">
                                                                            <span class="badge bg-light text-dark border">@Model.ItemsPost[ix].Category</span>
                                                                        </div>
                                                                    }
                                                                </div>

                                                                <div class="form-check form-switch m-0">
                                                                    <input class="form-check-input hn-check-item" type="checkbox" asp-for="ItemsPost[ix].IsDone" disabled="@Model.IsReadOnly" />
                                                                </div>
                                                            </div>

                                                            <div class="mt-2">
                                                                <textarea class="form-control" rows="2" asp-for="ItemsPost[ix].Notes" readonly="@Model.IsReadOnly" placeholder="Notas"></textarea>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                gIndex++;
                            }
                        </div>
                    }
                </div>
            </form>
        </div>

        <div class="col-12">
            <form method="post" enctype="multipart/form-data" asp-page-handler="UploadEvidence" asp-route-id="@Model.Order.Id" class="card shadow-sm border-0">
                @Html.AntiForgeryToken()

                <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between">
                    <div class="fw-semibold">Evidencias</div>
                    @if (!Model.IsReadOnly)
                    {
                        <button type="submit" class="btn btn-outline-primary btn-sm">Subir evidencia</button>
                    }
                </div>

                <div class="card-body">
                    @if (!Model.IsReadOnly)
                    {
                        <input class="form-control" type="file" name="EvidenceFile" accept=".jpg,.jpeg,.png,.webp,.pdf,.heic,.heif" />
                        <hr />
                    }

                    @if (Model.Evidences.Count == 0)
                    {
                        <div class="text-muted">Sin evidencias.</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var ev in Model.Evidences)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@ev.OriginalFileName</div>
                                        <div class="text-muted small">@ev.UploadedAtLocal</div>
                                    </div>
                                    <a class="btn btn-outline-secondary btn-sm" href="?handler=DownloadEvidence&evidenceId=@ev.Id">Descargar</a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </form>
        </div>
    }

    @if (Model.Order.CurrentArea == ServiceOrderWorkflowArea.CierreTecnico)
    {
        <div class="col-12">
            <form method="post" asp-page-handler="SignAndSubmit" asp-route-id="@Model.Order.Id" class="card shadow-sm border-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TechSigDataUrl" id="hnTechSigDataUrl" />

                <div class="card-header bg-white border-0">
                    <div class="fw-semibold">Cierre tecnico: firma y envio</div>
                    <div class="text-muted small">El nombre del tecnico se toma automaticamente del usuario autenticado.</div>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-lg-6">
                            <label class="form-label small text-muted">Tecnico</label>
                            <input class="form-control mb-2" value="@Model.TechName" readonly />

                            <div class="border rounded-4 bg-light p-2 hn-sig-box">
                                <canvas id="hnTechCanvas" class="w-100 hn-sig-canvas" style="height:280px; touch-action:none;"></canvas>
                            </div>

                            <div class="d-flex gap-2 mt-2 align-items-center">
                                @if (!Model.IsReadOnly)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="hnSigClear('hnTechCanvas')">Limpiar</button>
                                }
                                @if (Model.HasTechSignature)
                                {
                                    <span class="text-muted small">Firma guardada</span>
                                    <a class="small ms-auto" href="?handler=SignatureImage&id=@Model.Order.Id&role=Technician" target="_blank">Ver</a>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    @{
                        var disabled = Model.IsReadOnly ||
                        Model.Order.Status == ServiceOrderStatus.InReview ||
                        Model.Order.Status == ServiceOrderStatus.Finalized ||
                        Model.Order.Status == ServiceOrderStatus.Completed;
                    }

                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        <button type="submit"
                                class="btn btn-success px-4"
                                onclick="hnCaptureSigs()"
                                @(disabled ? "disabled" : "")>
                            Firmar y enviar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-light border">Para firmar y enviar, avanza al area final <strong>Cierre tecnico</strong>.</div>
        </div>
    }
</div>

@section Scripts
{
    <script>
        function hnChecklistMarkAll(flag) {
            document.querySelectorAll('.hn-check-item').forEach(cb => cb.checked = flag);
            hnUpdateChecklistProgress();
        }

        function hnUpdateChecklistProgress() {
            const cbs = Array.from(document.querySelectorAll('.hn-check-item'));
            if (!cbs.length) return;

            const done = cbs.filter(cb => cb.checked).length;
            const pct = Math.round((done * 1000) / cbs.length) / 10;
            const pctText = (pct % 1 === 0 ? pct.toFixed(0) : pct.toFixed(1)) + "%";

            const t1 = document.getElementById('hnChecklistPctText');
            const t2 = document.getElementById('hnChecklistPctTextTop');
            const bar = document.getElementById('hnChecklistPctBar');

            if (t1) t1.textContent = pctText;
            if (t2) t2.textContent = pctText;
            if (bar) bar.style.width = pctText;
        }

        document.addEventListener('change', (e) => {
            if (e.target && e.target.classList && e.target.classList.contains('hn-check-item')) {
                hnUpdateChecklistProgress();
            }
        });

        document.addEventListener('DOMContentLoaded', () => hnUpdateChecklistProgress());

        const hnPads = {};

        function hnInitPad(canvasId) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;

            const ctx = canvas.getContext('2d');
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#111';

            function resize() {
                const dpr = window.devicePixelRatio || 1;
                const rect = canvas.getBoundingClientRect();

                canvas.width = Math.max(1, Math.floor(rect.width * dpr));
                canvas.height = Math.max(1, Math.floor(rect.height * dpr));

                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                ctx.lineWidth = 3;
            }

            resize();
            window.addEventListener('resize', resize);

            let drawing = false;
            let lastX = 0, lastY = 0;

            function getPos(ev) {
                const rect = canvas.getBoundingClientRect();
                if (ev.touches && ev.touches.length) {
                    return { x: ev.touches[0].clientX - rect.left, y: ev.touches[0].clientY - rect.top };
                }
                return { x: ev.clientX - rect.left, y: ev.clientY - rect.top };
            }

            function start(ev) {
                drawing = true;
                const p = getPos(ev);
                lastX = p.x; lastY = p.y;
                ev.preventDefault();
            }

            function move(ev) {
                if (!drawing) return;
                const p = getPos(ev);

                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(p.x, p.y);
                ctx.stroke();

                lastX = p.x; lastY = p.y;
                ev.preventDefault();
            }

            function end(ev) {
                drawing = false;
                if (ev) ev.preventDefault();
            }

            canvas.addEventListener('mousedown', start);
            canvas.addEventListener('mousemove', move);
            window.addEventListener('mouseup', end);

            canvas.addEventListener('touchstart', start, { passive: false });
            canvas.addEventListener('touchmove', move, { passive: false });
            window.addEventListener('touchend', end, { passive: false });

            hnPads[canvasId] = { canvas, ctx, resize };
        }

        function hnSigClear(canvasId) {
            const pad = hnPads[canvasId];
            if (!pad) return;
            const c = pad.canvas;
            const ctx = pad.ctx;
            ctx.clearRect(0, 0, c.width, c.height);
        }

        function hnCaptureSigs() {
            const tech = document.getElementById('hnTechCanvas');
            const hidden = document.getElementById('hnTechSigDataUrl');
            if (tech && hidden) hidden.value = tech.toDataURL('image/png');
        }

        hnInitPad('hnTechCanvas');
    </script>
    <style>
        .hn-sig-box {
            min-height: 300px;
        }

        .hn-sig-canvas {
            border-radius: 12px;
        }
    </style>
}
