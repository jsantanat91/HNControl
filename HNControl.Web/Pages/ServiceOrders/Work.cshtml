@page "{id:guid}"
@model HNControl.Web.Pages.ServiceOrders.WorkModel
@{
    ViewData["Title"] = "Orden de Servicio";

    string TypeBadge(string? typeKey)
    {
        var t = (typeKey ?? "").Trim();
        return t switch
        {
            "Preventivo" => "bg-success",
            "Correctivo" => "bg-danger",
            "NuevaInstalacion" => "bg-primary",
            "Nueva instalación" => "bg-primary",
            "Soporte" => "bg-warning text-dark",
            "General" => "bg-secondary",
            "Global" => "bg-dark",
            _ => "bg-info text-dark"
        };
    }

    string TypeFriendly(string? typeKey)
    {
        var t = (typeKey ?? "").Trim();
        return t switch
        {
            "NuevaInstalacion" => "Nueva instalación",
            _ => t
        };
    }

    string CatBadge(string? cat)
    {
        var s = (cat ?? "").Trim();
        if (string.IsNullOrWhiteSpace(s)) return "bg-light text-dark border";

        // Hash estable (sin GetHashCode) para colores consistentes.
        unchecked
        {
            int h = 0;
            foreach (var ch in s)
                h = (h * 31) + ch;

            var idx = Math.Abs(h) % 6;
            return idx switch
            {
                0 => "bg-primary-subtle text-primary border",
                1 => "bg-success-subtle text-success border",
                2 => "bg-warning-subtle text-warning border",
                3 => "bg-danger-subtle text-danger border",
                4 => "bg-info-subtle text-info border",
                _ => "bg-secondary-subtle text-secondary border",
            };
        }
    }
}

@if (Model.Order == null)
{
    <div class="alert alert-danger">Orden no encontrada.</div>
    return;
}

<div class="d-flex align-items-start justify-content-between gap-3 mb-3">
    <div>
        <h2 class="mb-1">Orden de Servicio</h2>
        <div class="text-muted">
            Cliente: <strong>@(Model.Order.Client?.Name ?? "-")</strong>
            · Título: <strong>@Model.Order.Title</strong>
            · Tipo: <strong>@(Model.WorkItems != null && Model.WorkItems.Count > 0 ? "Global" : Model.Order.Type.ToString())</strong>
            · Actividades: <strong>@((Model.WorkItems != null && Model.WorkItems.Count > 0) ? Model.WorkItems.Count : 1)</strong>
            · Status: <strong>@Model.Order.Status</strong>
            · Progreso checklist: <strong>@Model.ChecklistCompletionPercent</strong>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="javascript:history.back()">Volver</a>
        @if (!string.IsNullOrWhiteSpace(Model.ClientDownloadUrl))
        {
            <a class="btn btn-primary" target="_blank" href="@Model.ClientDownloadUrl">Link cliente</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

<div class="row g-3">

    <!-- CHECKLIST + FIRMAS (mismo form, para que "Firmar y enviar" también guarde notas/checklist) -->
    <div class="col-12">
        <form method="post">
            <input type="hidden" name="id" value="@Model.Order.Id" />
            <input type="hidden" name="TechSigDataUrl" id="hnTechSigDataUrl" />
            <input type="hidden" name="ClientSigDataUrl" id="hnClientSigDataUrl" />

            <!-- Checklist -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-semibold">Checklist</div>
                        <div class="text-muted small">Progreso total: @Model.ChecklistCompletionPercent</div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap justify-content-end">
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="hnChecklistMarkAll(true)">Marcar todo</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="hnChecklistMarkAll(false)">Limpiar</button>
                        <button type="submit" class="btn btn-primary btn-sm" formaction="?handler=SaveChecklist">Guardar</button>
                    </div>
                </div>

                <div class="card-body">
                    <div class="progress mb-3" style="height:10px;">
                        <div class="progress-bar" role="progressbar" style="width:@Model.ChecklistCompletionPercent"></div>
                    </div>

                    @if (Model.ChecklistGroups == null || Model.ChecklistGroups.Count == 0)
                    {
                        <div class="text-muted">Esta orden no tiene checklist todavía.</div>
                    }
                    else
                    {
                        // Global: accordion por actividad
                        if (Model.WorkItems != null && Model.WorkItems.Count > 0)
                        {
                            <div class="accordion" id="hnChecklistAcc">
                                @for (var gi = 0; gi < Model.ChecklistGroups.Count; gi++)
                                {
                                    var g = Model.ChecklistGroups[gi];
                                    var collapseId = $"hnAcc_{gi}";
                                    var headId = $"hnHead_{gi}";
                                    var isGeneral = g.WorkItemId == null;

                                    <div class="accordion-item border-0 mb-2">
                                        <h2 class="accordion-header" id="@headId">
                                            <button class="accordion-button @(g.IsDefaultOpen ? "" : "collapsed") rounded-4 shadow-sm" type="button"
                                                    data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(g.IsDefaultOpen ? "true" : "false")" aria-controls="@collapseId">
                                                <div class="d-flex w-100 justify-content-between align-items-center gap-3 flex-wrap">
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <span class="badge @TypeBadge(g.TypeKey)">@(isGeneral ? "General" : $"Actividad {g.ActivityNumber}")</span>
                                                        <span class="fw-semibold">@g.Title</span>
                                                        <span class="badge rounded-pill bg-light text-dark border">@TypeFriendly(g.TypeLabel)</span>
                                                    </div>
                                                    <div class="text-muted small">
                                                        @g.DoneCount/@g.TotalCount · @g.CompletionPercent
                                                    </div>
                                                </div>
                                            </button>
                                        </h2>

                                        <div id="@collapseId" class="accordion-collapse collapse @(g.IsDefaultOpen ? "show" : "")" aria-labelledby="@headId" data-bs-parent="#hnChecklistAcc">
                                            <div class="accordion-body pt-2">

                                                @* Campos abiertos por actividad *@
                                                @if (g.WorkItemPostIndex.HasValue)
                                                {
                                                    <input type="hidden" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].Id" />

                                                    <div class="border rounded-4 p-3 bg-white mb-3">
                                                        <div class="fw-semibold mb-2">Datos de la actividad</div>
                                                        <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <label class="form-label small text-muted mb-1">Trabajo realizado</label>
                                                                <textarea class="form-control" rows="3" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].WorkPerformed"
                                                                          placeholder="Qué se hizo, configuración, pruebas, etc."></textarea>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label small text-muted mb-1">Material usado</label>
                                                                <textarea class="form-control" rows="3" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].MaterialsUsed"
                                                                          placeholder="Cámara, canaleta, conectores, metros de cable, etc."></textarea>
                                                            </div>

                                                            <div class="col-md-9">
                                                                <label class="form-label small text-muted mb-1">Observaciones del técnico</label>
                                                                <textarea class="form-control" rows="2" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].TechnicianNotes"
                                                                          placeholder="Pendientes, riesgos, recomendaciones, detalles importantes."></textarea>
                                                            </div>

                                                            <div class="col-md-3 d-flex align-items-end">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" asp-for="WorkItemsPost[g.WorkItemPostIndex.Value].IsCompleted" />
                                                                    <label class="form-check-label">Actividad completada</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }

                                                @* Checklist items *@
                                                @if (g.ItemIndices == null || g.ItemIndices.Count == 0)
                                                {
                                                    <div class="text-muted">Sin checklist para esta sección.</div>
                                                }
                                                else
                                                {
                                                    <div class="list-group">
                                                        @foreach (var ix in g.ItemIndices)
                                                        {
                                                            var it = Model.ItemsPost[ix];
                                                            var noteId = $"hnNote_{ix}";

                                                            <div class="list-group-item rounded-4 mb-2 border">
                                                                <input type="hidden" asp-for="ItemsPost[ix].Id" />

                                                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                                                    <div class="d-flex align-items-start gap-2">
                                                                        <div class="form-check mt-1">
                                                                            <input class="form-check-input hn-check-item" type="checkbox" asp-for="ItemsPost[ix].IsDone" />
                                                                        </div>

                                                                        <div>
                                                                            <div class="fw-semibold">@it.Title</div>
                                                                            <div class="d-flex gap-2 flex-wrap mt-1">
                                                                                @if (!string.IsNullOrWhiteSpace(it.Category))
                                                                                {
                                                                                    <span class="badge rounded-pill @CatBadge(it.Category)">@it.Category</span>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#@noteId">
                                                                        Notas
                                                                    </button>
                                                                </div>

                                                                <div class="collapse mt-2" id="@noteId">
                                                                    <label class="form-label small mt-2 mb-1 text-muted">Notas</label>
                                                                    <textarea class="form-control" rows="2" asp-for="ItemsPost[ix].Notes"
                                                                              placeholder="Ej: material pendiente, canaleta instalada, configuración lista, etc."></textarea>
                                                                </div>

                                                                @if (!string.IsNullOrWhiteSpace(it.Notes))
                                                                {
                                                                    <div class="small text-muted mt-2">Nota actual: @it.Notes</div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="text-muted small mt-2">
                                Tip rápido: abre cada actividad, marca el checklist y escribe notas donde aplique. Al final, <strong>Firmar y enviar</strong> guarda todo.
                            </div>
                        }
                        else
                        {
                            // No-global: UI compacta
                            var g = Model.ChecklistGroups.FirstOrDefault();
                            if (g == null)
                            {
                                <div class="text-muted">Esta orden no tiene checklist todavía.</div>
                            }
                            else
                            {
                                <div class="border rounded-4 p-3 bg-white">
                                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                        <div>
                                            <div class="fw-semibold">@g.Title</div>
                                            <div class="text-muted small">@TypeFriendly(g.TypeLabel)</div>
                                        </div>
                                        <div class="text-muted small">@g.DoneCount/@g.TotalCount · @g.CompletionPercent</div>
                                    </div>

                                    <div class="list-group mt-3">
                                        @foreach (var ix in g.ItemIndices)
                                        {
                                            var it = Model.ItemsPost[ix];
                                            var noteId = $"hnNote_{ix}";

                                            <div class="list-group-item rounded-4 mb-2 border">
                                                <input type="hidden" asp-for="ItemsPost[ix].Id" />

                                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                                    <div class="d-flex align-items-start gap-2">
                                                        <div class="form-check mt-1">
                                                            <input class="form-check-input hn-check-item" type="checkbox" asp-for="ItemsPost[ix].IsDone" />
                                                        </div>

                                                        <div>
                                                            <div class="fw-semibold">@it.Title</div>
                                                            @if (!string.IsNullOrWhiteSpace(it.Category))
                                                            {
                                                                <div class="mt-1"><span class="badge rounded-pill @CatBadge(it.Category)">@it.Category</span></div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#@noteId">Notas</button>
                                                </div>

                                                <div class="collapse mt-2" id="@noteId">
                                                    <label class="form-label small mt-2 mb-1 text-muted">Notas</label>
                                                    <textarea class="form-control" rows="2" asp-for="ItemsPost[ix].Notes"
                                                              placeholder="Notas opcionales"></textarea>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            <!-- Firmas -->
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-header bg-white border-0">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <div class="fw-semibold">Firmas</div>
                            <div class="text-muted small">
                                Dibuja ambas firmas. El botón <strong>Firmar y enviar</strong> también guarda checklist/notas.
                            </div>
                        </div>

                        <div class="text-muted small">
                            Requisito: firma técnico + firma cliente.
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-lg-6">
                            <div class="fw-semibold mb-2">Técnico</div>
                            <label class="form-label small text-muted">Nombre</label>
                            <input class="form-control mb-2" name="TechName" value="@Model.TechName" placeholder="Nombre del técnico" />

                            <div class="border rounded-4 bg-light p-2 hn-sig-box">
                                <canvas id="hnTechCanvas" class="w-100 hn-sig-canvas" style="height:280px; touch-action:none;"></canvas>
                            </div>

                            <div class="d-flex gap-2 mt-2 align-items-center">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="hnSigClear('hnTechCanvas')">Limpiar</button>
                                @if (Model.HasTechSignature)
                                {
                                    <span class="text-muted small">Firma guardada ✅</span>
                                    <a class="small ms-auto" href="?handler=SignatureImage&id=@Model.Order.Id&role=Technician" target="_blank">Ver</a>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="fw-semibold mb-2">Cliente</div>
                            <label class="form-label small text-muted">Nombre</label>
                            <input class="form-control mb-2" name="ClientName" value="@Model.ClientSignerName" placeholder="Nombre del cliente" />

                            <div class="border rounded-4 bg-light p-2 hn-sig-box">
                                <canvas id="hnClientCanvas" class="w-100 hn-sig-canvas" style="height:280px; touch-action:none;"></canvas>
                            </div>

                            <div class="d-flex gap-2 mt-2 align-items-center">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="hnSigClear('hnClientCanvas')">Limpiar</button>
                                @if (Model.HasClientSignature)
                                {
                                    <span class="text-muted small">Firma guardada ✅</span>
                                    <a class="small ms-auto" href="?handler=SignatureImage&id=@Model.Order.Id&role=Client" target="_blank">Ver</a>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    @{
                        var disabled = Model.Order.Status == HNControl.Web.Models.ServiceOrderStatus.InReview
                        || Model.Order.Status == HNControl.Web.Models.ServiceOrderStatus.Finalized
                        || Model.Order.Status == HNControl.Web.Models.ServiceOrderStatus.Completed;
                    }

                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        <button type="submit"
                                class="btn btn-success px-4"
                                formaction="?handler=SignAndSubmit"
                                onclick="hnCaptureSigs()"
                                @(disabled ? "disabled" : "")>
                            Firmar y enviar
                        </button>
                    </div>

                    @if (disabled)
                    {
                        <div class="text-muted small mt-2">
                            Esta orden ya está en revisión/finalizada. Si necesitas re-firmar, pídele al admin que la regrese a “En proceso”.
                        </div>
                    }
                </div>
            </div>
        </form>
    </div>

    <!-- Evidencias -->
    <div class="col-12">
        <form method="post" enctype="multipart/form-data" class="card shadow-sm border-0">
            <input type="hidden" name="id" value="@Model.Order.Id" />

            <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between">
                <div class="fw-semibold">Evidencias</div>
                <button type="submit" class="btn btn-outline-primary btn-sm" formaction="?handler=UploadEvidence">Subir evidencia</button>
            </div>

            <div class="card-body">
                <div class="mb-2 text-muted small">
                    Permitidos: JPG/JPEG/PNG/WEBP/PDF/HEIC/HEIF
                </div>

                <input class="form-control" type="file" name="EvidenceFile" accept=".jpg,.jpeg,.png,.webp,.pdf,.heic,.heif" />

                <hr />

                @if (Model.Evidences.Count == 0)
                {
                    <div class="text-muted">Sin evidencias.</div>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var ev in Model.Evidences)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@ev.OriginalFileName</div>
                                    <div class="text-muted small">@ev.UploadedAtLocal</div>
                                </div>
                                <a class="btn btn-outline-secondary btn-sm" href="?handler=DownloadEvidence&evidenceId=@ev.Id">Descargar</a>
                            </div>
                        }
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script>
        function hnChecklistMarkAll(flag) {
            document.querySelectorAll('.hn-check-item').forEach(cb => cb.checked = flag);
        }

        const hnPads = {};

        function hnInitPad(canvasId) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;

            const ctx = canvas.getContext('2d');
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#111';

            function resize() {
                const dpr = window.devicePixelRatio || 1;
                const rect = canvas.getBoundingClientRect();

                canvas.width = Math.max(1, Math.floor(rect.width * dpr));
                canvas.height = Math.max(1, Math.floor(rect.height * dpr));

                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                ctx.lineWidth = 3;
            }

            resize();
            window.addEventListener('resize', resize);

            let drawing = false;
            let lastX = 0, lastY = 0;

            function getPos(ev) {
                const rect = canvas.getBoundingClientRect();
                if (ev.touches && ev.touches.length) {
                    return { x: ev.touches[0].clientX - rect.left, y: ev.touches[0].clientY - rect.top };
                }
                return { x: ev.clientX - rect.left, y: ev.clientY - rect.top };
            }

            function start(ev) {
                drawing = true;
                const p = getPos(ev);
                lastX = p.x; lastY = p.y;
                ev.preventDefault();
            }

            function move(ev) {
                if (!drawing) return;
                const p = getPos(ev);

                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(p.x, p.y);
                ctx.stroke();

                lastX = p.x; lastY = p.y;
                ev.preventDefault();
            }

            function end(ev) {
                drawing = false;
                ev.preventDefault();
            }

            canvas.addEventListener('mousedown', start);
            canvas.addEventListener('mousemove', move);
            window.addEventListener('mouseup', end);

            canvas.addEventListener('touchstart', start, { passive: false });
            canvas.addEventListener('touchmove', move, { passive: false });
            window.addEventListener('touchend', end, { passive: false });

            hnPads[canvasId] = { canvas, ctx, resize };
        }

        function hnSigClear(canvasId) {
            const pad = hnPads[canvasId];
            if (!pad) return;
            const c = pad.canvas;
            const ctx = pad.ctx;
            ctx.clearRect(0, 0, c.width, c.height);
        }

        function hnCaptureSigs() {
            const tech = document.getElementById('hnTechCanvas');
            const client = document.getElementById('hnClientCanvas');

            document.getElementById('hnTechSigDataUrl').value = tech ? tech.toDataURL('image/png') : '';
            document.getElementById('hnClientSigDataUrl').value = client ? client.toDataURL('image/png') : '';
        }

        hnInitPad('hnTechCanvas');
        hnInitPad('hnClientCanvas');
    </script>

    <style>
        .hn-sig-box { min-height: 300px; }
        .hn-sig-canvas { border-radius: 12px; }

        /* accordion más amable: menos "caja gris" */
        .accordion-button { background: #fff; }
        .accordion-button:not(.collapsed) { box-shadow: none; }
        .accordion-button:focus { box-shadow: none; }
    </style>
}
