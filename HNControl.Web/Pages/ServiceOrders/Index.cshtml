@page
@using HNControl.Web.Helpers
@model HNControl.Web.Pages.ServiceOrders.IndexModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Órdenes de servicio</h1>
        <div class="text-muted small">Vista del mes activo por defecto. Usa filtros para consultar meses anteriores.</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

<form method="get" class="card shadow-soft hn-hover mb-3">
    <div class="card-body row g-2 align-items-end mx-0">
        <div class="col-6 col-xl-2"><label class="form-label">Desde</label><input class="form-control form-control-sm" type="date" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-6 col-xl-2"><label class="form-label">Hasta</label><input class="form-control form-control-sm" type="date" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-6 col-xl-2">
            <label class="form-label">Tipo</label>
            <select class="form-select" name="Type">
                <option value="">Todos</option>
                @foreach (var t in Model.TypeOptions)
                {
                    var lbl = UiBadges.ServiceOrderTypeBadge(t).text;
                    <option value="@t" selected="@(Model.Type == t)">@lbl</option>
                }
            </select>
        </div>
        <div class="col-6 col-xl-2">
            <label class="form-label">Estatus</label>
            <select class="form-select" name="Status">
                <option value="">Todos</option>
                @foreach (var st in Model.StatusOptions)
                {
                    var lbl = UiBadges.ServiceOrderStatusBadge(st).text;
                    <option value="@st" selected="@(Model.Status == st)">@lbl</option>
                }
            </select>
        </div>
        <div class="col-6 col-xl-1"><label class="form-label">Por página</label><select class="form-select form-select-sm" name="PageSize">@foreach (var s in new[] { 10,20,50,100 }) {<option value="@s" selected="@(Model.PageSize==s)">@s</option>}</select></div>
        <div class="col-12 col-xl-2 d-flex gap-2 justify-content-start flex-wrap">
            <button class="btn btn-primary btn-sm" type="submit">Filtrar</button>
            <a class="btn btn-outline-secondary btn-sm" asp-page="/ServiceOrders/Index">Limpiar</a>
        </div>
    </div>
</form>

<div class="card shadow-soft hn-hover mb-3">
    <div class="card-header fw-semibold">Últimos 3 clientes con órdenes</div>
    <div class="card-body">
        @if (!Model.RecentClientGroups.Any())
        {
            <div class="text-muted">Sin actividad reciente.</div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var group in Model.RecentClientGroups)
                {
                    <div class="border rounded p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="fw-semibold">@group.Client</div>
                            <div class="d-flex gap-2">
                                <span class="hn-chip hn-chip-neutral">Órdenes: @group.Total</span>
                                @if (group.Overdue > 0)
                                {
                                    <span class="hn-chip hn-chip-priority-critical">Atrasadas: @group.Overdue</span>
                                }
                            </div>
                        </div>
                        <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-2">
                            @foreach (var r in group.Orders)
                            {
                                var type = UiBadges.ServiceOrderTypeBadge(r.Type);
                                var status = UiBadges.ServiceOrderStatusBadge(r.Status);
                                <div class="col d-flex">
                                    <div class="card border w-100">
                                        <div class="card-body d-flex flex-column">
                                            <div class="fw-semibold">@r.Title</div>
                                            <div class="small text-muted">@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd") · Entrega: @r.Due</div>
                                            <div class="small text-muted">Tomada por: @r.ClaimedBy</div>
                                            <div class="mt-2 d-flex gap-1 flex-wrap">
                                                <span class="hn-chip hn-chip-type">@type.text</span>
                                                <span class="hn-chip hn-chip-neutral">@status.text</span>
                                            </div>
                                            <div class="mt-auto pt-2 d-flex gap-2 flex-wrap">
                                                <a class="btn btn-sm btn-outline-primary" asp-page="/ServiceOrders/Work" asp-route-id="@r.Id">Abrir</a>
                                                @if (r.HasPdf)
                                                {
                                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/ServiceOrders/DownloadPdf" asp-route-id="@r.Id" target="_blank">PDF</a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card shadow-soft hn-hover">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="fw-semibold">Backlog de atrasados (otros clientes)</div>
        <span class="text-muted small">@Model.TotalCount registro(s)</span>
    </div>
    <div class="card-body">
        @if (Model.Rows.Count == 0)
        {
            <div class="alert alert-secondary mb-0">No hay órdenes atrasadas para este filtro.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
                @foreach (var r in Model.Rows)
                {
                    var type = UiBadges.ServiceOrderTypeBadge(r.Type);
                    var status = UiBadges.ServiceOrderStatusBadge(r.Status);
                    <div class="col d-flex">
                        <div class="card border w-100">
                            <div class="card-body d-flex flex-column">
                                <div class="fw-bold fs-6 lh-sm">@r.Title</div>
                                <div class="text-muted small">@r.Client</div>
                                <div class="small text-muted">Entrega: @r.Due</div>
                                <div class="small text-muted">Tomada por: @r.ClaimedBy</div>
                                <div class="mt-2 d-flex gap-1 flex-wrap">
                                    <span class="hn-chip hn-chip-type">@type.text</span>
                                    <span class="hn-chip hn-chip-status-down">@status.text</span>
                                </div>
                                <div class="mt-auto pt-3 d-flex gap-2 flex-wrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/ServiceOrders/Work" asp-route-id="@r.Id">Abrir</a>
                                    @if (r.HasPdf)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" asp-page="/ServiceOrders/DownloadPdf" asp-route-id="@r.Id" target="_blank">Ver PDF</a>
                                    }
                                    @if (r.CanTake && !r.IsMine)
                                    {
                                        <form method="post" asp-page-handler="Take" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button class="btn btn-sm btn-success" type="submit">Tomar</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Backlog atrasados · Página @Model.Page de @Model.TotalPages</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-page="/ServiceOrders/Index" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-Type="@(Model.Type?.ToString())" asp-route-Status="@(Model.Status?.ToString())" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page-1)">Anterior</a>
        <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-page="/ServiceOrders/Index" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-Type="@(Model.Type?.ToString())" asp-route-Status="@(Model.Status?.ToString())" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page+1)">Siguiente</a>
    </div>
</div>

