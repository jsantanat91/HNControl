@page
@using HNControl.Web.Helpers
@model HNControl.Web.Pages.ServiceOrders.IndexModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 m-0">Ordenes de servicio</h1>
        <div class="text-muted small">Todas las ordenes son visibles. Solo quien la toma puede editar.</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Info))
{
    <div class="alert alert-info">@Model.Info</div>
}

<form method="get" class="card shadow-soft hn-hover mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">Desde</label><input class="form-control" type="date" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-3"><label class="form-label">Hasta</label><input class="form-control" type="date" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-2"><label class="form-label">Por p&aacute;gina</label><select class="form-select" name="PageSize">@foreach (var s in new[] { 10,20,50,100 }) {<option value="@s" selected="@(Model.PageSize==s)">@s</option>}</select></div>
        <div class="col-md-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Filtrar</button><a class="btn btn-outline-secondary" asp-page="/ServiceOrders/Index">Limpiar</a></div>
    </div>
</form>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-secondary">No hay ordenes registradas.</div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3">
        @foreach (var r in Model.Rows)
        {
            var type = UiBadges.ServiceOrderTypeBadge(r.Type);
            var status = UiBadges.ServiceOrderStatusBadge(r.Status);
            <div class="col d-flex">
                <div class="card shadow-soft hn-hover w-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="fw-bold fs-5 lh-sm">@r.Title</div>
                                <div class="text-muted small">@r.Client</div>
                            </div>
                            <div class="text-muted small">@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</div>
                        </div>
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            <span class="badge @type.css">@type.text</span>
                            <span class="badge @status.css">@status.text</span>
                        </div>
                        <div class="small mt-2 text-muted">Tomada por: @r.ClaimedBy</div>
                        <div class="small text-muted">Entrega: @r.Due</div>
                        <div class="mt-auto pt-3 d-flex gap-2 flex-wrap">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/ServiceOrders/Work" asp-route-id="@r.Id">Abrir</a>
                            @if (r.HasPdf)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/ServiceOrders/DownloadPdf" asp-route-id="@r.Id" target="_blank">Ver PDF</a>
                            }
                            @if (r.CanTake && !r.IsMine)
                            {
                                <form method="post" asp-page-handler="Take" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button class="btn btn-sm btn-success" type="submit">Tomar</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Total: @Model.TotalCount · P&aacute;gina @Model.Page de @Model.TotalPages</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-page="/ServiceOrders/Index" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page-1)">Anterior</a>
        <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-page="/ServiceOrders/Index" asp-route-DateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-PageSize="@Model.PageSize" asp-route-Page="@(Model.Page+1)">Siguiente</a>
    </div>
</div>
